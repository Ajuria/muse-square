{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 4321,
      "autoPort": true
    },
    {
      "name": "harness",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--directory",
        "."
      ],
      "port": 4173
    },
    {
      "name": "proto-https",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "tools/harness/https-serve.mjs",
        "tools/proto",
        "8443",
        "8080"
      ],
      "port": 8443,
      "url": "https://localhost:8443"
    }
  ]
}