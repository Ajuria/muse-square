---
// Refonte 3 onglets (04/08, owner) : Demander / Agir / Piloter — mêmes mots que la Nav.
// Rétro-compat des anciens noms d'active ("veille" → agir, "evenements" → piloter).
const raw = String(Astro.props.active ?? "agir");
const active = raw === "veille" ? "agir" : raw === "evenements" ? "piloter" : raw;

const hrefDemander = "/app/insightevent/prompt";
const hrefAgir = "/app/insightevent/pulse";
const hrefPiloter = "/app/insightevent/tableau";
---

<div class="ms-bottombar" role="navigation" aria-label="Navigation">
  <div class="ms-bottombar-nav">

    <a class={`ms-bottombar-item ${active === "demander" ? "is-active" : ""}`} href={hrefDemander} aria-label="Demander" aria-current={active === "demander" ? "page" : undefined}>
      <div class="ms-bottombar-ico" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
        </svg>
      </div>
      <div class="ms-bottombar-label">DEMANDER</div>
    </a>

    <a class={`ms-bottombar-item ${active === "agir" ? "is-active" : ""}`} href={hrefAgir} aria-label="Agir" aria-current={active === "agir" ? "page" : undefined}>
      <div class="ms-bottombar-ico" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <circle cx="12" cy="12" r="3"/>
          <path d="M6.3 6.3a8 8 0 0 0 0 11.4"/>
          <path d="M17.7 6.3a8 8 0 0 1 0 11.4"/>
          <path d="M3.5 3.5a14 14 0 0 0 0 17"/>
          <path d="M20.5 3.5a14 14 0 0 1 0 17"/>
        </svg>
      </div>
      <div class="ms-bottombar-label">AGIR</div>
    </a>

    <a class={`ms-bottombar-item ${active === "piloter" ? "is-active" : ""}`} href={hrefPiloter} aria-label="Piloter" aria-current={active === "piloter" ? "page" : undefined}>
      <div class="ms-bottombar-ico" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
          <circle cx="12" cy="9" r="2.5" fill="currentColor" stroke="none"/>
        </svg>
      </div>
      <div class="ms-bottombar-label">PILOTER</div>
    </a>

  </div>
</div>

<style is:global>
.ms-bottombar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 70;
  background: #ffffff;
  border-top: 1px solid rgba(17,24,39,0.10);
}
.ms-bottombar-nav {
  max-width: 620px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 74px;
  padding-bottom: env(safe-area-inset-bottom, 0px);
}
.ms-bottombar-item {
  flex: 1 1 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  text-decoration: none;
  color: rgba(17,24,39,0.55);
  padding: 8px 10px;
  border-radius: 12px;
  line-height: 1;
  transition: color 120ms ease;
}
.ms-bottombar-item.is-active { color: #1D3BB3; }
.ms-bottombar-item:hover { color: #1D3BB3; }
.ms-bottombar-ico { display: flex; align-items: center; justify-content: center; }
.ms-bottombar-label { font-size: 10px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
</style>