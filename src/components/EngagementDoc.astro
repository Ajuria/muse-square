---
// src/components/EngagementDoc.astro — LE DOCUMENT D'UN DISPOSITIF, partagé par ses DEUX adresses (13/09, owner :
// « je ne comprends pas bien où se situe cette page ? Dans Agir vraiment ? »).
// Une OPÉRATION vit sous Agir (/app/insightevent/engagement) ; un PÔLE se pilote (/app/insightevent/pole, onglet
// Piloter, retour au Tableau de bord). Même rendu (MSCardKit.renderEvolution), même câblage (photos, version
// suivante, bilan…) ; seuls l'adresse, le lien de retour et l'onglet surligné changent. Le script redresse l'adresse
// quand la nature servie ne correspond pas à la page (un ancien lien vers un pôle passe par /engagement → /pole).
import { EVOL_COPY } from "../lib/commitments/commitmentCopy";
interface Props { id: string; page: "engagement" | "pole"; backHref: string; backLabel: string }
const { id, page, backHref, backLabel } = Astro.props;
---

    <div id="eng-root" data-id={id} data-page={page}>
      <div id="eng-toolbar">
        <a href={backHref} id="eng-back">← {backLabel}</a>
      </div>
      <div id="eng-status">
        <!-- Canonical loader (MSLoader); /ms-loader.js rotates the label. -->
        <div class="ms-loader" role="status" aria-live="polite">
          <img class="ms-loader__gif" src="/icons/load/ms_load_icon.gif" alt="" />
          <div class="ms-loader__msg" data-ms-loader="engagement" data-ms-i="0">Chargement de l’évolution…</div>
        </div>
      </div>
      <div id="eng-doc" style="display:none;"></div>
    </div>

    <style is:global>
      #eng-root { max-width: 820px; margin: 0 auto; padding: 16px; font-family: system-ui, -apple-system, sans-serif; color: #111827; }
      #eng-toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
      #eng-back { font-size: 14px; color: #6b7280; text-decoration: none; }
      #eng-status { padding: 60px 0; text-align: center; color: #374151; font-size: 14px; }
      #eng-doc { background: #fff; border: 1px solid rgba(0,0,0,0.10); border-radius: 10px; padding: 26px 28px; }
      /* Titres de section en ENCRE (owner 28/08) : le gris clair était illisible. */
      .eg-uc { font-size: 13px; letter-spacing: .06em; text-transform: uppercase; color: #111827; font-weight: 700; margin-bottom: 10px; }
      .eg-sec { margin-bottom: 26px; }
      /* TÉLÉPHONE (< 768 px, audit mobile 07/09) : c'est la page qu'ouvre le bouton « Ajuster »
         des messages Slack. La mise en page tient déjà (rien ne déborde à 375 px) ; seuls les
         gestes étaient sous le pouce (boutons 29 px, dépliants 15 px). Le desktop ne change pas. */
      @media (max-width: 767px) {
        #eng-root { padding: 12px 12px 16px; }
        #eng-doc { padding: 18px 16px; }
        #eng-doc button { min-height: 40px; }
        #eng-doc summary:not([style*="border-radius:50%"]) { padding-top: 8px; padding-bottom: 8px; }
      }
    </style>

    <script is:inline src="/js/ms-loader.js?v=2"></script>
    <script is:inline src="/js/scope-form.js?v=1"></script>
    <script is:inline src="/js/commit-form.js?v=16"></script>
    <script is:inline src="/js/pole-form.js?v=6"></script>
    <script is:inline src="/js/card-kit.js?v=120"></script>
    <script is:inline define:vars={{ COPY: EVOL_COPY, PAGE: page }}>
      (function () {
        var root = document.getElementById("eng-root");
        var statusEl = document.getElementById("eng-status");
        var docEl = document.getElementById("eng-doc");

        function esc(s) { return String(s == null ? "" : s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;"); }
        function t(key, vars) { var s = COPY[key] || ""; if (vars) for (var k in vars) if (vars.hasOwnProperty(k)) s = s.split("{"+k+"}").join(vars[k]); return s; }
        function showError(msg) { statusEl.textContent = msg; statusEl.style.display = "block"; docEl.style.display = "none"; }
        function doneBtnStyle(sel) { return "font-size:12px;padding:6px 14px;border-radius:6px;cursor:pointer;font-family:inherit;font-weight:600;" + (sel ? "background:#1D3BB3;color:#fff;border:1px solid #1D3BB3;" : "background:#f3f4f6;color:#6b7280;border:1px solid #e5e7eb;"); }

        // ── PURE render moved to the SHARED public/js/card-kit.js (MSCardKit.renderEvolution),
        //    the SINGLE source verified by tools/harness/card-harness.html — same as the system
        //    cards. This page keeps ONLY the interactive wiring (capture POSTs + advice
        //    M'engager sub-form via window.MSCommitForm), attached after the kit renders. ──
        function render(data) {
          if (!data || !data.ok) { showError((data && data.error) || "Engagement introuvable."); return; }
          // 13/09 — deux adresses pour deux natures : un PÔLE se pilote (/pole, onglet Piloter), une OPÉRATION vit sous
          // Agir (/engagement). Un lien ancien (Slack, Explorer, favori) qui ouvre un pôle par /engagement est redressé
          // ici, une fois la nature connue — les paramètres de l'adresse (location_id) sont gardés.
          var nature = data.commitment && data.commitment.dispositif_nature === "permanent" ? "pole" : "engagement";
          if (nature !== PAGE) { var u = new URL(window.location.href); u.pathname = "/app/insightevent/" + nature; window.location.replace(u.toString()); return; }
          if (!window.MSCardKit || !MSCardKit.renderEvolution) { showError("Erreur lors du chargement de l'évolution."); return; }
          docEl.innerHTML = MSCardKit.renderEvolution(data, COPY);
          // ── Photos des composants (étape 4, 03/09, spec dispositifs-typologie § 5) ──
          // Le kit a rendu un emplacement par composant ; la page les remplit depuis l'API et
          // câble « Documenter » : choisir une image, la RÉDUIRE dans le navigateur (1600 px,
          // JPEG) — moins de 1,5 Mo part vers l'API — puis rendre la photo lue. Une personne
          // visible → l'API a effacé l'image, la page dit pourquoi.
          (function wirePhotos() {
            var sec = docEl.querySelector("[data-eg-components]");
            if (!sec || !MSCardKit.renderComponentPhoto) return;
            var did = sec.getAttribute("data-eg-dispositif"), ver = sec.getAttribute("data-eg-version");
            if (!did) return;
            var cmLoc = (data.commitment && data.commitment.location_id) || "";
            var slot = function (key) { return sec.querySelector('[data-eg-photo="' + key + '"]'); };
            var show = function (key, photo) { var el = slot(key); if (el) el.innerHTML = MSCardKit.renderComponentPhoto(photo, COPY); };
            var say = function (key, msg) { var el = slot(key); if (el) el.textContent = msg; };
            // 13/09 — LA VERSION FAITE PAR LA PHOTO (owner : « Si photo change, versionning change » ·
            // « en plus de l'image, on doit confirmer avec le user le changement réalisé »). L'API a déjà
            // créé la version suivante en arrière-plan et rend ses phrases ; ici, on les montre SOUS le
            // composant et on pose LA question — la seule du chantier, au niveau du composant. La réponse
            // devient la note de la version nouvelle, puis la page s'ouvre dessus.
            var montrerVersion = function (key, v) {
              var el = slot(key); if (!el || !v) return;
              // La page regardait la version précédente : les photos suivantes vont sur la nouvelle.
              ver = String(v.version_no); sec.setAttribute("data-eg-version", ver);
              var box = document.createElement("div");
              box.setAttribute("data-eg-chg", v.commitment_id);
              box.setAttribute("style", "margin-top:10px;padding:10px 12px;background:#F5F8FF;border:1px solid #DCE4FB;border-radius:8px;");
              var phrases = (v.raisons || []).map(function (p) { return '<div style="font-size:12.5px;color:#374151;line-height:1.55;">' + esc(p) + '</div>'; }).join("");
              box.innerHTML = phrases
                + '<div style="font-size:12.5px;color:#111827;font-weight:600;margin-top:4px;">' + esc(t("photo_chg_version", { n: v.version_no })) + '</div>'
                + '<label style="display:block;font-size:11px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#6b7280;margin:10px 0 4px;">' + esc(t("photo_chg_q")) + '</label>'
                + '<input type="text" data-eg-chg-note placeholder="' + esc(t("retro_line_ph")) + '" style="width:100%;box-sizing:border-box;font-size:13px;font-family:inherit;color:#111827;border:1px solid #e5e7eb;border-radius:6px;padding:8px 10px;" />'
                + '<div style="display:flex;align-items:center;gap:10px;margin-top:8px;">'
                + '<button type="button" data-eg-chg-save style="font-size:12px;font-weight:600;font-family:inherit;padding:7px 14px;border-radius:6px;cursor:pointer;background:#1D3BB3;color:#fff;border:1px solid #1D3BB3;">' + esc(t("vform_cta")) + '</button>'
                + '<span data-eg-chg-msg style="font-size:12px;color:#b91c1c;"></span></div>';
              el.appendChild(box);
              var input = box.querySelector("[data-eg-chg-note]"), save = box.querySelector("[data-eg-chg-save]"), msg = box.querySelector("[data-eg-chg-msg]");
              var ouvrir = function () { window.location.href = MSCardKit.msPoleUrl(v.commitment_id); };
              save.addEventListener("click", function () {
                var note = (input && input.value ? String(input.value) : "").trim();
                if (!note) { ouvrir(); return; }                  // rien à écrire : la version existe déjà
                save.disabled = true; save.textContent = "…"; msg.textContent = "";
                fetch("/api/commitments/disposition", { method: "POST", headers: { "content-type": "application/json" },
                  body: JSON.stringify({ commitment_id: v.commitment_id, location_id: cmLoc, dispositif_note: note }) })
                  .then(function (r) { return r.json(); })
                  .then(function (j) {
                    if (j && j.ok) { ouvrir(); return; }
                    save.disabled = false; save.textContent = t("vform_cta"); msg.textContent = "Erreur : " + ((j && j.error) || "réessayez");
                  })
                  .catch(function () { save.disabled = false; save.textContent = t("vform_cta"); msg.textContent = "Erreur, réessayez."; });
              });
              if (input) input.focus();
            };
            fetch("/api/dispositifs/photos?dispositif_id=" + encodeURIComponent(did) + (ver ? "&version_no=" + encodeURIComponent(ver) : ""))
              .then(function (r) { return r.json(); })
              .then(function (j) {
                if (!(j && j.ok)) return;
                (j.photos || []).forEach(function (p) { show(p.component_key, p); });
                // Ce que le dispositif vend (07/09) : les articles CONFIRMÉS des photos nourrissent
                // « les articles de la photo » du formulaire de la version suivante.
                var items = [];
                (j.photos || []).forEach(function (p) { (p.items_confirmed || []).forEach(function (it) { if (it && it.item_code) items.push({ item_code: it.item_code, item_description: it.item_description || it.item_code }); }); });
                window._egPhotoItems = items;
              })
              .catch(function () {});
            function shrink(file) {
              return new Promise(function (resolve, reject) {
                var img = new Image(); var url = URL.createObjectURL(file);
                img.onload = function () {
                  var max = 1600, w = img.width, h = img.height, k = Math.min(1, max / Math.max(w, h));
                  var c = document.createElement("canvas"); c.width = Math.round(w * k); c.height = Math.round(h * k);
                  c.getContext("2d").drawImage(img, 0, 0, c.width, c.height);
                  URL.revokeObjectURL(url);
                  resolve(c.toDataURL("image/jpeg", 0.85));
                };
                img.onerror = function () { URL.revokeObjectURL(url); reject(new Error("image illisible")); };
                img.src = url;
              });
            }
            // 15/09 — CE BLOC ÉCOUTE `docEl`, PAS `sec`. `sec` est la section COMPOSANTS ; le bandeau du
            // plan est une section SŒUR, donc un écouteur posé sur `sec` ne reçoit JAMAIS son clic ni son
            // changement de fichier. Livré comme ça une première fois : le bouton « Déposer → » était
            // MORT, et je l'ai annoncé à l'owner comme utilisable. Un rendu vérifié ne prouve pas un
            // geste — seul le geste joué le prouve.
            // ── DÉPOSER LE PLAN DU MAGASIN (owner 15/09, voie b). Sur `docEl` : le bandeau du plan est
            // une section SŒUR de Composants. Le bouton ouvre le sélecteur caché ; le fichier peut aussi
            // être GLISSÉ sur le cadre — c'est le geste qu'on attend d'une zone en pointillés, et ne pas
            // l'avoir mis était un travail à moitié fait.
            docEl.addEventListener("click", function (ev) {
              var dpc = ev.target && ev.target.closest ? ev.target.closest("[data-eg-depot-choisir]") : null;
              if (!dpc) return;
              var zone = dpc.closest("[data-eg-depot-plan]");
              var inp = zone && zone.querySelector("[data-eg-depot-fichier]");
              if (inp) inp.click();
            });
            // GLISSER-DÉPOSER. `dragover` doit être annulé, sinon le navigateur ouvre le fichier à la
            // place. La zone se marque pendant le survol : sans retour visuel, on ne sait pas si on peut
            // lâcher.
            docEl.addEventListener("dragover", function (ev) {
              var z = ev.target && ev.target.closest ? ev.target.closest("[data-eg-depot-plan]") : null;
              if (!z) return;
              ev.preventDefault();
              z.setAttribute("data-survol", "1");
            });
            docEl.addEventListener("dragleave", function (ev) {
              var z = ev.target && ev.target.closest ? ev.target.closest("[data-eg-depot-plan]") : null;
              if (z) z.removeAttribute("data-survol");
            });
            docEl.addEventListener("drop", function (ev) {
              var z = ev.target && ev.target.closest ? ev.target.closest("[data-eg-depot-plan]") : null;
              if (!z) return;
              ev.preventDefault();
              z.removeAttribute("data-survol");
              var f = ev.dataTransfer && ev.dataTransfer.files && ev.dataTransfer.files[0];
              if (f) envoyerPlan(f, z);
            });
            // LE FILTRE DE LA LISTE : il tape sur le nom ET sur le numéro, qui reste un raccourci pour
            // qui le connaît. Aucun aller-retour à l'API — la liste est déjà là.
            docEl.addEventListener("input", function (ev) {
              var fi = ev.target && ev.target.hasAttribute && ev.target.hasAttribute("data-eg-cible-filtre") ? ev.target : null;
              if (!fi) return;
              var bloc = fi.closest("[data-eg-cibles]");
              var q = String(fi.value || "").trim().toLowerCase();
              var vus = 0;
              bloc.querySelectorAll("[data-eg-cible]").forEach(function (x) {
                var ok = !q || String(x.getAttribute("data-eg-cible-cherche") || "").indexOf(q) >= 0;
                x.hidden = !ok;
                if (ok) vus++;
              });
              var rien = bloc.querySelector("[data-eg-cible-rien]");
              if (rien) rien.hidden = vus > 0;
            });
            docEl.addEventListener("change", function (ev) {
              var f = ev.target && ev.target.hasAttribute && ev.target.hasAttribute("data-eg-depot-fichier") ? ev.target : null;
              if (!f || !f.files || !f.files[0]) return;
              envoyerPlan(f.files[0], f.closest("[data-eg-depot-plan]"));
            });
            // UN SEUL foyer d'envoi : le sélecteur et le glisser-déposer y passent tous les deux.
            function envoyerPlan(fichier, zone) {
              if (!fichier || !zone) return;
              var msgP = zone.querySelector("[data-eg-depot-msg]");
              var bouton = zone.querySelector("[data-eg-depot-choisir]");
              var loc = bouton ? bouton.getAttribute("data-eg-depot-choisir") : "";
              if (msgP) msgP.textContent = "";
              if (bouton) bouton.disabled = true;
              var lect = new FileReader();
              lect.onload = function () {
                var s64 = String(lect.result || "");
                var virgule = s64.indexOf(",");
                fetch("/api/dispositifs/plan", { method: "POST", headers: { "content-type": "application/json" },
                  body: JSON.stringify({ location_id: loc, content_type: fichier.type,
                    original_name: fichier.name, file_base64: virgule >= 0 ? s64.slice(virgule + 1) : s64 }) })
                  .then(function (r) { return r.json(); })
                  .then(function (j) {
                    if (j && j.ok) { window.location.reload(); return; }
                    if (bouton) bouton.disabled = false;
                    if (msgP) {
                      msgP.textContent = j && j.refus === "type_refuse" ? (COPY.pole_plan_depot_refus_type || "")
                        : j && j.refus === "trop_lourd" ? (COPY.pole_plan_depot_refus_poids || "")
                        : (COPY.pole_plan_depot_echec || "");
                    }
                  })
                  .catch(function () { if (bouton) bouton.disabled = false; if (msgP) msgP.textContent = COPY.pole_plan_depot_echec || ""; });
              };
              lect.onerror = function () { if (bouton) bouton.disabled = false; if (msgP) msgP.textContent = COPY.pole_plan_depot_echec || ""; };
              lect.readAsDataURL(fichier);
            }
            sec.addEventListener("click", function (ev) {
              // Confirmer les articles (03/09) : les cases cochées partent en items_confirmed.
              var cbtn = ev.target && ev.target.closest ? ev.target.closest("[data-eg-items-submit]") : null;
              if (cbtn) {
                var box = cbtn.closest("[data-eg-items-confirm]"); var rowEl = cbtn.closest("[data-eg-component]");
                if (!box || !rowEl) return;
                var pid = box.getAttribute("data-eg-items-confirm"); var ckey = rowEl.getAttribute("data-eg-component");
                var codes = Array.prototype.map.call(box.querySelectorAll("[data-eg-item]:checked"), function (i) { return i.getAttribute("data-eg-item"); });
                cbtn.disabled = true;
                fetch("/api/dispositifs/photos", { method: "POST", headers: { "content-type": "application/json" },
                  body: JSON.stringify({ action: "confirm", dispositif_id: did, photo_id: pid, items_confirmed: codes }) })
                  .then(function (r) { return r.json(); })
                  .then(function (j) {
                    if (j && j.ok && j.photo) { show(ckey, j.photo); if (j.measured_scope_changed) setTimeout(load, 400); }   // P4 : le périmètre a changé → la page se relit
                    else { cbtn.disabled = false; }
                  })
                  .catch(function () { cbtn.disabled = false; });
                return;
              }
              // 15/09 (owner : « la liste avec photos d'abord ») — LE PREMIER TOUCHER DEMANDE LA LISTE,
              // il n'ouvre plus un champ de numéro. La route la construit (`dry` sans numéro) avec la
              // dernière photo et la longueur de façade de chaque composant du SITE — une photo mal
              // classée peut appartenir à un autre pôle, et c'est le cas qu'on corrige.
              var dp = ev.target && ev.target.closest ? ev.target.closest("[data-eg-photo-deplacer]") : null;
              if (dp) {
                var pidD = dp.getAttribute("data-eg-photo-deplacer");
                var wrapD = sec.querySelector('[data-eg-photo-rm-wrap="' + pidD + '"]');
                if (!wrapD) return;
                dp.disabled = true;
                fetch("/api/dispositifs/photos", { method: "POST", headers: { "content-type": "application/json" },
                  body: JSON.stringify({ action: "deplacer", dispositif_id: did, photo_id: pidD, dry: true }) })
                  .then(function (r) { return r.json(); })
                  .then(function (j) {
                    dp.disabled = false;
                    if (!j || !j.ok || !Array.isArray(j.cibles)) { dp.textContent = COPY.pole_photo_failed || ""; return; }
                    wrapD.setAttribute("data-eg-depuis-pole", j.depuis_pole || "");
                    wrapD.innerHTML = MSCardKit.listeDeDeplacement(j.cibles, j.depuis_pole, COPY)
                      + '<div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:8px;width:100%;">'
                      + '<button type="button" data-eg-deplacer-go="' + esc(pidD) + '" disabled style="font-size:12px;font-weight:600;font-family:inherit;color:#fff;background:#1D3BB3;border:1px solid #1D3BB3;border-radius:8px;padding:4px 12px;cursor:pointer;opacity:.45;">' + esc(COPY.pole_photo_confirm || "Confirmer →") + '</button>'
                      + '<button type="button" data-eg-deplacer-renoncer style="font-size:12px;font-weight:500;font-family:inherit;color:#6b7280;background:none;border:none;cursor:pointer;">' + esc(COPY.pole_photo_deplacer_annuler || "Annuler") + '</button>'
                      + '<div data-eg-deplacer-vise style="flex-basis:100%;font-size:12.5px;color:#6b7280;margin-top:2px;"></div></div>';
                    var fi = wrapD.querySelector("[data-eg-cible-filtre]");
                    if (fi) fi.focus();
                  })
                  .catch(function () { dp.disabled = false; dp.textContent = COPY.pole_photo_failed || ""; });
                return;
              }
              // LE CHOIX D'UNE CIBLE : elle se marque, la ligne dit ce qu'elle emmène, Confirmer s'ouvre.
              var cb = ev.target && ev.target.closest ? ev.target.closest("[data-eg-cible]") : null;
              if (cb) {
                var wrapC2 = cb.closest("[data-eg-photo-rm-wrap]");
                wrapC2.querySelectorAll("[data-eg-cible]").forEach(function (x) {
                  var on = x === cb;
                  x.style.borderColor = on ? "#1D3BB3" : "#e5e7eb";
                  x.style.background = on ? "#F5F7FF" : "#fff";
                  x.setAttribute("data-on", on ? "1" : "0");
                });
                var viseC = wrapC2.querySelector("[data-eg-deplacer-vise]");
                var goC = wrapC2.querySelector("[data-eg-deplacer-go]");
                // LE CHANGEMENT DE PÔLE VIENT DE LA CIBLE, que la route a déjà tranché. Mon premier jet
                // le recalculait ici depuis un attribut `data-eg-depuis-pole` que je n'avais JAMAIS posé :
                // l'avertissement ne se déclenchait donc jamais, et la liste contournait en silence le
                // garde-fou construit la veille. Trouvé en jouant le geste, pas en relisant.
                var autre = cb.getAttribute("data-eg-cible-autre") === "1";
                if (viseC) {
                  viseC.textContent = autre
                    ? t("pole_photo_deplacer_vise_autre_pole", { nom: cb.getAttribute("data-eg-cible-nom"), pole: cb.getAttribute("data-eg-cible-pole"), depuis: wrapC2.getAttribute("data-eg-depuis-pole") || "" })
                    : t("pole_photo_deplacer_vise", { nom: cb.getAttribute("data-eg-cible-nom"), pole: cb.getAttribute("data-eg-cible-pole") });
                  viseC.style.color = autre ? "#B45309" : "#0F6E56";
                }
                if (goC) { goC.disabled = false; goC.style.opacity = "1"; goC.setAttribute("data-eg-cible-no", cb.getAttribute("data-eg-cible")); }
                return;
              }
              // RENONCER : le kit re-rend le bloc de gestes, aucune copie de markup ici.
              if (ev.target && ev.target.closest && ev.target.closest("[data-eg-deplacer-renoncer]")) {
                var wrapC = ev.target.closest("[data-eg-photo-rm-wrap]");
                var pidC = wrapC && wrapC.getAttribute("data-eg-photo-rm-wrap");
                if (pidC) wrapC.innerHTML = MSCardKit.gestesDePhoto(pidC, COPY);
                return;
              }
              var dgo = ev.target && ev.target.closest ? ev.target.closest("[data-eg-deplacer-go]") : null;
              if (dgo && !dgo.disabled) {
                var pidG2 = dgo.getAttribute("data-eg-deplacer-go");
                var wrapG = dgo.closest("[data-eg-photo-rm-wrap]");
                // Le numéro vient de la CIBLE CHOISIE dans la liste, plus d'un champ : le champ n'existe
                // plus (owner 15/09). Le numéro reste la clé de la règle — c'est la SAISIE qui a changé,
                // pas la mécanique, donc `planDeDeplacement` n'est pas touché.
                var noG = { value: dgo.getAttribute("data-eg-cible-no") || "" };
                dgo.disabled = true;
