          wireDispo(cm);
          wireDiag(cm);
          wirePermanent(cm);
          wireNextVersion(cm);
        }

        // « Rendre permanent → » (08/09) : le kit rend le bouton sur une opération TERMINÉE dont le
        // périmètre porte des familles (owner seul). La page crée le pôle — POST /api/commitments,
        // nature permanent, MÊME corps que pole-form.js — puis ouvre sa page. Aucun
        // parent_commitment_id : l'API ne l'accepte que d'un parent déjà permanent.
        // 09/09 (owner : « go back went to Agir instead of the dispositif ») : « ← Retour » revient à la page
        // d'où l'on vient quand elle est à nous (une autre version du dispositif, Piloter, Agir) ; sans
        // provenance connue, le lien garde sa cible historique (Agir).
        (function wireBack() {
          var a = document.getElementById("eng-back");
          if (!a) return;
          a.addEventListener("click", function (e) {
            var ref = "";
            try { ref = String(document.referrer || ""); } catch (_) { ref = ""; }
            var sameOrigin = ref && ref.indexOf(window.location.origin + "/") === 0;
            if (sameOrigin && window.history.length > 1) { e.preventDefault(); window.history.back(); }
          });
        })();
        // 13/09 — la version suivante d'un PÔLE, sans question (owner : « le versionning du pôle est déclaratif —
        // sa page de réglages »). Le kit rend un volet ; la page y monte LE formulaire de pôle (module partagé
        // MSPoleForm, celui de la création) pré-rempli avec la version courante et armé de parent_commitment_id :
        // l'exploitant modifie ce qui change, « Enregistrer → » crée la version suivante, la page s'ouvre dessus.
        // Le contexte de création (familles, responsables, types de composant, pôles) vient de la même route
        // que Nouvelle opération et le Compte : /api/insight/evenement?create_context=1. Chargé au premier
        // dépliage du volet — pas un aller-retour de plus tant qu'on ne l'ouvre pas.
        // Le contexte de création, lu UNE fois par page : la description des composants et le formulaire
        // de « La version suivante » veulent tous les deux ses `component_types`. Sans ce foyer, ouvrir le
        // formulaire coûtait un aller-retour de plus pour la même réponse (budget 3 s).
        var _ctxP = null;
        function contexteCreation(loc) {
          if (!_ctxP) {
            _ctxP = fetch("/api/insight/evenement?location_id=" + encodeURIComponent(loc) + "&create_context=1")
              .then(function (r) { return r.json(); })
              .then(function (j) { if (!j || !j.ok) throw new Error((j && j.error) || "contexte indisponible"); return j; });
          }
          return _ctxP;
        }

        function wireNextVersion(cm) {
          var sec = docEl.querySelector("[data-eg-nextversion-sec]"), mount = docEl.querySelector("[data-eg-nextversion-mount]");
          if (!sec || !mount || !window.MSPoleForm) return;
          var monte = false;
          sec.addEventListener("toggle", function () {
            if (!sec.open || monte) return; monte = true;
            mount.innerHTML = '<div style="font-size:12px;color:#9CA3AF;">Chargement…</div>';
            // Les responsables viennent de l'équipe (la même source que l'onglet Pôles du Compte) — le contexte
            // de création ne les porte pas. Les deux lectures partent ensemble.
            Promise.all([
              contexteCreation(cm.location_id),
              fetch("/api/channels/team?location_id=" + encodeURIComponent(cm.location_id)).then(function (r) { return r.json(); }).catch(function () { return {}; }),
            ]).then(function (rs) {
