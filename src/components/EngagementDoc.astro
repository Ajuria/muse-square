          // reste le travail de « La version suivante » — la route le refuse, la règle est dans
          // lib/dispositifs/composantsDescription.ts.
          // Le libellé reste un TEXTE tant que les options du registre ne sont pas arrivées : une lecture
          // en échec laisse la rangée telle qu'elle était, jamais vide.
          (function wireDescriptions() {
            var sec = docEl.querySelector("[data-eg-components]");
            var cmx = data.commitment || {};
            if (!sec || cmx.status !== "open" || data.role === "member" || window._msMemberView === true) return;
            var rangees = [].slice.call(sec.querySelectorAll("[data-eg-component]"));
            if (!rangees.length) return;
            contexteCreation(cmx.location_id).then(function (ctx) {
              var types = ctx && Array.isArray(ctx.component_types) ? ctx.component_types : [];
              if (!types.length) return;
              var rolesDe = function (v) { var t = types.filter(function (x) { return x.value === v; })[0]; return t && Array.isArray(t.roles) ? t.roles : []; };
              var inp = "font-size:12px;color:#111827;background:#fff;border:1px solid #e5e7eb;border-radius:8px;padding:3px 6px;font-family:inherit;cursor:pointer;";

              // Le mot de l'\u00e9tat, et l'enregistrement, D\u00c9CLAR\u00c9S AVANT les rang\u00e9es : `var` remonte le nom mais
              // pas la valeur, et un \u00e9couteur pos\u00e9 sur une fonction encore ind\u00e9finie ne fait RIEN, en silence
              // \u2014 c'est exactement ce que la liste des r\u00f4les faisait au premier jet.
              var note = document.createElement("div");
              note.setAttribute("style", "font-size:12px;margin-top:4px;");
              sec.appendChild(note);
              var enregistrer = function () {
                // La liste envoy\u00e9e est la COMPOSITION du p\u00f4le, pas un delta : toutes les rang\u00e9es partent.
                var corps = rangees.map(function (row) {
                  var k = row.getAttribute("data-eg-component");
                  var ts = sec.querySelector('[data-eg-desc-type="' + k + '"]');
                  var rs = sec.querySelector('[data-eg-desc-role="' + k + '"]');
                  return { key: k, type: ts ? ts.value : row.getAttribute("data-eg-comp-type"), role: rs && rs.value ? rs.value : null };
                });
                note.style.color = "#6b7280"; note.textContent = "\u2026";
                fetch("/api/commitments/edit", {
                  method: "POST", headers: { "content-type": "application/json" },
                  body: JSON.stringify({ commitment_id: cmx.commitment_id, location_id: cmx.location_id, components: corps }),
                }).then(function (r) { return r.json(); }).then(function (j) {
                  if (j && j.ok) {
                    note.style.color = "#166534"; note.textContent = t("saved");
                    corps.forEach(function (c) {
                      var row = sec.querySelector('[data-eg-component="' + c.key + '"]');
                      if (row) { row.setAttribute("data-eg-comp-type", c.type || ""); row.setAttribute("data-eg-comp-role", c.role || ""); }
                    });
                  } else {
                    note.style.color = "#b91c1c"; note.textContent = (j && j.error) || "Erreur";
                  }
                }).catch(function () { note.style.color = "#b91c1c"; note.textContent = "Erreur"; });
              };

              rangees.forEach(function (row) {
                var key = row.getAttribute("data-eg-component");
                var cur = row.getAttribute("data-eg-comp-type") || "";
                var curRole = row.getAttribute("data-eg-comp-role") || "";
                var cible = sec.querySelector('[data-eg-comp-meta="' + key + '"]');
                if (!cible) return;
                // Un type courant absent de la liste servie (curation par m\u00e9tier) est AJOUT\u00c9 \u00e0 sa liste :
                // sans \u00e7a, ouvrir la page changerait sa valeur en silence au premier enregistrement.
                var opts = types.slice();
                if (cur && !opts.some(function (o) { return o.value === cur; })) opts.unshift({ value: cur, label_fr: cur, roles: [] });
                var tSel = document.createElement("select");
                tSel.setAttribute("data-eg-desc-type", key); tSel.setAttribute("style", inp);
                tSel.innerHTML = opts.map(function (o) { return '<option value="' + esc(o.value) + '">' + esc(o.label_fr) + "</option>"; }).join("");
                tSel.value = cur;   // la valeur s'AFFECTE : un attribut `selected` pos\u00e9 dans du HTML ne fait pas foi partout
