                var owners = (Array.isArray(team.items) ? team.items : []).map(function (m) { return (String(m.first_name || "") + (m.last_name ? " " + m.last_name : "")).trim(); }).filter(Boolean);
                // Une famille vit dans un seul pôle — mais les familles de CE pôle sont les siennes, pas « prises ».
                var taken = {};
                (Array.isArray(ctx.poles) ? ctx.poles : []).forEach(function (pp) {
                  if (pp.dispositif_id && cm.dispositif_id && String(pp.dispositif_id) === String(cm.dispositif_id)) return;
                  if (pp.commitment_id && String(pp.commitment_id) === String(cm.commitment_id)) return;
                  (pp.families || []).forEach(function (f) { taken[f] = pp.name; });
                });
                MSPoleForm.render(mount, {
                  location_id: cm.location_id,
                  families: Array.isArray(ctx.families) ? ctx.families : [],
                  owners: owners,
                  takenFamilies: taken,
