                      + '<button type="button" data-eg-photo-rm-no style="font-size:12px;font-weight:500;font-family:inherit;color:#6b7280;background:none;border:none;cursor:pointer;padding:7px 4px;">' + esc(COPY.cancel || "") + '</button>'
                      + '<span data-eg-photo-rm-msg style="font-size:12px;color:#b91c1c;"></span></div>';
                  })
                  .catch(function () { rm.disabled = false; rm.textContent = COPY.pole_photo_failed || ""; });
                return;
              }
              if (ev.target && ev.target.closest && ev.target.closest("[data-eg-photo-rm-no]")) {
                // On revient à l'état d'avant : le kit re-rend le bloc, aucune copie de markup ici.
                var wrapN = ev.target.closest("[data-eg-photo-rm-wrap]");
                var pidN = wrapN && wrapN.getAttribute("data-eg-photo-rm-wrap");
                if (pidN) wrapN.innerHTML = '<button type="button" data-eg-photo-rm="' + esc(pidN) + '" style="font-size:12px;font-weight:500;font-family:inherit;color:#B45309;background:#fff;border:1px solid #B45309;border-radius:8px;padding:6px 12px;cursor:pointer;min-height:32px;">' + esc(COPY.pole_photo_retirer || "") + '</button>';
                return;
              }
              var go = ev.target && ev.target.closest ? ev.target.closest("[data-eg-photo-rm-go]") : null;
              if (go) {
                var pidG = go.getAttribute("data-eg-photo-rm-go");
                var keyG = (go.closest("[data-eg-component]") || {}).getAttribute
                  ? go.closest("[data-eg-component]").getAttribute("data-eg-component") : null;
                var msgG = go.parentNode.querySelector("[data-eg-photo-rm-msg]");
                go.disabled = true;
                fetch("/api/dispositifs/photos", { method: "POST", headers: { "content-type": "application/json" },
                  body: JSON.stringify({ action: "retirer", dispositif_id: did, photo_id: pidG }) })
                  .then(function (r) { return r.json(); })
                  .then(function (j) {
                    if (!j || !j.ok) { go.disabled = false; if (msgG) msgG.textContent = COPY.pole_photo_failed || ""; return; }
                    // Une version est tombée : l'adresse de la page peut être celle de cette version.
                    // On ouvre celle qui survit — l'adresse vient de l'API, jamais d'une déduction.
                    if (j.version_retiree && j.version_courante_apres && j.version_courante_apres.commitment_id) {
                      window.location.href = MSCardKit.msPoleUrl(j.version_courante_apres.commitment_id); return;
