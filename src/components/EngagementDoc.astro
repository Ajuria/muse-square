                  rSel.innerHTML = '<option value="">R\u00f4le</option>' + rs.map(function (r) { return '<option value="' + esc(r.value) + '">' + esc(r.label_fr) + "</option>"; }).join("");
                  rSel.value = sel || "";
                  rSel.style.display = rs.length ? "" : "none";
                };
                peupler(cur, curRole);
                cible.innerHTML = ""; cible.appendChild(tSel); cible.appendChild(rSel);
                tSel.addEventListener("change", function () { peupler(tSel.value, ""); enregistrer(); });
                rSel.addEventListener("change", enregistrer);
              });
            }).catch(function () { /* la rangée garde son texte : c'est l'affichage d'avant */ });
          })();
          docEl.style.display = "block";
