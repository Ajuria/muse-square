---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Proofs from '../components/home/Proofs.astro';
import MiniOffers from '../components/home/MiniOffers.astro';
import SocialProof from '../components/home/SocialProof.astro';
const FORM_URL = "https://docs.google.com/forms/d/e/1FAIpQLSdaDoRrjhcEauybMeFNQSm_qlYD1RTahTw_ligFT2D20AoopA/viewform?usp=header";
---
<BaseLayout
  title="Muse Square — La mémoire opérationnelle de votre organisation"
  description="Muse Square est la mémoire opérationnelle de votre organisation : sachez ce qui impacte votre activité, mesurez vos dispositifs de vente et réutilisez ce qui a marché."
>
<!-- Hero typographique (proto validé 31/08 : tools/proto/hero-proto-lieu.html, variante B).
     L'image occupe la moitié droite et se fond vers le blanc — le texte reste le sujet. -->
<section class="ms-hero-b relative w-screen left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] overflow-hidden">
  <div class="ms-hero-b-photo" aria-hidden="true"></div>
  <div class="ms-hero-b-veil" aria-hidden="true"></div>
  <div class="ms-container relative z-[2]">
    <div class="ms-hero-b-in">
      <h1 class="ms-hero-b-title">La mémoire opérationnelle<br />de votre <span>organisation</span>.</h1>
      <p class="ms-hero-b-sub">
        Transformez votre expérience en actif opérationnel :<br />
        sachez ce qui impacte votre activité, mesurez vos dispositifs de vente et réutilisez ce qui a marché.
      </p>
      <div class="mt-[30px] flex flex-wrap gap-3">
        <a href="/offres" class="msq-btn-ghost" style="background:#111827;color:#fff;border-color:#111827" data-kpi="cta_view_offres">Découvrir</a>
        <a href="/contact" class="msq-btn-ghost" style="color:#111827;border-color:rgba(0,0,0,.18)" data-kpi="cta_contact">Nous contacter</a>
      </div>
    </div>
  </div>
</section>

<style>
  .ms-hero-b { background: #fff; }
  .ms-hero-b-photo {
    position: absolute; top: 0; right: 0; bottom: 0; width: 56%;
    background-image: url('/images/banner-services-300k.webp');
    background-size: cover; background-position: right center;
    -webkit-mask-image: linear-gradient(90deg, rgba(0,0,0,0) 0%, rgba(0,0,0,.42) 38%, rgba(0,0,0,.95) 100%);
    mask-image: linear-gradient(90deg, rgba(0,0,0,0) 0%, rgba(0,0,0,.42) 38%, rgba(0,0,0,.95) 100%);
  }
  .ms-hero-b-in { padding: 88px 0 72px; max-width: 620px; }
  .ms-hero-b-kicker {
    font-size: 11px; letter-spacing: .14em; text-transform: uppercase;
    color: var(--color-brand-blue); font-weight: 700; margin: 0 0 18px;
  }
  .ms-hero-b-title {
    font-size: 60px; line-height: 1.06; font-weight: 500; letter-spacing: -.025em;
    margin: 0; color: var(--color-text-primary);
  }
  .ms-hero-b-title span { color: var(--color-brand-blue); }
  .ms-hero-b-sub {
    font-size: 19px; line-height: 1.55; color: #374151; margin: 22px 0 0;
  }
  /* Voile blanc entre l'image et le texte : dense en haut, où vivent le titre et
     le sous-texte ; transparent en bas, où l'image reprend sa place. Desktop non
     concerné — le masque latéral y suffit. */
  .ms-hero-b-veil { display: none; }
  @media (max-width: 900px) {
    .ms-hero-b-photo { width: 100%; opacity: .55; background-position: center;
      -webkit-mask-image: none; mask-image: none; }
    .ms-hero-b-veil {
      display: block; position: absolute; inset: 0; z-index: 1; pointer-events: none;
      background: linear-gradient(180deg,
        rgba(255,255,255,.94) 0%,
        rgba(255,255,255,.90) 42%,
        rgba(255,255,255,.62) 74%,
        rgba(255,255,255,.30) 100%);
    }
    .ms-hero-b-in { padding: 56px 0 48px; max-width: none; }
    .ms-hero-b-title { font-size: 34px; }
    .ms-hero-b-sub { font-size: 17px; }
  }
</style>

<!-- Rest of the home page -->
<MiniOffers />
<Proofs />
<div class="ms-divider my-[6px] sm:my-[8px] lg:my-[12px]"></div>
<SocialProof />
<!-- Divider above questionnaire -->
<div class="ms-divider my-[6px] sm:my-[8px] lg:my-[12px]"></div>
</BaseLayout>