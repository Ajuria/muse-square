---
/**
 * Competitor Strategic Profile Page
 * URL: /app/insightevent/competitor?id=COMPETITOR_ID
 *
 * Standalone page — does NOT load data in pulse.
 * All data fetched client-side via /api/competitive/competitor-profile
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { Show } from "@clerk/astro/components";
export const prerender = false;

const location_id =
  (Astro.locals &&
    typeof (Astro.locals as any).location_id === "string" &&
    (Astro.locals as any).location_id.trim())
    ? (Astro.locals as any).location_id.trim()
    : null;

if (!location_id) {
  return Astro.redirect("/app/insightevent/pulse");
}
---

<BaseLayout title="Profil concurrent — Muse Square" hideSurveyCta={true} hideFooter={true}>
  <link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css" />
  <div id="cp-root" style="max-width:680px;margin:0 auto;padding:16px 12px 140px;">
    <div id="cp-loading">
      <!-- Canonical loader (MSLoader); /ms-loader.js rotates the label. -->
      <div class="ms-loader" role="status" aria-live="polite">
        <img class="ms-loader__gif" src="/icons/load/ms_load_icon.gif" alt="" />
        <div class="ms-loader__msg" data-ms-loader="competitor" data-ms-i="0">Chargement du profil concurrent…</div>
      </div>
    </div>
    <div id="cp-content" style="display:none;"></div>
    <div id="cp-error" style="display:none;text-align:center;padding:80px 0;color:#c00;font-size:14px;"></div>
  </div>
</BaseLayout>

  <script is:inline src="/js/ms-loader.js?v=1"></script>
  <script is:inline define:vars={{ location_id }}>
    // @ts-nocheck
    (function() {
      var params = new URLSearchParams(window.location.search);
      var competitorId = (params.get("id") || "").trim();
      if (!competitorId) {
        document.getElementById("cp-loading").style.display = "none";
        document.getElementById("cp-error").style.display = "block";
        document.getElementById("cp-error").textContent = "Identifiant concurrent manquant.";
        return;
      }

      fetch("/api/competitive/competitor-profile?id=" + encodeURIComponent(competitorId))
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (!d.ok) {
            document.getElementById("cp-loading").style.display = "none";
            document.getElementById("cp-error").style.display = "block";
            document.getElementById("cp-error").textContent = d.error || "Erreur inconnue";
            return;
          }
          document.getElementById("cp-loading").style.display = "none";
          document.getElementById("cp-content").style.display = "block";
          renderProfile(d);
        })
        .catch(function(e) {
          document.getElementById("cp-loading").style.display = "none";
          document.getElementById("cp-error").style.display = "block";
          document.getElementById("cp-error").textContent = e.message || "Erreur r\u00e9seau";
        });

      function esc(s) {
        if (!s) return "";
        var d = document.createElement("div");
        d.textContent = String(s);
        return d.innerHTML;
      }

      function timeAgo(dateStr) {
        if (!dateStr) return "";
        var diff = Date.now() - new Date(dateStr).getTime();
        var days = Math.floor(diff / 86400000);
        if (days < 1) return "aujourd\u0027hui";
        if (days === 1) return "il y a 1j";
        if (days < 7) return "il y a " + days + "j";
        var weeks = Math.floor(days / 7);
        if (weeks < 5) return "il y a " + weeks + " sem.";
        var months = Math.floor(days / 30);
        return "il y a " + months + " mois";
      }

      function threatColor(level) {
        if (level === "critical") return "#A32D2D";
        if (level === "high") return "#D85A30";
        if (level === "medium") return "#BA7517";
        return "#5F5E5A";
      }

      // ── Document unique (grammaire ENGAGEMENT — proto competitor-proto.html (supprime le 05/09/2026 - surface livree, historique git) validé owner 17/08) :
      //    en-tête kicker/titre/liseré, verdict en headline, sections Offre · Publics/Clients visés ·
      //    Différenciation · Actualité commerciale. Les onglets Profil/Actualités sont morts (fusion).
      function renderProfile(d) {
        var dir = d.directory || {}, th = d.threat || {}, an = d.analysis || {}, usr = d.user || {};
        var AMBER = "#B45309", GREEN = "#059669", BLUE = "#1D3BB3";
        var AUD_FR = { tourists: "touristes", families: "familles", professionals: "professionnels", local: "client\u00e8le locale", mixed: "client\u00e8le mixte", students: "\u00e9tudiants", seniors: "seniors" };
        var MEN_FR = { low: "menace faible", medium: "menace mod\u00e9r\u00e9e", moderate: "menace mod\u00e9r\u00e9e", high: "menace forte", critical: "menace critique" };
        var REL_FR = { direct_competitor: "concurrent direct", indirect_competitor: "concurrent indirect", complementary: "compl\u00e9mentaire", substitute: "substitut" };
        var SIGNAL_FR = { premium_eux: ["eux plus cher", "#FEF3E2", AMBER], premium_vous: ["vous plus cher", "#FEF3E2", AMBER], parite: ["parit\u00e9", "#F3F4F6", "#6b7280"], gap_eux: ["eux seulement", "#FEF3E2", AMBER], gap_vous: ["vous seulement", "#E6F6F0", GREEN] };
        // Gras de balayage (owner 17/08 : « difficult to scan ») : dans la prose, les PRIX,
        // pourcentages, gratuités et horaires ressortent — échappement D'ABORD, jamais l'inverse.
        var _gras = function (txt2) {
          return esc(txt2).replace(/(\d[\d\u00a0 ,.]*\s?\u20ac|[+\u2212-]?\d+[.,]?\d*\s?%|gratuit\w*|\d{1,2}\s?h\s?\d{0,2}(?:\s?[\u2013-]\s?\d{1,2}\s?h\s?\d{0,2})?)/gi, '<b>$1</b>');
        };
        var chip = function (txt, bg, col) { return '<span style="font-size:10.5px;font-weight:600;border-radius:20px;padding:2px 9px;white-space:nowrap;display:inline-flex;background:' + bg + ';color:' + col + ';">' + txt + '</span>'; };
        var secHd = function (txt, extra) { return '<div style="font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:#9ca3af;font-weight:600;margin:22px 0 10px;">' + txt + (extra || '') + '</div>'; };
        var card = function (inner) { return '<div style="background:#fff;border:0.5px solid #e5e7eb;border-radius:10px;padding:12px 14px;font-size:13px;line-height:1.55;">' + inner + '</div>'; };
        var html = '';

        html += '<div style="margin-bottom:14px;"><a href="javascript:history.back()" style="font-size:13px;color:#6b7280;text-decoration:none;">\u2190 Retour</a></div>';

        // EN-T\u00caTE document.
        html += '<div style="border-bottom:2px solid #1D3BB3;padding-bottom:14px;margin-bottom:22px;">'
          + '<div style="display:flex;align-items:baseline;font-size:12px;letter-spacing:.10em;text-transform:uppercase;color:#1D3BB3;font-weight:600;">Profil strat\u00e9gique'
          + '<span style="margin-left:auto;font-size:13px;font-weight:500;letter-spacing:normal;text-transform:none;color:#6b7280;white-space:nowrap;">' + esc(usr.company_name || '') + '</span></div>'
          + '<div style="font-size:21px;font-weight:600;margin-top:5px;line-height:1.3;">' + esc(dir.competitor_name || '\u2014') + '</div>'
          + '<div style="font-size:13px;color:#6b7280;margin-top:6px;">'
          + [dir.address, dir.city].filter(Boolean).map(esc).join(', ')
          + (th.distance_km != null ? ' \u00b7 \u00e0 ' + String(Math.round(th.distance_km * 10) / 10).replace('.', ',') + ' km' : '')
          + (dir.google_rating != null ? ' \u00b7 \u2605 ' + String(Number(dir.google_rating).toFixed(1)).replace('.', ',') : '')
          + '</div>'
          + '<div style="font-size:12px;color:#9ca3af;margin-top:4px;">'
          + [REL_FR[an.relationship_type], MEN_FR[th.threat_level]].filter(Boolean).map(esc).join(' \u00b7 ')
          + '</div></div>';

        // LE VERDICT d'abord ; sans analyse, l'absence est dite.
        if (an.verdict) html += '<div style="font-size:17px;font-weight:600;color:#111827;line-height:1.4;margin-bottom:6px;">' + esc(an.verdict) + '</div>';
        else html += '<div style="font-size:13px;color:#9CA3AF;margin-bottom:6px;">' + (dir.enriched ? 'Analyse pas encore g\u00e9n\u00e9r\u00e9e \u2014 la veille de nuit la produit cette semaine.' : 'Ajoutez une URL source \u00e0 ce suivi pour activer l\u2019analyse.') + '</div>';

        // OFFRE.
        html += secHd('Offre') + card((function () {
          var h2 = '';
          if (an.value_prop_theirs) h2 += '<div><b>Proposition de valeur :</b> ' + _gras(an.value_prop_theirs) + '</div>';
          if (an.value_prop_yours) h2 += '<div style="color:#6b7280;margin-top:4px;"><b style="color:#374151;">La v\u00f4tre :</b> ' + esc(an.value_prop_yours) + '</div>';
          var prix = an.price_comparison || [];
          if (prix.length) {
            h2 += '<table style="border-collapse:collapse;width:100%;margin-top:10px;"><tr>'
              + ['Cat\u00e9gorie', 'Eux', 'Vous', ''].map(function (t2) { return '<th style="text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:#9ca3af;font-weight:600;padding:6px 10px;border-bottom:1px solid #e5e7eb;">' + t2 + '</th>'; }).join('') + '</tr>';
            prix.forEach(function (r2) {
              var sg = SIGNAL_FR[r2.signal] || null;
              var td = 'font-size:12.5px;padding:7px 10px;border-bottom:1px solid #f0f2f5;vertical-align:top;';
              h2 += '<tr><td style="' + td + 'font-weight:650;">' + esc(r2.category || '') + '</td>'
                + '<td style="' + td + '">' + (r2.their_item ? esc(r2.their_item) + (r2.their_price ? ' \u00b7 <b>' + esc(r2.their_price) + '</b>' : '') : '<span style="color:#9CA3AF;">\u2014</span>') + '</td>'
                + '<td style="' + td + '">' + (r2.your_item ? esc(r2.your_item) + (r2.your_price ? ' \u00b7 <b>' + esc(r2.your_price) + '</b>' : '') : '<span style="color:#9CA3AF;">\u2014</span>') + '</td>'
                + '<td style="' + td + '">' + (sg ? chip(sg[0], sg[1], sg[2]) : '') + '</td></tr>'
                + (r2.reading ? '<tr><td colspan="4" style="font-size:11.5px;color:#6B7280;border-bottom:1px solid #e5e7eb;padding:0 10px 7px;">' + _gras(r2.reading) + '</td></tr>' : '');
            });
            h2 += '</table>';
          }
          var tarifs = d.tarifs || [];
          if (tarifs.length) {
            h2 += '<div style="font-size:12px;font-weight:650;color:#374151;margin-top:10px;">Tarifs relev\u00e9s par votre veille <span style="font-weight:500;color:#9CA3AF;">(' + tarifs.length + ' article' + (tarifs.length > 1 ? 's' : '') + ', dernier relev\u00e9 le ' + String(tarifs[0].vu_le || '').slice(8, 10) + '/' + String(tarifs[0].vu_le || '').slice(5, 7) + ')</span></div>';
            tarifs.slice(0, 6).forEach(function (t2) {
              h2 += '<div style="display:flex;align-items:baseline;gap:8px;padding:4px 0;border-top:1px solid #f0f2f5;font-size:12.5px;">'
                + '<span style="min-width:0;flex:1;">' + esc(t2.item) + (t2.qualif ? ' <span style="color:#9CA3AF;font-size:11px;">(' + esc(t2.qualif) + ')</span>' : '') + '</span>'
                + '<span style="font-weight:650;white-space:nowrap;">' + String(t2.prix).replace('.', ',') + ' \u20ac</span></div>';
            });
          }
          // Offres et prix lus au WEB (registre non v\u00e9rifi\u00e9) — c'est ici qu'ils se lisent,
          // jamais enterr\u00e9s dans l'actualit\u00e9 (owner 17/08 : le r\u00e9cap offre/prix EN T\u00caTE).
          var webOffres = d.actu && d.actu.autres_offres ? d.actu.autres_offres : null;
          if (webOffres) {
            h2 += '<div style="display:flex;align-items:baseline;gap:8px;padding:6px 0;border-top:1px solid #f0f2f5;font-size:12.5px;margin-top:6px;">'
              + '<span style="width:7px;height:7px;border-radius:50%;background:' + AMBER + ';flex:none;"></span>'
              + '<span style="min-width:0;flex:1;"><b style="color:' + AMBER + ';">Autres offres et produits</b> <span style="font-size:10.5px;color:#9CA3AF;">Web \u2014 non v\u00e9rifi\u00e9</span>'
              + '<span style="display:block;font-size:11.5px;color:#6B7280;">' + _gras(webOffres) + '</span></span></div>';
          }
          if (!tarifs.length && !(an.price_comparison || []).length && !webOffres) {
            h2 += '<div style="font-size:12px;color:#9CA3AF;margin-top:8px;">Aucun tarif relev\u00e9 sur ses pages par la veille de nuit \u2014 tarifs non publi\u00e9s ou page tarifs absente du suivi.</div>';
          }
          if ((an.product_gaps || []).length) h2 += '<div style="font-size:12px;color:#6B7280;margin-top:8px;"><b style="color:#374151;">Ils ont, vous n\u2019avez pas :</b> ' + an.product_gaps.map(esc).join(' \u00b7 ') + '</div>';
          if ((an.product_complements || []).length) h2 += '<div style="font-size:12px;color:#6B7280;margin-top:4px;"><b style="color:#374151;">Compl\u00e9mentaires (pas concurrents) :</b> ' + an.product_complements.map(esc).join(' \u00b7 ') + '</div>';
          return h2 || '<span style="color:#9CA3AF;font-size:12.5px;">Rien \u00e0 comparer encore \u2014 l\u2019analyse arrive avec la veille de nuit.</span>';
        })());

        // PUBLICS/CLIENTS VIS\u00c9S.
        var mes = [usr.primary_audience_1, usr.primary_audience_2].filter(Boolean);
        html += secHd('Publics/Clients vis\u00e9s') + card((function () {
          var h2 = '<div style="display:flex;align-items:baseline;gap:6px;flex-wrap:wrap;">';
          [[dir.primary_audience, 'principal'], [dir.secondary_audience, 'secondaire']].forEach(function (pa) {
            if (!pa[0]) return;
            var commun = mes.indexOf(pa[0]) >= 0;
            h2 += chip(esc(AUD_FR[pa[0]] || pa[0]) + ' (' + pa[1] + ')' + (commun ? ' \u2014 commun avec vous' : ''), commun ? '#FEF3E2' : '#F3F4F6', commun ? AMBER : '#6b7280');
          });
          h2 += '<span style="color:#9CA3AF;font-size:11.5px;">le v\u00f4tre : ' + (mes.map(function (a2) { return esc(AUD_FR[a2] || a2); }).join(' \u00b7 ') || 'non renseign\u00e9 au profil') + '</span></div>';
          if (th.audience_overlap_pct != null) h2 += '<div style="font-size:12px;color:#6B7280;margin-top:6px;">Recouvrement mesur\u00e9 : <b>' + Math.round(th.audience_overlap_pct) + ' %</b>' + (th.seasonality_alignment ? ' \u00b7 m\u00eames saisons' : '') + '</div>';
          if (an.segment_overlap) h2 += '<div style="font-size:12px;color:#6B7280;margin-top:4px;">' + _gras(an.segment_overlap) + '</div>';
          return h2;
        })());

        // DIFF\u00c9RENCIATION.
        if ((an.differentiation_theirs || []).length || (an.differentiation_yours || []).length) {
          html += secHd('Diff\u00e9renciation') + card('<div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">'
            + '<div><div style="font-weight:650;margin-bottom:4px;">Eux</div>' + (an.differentiation_theirs || []).map(function (x) { return '<div style="font-size:12px;color:#374151;padding:3px 0;border-top:1px solid #f0f2f5;">' + esc(x) + '</div>'; }).join('') + '</div>'
            + '<div><div style="font-weight:650;margin-bottom:4px;">Vous</div>' + (an.differentiation_yours || []).map(function (x) { return '<div style="font-size:12px;color:#374151;padding:3px 0;border-top:1px solid #f0f2f5;">' + esc(x) + '</div>'; }).join('') + '</div></div>'
            + ((an.parity_gaps || []).length ? '<div style="font-size:12px;color:' + AMBER + ';margin-top:8px;"><b>Table stakes qu\u2019ils ont et pas vous :</b> ' + an.parity_gaps.map(esc).join(' \u00b7 ') + '</div>' : ''));
        }

        // ACTUALIT\u00c9 COMMERCIALE (lecture web hebdo) — absence dite.
        var actu = d.actu || null;
        html += secHd('Actualit\u00e9 commerciale', ' <span style="text-transform:none;letter-spacing:0;font-weight:500;">Web \u2014 non v\u00e9rifi\u00e9' + (actu && actu.lu_le ? ' \u00b7 lu le ' + String(actu.lu_le).slice(8, 10) + '/' + String(actu.lu_le).slice(5, 7) : '') + '</span>')
          + card((function () {
            if (!actu || !(actu.mises || []).length) return '<span style="color:#9CA3AF;font-size:12.5px;">Pas encore lue \u2014 la veille de nuit lit chaque suivi une fois par semaine.</span>';
            var h2 = actu.lead ? '<div style="color:#374151;">' + _gras(actu.lead) + '</div>' : '';
            (actu.mises || []).forEach(function (m2) {
              h2 += '<div style="display:flex;align-items:baseline;gap:8px;padding:6px 0;border-top:1px solid #f0f2f5;font-size:12.5px;">'
                + '<span style="width:7px;height:7px;border-radius:50%;background:' + BLUE + ';flex:none;"></span>'
                + '<span style="min-width:0;flex:1;"><b>' + esc(m2.titre || '') + '</b>'
                + (m2.dates ? ' ' + chip(esc(m2.dates), '#EEF2FF', BLUE) : '')
                + '<span style="display:block;font-size:11.5px;color:#6B7280;">' + _gras(m2.detail || '') + '</span></span></div>';
            });
            if ((actu.sources || []).length) h2 += '<div style="font-size:11px;color:#9CA3AF;margin-top:4px;">Sources : ' + actu.sources.map(function (u2) {
              return '<a href="' + esc(u2) + '" target="_blank" rel="noopener" style="color:#1D3BB3;text-decoration:none;">' + esc(String(u2).replace(/^https?:\/\/(www\.)?/, '').split('/')[0]) + '</a>';
            }).join(' \u00b7 ') + '</div>';
            return h2;
          })());

        // GESTES — labels existants seulement ; la page EXTERNE se lit d'ici (plus depuis la fiche).
        html += '<div style="display:flex;gap:14px;margin-top:22px;align-items:center;">'
          + '<a href="/app/insightevent/pulse" style="font-size:13px;font-weight:650;color:#1D3BB3;text-decoration:none;">Communiquer \u2192</a>'
          + (dir.source_url ? '<a href="' + esc(dir.source_url) + '" target="_blank" rel="noopener" style="font-size:13px;font-weight:650;color:#1D3BB3;text-decoration:none;">Consulter \u2192</a>' : '')
          + '</div>';

        document.getElementById("cp-content").innerHTML = html;
      }
    })();
  </script>
</body>
</html>