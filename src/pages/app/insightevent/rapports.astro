---
// LA PAGE « RAPPORTS » (docs/explorer-outil-spec.md § 6, incrément 4 — owner 12/09, n3 : « le Rapport lui-même dans une
// page dédiée qu'on peut relier au tableau de bord »). Trois choses, dans l'ordre : composer un Rapport (Nouveau
// rapport — la boucle d'Explorer, POST /api/explorer/agent, les blocs vérifiés dès le retour de l'outil), vos Modèles
// (GET /api/explorer/modeles — « Composer depuis ce modèle », « Envoyer chaque… » : incrément 5, GET/POST
// /api/explorer/envois, la zone « Vos envois » avec « Arrêter »), vos Rapports (GET /api/explorer/rapports). Un document
// ouvert porte ses actions (↑ ↓, Dupliquer, Retirer, Votre note, Approfondir ; Actualiser, Modifier la Synthèse,
// Enregistrer comme modèle) et l'historique de ses versions — tout passe par les routes, rien n'est calculé ici.
// Le rendu est celui du kit (renderAnswerBlocks), le même que la réponse d'Explorer et que le rapport de famille.
// Le site : ?location_id, sinon le site actif de la session (les routes le résolvent et le rendent).
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { Show } from "@clerk/astro/components";

const location_id = Astro.url.searchParams.get("location_id") || "";
const document_id = Astro.url.searchParams.get("document_id") || "";
---

<Show when="signed-out" client:load>
  <meta http-equiv="refresh" content="0; url=/sign-in" />
</Show>

<Show when="signed-in" client:load>
  <BaseLayout title="Rapports — Muse Square" hideSurveyCta={true} hideFooter={true}>
    <div id="rp-root" data-location={location_id} data-document={document_id}>
      <div class="rp-head">
        <div class="rp-title">Rapports</div>
        <a class="rp-back" href="/app/insightevent/prompt">Explorer</a>
      </div>

      <div class="rp-zone" id="rp-composer">
        <div class="rp-zh">Nouveau rapport</div>
        <textarea id="rp-q" rows="2" placeholder="Les sections que vous voulez voir : ventes, panier, mix, pôles, résultat net…"></textarea>
        <div class="rp-row">
          <select id="rp-periode" aria-label="Période">
            <option value="30_derniers_jours">30 derniers jours</option>
            <option value="semaine_derniere">La semaine dernière</option>
            <option value="mois_dernier">Le mois dernier</option>
            <option value="trimestre_dernier">Le trimestre dernier</option>
            <option value="douze_derniers_mois">Les 12 derniers mois</option>
            <option value="dates_precises">Dates précises…</option>
          </select>
          <input type="date" id="rp-du" aria-label="Premier jour" style="display:none;" />
          <input type="date" id="rp-au" aria-label="Dernier jour" style="display:none;" />
          <button type="button" id="rp-compose" class="rp-btn rp-btn-primary">Composer</button>
          <span id="rp-compose-status" class="rp-muted"></span>
        </div>
        <ul id="rp-tools" class="rp-tools"></ul>
      </div>

      <div class="rp-zone">
        <div class="rp-zh">Vos modèles</div>
        <div id="rp-modeles" class="rp-muted">Chargement…</div>
      </div>

      <div class="rp-zone">
        <div class="rp-zh">Vos envois</div>
        <div id="rp-envois" class="rp-muted">Chargement…</div>
      </div>

      <div class="rp-zone">
        <div class="rp-zh">Vos rapports</div>
        <div id="rp-list" class="rp-muted">Chargement…</div>
      </div>

      <div id="rp-doc"></div>
    </div>

    <style is:global>
      #rp-root { max-width: 760px; margin: 0 auto; padding: 16px; font-family: system-ui, -apple-system, sans-serif; color: #111827; }
      .rp-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin: 0 0 14px; }
      .rp-title { font-size: 20px; font-weight: 600; color: #111827; }
      .rp-back { font-size: 13px; color: #6b7280; text-decoration: none; }
      .rp-zone { background: #fff; border: 0.5px solid #E5E7EB; border-radius: 12px; padding: 16px 18px; margin: 0 0 16px; }
      .rp-zh { font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #1D3BB3; margin: 0 0 12px; }
      .rp-muted { font-size: 12.5px; color: #9CA3AF; }
      .rp-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 8px; }
      #rp-q { width: 100%; box-sizing: border-box; border: 1px solid #E5E7EB; border-radius: 10px; padding: 9px 11px; font: inherit; font-size: 14px; resize: vertical; }
      #rp-periode { border: 1px solid #E5E7EB; border-radius: 8px; padding: 7px 9px; font: inherit; font-size: 13px; background: #fff; }
      .rp-btn { border: 1px solid #E5E7EB; background: #fff; color: #1D3BB3; border-radius: 8px; padding: 6px 11px; font: inherit; font-size: 12.5px; font-weight: 500; cursor: pointer; }
      .rp-btn[disabled] { opacity: .5; cursor: default; }
      .rp-btn-primary { background: #1D3BB3; color: #fff; border-color: #1D3BB3; }
      .rp-tools { margin: 8px 0 0; padding: 0; list-style: none; }
      .rp-tools li { font-size: 12.5px; color: #4B5563; padding: 3px 0 3px 10px; border-left: 2px solid #E5E7EB; }
      .rp-tools li.run { border-left-color: #1D3BB3; }
      .rp-item { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 12px; padding: 8px 0; border-top: 0.5px solid #F3F4F6; font-size: 13.5px; }
      .rp-item:first-child { border-top: 0; }
      .rp-item a { color: #1D3BB3; text-decoration: none; font-weight: 500; }
      .rp-item .rp-muted { font-size: 12px; }
      .rp-actions { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; padding-top: 10px; border-top: 0.5px dashed #E5E7EB; }
      /* 14/09 — le rang « 3 / 8 » : un repère, pas une donnée. Gris, petit, aligné avec les boutons. */
      /* Dans la ligne de titre (majuscules, bleu donnée) : le rang reste un REPÈRE — gris, chiffres de
         largeur fixe pour que « 9 / 12 » et « 10 / 12 » n'écartent pas le titre, et un séparateur discret. */
      .rp-rang { color: #9CA3AF; font-weight: 600; font-variant-numeric: tabular-nums; letter-spacing: 0; }
      .rp-rang::after { content: " \00b7 "; color: #D1D5DB; }
      /* Le clignotement d'une seconde après un geste : le bleu donnée, qui s'efface. Aucun décalage de mise
         en page (outline, pas border) — un bloc qui grandit en clignotant déplacerait ses voisins. */
      .rp-vient-de-bouger { outline: 2px solid #1D3BB3; outline-offset: 3px; border-radius: 6px; animation: rp-fade 1s ease-out forwards; }
      [data-rapport-section]:focus { outline: none; }
      /* 14/09 — l'éditeur DANS le bloc (owner : « pas dans un pop-up hideux »). Il se pose sous les gestes,
         détaché du contenu par un fond neutre : on voit qu'on écrit À PROPOS de la section, pas dedans. */
      .rp-editeur { margin-top: 10px; padding: 12px; background: #F9FAFB; border: 1px solid #E5E7EB; border-radius: 10px; }
      .rp-editeur-titre { font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #1D3BB3; margin-bottom: 8px; }
      .rp-editeur textarea, .rp-editeur input[type="text"] { width: 100%; box-sizing: border-box; font: inherit; font-size: 13.5px; line-height: 1.5; color: #111827;
        border: 1px solid #E5E7EB; border-radius: 8px; padding: 9px 10px; background: #fff; resize: vertical; }
      .rp-editeur textarea:focus, .rp-editeur input[type="text"]:focus { outline: 2px solid #1D3BB3; outline-offset: -1px; border-color: #1D3BB3; }
      .rp-editeur-pied { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 8px; }
      /* L'aide de raccourcis s'efface sur petit écran : elle nomme des touches qu'un téléphone n'a pas. */
      .rp-editeur-aide { font-size: 11.5px; }
      /* 14/09 — la liste des sections à ajouter : chaque choix montre son NOM et sa DÉFINITION. Un nom seul
         (« Mix produits & services ») ne dit pas ce qu'on ajoute ; la définition existe au lexique, on la
         montre au lieu de la cacher au survol — on choisit une fois, on ne survole pas treize lignes. */
      .rp-choix { display: grid; gap: 6px; }
      .rp-choix-item { display: block; width: 100%; text-align: left; font: inherit; cursor: pointer;
        background: #fff; border: 1px solid #E5E7EB; border-radius: 8px; padding: 9px 11px; }
      .rp-choix-item:hover:not(:disabled) { border-color: #1D3BB3; background: #F5F7FF; }
      .rp-choix-item:disabled { opacity: 0.5; cursor: default; }
      .rp-choix-titre { display: block; font-size: 13.5px; font-weight: 600; color: #111827; }
      .rp-choix-def { display: block; font-size: 12px; color: #6B7280; line-height: 1.45; margin-top: 2px; }
      @media (max-width: 640px) { .rp-editeur-aide { display: none; } }
      @keyframes rp-fade { from { outline-color: #1D3BB3; } to { outline-color: rgba(29,59,179,0); } }
      /* Respecte le réglage système : sans mouvement, le liseré s'affiche et disparaît sans animation. */
      @media (prefers-reduced-motion: reduce) { .rp-vient-de-bouger { animation: none; } }
      .rp-bar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 0 0 10px; }
      .rp-versions { font-size: 12px; color: #6B7280; margin: 0 0 10px; }
      .rp-versions a { color: #1D3BB3; text-decoration: none; margin-right: 10px; }
      .rp-form { flex-basis: 100%; margin-top: 6px; padding: 10px 12px; background: #F9FAFB; border-radius: 10px; font-size: 13px; }
      .rp-form select, .rp-form input[type="text"] { border: 1px solid #E5E7EB; border-radius: 8px; padding: 6px 8px; font: inherit; font-size: 13px; background: #fff; }
      .rp-form label { margin-right: 12px; white-space: nowrap; }
      .rp-form .rp-row { margin-top: 6px; }
      .rp-err { background: #FEF3C7; color: #92400E; border-radius: 10px; padding: 9px 12px; margin: 0 0 10px; font-size: 13px; }
    </style>

    <script is:inline src="/js/card-kit.js?v=103"></script>
    <script is:inline>
      (function () {
        var root = document.getElementById("rp-root");
        var $ = function (id) { return document.getElementById(id); };
        var loc = root.dataset.location || "";
        var openId = root.dataset.document || "";
        var kit = window.MSCardKit;

        function esc(s) { return String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;"); }
        function el(tag, cls, text) { var e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; }
        function frD(iso) { var m = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(iso || "")); return m ? (m[3] + "/" + m[2] + "/" + m[1]) : String(iso || ""); }
        function q(extra) { return "?location_id=" + encodeURIComponent(loc) + (extra || ""); }
        function showErr(container, msg) { var e = el("div", "rp-err", msg); container.insertBefore(e, container.firstChild); setTimeout(function () { e.remove(); }, 6000); }
        async function getJson(url) { var r = await fetch(url); var j = await r.json().catch(function () { return null; }); if (!r.ok || !j || !j.ok) throw new Error((j && j.error) || ("HTTP " + r.status)); return j; }
        async function postJson(url, body) { var r = await fetch(url, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) }); var j = await r.json().catch(function () { return null; }); if (!r.ok || !j || !j.ok) throw new Error((j && j.error) || ("HTTP " + r.status)); return j; }
        function parseSse(chunk, state, onEvent) {
          state.buf += chunk;
          var parts = state.buf.split("\n\n"); state.buf = parts.pop();
          parts.forEach(function (p) {
            var ev = null, data = "";
            p.split("\n").forEach(function (line) { if (line.indexOf("event: ") === 0) ev = line.slice(7); else if (line.indexOf("data: ") === 0) data += line.slice(6); });
            if (ev) { try { onEvent(ev, JSON.parse(data)); } catch (e) { /* ligne illisible */ } }
          });
        }
        function toolLine(list, r) {
          var li = el("li", r.ok === false ? "ko" : "");
          li.appendChild(el("b", null, r.label_fr || r.name)); li.appendChild(document.createTextNode(" — " + (r.summary || "")));
          if (typeof r.ms === "number") li.appendChild(el("span", "rp-muted", " · " + (r.ms / 1000).toFixed(1).replace(".", ",") + " s"));
          list.appendChild(li); return li;
        }

        // ── La boucle d'Explorer : une demande → les blocs vérifiés au fil des outils, puis le tour (Synthèse) ──
        async function composer(body, tools, onBlocks) {
          var pending = el("li", "run", "…"); tools.appendChild(pending);
          var res = await fetch("/api/explorer/agent", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(Object.assign({ location_id: loc, stream: true }, body)) });
          if (!res.ok || !res.body) throw new Error("HTTP " + res.status);
          var reader = res.body.getReader(), dec = new TextDecoder(), state = { buf: "" }, result = null;
          while (true) {
            var chunk = await reader.read(); if (chunk.done) break;
            parseSse(dec.decode(chunk.value, { stream: true }), state, function (ev, data) {
              if (ev === "tool") { toolLine(tools, data); tools.appendChild(pending); if (Array.isArray(data.blocks) && data.blocks.length && onBlocks) onBlocks(data); }
              if (ev === "result") result = data;
            });
          }
          pending.remove();
          if (!result || !result.body || result.body.ok !== true) throw new Error((result && result.body && result.body.error) || "réponse illisible");
          return result.body;
        }

        // ── Le document ouvert : le kit, les actions, l'historique ──
        var docEl = $("rp-doc");
        // 14/09 (owner : « on ne suit pas bien où le bloc est parti »). La cause n'était PAS que les blocs se
        // ressemblent : `renderDocument` détruit tout et reconstruit, puis ramenait en HAUT du rapport
        // (`zone.scrollIntoView({block:"start"})`) — chaque flèche renvoyait l'exploitant au début, et le
        // bouton qu'il venait de cliquer n'existait plus, donc le focus retombait sur le corps de page.
        // `ancre` = { section, bouton } : après le rendu, on ramène CETTE section au centre, on la fait
        // clignoter une seconde, et on rend le focus au MÊME bouton — pour que trois montées d'affilée se
        // fassent sans rien rechercher, à la souris comme au clavier.
        // 14/09 — L'ÉDITEUR DANS LE BLOC. La grammaire du workspace d'Agir : on écrit là où on regarde,
        // jamais par-dessus. (Le module `draft-workspace.js` lui-même n'est PAS réutilisé : c'est le
        // workspace d'ENVOI — canaux, destinataires, brouillons — et le traîner dans un Rapport y
        // amènerait tout ce qui n'a rien à y faire. On en reprend le geste, pas le code.)
        //
        // UN SEUL éditeur ouvert à la fois, dans tout le document : deux zones de saisie ouvertes côte à
        // côte, on ne sait plus laquelle on remplit, et Échap n'en ferme qu'une.
        function editeurDansLeBloc(bloc, opts) {
          var ouvert = docEl.querySelector(".rp-editeur");
          if (ouvert) ouvert.remove();
          var box = el("div", "rp-editeur");
          var lab = el("div", "rp-editeur-titre", opts.titre); box.appendChild(lab);
          var ta = document.createElement(opts.uneLigne ? "input" : "textarea");
          if (opts.uneLigne) ta.type = "text"; else ta.rows = 3;
          ta.placeholder = opts.placeholder || ""; ta.value = opts.valeur || "";
          ta.setAttribute("aria-label", opts.titre);
          box.appendChild(ta);
          var pied = el("div", "rp-editeur-pied");
          var etat = el("span", "rp-muted", "");
          var valider = el("button", "rp-btn rp-btn-primary", opts.cta); valider.type = "button";
          var annuler = el("button", "rp-btn", "Annuler"); annuler.type = "button";
          // L'aide de saisie se DIT : un raccourci qu'on ne montre pas n'existe pas.
          var aide = el("span", "rp-muted rp-editeur-aide", "⌘+Entrée pour valider · Échap pour annuler");
          pied.appendChild(valider); pied.appendChild(annuler); pied.appendChild(aide); pied.appendChild(etat);
          box.appendChild(pied);
          if (opts.apres && opts.apres.parentNode) opts.apres.parentNode.insertBefore(box, opts.apres.nextSibling);
          else bloc.appendChild(box);
          ta.focus();
          if (typeof box.scrollIntoView === "function") box.scrollIntoView({ block: "nearest" });

          var fermer = function () { box.remove(); };
          var envoyer = async function () {
            var texte = ta.value.trim();
            // Vide : on ne valide pas, et on le DIT — un bouton qui ne fait rien passe pour cassé.
            if (!texte) { etat.textContent = "Écrivez quelque chose d'abord."; ta.focus(); return; }
            valider.disabled = true; annuler.disabled = true; etat.textContent = "…";
            try { await opts.valider(texte); }
            catch (e) {
              // L'échec garde le texte SOUS LES YEUX : le perdre après l'avoir écrit est impardonnable.
              valider.disabled = false; annuler.disabled = false;
              etat.textContent = String(e.message || e); return;
            }
            fermer();   // le document se re-rend : l'éditeur disparaît avec lui
          };
          valider.addEventListener("click", envoyer);
          annuler.addEventListener("click", fermer);
          ta.addEventListener("keydown", function (ev) {
            if (ev.key === "Escape") { ev.preventDefault(); fermer(); return; }
            if (ev.key === "Enter" && (opts.uneLigne || ev.metaKey || ev.ctrlKey)) { ev.preventDefault(); envoyer(); }
          });
        }

        function renderDocument(doc, ancre) {
          docEl.innerHTML = "";
          var zone = el("div", "rp-zone");
          var reg = doc.rapport.synthese ? doc.rapport.synthese.register : "vetted";
          var bar = el("div", "rp-bar");
          var head = el("div", "rp-zh", "Rapport · version " + doc.version); head.style.margin = "0"; bar.appendChild(head);
          var st = el("span", "rp-muted", "");
          var mk = function (label, fn, aria) { var b = el("button", "rp-btn", label); b.type = "button"; if (aria) { b.setAttribute("aria-label", aria); b.title = aria; } b.addEventListener("click", async function () { b.disabled = true; st.textContent = "…"; try { await fn(); st.textContent = ""; } catch (e) { showErr(zone, String(e.message || e)); st.textContent = ""; } b.disabled = false; }); return b; };
          // Où regarder APRÈS le geste : un déplacement suit le bloc à sa nouvelle place (`vers`) ; un
          // retrait n'a plus de bloc à montrer, on regarde celui qui a pris la place (borné) ; les autres
          // restent sur leur section.
          var ancreDuGeste = function (g, params, bouton) {
            if (!params) return null;
            if (g === "deplacer") return { section: params.vers, bouton: bouton };
            if (g === "retirer") return { section: Math.max(0, params.section - 1), bouton: null };
            return { section: params.section, bouton: bouton };
          };
          var geste = async function (g, params, bouton) { var j = await postJson("/api/explorer/rapports", Object.assign({ location_id: loc, document_id: doc.document_id, geste: g }, params || {})); renderDocument(Object.assign({}, j.document, { ajoutables: j.ajoutables }), ancreDuGeste(g, params, bouton)); loadRapports(); };
          bar.appendChild(mk("Actualiser", function () { return geste("actualiser", {}); }));
          // 14/09 — la Synthèse aussi : c'est le texte le PLUS long du document (trois à cinq phrases), donc
          // le pire cas pour une boîte de dialogue. L'éditeur s'ouvre sous la barre, pré-rempli avec le
          // texte en place — on corrige ce qui est écrit au lieu de le retaper.
          bar.appendChild(mk("Modifier la Synthèse", function () {
            editeurDansLeBloc(zone, {
              titre: "La Synthèse, dans vos mots", cta: "Enregistrer", apres: bar,
              valeur: doc.rapport.synthese ? doc.rapport.synthese.text : "",
              placeholder: "Ce que la période dit, en quelques phrases.",
              valider: function (texte) { return geste("synthese", { texte: texte }); },
            });
          }));
          // 14/09 — le dernier `prompt()` de la page tombe avec les autres : une seule boîte du navigateur
          // qui subsiste, et c'est elle qu'on retrouve au mauvais moment. Un NOM tient sur une ligne, donc
          // un champ d'une ligne où Entrée valide — pas une zone de trois lignes qui invite à une phrase.
          bar.appendChild(mk("Enregistrer comme modèle", function () {
            editeurDansLeBloc(zone, {
              titre: "Le nom du modèle", cta: "Enregistrer", apres: bar, uneLigne: true,
              valeur: doc.titre.replace(/ — .*$/, ""),
              placeholder: "Hebdo ventes, Point mensuel pôles…",
              valider: async function (nom) {
                var j = await postJson("/api/explorer/modeles", { location_id: loc, document_id: doc.document_id, nom: nom });
                st.textContent = "Modèle enregistré : " + j.nom + (j.periode_par_defaut ? " (période : les 30 derniers jours)" : "");
                loadModeles();
              },
            });
          }));
          // 14/09 — « + Ajouter une section » : le geste porte sur le DOCUMENT, pas sur une section ; la
          // nouvelle arrive à la fin (avant Sources, arbitrage owner) et ↑ ↓ la déplacent. `ajoutables`
          // vient du serveur avec le document ; absent (réponse ancienne), le bouton ne s'affiche pas —
          // plutôt que d'ouvrir une liste vide qui dirait faussement « tout est déjà là ».
          if (Array.isArray(doc.ajoutables)) {
            bar.appendChild(mk("+ Ajouter une section", function () {
              choixDeSection(zone, bar, doc.ajoutables, function (cle) { return geste("ajouter", { cle: cle }); });
            }));
          }
          bar.appendChild(st);
          zone.appendChild(bar);
          var hist = el("div", "rp-versions", ""); zone.appendChild(hist);
          getJson("/api/explorer/rapports" + q("&document_id=" + encodeURIComponent(doc.document_id) + "&versions=1")).then(function (j) {
            if (!j.versions || j.versions.length < 2) return;
            hist.appendChild(document.createTextNode("Versions : "));
            j.versions.forEach(function (v) {
              var a = el("a", null, "v" + v.version + " · " + frD(v.created_at)); a.href = "#";
              if (v.version === doc.version) a.style.fontWeight = "700";
              a.addEventListener("click", async function (ev) { ev.preventDefault(); try { var jj = await getJson("/api/explorer/rapports" + q("&document_id=" + encodeURIComponent(doc.document_id) + "&version=" + v.version)); renderDocument(Object.assign({}, jj.document, { ajoutables: jj.ajoutables })); } catch (e) { showErr(zone, String(e.message || e)); } });
              hist.appendChild(a);
            });
          }).catch(function () {});
          var body = el("div"); body.innerHTML = kit.renderAnswerBlocks([{ type: "register", register: reg }, doc.rapport]); zone.appendChild(body);
          var zones = body.querySelectorAll("[data-rapport-section]");
          zones.forEach(function (z) {
            var i = Number(z.getAttribute("data-rapport-section"));
            // 14/09 (owner) — « 3 / 8 » : la position se LIT au lieu de se suivre du regard. Sur un rapport
            // de douze sections, c'est ce qui sert le plus : on compare un numéro avant et après, sans
            // avoir rien vu bouger.
            // CORRIGÉ le 14/09 : je l'avais posé dans la rangée des BOUTONS, alors que j'avais annoncé « à
            // côté du titre ». L'owner regardait le titre et ne voyait rien — un repère de position se lit
            // là où l'œil cherche le nom de la section, pas au milieu des gestes. Il entre donc DANS la
            // ligne de titre que le kit rend (premier enfant du bloc, card-kit.js `rapport` → `zone`).
            var rang = el("span", "rp-rang", (i + 1) + " / " + zones.length);
            rang.setAttribute("aria-label", "Section " + (i + 1) + " sur " + zones.length);
            var titreEl = z.firstElementChild;
            var actions = el("div", "rp-actions");
            if (titreEl) titreEl.insertBefore(rang, titreEl.firstChild);
            else actions.appendChild(rang);          // repli : mieux vaut le rang au mauvais endroit qu'absent
            // Déplacer : des flèches, pas des mots (owner 12/09) — Monter / Descendre sont les mots lus par un lecteur d'écran.
            if (i > 0) actions.appendChild(mk("↑", function () { return geste("deplacer", { section: i, vers: i - 1 }, "↑"); }, "Monter"));
            if (i < zones.length - 1) actions.appendChild(mk("↓", function () { return geste("deplacer", { section: i, vers: i + 1 }, "↓"); }, "Descendre"));
            actions.appendChild(mk("Dupliquer", function () { return geste("dupliquer", { section: i }, "Dupliquer"); }));
            actions.appendChild(mk("Retirer", function () { return geste("retirer", { section: i }); }));
            // 14/09 (owner : « on devrait éditer dans le bloc lui-même, pas dans un pop-up hideux »). Les
            // deux gestes passaient par `prompt()` — la boîte du navigateur : elle bloque la page, elle ne
            // montre pas la section qu'on annote, elle ne garde aucun brouillon, et sur téléphone une
            // question de deux lignes s'y tape à l'aveugle. On édite désormais LÀ OÙ ON REGARDE.
            actions.appendChild(mk("Votre note", function () {
              editeurDansLeBloc(z, {
                titre: "Votre note", cta: "Enregistrer",
                placeholder: "Ce que vous savez et que la mesure ne dit pas.",
                valider: function (texte) { return geste("note", { section: i, texte: texte }, "Votre note"); },
              });
            }));
            var approfondirSur = function (bloc, idx) {
              editeurDansLeBloc(bloc, {
                titre: "Approfondir", cta: "Demander",
                placeholder: "Votre question sur cette section.",
                valider: async function (question) {
                  var tools = el("ul", "rp-tools"); z.appendChild(tools);
                  var r = await composer({ approfondir: { document_id: doc.document_id, section: i, question: question } }, tools, null);
                  tools.remove();
                  // 14/09 (owner : « Approfondir s'est refermé comme s'il savait que c'était tout pour moi,
                  // ce qui est faux »). Une réponse appelle la question suivante : on rouvre l'éditeur sur
                  // LA MÊME section, vide, curseur dedans. Le document est rendu d'abord (la réponse doit
                  // être lisible), puis la section est ramenée à l'écran par l'ancre — sinon on rouvrirait
                  // un champ que l'exploitant ne voit pas.
                  renderDocument(Object.assign({}, r.document, { ajoutables: r.ajoutables }), { section: i, bouton: null });
                  loadRapports();
                  var revenue = docEl.querySelector('[data-rapport-section="' + i + '"]');
                  if (revenue) approfondirSur(revenue, i);
                },
              });
            };
            actions.appendChild(mk("Approfondir", function () { approfondirSur(z, i); }));
            z.appendChild(actions);
          });
          docEl.appendChild(zone);
          // Sans ancre (ouverture d'un rapport), on montre le début. AVEC une ancre (après un geste), on
          // montre LA section concernée, au centre — jamais le haut du document, qui était le défaut.
          var cible = ancre ? body.querySelector('[data-rapport-section="' + ancre.section + '"]') : null;
          if (!cible) { if (typeof zone.scrollIntoView === "function") zone.scrollIntoView({ block: "start" }); return; }
          if (typeof cible.scrollIntoView === "function") cible.scrollIntoView({ block: "center", behavior: "smooth" });
          // Le clignotement : une seconde, puis plus rien. Il ne laisse aucun élément permanent à l'écran.
          cible.classList.add("rp-vient-de-bouger");
          setTimeout(function () { cible.classList.remove("rp-vient-de-bouger"); }, 1000);
          // Le focus au MÊME bouton : trois montées d'affilée sans rien rechercher, souris ou clavier.
          // `preventScroll` : focus() défile de lui-même et lutterait contre le défilement doux ci-dessus.
          var pose = function (e) { try { e.focus({ preventScroll: true }); } catch (err) { e.focus(); } };
          var mis = false;
          if (ancre.bouton) {
            var btns = cible.querySelectorAll(".rp-actions button");
            for (var bi = 0; bi < btns.length; bi++) {
              if (btns[bi].textContent === ancre.bouton) { pose(btns[bi]); mis = true; break; }
            }
          }
          // Le bouton peut ne plus exister : monté tout en haut, « ↑ » disparaît. On pose alors le focus sur
          // le BLOC lui-même, jamais sur le bouton voisin — au sommet, le voisin est « ↓ », et Entrée
          // redescendrait le bloc qu'on vient de monter.
          if (!mis) { cible.setAttribute("tabindex", "-1"); pose(cible); }
        }
        // 14/09 — LE SÉLECTEUR DE SECTION (owner : « comment ajoute-t-on des blocs, et on les choisit
        // comment ? »). La liste vient du SERVEUR : le vocabulaire des sections vit dans src/lib/fr, la
        // page ne peut pas le connaître. Chaque choix porte son titre ET sa définition — on choisit en
        // sachant ce qu'on ajoute, pas en devinant d'après un nom.
        function choixDeSection(zone, apres, ajoutables, ajouter) {
          var ouvert = docEl.querySelector(".rp-editeur");
          if (ouvert) ouvert.remove();
          var box = el("div", "rp-editeur");
          box.appendChild(el("div", "rp-editeur-titre", "Ajouter une section"));
          var etat = el("span", "rp-muted", "");
          if (!ajoutables.length) {
            // Toutes présentes : on le DIT. Une liste vide laisserait croire que le bouton est cassé.
            box.appendChild(el("div", "rp-muted", "Toutes les sections sont déjà dans ce Rapport."));
          } else {
            var liste = el("div", "rp-choix");
            ajoutables.forEach(function (d) {
              var b = el("button", "rp-choix-item"); b.type = "button";
              b.appendChild(el("span", "rp-choix-titre", d.titre));
              if (d.definition) b.appendChild(el("span", "rp-choix-def", d.definition));
              b.addEventListener("click", async function () {
                liste.querySelectorAll("button").forEach(function (x) { x.disabled = true; });
                etat.textContent = "Composition de « " + d.titre + " »…";
                try { await ajouter(d.cle); }
                catch (e) {
                  liste.querySelectorAll("button").forEach(function (x) { x.disabled = false; });
                  etat.textContent = String(e.message || e);
                }
              });
              liste.appendChild(b);
            });
            box.appendChild(liste);
          }
          var pied = el("div", "rp-editeur-pied");
          var annuler = el("button", "rp-btn", "Annuler"); annuler.type = "button";
          annuler.addEventListener("click", function () { box.remove(); });
          pied.appendChild(annuler); pied.appendChild(etat);
          box.appendChild(pied);
          if (apres && apres.parentNode) apres.parentNode.insertBefore(box, apres.nextSibling);
          else zone.appendChild(box);
          if (typeof box.scrollIntoView === "function") box.scrollIntoView({ block: "nearest" });
        }

        async function openDocument(id, version) {
          try { var j = await getJson("/api/explorer/rapports" + q("&document_id=" + encodeURIComponent(id) + (version ? "&version=" + version : ""))); renderDocument(Object.assign({}, j.document, { ajoutables: j.ajoutables })); }
          catch (e) { showErr(docEl, String(e.message || e)); }
        }

        // ── Vos rapports ──
        async function loadRapports() {
          var box = $("rp-list");
          try {
            var j = await getJson("/api/explorer/rapports" + q());
            if (!loc && j.location_id) loc = j.location_id;
            box.innerHTML = "";
            if (!j.documents.length) { box.textContent = "Aucun Rapport enregistré sur ce site — composez-en un ci-dessus."; return; }
            j.documents.forEach(function (d) {
              var row = el("div", "rp-item");
              var a = el("a", null, d.titre); a.href = "#"; a.addEventListener("click", function (ev) { ev.preventDefault(); openDocument(d.document_id); });
              row.appendChild(a);
              row.appendChild(el("span", "rp-muted", "du " + frD(d.periode_du) + " au " + frD(d.periode_au) + " · " + d.n_sections + " sections · version " + d.version + " · " + frD(d.created_at)));
              box.appendChild(row);
            });
          } catch (e) { box.textContent = "Rapports indisponibles : " + String(e.message || e); }
        }

        // ── Vos modèles ──
        async function loadModeles() {
          var box = $("rp-modeles");
          try {
            var j = await getJson("/api/explorer/modeles" + q());
            if (!loc && j.location_id) loc = j.location_id;
            box.innerHTML = "";
            j.modeles.forEach(function (m) {
              var row = el("div", "rp-item");
              var left = el("div"); left.appendChild(el("div", null, m.nom)); left.appendChild(el("div", "rp-muted", (m.sections_fr || []).join(" · ")));
              row.appendChild(left);
              var b = el("button", "rp-btn", "Composer depuis ce modèle"); b.type = "button";
              b.addEventListener("click", function () { lancerComposition({ modele: m.par_defaut ? "ventes" : m.nom, periode: m.periode_relative }); });
              row.appendChild(b);
              // 12/09 (spec § 6.4, incrément 5) — « Envoyer chaque … » : le même Modèle, rempli sur la période de la cadence, à moi ou à l'équipe.
              var be = el("button", "rp-btn", "Envoyer chaque…"); be.type = "button";
              be.addEventListener("click", function () { var f = row.querySelector(".rp-form"); if (f) { f.remove(); return; } row.appendChild(formEnvoi(m)); });
              row.appendChild(be);
              box.appendChild(row);
            });
          } catch (e) { box.textContent = "Modèles indisponibles : " + String(e.message || e); }
        }

        // ── Vos envois (spec § 6.4, incrément 5) : un Modèle, une cadence, une heure, un canal, des destinataires ──
        var contacts = { moi: null, equipe: [] };
        var JOURS = ["lundi", "mardi", "mercredi", "jeudi", "vendredi", "samedi", "dimanche"];
        function opt(sel, value, label) { var o = document.createElement("option"); o.value = value; o.textContent = label; sel.appendChild(o); return o; }
        function formEnvoi(m) {
          var f = el("div", "rp-form");
          var modele_id = m.par_defaut ? "ventes" : m.template_id;
          var r1 = el("div", "rp-row");
          var cad = document.createElement("select"); cad.setAttribute("aria-label", "Cadence");
          opt(cad, "quotidien", "chaque jour");
          JOURS.forEach(function (j, i) { opt(cad, "hebdomadaire:" + (i + 1), "chaque " + j); });
          opt(cad, "mensuel:1", "chaque 1er du mois"); opt(cad, "mensuel:15", "chaque 15 du mois");
          opt(cad, "trimestriel", "chaque trimestre"); opt(cad, "annuel", "chaque année");
          cad.value = "hebdomadaire:1";
          var heure = document.createElement("select"); heure.setAttribute("aria-label", "Heure");
          for (var h = 6; h <= 20; h++) opt(heure, String(h), "à " + h + " h");
          heure.value = "8";
          var canal = document.createElement("select"); canal.setAttribute("aria-label", "Canal");
          opt(canal, "email", "par email"); opt(canal, "slack", "sur Slack");
          r1.appendChild(cad); r1.appendChild(heure); r1.appendChild(canal);
          f.appendChild(r1);
          var r2 = el("div", "rp-row");
          var dest = el("div"); r2.appendChild(dest);
          var slackIn = document.createElement("input"); slackIn.type = "text"; slackIn.placeholder = "#canal Slack (vide : le canal par défaut)"; slackIn.setAttribute("aria-label", "Canal Slack"); slackIn.style.display = "none"; r2.appendChild(slackIn);
          f.appendChild(r2);
          var rendreDest = function () {
            dest.innerHTML = "";
            if (canal.value === "slack") { dest.style.display = "none"; slackIn.style.display = ""; return; }
            dest.style.display = ""; slackIn.style.display = "none";
            var liste = [];
            if (contacts.moi) liste.push({ nom: "Moi (" + contacts.moi + ")", email: contacts.moi, coche: true });
            contacts.equipe.forEach(function (c) { liste.push({ nom: c.nom, email: c.email, coche: false }); });
            if (!liste.length) { dest.appendChild(el("span", "rp-muted", "Aucun destinataire connu : votre email n'est pas lisible et l'équipe n'a pas d'email (Communiquer → équipe).")); return; }
            liste.forEach(function (c) { var lab = el("label"); var cb = document.createElement("input"); cb.type = "checkbox"; cb.value = c.email; cb.checked = c.coche; lab.appendChild(cb); lab.appendChild(document.createTextNode(" " + c.nom)); dest.appendChild(lab); });
          };
          canal.addEventListener("change", rendreDest); rendreDest();
          var r3 = el("div", "rp-row"); var st = el("span", "rp-muted", "");
          var lire = function () {
            var parts = cad.value.split(":");
            var body = { location_id: loc, modele_id: modele_id, cadence: parts[0], heure: Number(heure.value), canal: canal.value };
            if (parts[1]) body.jour = Number(parts[1]);
            if (canal.value === "slack") body.destinataires = slackIn.value.trim() ? [slackIn.value.trim()] : [];
            else body.destinataires = Array.prototype.map.call(dest.querySelectorAll("input:checked"), function (cb) { return cb.value; });
            return body;
          };
          var mk = function (label, cls, fn) { var b = el("button", cls, label); b.type = "button"; b.addEventListener("click", async function () { b.disabled = true; st.textContent = "…"; try { await fn(); } catch (e) { st.textContent = String(e.message || e); } b.disabled = false; }); return b; };
          r3.appendChild(mk("Enregistrer", "rp-btn rp-btn-primary", async function () {
            var j = await postJson("/api/explorer/envois", lire());
            st.textContent = "Envoi programmé : " + j.cadence_fr + (j.destinataires.length ? " à " + j.destinataires.join(", ") : "");
            loadEnvois();
          }));
          r3.appendChild(mk("Envoyer maintenant", "rp-btn", async function () {
            var body = lire(); body.maintenant = true;
            var j = await postJson("/api/explorer/envois", body);
            st.textContent = (j.ok ? "Envoyé " + j.periode_fr + " à " + j.envoyes.join(", ") : j.raison) + (j.echecs && j.echecs.length ? " — échecs : " + j.echecs.join(" ; ") : "");
            loadEnvois(); loadRapports();
          }));
          r3.appendChild(st);
          f.appendChild(r3);
          return f;
        }
        async function loadEnvois() {
          var box = $("rp-envois");
          try {
            var j = await getJson("/api/explorer/envois" + q());
            contacts = j.contacts || contacts;
            box.innerHTML = "";
            var actifs = j.envois.filter(function (s) { return s.actif; });
            if (!actifs.length) { box.textContent = "Aucun envoi programmé — « Envoyer chaque… » sous un Modèle."; return; }
            actifs.forEach(function (s) {
              var row = el("div", "rp-item");
              var left = el("div");
              left.appendChild(el("div", null, s.modele_nom + " · " + s.cadence_fr + " · " + (s.canal === "slack" ? "sur Slack " + (s.destinataires.join(", ") || "(canal par défaut)") : "par email à " + s.destinataires.join(", "))));
              var d = s.derniers && s.derniers[0];
              left.appendChild(el("div", "rp-muted", d ? ("Dernier envoi : " + frD(d.sent_at) + (d.document_id ? " · " + d.n_recipients + " destinataire" + (d.n_recipients > 1 ? "s" : "") : " · retenu, sans matière du " + frD(d.periode_du) + " au " + frD(d.periode_au))) : "Aucun envoi encore"));
              row.appendChild(left);
              var b = el("button", "rp-btn", "Arrêter"); b.type = "button";
              b.addEventListener("click", async function () { b.disabled = true; try { await postJson("/api/explorer/envois", { location_id: loc, schedule_id: s.schedule_id, actif: false }); loadEnvois(); } catch (e) { showErr(box, String(e.message || e)); b.disabled = false; } });
              row.appendChild(b);
              box.appendChild(row);
            });
          } catch (e) { box.textContent = "Envois indisponibles : " + String(e.message || e); }
        }

        // ── Nouveau rapport : la demande passe par la boucle ; le Rapport composé se rend, puis s'enregistre ──
        // 14/09 (owner : « trimestre, 12 mois ou une date précise »). UN seul menu, pas deux contrôles côte à
        // côte : neuf demandes sur dix sont une période NOMMÉE, et une période nommée porte son libellé
        // français jusque dans le Rapport imprimé. Les deux champs de date n'apparaissent que si on les demande.
        var PERIODE_FR = {
          "30_derniers_jours": "sur vos 30 derniers jours", "semaine_derniere": "sur la semaine dernière",
          "mois_dernier": "sur le mois dernier", "trimestre_dernier": "sur le trimestre dernier",
          "douze_derniers_mois": "sur vos 12 derniers mois",
        };
        (function () {
          var sel = $("rp-periode"), du = $("rp-du"), au = $("rp-au");
          var bascule = function () { var on = sel.value === "dates_precises"; du.style.display = on ? "" : "none"; au.style.display = on ? "" : "none"; };
          sel.addEventListener("change", bascule); bascule();
        })();
        // La période en MOTS. Des dates précises se disent en français (JJ/MM/AAAA) : la forme que
        // l'exploitant lit, et celle que le Rapport imprimera.
        function periodeEnMots(v) {
          if (v !== "dates_precises") return PERIODE_FR[v] || "";
          var d = $("rp-du").value, a = $("rp-au").value || d;
          return d ? ("du " + frD(d) + " au " + frD(a)) : "";
        }
        async function lancerComposition(opts) {
          var btn = $("rp-compose"), status = $("rp-compose-status"), tools = $("rp-tools");
          var periode = opts.periode || $("rp-periode").value;
          var sections = opts.modele ? "" : $("rp-q").value.trim();
          if (!opts.modele && !sections) { status.textContent = "Dites ce que le rapport doit montrer."; return; }
          var perMots = opts.periode ? (PERIODE_FR[opts.periode] || "") : periodeEnMots(periode);
          if (periode === "dates_precises" && !perMots) { status.textContent = "Donnez le premier jour de la période."; return; }
          var question = opts.modele
            ? ("Compose mon rapport « " + opts.modele + " » " + perMots + ".")
            : ("Compose un rapport " + perMots + " avec : " + sections + ".");
          btn.disabled = true; status.textContent = "Composition…"; tools.innerHTML = ""; docEl.innerHTML = "";
          var streamed = el("div", "rp-zone"); docEl.appendChild(streamed);
          try {
            var body = await composer({ messages: [{ role: "user", content: question }] }, tools, function (data) {
              var bl = el("div"); bl.innerHTML = kit.renderAnswerBlocks([{ type: "register", register: "vetted" }].concat(data.blocks)); streamed.appendChild(bl);
            });
            var rapport = (body.blocks || []).filter(function (b) { return b && b.type === "rapport"; })[0];
            if (!rapport) { streamed.innerHTML = kit.renderAnswerBlocks(body.blocks || []); status.textContent = "La réponse ne contient pas de Rapport."; btn.disabled = false; return; }
            // Le Rapport composé s'enregistre (version 1) : le document ouvert porte alors ses actions.
            var saved = await postJson("/api/explorer/rapports", { location_id: loc, rapport: rapport });
            status.textContent = "Rapport enregistré";
            await loadRapports(); await openDocument(saved.document_id);
          } catch (e) { showErr(docEl, String(e.message || e)); status.textContent = ""; }
          btn.disabled = false;
        }
        $("rp-compose").addEventListener("click", function () { lancerComposition({}); });
        $("rp-q").addEventListener("keydown", function (e) { if (e.key === "Enter" && (e.metaKey || e.ctrlKey)) lancerComposition({}); });

        if (!kit || typeof kit.renderAnswerBlocks !== "function") { docEl.textContent = "Rendu indisponible."; return; }
        // 14/09 (owner : la page ouverte sans ?location_id rendait TROIS panneaux « location_id requis »,
        // aucun Modèle, donc aucun « Envoyer chaque… », et « Composer ne fait rien » — il postait avec un
        // site vide). Le commentaire d'en-tête prétendait que les routes résolvaient le site actif : c'est
        // faux, les deux replis plus bas le récupèrent d'une réponse qui l'exigeait déjà — circulaire.
        // LE FOYER est `/api/profile/locations`, celui de Pulse, du mois et de l'événement ; le site
        // principal d'abord (is_primary), sinon le premier. Sans site, on le DIT au lieu de laisser trois
        // panneaux répéter une erreur technique que l'exploitant ne peut pas corriger.
        async function resoudreSite() {
          if (loc) return true;
          try {
            var j = await getJson("/api/profile/locations");
            var l = Array.isArray(j.locations) ? j.locations : [];
            var choisi = l.find(function (x) { return x && x.is_primary; }) || l[0] || null;
            if (choisi && choisi.location_id) { loc = String(choisi.location_id); return true; }
          } catch (e) { /* le message ci-dessous dit la même chose, en français */ }
          return false;
        }
        resoudreSite().then(function (ok) {
          if (!ok) {
            ["rp-modeles", "rp-envois", "rp-list"].forEach(function (id) {
              var b = $(id); if (b) b.textContent = "Aucun site sur ce compte pour l'instant.";
            });
            var c = $("rp-compose"); if (c) c.disabled = true;
            return;
          }
          loadRapports().then(function () { loadModeles(); loadEnvois(); if (openId) openDocument(openId); });
        });
      })();
    </script>
  </BaseLayout>
</Show>
