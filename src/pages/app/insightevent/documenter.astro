---
export const prerender = false;
// « /documenter » — L'APP DE CAPTURE DE L'ESPACE (owner 14/09).
//
// LE PRINCIPE, qui renverse celui de la page d'un pôle : on PHOTOGRAPHIE ce qu'on a sous les yeux, puis
// on dit ce que c'est. Exiger le choix avant l'appareil photo imposait à l'exploitant l'ordre de la base
// de données ; devant une étagère, c'est l'inverse qui est naturel.
//
// DEUX QUESTIONS, ET RIEN D'AUTRE (arbitrage owner) : à quel PÔLE, puis à quel COMPOSANT. Le pôle
// d'abord parce qu'il réduit la seconde liste à trois ou quatre choix au lieu de cinquante. Le composant
// se choisit par son N° SUR LE PLAN quand il en a un — c'est ce qui est écrit sur le meuble, donc ce que
// l'exploitant lit les yeux dessus. Les familles, l'exposition et le nombre d'étagères ne se demandent
// JAMAIS : ils se lisent sur la photo (lib/ai/photoExtraction).
//
// L'IMAGE RESTE DANS LE NAVIGATEUR jusqu'au rattachement, puis part écrite d'un coup. C'est une
// contrainte de la base, pas un choix : `dispositif_photos.component_key` est obligatoire — une photo ne
// peut pas exister détachée, et inventer un état « photo orpheline » créerait des images qui ne veulent
// rien dire. Le rattachement se fait donc APRÈS la prise et AVANT l'écriture.
//
// Une photo, deux touchers. La rafale (plusieurs photos en une marche) est un autre chantier :
// docs/marche-guidee-spec.md.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { Show } from "@clerk/astro/components";
import { EVOL_COPY } from "../../../lib/commitments/commitmentCopy";

const locParam = Astro.url.searchParams.get("location_id") || "";
---

<Show when="signed-out" client:load>
  <meta http-equiv="refresh" content="0; url=/sign-in" />
</Show>

<Show when="signed-in" client:load>
  <BaseLayout title="Documenter — Muse Square" hideSurveyCta={true} hideFooter={true}>
    <div id="cap-root" data-loc={locParam}>
      <div id="cap-head">
        <a href="/app/insightevent/tableau" id="cap-back">← {EVOL_COPY.back_pole}</a>
      </div>
      <h1 id="cap-titre">{EVOL_COPY.capture_titre}</h1>
      <div id="cap-body">Chargement…</div>
    </div>

    <style is:global>
      #cap-root { max-width: 560px; margin: 0 auto; padding: 16px; font-family: system-ui, -apple-system, sans-serif; color: #111827; }
      #cap-head { margin-bottom: 10px; }
      #cap-back { font-size: 14px; color: #6b7280; text-decoration: none; }
      #cap-titre { font-size: 20px; font-weight: 600; margin: 0 0 14px; }
      #cap-body { font-size: 13px; color: #6b7280; }
      .cap-shot { display: block; width: 100%; box-sizing: border-box; padding: 18px 16px; border: 1px solid #1D3BB3; border-radius: 12px; background: #1D3BB3; color: #fff; font-size: 16px; font-weight: 600; font-family: inherit; cursor: pointer; }
      .cap-q { font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: #6b7280; margin: 18px 0 8px; }
      .cap-choix { display: block; width: 100%; box-sizing: border-box; text-align: left; padding: 14px; margin-bottom: 8px; border: 1px solid #e5e7eb; border-radius: 10px; background: #fff; font-size: 15px; font-family: inherit; color: #111827; cursor: pointer; min-height: 48px; }
      .cap-choix b { font-weight: 600; }
      .cap-choix span { color: #6b7280; font-size: 13px; }
      #cap-apercu { width: 100%; border-radius: 10px; border: 1px solid #e5e7eb; display: block; margin-bottom: 4px; }
      .cap-lien { background: none; border: none; padding: 6px 0; font-size: 13px; color: #1D3BB3; font-family: inherit; cursor: pointer; }
      .cap-err { color: #b91c1c; font-size: 13px; }
    </style>

    <!-- card-kit pour `msPoleUrl` : l'adresse d'un pôle a UN foyer, jamais une chaîne recopiée. -->
    <script is:inline src="/js/card-kit.js?v=96"></script>
    <script is:inline src="/js/photo-capture.js?v=1"></script>
    <script is:inline define:vars={{ COPY: EVOL_COPY }}>
      (function () {
        var root = document.getElementById("cap-root");
        var body = document.getElementById("cap-body");
        function esc(s) { return String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;"); }
        function t(k) { return COPY[k] || ""; }

        // L'état du tour : l'image tenue en mémoire, puis le pôle, puis le composant.
        var etat = { image: null, poles: [], pole: null, multi: false };

        // 14/09 (owner : « les pôles et photos sont rattachés à une location ») — TOUS LES SITES, pas le
        // premier. Prendre le lieu principal ferait documenter un pôle du site A pendant qu'on est dans
        // le site B, et la photo partirait au mauvais magasin sans que rien ne le dise. Les pôles de tous
        // les sites sont chargés EN PARALLÈLE et la liste les groupe par site : le choix du pôle répond
        // donc aussi au site, sans ajouter la troisième question que l'owner a exclue.
        function sites() {
          return fetch("/api/profile/locations", { cache: "no-store" }).then(function (r) { return r.json(); })
            .then(function (p) { return (p && p.ok && Array.isArray(p.locations) ? p.locations : []).filter(function (l) { return l && l.location_id; }); })
            .catch(function () { return []; });
        }

        function chargerPoles(loc) {
          return fetch("/api/insight/evenement?location_id=" + encodeURIComponent(loc) + "&create_context=1")
            .then(function (r) { return r.json(); })
            .then(function (j) { return (j && j.ok && Array.isArray(j.poles)) ? j.poles : []; })
            .catch(function () { return []; });
        }

        function vuePrise() {
          body.innerHTML = '<button type="button" class="cap-shot" data-cap-shot>' + esc(t("capture_prendre")) + "</button>";
          body.querySelector("[data-cap-shot]").addEventListener("click", function () {
            var input = document.createElement("input");
            input.type = "file"; input.accept = "image/*"; input.setAttribute("capture", "environment");
            input.style.display = "none"; document.body.appendChild(input);
            input.addEventListener("change", function () {
              var file = input.files && input.files[0]; input.remove();
              if (!file) return;
              body.innerHTML = '<div>' + esc(t("pole_photo_reading")) + "</div>";
              MSPhotoCapture.shrink(file).then(function (dataUrl) {
                etat.image = dataUrl; vueQuestions();
              }).catch(function () { body.innerHTML = '<div class="cap-err">' + esc(t("pole_photo_failed")) + "</div>"; vuePrise(); });
            });
            input.click();
          });
        }

        function apercu() {
          return '<img id="cap-apercu" src="' + esc(etat.image) + '" alt="" />'
            + '<button type="button" class="cap-lien" data-cap-reprendre>' + esc(t("capture_reprendre")) + "</button>";
        }

        // QUESTION 1 — le pôle. QUESTION 2 — le composant, par son N° sur le plan quand il en a un.
        function vueQuestions() {
          if (!etat.poles.length) {
            body.innerHTML = apercu() + '<div class="cap-q">' + esc(t("capture_q_pole")) + "</div><div>" + esc(t("capture_aucun_pole")) + "</div>";
            cablerReprendre(); return;
          }
          var h = apercu() + '<div class="cap-q">' + esc(t("capture_q_pole")) + "</div>";
          // Plusieurs sites : le nom du site suit celui du pôle (même règle que les chips de Piloter,
          // qui ne montrent le site que sur un compte multi-site).
          var multi = etat.multi;
          etat.poles.forEach(function (p, i) {
            h += '<button type="button" class="cap-choix" data-cap-pole="' + i + '"><b>' + esc(p.name) + "</b>"
              + (multi && p.site_label ? ' <span>' + esc(p.site_label) + "</span>" : "") + "</button>";
          });
          body.innerHTML = h;
          cablerReprendre();
          body.querySelectorAll("[data-cap-pole]").forEach(function (b) {
            b.addEventListener("click", function () { etat.pole = etat.poles[Number(b.getAttribute("data-cap-pole"))]; vueComposants(); });
          });
        }

        function vueComposants() {
          var comps = (etat.pole && Array.isArray(etat.pole.components)) ? etat.pole.components : [];
          var h = apercu() + '<div class="cap-q">' + esc(etat.pole.name) + " · " + esc(t("capture_q_composant")) + "</div>";
          if (!comps.length) { body.innerHTML = h + "<div>" + esc(t("capture_aucun_composant")) + "</div>"; cablerReprendre(); return; }
          comps.forEach(function (c, i) {
            // Le composant se nomme comme le bloc Composants de sa page : le libellé libre, sinon le type.
            // Le N° SUR LE PLAN n'est pas ici : `listPoleComponents` ne le porte pas (il vit dans les
            // mesures d'espace et sur les photos). Le proposer demanderait une lecture de plus — à faire
            // quand l'owner aura confirmé que le numéro est ce qu'il cherche des yeux.
            var nom = c.label || c.type_label_fr || "";
            var meta = [c.type_label_fr, c.role_label_fr].filter(function (x) { return x && x !== nom; }).join(" · ");
            h += '<button type="button" class="cap-choix" data-cap-comp="' + i + '"><b>' + esc(nom) + "</b>"
              + (meta ? ' <span>' + esc(meta) + "</span>" : "") + "</button>";
          });
          body.innerHTML = h;
          cablerReprendre();
          body.querySelectorAll("[data-cap-comp]").forEach(function (b) {
            b.addEventListener("click", function () { envoyer(comps[Number(b.getAttribute("data-cap-comp"))]); });
          });
        }

        function cablerReprendre() {
          var r = body.querySelector("[data-cap-reprendre]");
          if (r) r.addEventListener("click", function () { etat.image = null; etat.pole = null; vuePrise(); });
        }

        function envoyer(comp) {
          body.innerHTML = apercu() + "<div>" + esc(t("capture_envoi")) + "</div>";
          MSPhotoCapture.envoyer({
            dispositif_id: etat.pole.dispositif_id,
            component_key: comp.component_key || comp.key,
            image_base64: etat.image,
            fixture_no: null,
          }).then(function (j) {
            if (j && j.ok) {
              // La preuve est sur la page du pôle : la photo, sa légende, et la version suivante si la
              // photo en a fait naître une (13/09). On y va — jamais un message qui dit « c'est écrit ».
              var id = (j.version && j.version.commitment_id) || etat.pole.commitment_id;
              window.location.href = id ? MSCardKit.msPoleUrl(id) : "/app/insightevent/tableau";
              return;
            }
            var msg = j && j.rejected === "person" ? t("pole_photo_person") : t("pole_photo_failed");
            body.innerHTML = apercu() + '<div class="cap-err">' + esc(msg) + "</div>";
            cablerReprendre();
          }).catch(function () {
            body.innerHTML = apercu() + '<div class="cap-err">' + esc(t("pole_photo_failed")) + "</div>";
            cablerReprendre();
          });
        }

        (function demarrer() {
          // `?location_id=` restreint à un site (le lien d'une page qui en porte un) ; sans lui, TOUS les
          // sites du compte. Les lectures partent ensemble — jamais une par une.
          var loc = root.dataset.loc;
          var lieux = loc ? Promise.resolve([{ location_id: loc, company_name: null }]) : sites();
          lieux.then(function (ls) {
            if (!ls.length) { body.innerHTML = '<div class="cap-err">' + esc(t("capture_aucun_pole")) + "</div>"; return; }
            etat.multi = ls.length > 1;
            return Promise.all(ls.map(function (l) {
              return chargerPoles(l.location_id).then(function (poles) {
                return poles.map(function (p) { return Object.assign({}, p, { location_id: l.location_id, site_label: l.company_name || null }); });
              });
            })).then(function (parSite) {
              etat.poles = [].concat.apply([], parSite);
              vuePrise();
            });
          });
        })();
      })();
    </script>
  </BaseLayout>
</Show>
