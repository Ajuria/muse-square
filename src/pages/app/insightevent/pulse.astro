          } else { msg.textContent = 'Erreur : ' + ((j && j.error) || 'réessayez'); msg.style.color = '#b91c1c'; }
        }).catch(function(){ msg.textContent = 'Erreur réseau.'; msg.style.color = '#b91c1c'; });
