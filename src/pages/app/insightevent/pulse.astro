  // ══ TRIAGE PAR SITE (validé 26/07 — proto public/actions-triage-proto.html) ══════════════════
  // Doctrine (docs/pulse-actions-triage.md) : UNE page qui centralise l'action.
  //  - Blocs PAR SITE (un P&L, une équipe) : contextuel d'abord, chantiers structurels compacts après.
  //  - Tri défaut = HORIZON (aujourd'hui → semaine → structurel) puis |ENJEU| décroissant.
  //    L'enjeu est une MAGNITUDE, l'urgence une FENÊTRE — deux axes, jamais confondus.
  //  - PLI : 3 cartes contextuelles + 2 chantiers visibles par site, le reste sous « Voir N autres ».
  //    L'Enjeu est un critère de RANG, jamais d'existence (compte jeune = cartes sans pill, sous le pli).
  //  - FILTRES (3 max) : horizon / nature (défendre-capter) / tri par enjeu. Filtrer déplie tout.
  //  - « Motif de fond » : pill héritée de la classe du jour (serveur, dayClassRegistry) — une pill
  //    ambre peut coexister avec une carte opportunité : le bon jour est l'exception du motif.
  // buildTriageLayout() re-construit tout à chaque rendu du brief (wireBriefHandlers) ;
  // renderStructuralSection() (nom historique) ne fait plus que rafraîchir les chantiers/états.
  var STRUCT_FAM_FR = { weather: 'Météo', competition: 'Concurrence', tourism: 'Tourisme', events: 'Événements', mobility: 'Mobilité', suivis: 'Concurrents suivis', calendar: 'Calendrier', traffic: 'Affluence', sales: 'Remises' };
  var _triageState = { fh: 'tous', fn: 'tous', sortEnjeu: false };

  function _structActiveCommit(imp) {
    var commits = Array.isArray(window._plsCommitments) ? window._plsCommitments : [];
    for (var i = 0; i < commits.length; i++) {
      var c = commits[i];
      if (String(c.origin_action_type || '') === 'structural_' + imp.class_key
        && String(c.location_id || '') === String(imp.location_id || '')
        && (c.status === 'open' || c.status === 'pending')) return c;
    }
    return null;
  }

  function _structRowHtml(imp, key, coinPorte) {
