    // Consulter — shared navigation, fully sourced from the tapped card object
    // (__msCardByIdx) so it works from the menu button OR a title/text click, and
    // always carries the card's own venue (multi-venue safe — the empty-dossier fix).
    function openConsultForCard(cardIdx) {
      var _ac = null;
      try { _ac = (window.__msCardByIdx && window.__msCardByIdx[cardIdx]) || null; } catch(ex) {}
      if (!_ac) return;
      // Cartes de cycle de vie d'\u00e9v\u00e9nement (03/08) : la \u00ab source \u00bb est le DOSSIER, pas la page insight.
      if (_ac.saved_item_id && String(_ac.change_subtype || "").indexOf("event_") === 0) {
        window.location.href = "/app/insightevent/evenement?location_id=" + encodeURIComponent(String(_ac.location_id || "") || locationId) + "&saved_item_id=" + encodeURIComponent(String(_ac.saved_item_id));
        return;
      }
      var actionType = String(_ac.change_subtype || "");
      var affected = _ac.affected_date ? (normalizeYmd(_ac.affected_date) || "") : "";
      var cardLocId = String(_ac.location_id || "") || locationId;
      var _instId = _ac.card_instance_id ? String(_ac.card_instance_id) : "";
      try {
        var key = "ms_signal_data_" + cardLocId + "_" + affected;
        sessionStorage.setItem(key, JSON.stringify({ day: currentDay || {}, prof: data.profile || {}, actionCandidate: _ac }));
      } catch(ex) {}
      window.location.href = "/app/insightevent/insight?type=" + encodeURIComponent(actionType) + "&date=" + encodeURIComponent(affected) + "&location_id=" + encodeURIComponent(cardLocId) + (_instId ? "&card_instance_id=" + encodeURIComponent(_instId) : "");
    }

