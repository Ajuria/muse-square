    // (_engLocLabels désormais remplie en tête de rendu — voir isMultisite plus haut.)
    _engagementLocs = isMultisite
      ? (data._locations || []).map(function(l){ return l && l.location_id; }).filter(Boolean)
      : [currentLocationId];
    renderEngagements(_engagementLocs);

    // ---- Wire event handlers ----

    // Pills
    root.querySelectorAll("[data-pill-date]").forEach(btn => {
      btn.addEventListener("click", async () => {
        const d = btn.getAttribute("data-pill-date");
        if (!d) return;
        // Per-day (18/07) : render IMMÉDIAT à la nouvelle date (le hero/score n'attend pas le réseau),
        // puis refetch des signaux Concurrence POUR CE JOUR sur le bon périmètre — par site fusionné
        // en vue agrégée, le site AFFICHÉ sinon (l'ancien handler fetchait toujours le site de
        // session, et bloquait le render). Guard anti-course : seule la dernière date cliquée écrit.
        renderPulse(data, d, "radar");
        const _token = (window.__plsCsToken = (window.__plsCsToken || 0) + 1);
        try {
          const _isAgg = Array.isArray(data._locations) && data._locations.length > 1;
          const csResult = _isAgg
            ? fuseCompetitorSignals(await Promise.all(data._locations.map(l =>
                fetchCompetitorSignals(d, l.location_id).catch(() => ({ signals: [], followed_count: 0, top_threats: [], followed_competitors: [] })))))
            : await fetchCompetitorSignals(d, currentLocationId);
          if (window.__plsCsToken !== _token) return;
          data._competitor_signals = csResult.signals;
          data._competitor_followed_count = csResult.followed_count;
          if (Array.isArray(csResult.followed_competitors) && csResult.followed_competitors.length) data._followed_competitors = csResult.followed_competitors;
          renderPulse(data, d, "radar");
        } catch (e) {}
      });
    });

    // Weekly goal chip — relocate into the site-context row (.pls-loc-row)
    var _goalNode = root.querySelector("[data-goal-selector]");
    var _locRow = document.querySelector(".pls-loc-row");
    if (_goalNode && _locRow) {
      var _oldGoal = _locRow.querySelector("[data-goal-selector]");
      if (_oldGoal) _oldGoal.remove();
      _locRow.appendChild(_goalNode);
    }
    document.querySelectorAll("[data-goal-chip-toggle]").forEach(function(chip) {
      var pop = chip.parentElement ? chip.parentElement.querySelector("[data-goal-popover]") : null;
      chip.addEventListener("click", function(e) {
        e.stopPropagation();
        if (!pop) return;
        if (pop.hasAttribute("hidden")) { pop.removeAttribute("hidden"); chip.setAttribute("aria-expanded", "true"); }
        else { pop.setAttribute("hidden", ""); chip.setAttribute("aria-expanded", "false"); }
      });
    });
    if (!window.__plsGoalDocClick) {
      window.__plsGoalDocClick = true;
      document.addEventListener("click", function(e) {
        document.querySelectorAll("[data-goal-popover]").forEach(function(pop) {
          var wrap = pop.closest("[data-goal-selector]");
          if (wrap && !wrap.contains(e.target)) {
            pop.setAttribute("hidden", "");
            var c = wrap.querySelector("[data-goal-chip-toggle]");
            if (c) c.setAttribute("aria-expanded", "false");
          }
        });
      });
    }

    // Weekly goal selector
    document.querySelectorAll("[data-goal-selector] [data-goal-key]").forEach(function(btn) {
      btn.addEventListener("click", function() {
        var key = btn.getAttribute("data-goal-key");
        var clear = btn.getAttribute("aria-pressed") === "true"; // re-tapping the active goal deselects
        _activeGoalKey = clear ? "" : key;
        // Sticky across reloads for every view (aggregate + single-site).
        try { if (clear) localStorage.removeItem(_goalStoreKey()); else localStorage.setItem(_goalStoreKey(), key); } catch (e) {}
        // Also persist server-side for genuine single-site accounts (per-location goal store).
        if (Array.isArray(allLocations) && allLocations.length <= 1 && currentLocationId) {
          data.active_goal = clear ? null : { goal: key };
          fetch("/api/insight/set-goal", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify(clear
              ? { location_id: currentLocationId, scope: "weekly", clear: true }
              : { location_id: currentLocationId, scope: "weekly", goal: key }),
          }).catch(function(){});
        }
        // Re-render so the Goal pass reorders the cards and the chip reflects the choice.
        renderPulse(data, selectedDate, "radar");
      });
    });

    // Radar strip toggles — v5: accordéon (un volet ouvert à la fois), état mémorisé par site,
    // carte Concurrence initialisée au premier dépliage (Leaflet lazy).
    const _radarOpenKey = "ms_radar_open_" + currentLocationId;
    const _setVoletOpen = (id, open) => {
      const body = root.querySelector(`[data-radar-body="${id}"]`);
      const chevron = root.querySelector(`[data-radar-chevron="${id}"]`);
