    // legacy residual_z : traduction indicative (constante globale) comme avant.
    var _ypct = (r.threshold_basis === 'pct' && r.threshold_value != null)
      ? Math.round(Number(_cgFv(r.threshold_value)))
      : _cgTargetPct(r.threshold_value, _days); // % vs CA habituel to validate
    var _uplift = _base != null ? Math.round((_base / _days) * _ypct / 100 / 10) * 10 : null; // €/day, rounded to 10
    // R1 (proto engagement-cards-restyle-proto.html (supprime le 05/09/2026 - surface livree, historique git), validé 27/07) : le titre est l'ACTION
    // elle-même ; le chiffre (objectif ou résultat) vit en zone titre (bloc .amt, cf. _amt).
    // TITRE COURT, OBJECTIF EN DESSOUS (owner 25/08). `committed_action_text` est la saisie
    // BRUTE de l'exploitant : sur le compte owner, quarante mots avec leurs coquilles servaient
    // de titre de carte, sur deux lignes tronquées. La carte garde la phrase ENTIÈRE — c'est sa
    // parole, on n'y touche pas — mais le titre s'arrête au premier séparateur fort (tiret
    // cadratin, deux-points, point, retour à la ligne) et le reste descend dans le corps.
