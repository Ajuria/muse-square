---
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { Show } from "@clerk/astro/components";

const location_id =
  Astro.locals && typeof (Astro.locals as any).location_id === "string" && (Astro.locals as any).location_id.trim()
    ? (Astro.locals as any).location_id.trim()
    : null;

if (!location_id) {
  return Astro.redirect("/profile");
}

---

<BaseLayout title="Pulse — Insight Event" hideSurveyCta={true} hideFooter={true}>

    <style is:inline>
      .mon-wrap {
        width: 100%;
        max-width: 720px;
        margin: 0 auto;
        padding: 20px 20px 160px 20px;
        box-sizing: border-box;
        overflow: visible;
      }

      .mon-card {
        background: #FFFFFF;
        border: 1px solid #E8EDF5;
        border-radius: 14px;
        padding: 24px;
        box-shadow: 0 2px 12px rgba(17,24,39,0.06);
      }

      .mon-card-decision {
        background: rgba(29,59,179,0.04);
        border-left: 6px solid #0b37e5;
        padding: 24px;
        border-radius: 10px;
      }

      .mon-panels {
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding-top: 16px;
      }

      .mon-kicker {
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.10em;
        text-transform: uppercase;
        color: #1D3BB3;
        line-height: 1.1;
        margin: 0 0 6px 0;
      }

      .mon-head {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
      }

      .mon-ico { width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
      .mon-ico svg { display: block; }

      .mon-tabs-bar {
        display: flex;
        justify-content: flex-start;
        align-items: flex-end;
        gap: 22px;
        padding: 0 24px;
        border-bottom: none;
        margin: 16px -24px -24px -24px;
      }

      .mon-tab {
        appearance: none;
        border: none;
        background: transparent;
        font-size: 14px;
        font-weight: 500;
        color: #94A3B8;
        padding: 0 0 16px 0;
        position: relative;
        cursor: pointer;
      }

      .mon-tab.is-active { color: #1D3BB3; }
      .mon-tab.is-active::after {
        content: "";
        position: absolute;
        left: 0; bottom: 0;
        height: 3px; width: 100%;
        background: #1D3BB3;
        border-radius: 3px;
      }

      .mon-feed-item {
        display: flex; align-items: flex-start; gap: 12px;
        padding: 14px 0; border-bottom: 1px solid #F3F4F6;
      }
      .mon-feed-item:last-child { border-bottom: none; }
      .mon-feed-line1 { font-size: 14px; font-weight: 700; color: #111827; line-height: 1.3; margin-bottom: 3px; }
      .mon-feed-line2 { font-size: 13px; color: #374151; line-height: 1.4; margin-bottom: 2px; }
      .mon-feed-line3 { font-size: 12px; color: #6B7280; }
      .mon-feed-line4 { font-size: 12px; color: #6B7280; }

      .mon-vigilance-item {
        display: flex; align-items: flex-start; gap: 10px;
        font-size: 14px; color: #374151; line-height: 1.45;
        padding: 8px 0; border-bottom: 1px solid #F3F4F6;
      }
      .mon-vigilance-item:last-child { border-bottom: none; }

      .mon-status-ok   { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; color: #059669; }
      .mon-loading { padding: 40px 0; text-align: center; color: #9CA3AF; font-size: 14px; }
      .mon-error { padding: 20px; background: rgba(220,38,38,0.06); border-radius: 10px; color: #B91C1C; font-size: 13px; margin-top: 16px; }

      .mon-statut-safe { background: var(--color-pill-safe-bg); color: var(--color-pill-safe-text); padding: 6px 14px; border-radius: 999px; font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
      .mon-statut-warn { background: var(--color-pill-warn-bg); color: var(--color-pill-warn-text); border: 1px solid var(--color-pill-warn-border); padding: 6px 14px; border-radius: 999px; font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
      .mon-statut-risk { background: var(--color-pill-risk-bg); color: var(--color-pill-risk-text); border: 1px solid var(--color-pill-risk-border); padding: 6px 14px; border-radius: 999px; font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }

      /* ---- Date pills ---- */
      /* Bandeau de FAITS (build v3.2, 25/08) : colonnes-jours à faits — le score est mort. */
      .pls-col { flex:1; display:flex; flex-direction:column; align-items:center; gap:4px; padding:8px 4px 9px; border-radius:10px; background:transparent; border:1px solid transparent; font-family:inherit; cursor:pointer; min-height:88px; }
      .pls-col:hover { background:#FAFBFC; }
      .pls-col.is-sel { background:rgba(29,59,179,0.06); border-color:rgba(29,59,179,0.35); }
      .n7day { font-size:11.5px; font-weight:650; color:#374151; }
      .n7day.is-now { color:#1D3BB3; }
      .n7wx { font-size:11.5px; color:#374151; }
      .n7wx.warn { color:#B45309; font-weight:650; }
      .n7t { font-size:10.5px; color:#9CA3AF; }
      .n7ico { width:22px; height:22px; flex:none; }
      .n7ico.sm { width:13px; height:13px; }
      .n7temp { font-size:13px; font-weight:700; color:#111827; line-height:1; }
      .n7mini { display:inline-flex; align-items:center; gap:4px; font-size:10px; color:#6B7280; max-width:100%; }
      .n7mini.warn { color:#B45309; font-weight:650; }
      .n7chip { font-size:9.5px; padding:1px 7px; border-radius:12px; white-space:nowrap; max-width:100%; overflow:hidden; text-overflow:ellipsis; }
      .n7calm { color:#D1D5DB; font-size:11px; margin-top:auto; }
      .n7period { display:flex; gap:14px; flex-wrap:wrap; align-items:center; margin:8px 4px 0; font-size:11.5px; color:#374151; }
      .n7aff { display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin:8px 4px 0; font-size:11.5px; color:#374151; }

      /* ---- Location switcher ---- */
      .pls-loc-row {
        display: flex; align-items: center; justify-content: space-between;
        margin-bottom: 4px;
      }
      .pls-loc-name { font-size: 13px; font-weight: 600; color: #111827; }
      .pls-loc-addr { font-size: 12px; color: #9ca3af; }
      .pls-loc-btn {
        font-size: 12px; font-weight: 600; color: #1D3BB3;
        background: none; border: none; cursor: pointer; padding: 0;
      }
      /* Inc C (owner 25/08, point 6) : le menu déroulant de site meurt — segments du proto
         (agir-proto-v3, segBtn) : groupe gris, segment actif blanc ombré. */
      .pls-seg-wrap { display:inline-flex; background:#F3F4F6; border-radius:9px; padding:3px; margin-bottom:4px; max-width:100%; overflow-x:auto; }
      .pls-seg { font-family:inherit; border:none; cursor:pointer; font-size:12px; border-radius:7px; padding:5px 12px; color:#6b7280; background:none; white-space:nowrap; }
      .pls-seg.is-on { font-weight:600; color:#111827; background:#fff; box-shadow:0 1px 2px rgba(16,24,40,0.08); }




      /* ---- Action-card chips / action line / Agir / disposition ---- */
      .chip-n { display:inline-flex; align-items:center; gap:5px; font-size:12px; padding:3px 9px; border-radius:20px; background:var(--color-pill-source-low-bg); color:var(--color-pill-source-low-text); white-space:nowrap; }
      .chip-good { display:inline-flex; align-items:center; gap:4px; font-size:12px; padding:3px 9px; border-radius:20px; background:var(--color-pill-green-bg); color:var(--color-pill-green-text); white-space:nowrap; }
      /* Restyle R4 (validé 26/07, proto cards-restyle-proto.html (supprime le 05/09/2026 - surface livree, historique git)) : la ligne d'action est
         l'instruction de la carte — en gras pour porter la hiérarchie chiffre → action. */
      .aline { color:#1D3BB3; font-size:13px; font-weight:600; line-height:1.5; margin:8px 0 0; }
      /* Geste « Préciser ce compte » (carte client_dormant, spec client-patterns § R.3) —
         chips = forme .chip-n existante rendue cliquable ; survol = teinte de la tuile
         Intelligence ; confirmation = vert des pills (tokens). Proto validé owner 07/08. */
      .pr-strip { display:flex; align-items:center; gap:6px; flex-wrap:wrap; margin-top:8px; }
      .pr-q { font-size:12px; color:#6B7280; }
      .pr-chip { border:none; background:none; padding:0; cursor:pointer; font-family:inherit; }
      .pr-chip:hover .chip-n { background:#E6F1FB; color:#185FA5; }
      .pr-done { font-size:12px; color:var(--color-pill-green-text); margin-top:8px; }
      .pr-err { font-size:12px; color:#B45309; margin-top:8px; }
      .agir-btn { display:inline-flex; align-items:center; gap:5px; font-size:13px; font-weight:500; color:#1D3BB3; border:1px solid #1D3BB3; border-radius:10px; padding:6px 12px; background:transparent; cursor:pointer; font-family:inherit; }
      .disc { display:flex; align-items:center; justify-content:flex-end; gap:8px; padding:8px 16px 12px; border-top:1px solid var(--color-border); }
      .disc-btn { font-size:12px; color:var(--color-text-secondary); background:transparent; border:1px solid var(--color-border); border-radius:10px; padding:4px 10px; cursor:pointer; font-family:inherit; }

      /* ---- Eyebrow + Fil d'actualité timeline ---- */
      .eb { font-size:11px; letter-spacing:0.07em; text-transform:uppercase; color:var(--color-text-muted); font-weight:500; margin:0; }
      .tl { position:relative; padding-left:22px; margin-left:5px; border-left:1.5px solid var(--color-border); }
      .tlrow { position:relative; padding-bottom:18px; }
      .tldot { position:absolute; left:-28px; top:3px; width:9px; height:9px; border-radius:50%; background:#1D3BB3; border:2px solid var(--color-bg-card); }

      .ab-bar { display:none; }
      .ab-card { background:var(--color-bg-card); border:1px solid var(--color-border); border-radius:10px; overflow:visible; margin-bottom:12px; box-shadow:0 1px 3px rgba(16,24,40,0.06),0 1px 2px rgba(16,24,40,0.04); }
      /* ── FIL AGIR inc 2 (maquette agir-proto validée 14/08, spec docs/agir-fil-spec.md) :
         le conteneur-fil = les holders du triage ([data-t-cards]) et la section engagements ;
         dedans, les cartes deviennent des RANGÉES (filet 1 px, zéro boîte). ── */
      [data-t-cards]:not(:empty), #pls-engagement-cards:not(:empty) { background:var(--color-bg-card); border:1px solid rgba(0,0,0,0.08); border-radius:14px; overflow:hidden; }
      [data-t-cards] .ab-card, #pls-engagement-cards .ab-card { border:none; border-top:1px solid rgba(17,24,39,0.06); border-radius:0; margin-bottom:0; box-shadow:none; transition:background 0.12s; }
      [data-t-cards] .ab-card:first-child, #pls-engagement-cards .ab-card:first-child { border-top:none; }
      [data-t-cards] .ab-card:hover, #pls-engagement-cards .ab-card:hover { background:#FAFBFC; }
      /* Couleur de POSSESSION (Phase 2 cycle système/utilisateur) : les engagements sont À VOUS. */
      #pls-engagement-cards:not(:empty) { background:#F7F9FF; box-shadow:inset 2px 0 0 #1D3BB3; margin-bottom:14px; }
      #pls-engagement-cards .ab-card { background:transparent; }
      #pls-engagement-cards .ab-card:hover { background:#F2F5FF; }
      /* Médaillon-avatar : le disque devient un cercle 30 px ; anneau ambre = urgent. */
      .ab-disc { width:30px; height:30px; border-radius:50%; background:#F4F5F7; display:flex; align-items:center; justify-content:center; flex:none; }
      .pls-cta-sec { background:none; border:none; padding:0; font-family:inherit; font-size:12.5px; font-weight:500; color:#6B7280; cursor:pointer; }
      .pls-cta-sec:hover { color:#374151; }
      .pls-cta-pri { background:none; border:none; padding:0; font-family:inherit; font-size:12.5px; font-weight:650; color:#1D3BB3; cursor:pointer; }
      .pls-cta-pri:hover { text-decoration:underline; text-underline-offset:3px; }
      .ab-disc.urgent { box-shadow:0 0 0 2px #FDE68A; }
      .ab-card-row { display:flex; }
      .ab-bar { display:none; }
      .ab-bar.ab-threat { background:#e24b4a; }
      .ab-bar.ab-warning { background:#ef9f27; }
      .ab-bar.ab-opportunity { background:#059669; }
      .ab-inner { flex:1; min-width:0; }
      .ab-summary { padding:18px 20px 8px; cursor:pointer; }
      .ab-pills { display:flex; gap:5px; flex-wrap:wrap; margin-bottom:6px; }
      .ab-pill { font-size:9px; font-weight:700; padding:2px 7px; border-radius:20px; text-transform:uppercase; letter-spacing:0.03em; }
      .ab-what { font-size:15.5px; font-weight:650; color:#111827; line-height:1.35; margin-bottom:7px; letter-spacing:-0.01em; cursor:pointer; }
      .ab-what:hover { color:#1D3BB3; }
      .ab-what[data-consult-open]:hover { color:#1D3BB3; }
      .ab-sowhat { font-size:13px; color:#374151; line-height:1.65; max-width:58ch; }
      /* Restyle R1/R5/R6 : montant (Enjeu €/an) dans la zone titre — chiffre d'abord. Libellé
         invariant deux mots (« Enjeu · estimé/mesuré », « Motif de fond · estimé » si hérité) ;
         « facteurs mêlés » + sens de la couleur en infobulle (title), signalée par le
         pointillé. Couleur du montant = sens du flux (vert = à capter, ambre = à défendre). */
      .amt { text-align:right; flex:none; cursor:help; max-width:170px; }
      .amt-val { display:inline-block; font-size:19px; font-weight:700; line-height:1.1; white-space:nowrap; font-variant-numeric:tabular-nums; letter-spacing:-0.01em; padding:4px 10px; border-radius:10px; }
      .amt.gain .amt-val { color:#059669; background:#ECFDF5; }
      .amt.defend .amt-val { color:#B45309; background:#FFF7ED; }
      .amt-sub { font-size:11px; color:#6B7280; margin-top:3px; text-align:right; max-width:150px; }
      /* ALIGNEMENT À DROITE — SUR L'ENCRE, PAS SUR LES BOÎTES (owner 25/08, demandé dix fois ;
         mes mesures précédentes comparaient des rectangles et concluaient « aligné » à tort).
         Mesuré au navigateur AVANT : site à 949 px, nombres à 918 (pastille + ⓘ posé à SA
         DROITE), 939 et 940 (pastilles à padding 9 ou 10 px) — quatre bords dans une colonne.
         La pastille garde sa forme ; c'est le TEXTE qui doit tomber sur la même verticale :
         chaque élément de la colonne porte donc le même retrait. --ab-eur-pad est la seule
         source de ce nombre — le changer réaligne tout d'un coup. */
      /* BANDEAU (format B, proto agir-formats-proto) — les CHANTIERS ne sont pas des cartes :
         une ligne, hauteur fixe, deux lignes de texte, pas de pied. Mettre ces rangées sur
         .ab-rgrid + .ab-rfoot (25/08 après-midi) en avait fait des cartes normales : c'est la
         régression signalée par l'owner. La colonne droite garde le MÊME bord d'encre que les
         cartes (var --ab-eur-pad), donc les deux formats s'alignent verticalement. */
      /* padding-right 20 px = celui de .ab-rgrid : sans ça, bandeaux et cartes tombaient sur
         deux bords distants de 2 px (mesuré : 951 contre 949). */
      .ab-bnd { display:flex; align-items:center; gap:12px; padding:0 20px 0 18px; min-height:62px; }
      .ab-bnd-body { flex:1; min-width:0; }
      .ab-bnd-t { font-size:13px; font-weight:620; color:#111827; line-height:1.3; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; cursor:pointer; }
      .ab-bnd-t:hover { color:#1D3BB3; }
      .ab-bnd-f { font-size:11.5px; color:#6B7280; line-height:1.3; margin-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
      .ab-bnd-tail { display:flex; flex-direction:column; align-items:flex-end; gap:3px; flex:none; margin-left:14px; }
      /* La LOCATION est collée au bord droit : aucun retrait. Son encre tombe exactement sur
         celle du dernier geste de la ligne du dessous (owner 25/08 : « je VEUX la location à
         droite »). --ab-eur-pad ne s'applique PAS ici : il n'existe que dans .ab-eur, et un
         retrait de 10 px décalait la location de 10 px vers la gauche. */
      .ab-bnd-site { font-size:10.5px; color:#9CA3AF; white-space:nowrap; }
      .ab-bnd-line { display:flex; align-items:center; gap:14px; }
      .ab-bnd-line .pls-cta-sec, .ab-bnd-line .pls-cta-pri { padding:0; }
      .ab-eur { --ab-eur-pad:10px; }
      /* LOCATION COLLÉE AU BORD DROIT (owner 25/08 : « je VEUX la location à droite »).
         Le retrait de 10 px posé plus tôt alignait son encre sur celle du NOMBRE (939) mais la
         décollait du bord (949) : c'est ce décalage que l'owner voyait. Priorité au bord —
         la location, le sous-texte, la pastille et les gestes du pied partagent 949. */
      .ab-eur .ab-meta, .ab-eur .amt-sub { padding-right:0; }
      .ab-eur .amt-val { padding-left:var(--ab-eur-pad); padding-right:var(--ab-eur-pad); }
      .ab-eur .ab-pill-eur { padding:3px var(--ab-eur-pad); }
      .amt-i { cursor:help; width:14px; height:14px; border-radius:50%; border:1px solid #D1D5DB; color:#9CA3AF; font-size:9.5px; display:inline-flex; align-items:center; justify-content:center; font-style:italic; font-family:Georgia,serif; flex:none; }
      .ab-meta { display:block; font-size:11px; color:#6B7280; margin-bottom:3px; white-space:nowrap; }
      /* Peau de rangée (Inc 5) : la carte est une RANGÉE du fil — filet, grille, plus de boîte. */
      .ab-rgrid { display:grid; grid-template-columns:46px minmax(0,1fr) 156px; gap:0 14px; padding:16px 20px 0 16px; }
      .ab-eur { text-align:right; display:flex; flex-direction:column; align-items:flex-end; }
      .ab-eur .amt { display:flex; flex-direction:column; align-items:flex-end; }
      .ab-rfoot { display:flex; align-items:center; gap:7px; flex-wrap:wrap; padding:12px 20px 14px 76px; }
      #pls-triage .ab-card { border:none; border-radius:0; box-shadow:none; border-top:1px solid rgba(17,24,39,0.06); background:var(--color-bg-card); margin:0; }
      #pls-triage .ab-card:first-child { border-top:none; }
      #pls-triage [data-t-cards], #pls-triage [data-t-struct] { background:var(--color-bg-card); border:1px solid rgba(0,0,0,0.08); border-radius:14px; overflow:hidden; }
      .ab-newline { display:flex; align-items:center; gap:10px; padding:6px 16px; color:#1D3BB3; font-size:11.5px; font-weight:600; }
      .ab-newline::before, .ab-newline::after { content:""; flex:1; height:1px; background:#1D3BB3; opacity:0.35; }
      /* Décision D (18/07) : cartes action fermées à 3 lignes, « Voir plus » seulement si ça déborde. */
      .ab-sowhat.pls-clamp { display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; }
      .pls-more { font-size:11.5px; font-weight:600; color:#1D3BB3; cursor:pointer; margin-top:5px; }
      /* Décision C (18/07) : skeletons aux dimensions du contenu final, à la place de « Chargement… ». */
      .pls-sk { background:linear-gradient(90deg,#EDEFF2 25%,#F6F7F9 50%,#EDEFF2 75%); background-size:200% 100%; animation:pls-sk 1.4s infinite; border-radius:6px; }
      @keyframes pls-sk { 0% { background-position:200% 0; } 100% { background-position:-200% 0; } }
      @media (prefers-reduced-motion: reduce) { .pls-sk { animation:none; } }
      .ab-actions { display:none; padding:0 16px 14px; border-top:1px solid #F3F4F6; }
      .ab-actions.is-open { display:block; }
      .ab-action-item { display:flex; align-items:flex-start; gap:10px; padding:10px 0; border-bottom:1px solid #F9FAFB; }
      .ab-action-item:last-of-type { border-bottom:none; }
      .ab-check { width:18px; height:18px; border:1.5px solid #d1d5db; border-radius:4px; flex-shrink:0; margin-top:1px; display:flex; align-items:center; justify-content:center; cursor:pointer; background:#fff; transition:all 0.1s; }
      .ab-check.is-checked { background:#059669; border-color:#059669; }
      .ab-action-text { font-size:12.5px; color:#111827; line-height:1.4; }
      .ab-action-text.is-done { text-decoration:line-through; color:#6B7280; }
      .ab-action-meta { font-size:10px; color:#6B7280; margin-top:2px; }
      .ab-action-right { display:flex; flex-direction:column; align-items:flex-end; gap:4px; flex-shrink:0; margin-left:auto; padding-top:2px; }
      .ab-copy { font-size:10px; font-weight:600; color:#1D3BB3; background:none; border:none; cursor:pointer; padding:0; font-family:inherit; white-space:nowrap; }
      .ab-copy.is-copied { color:#059669; }
      .ab-zero { background:rgba(16,185,129,0.1); border:1px solid rgba(16,185,129,0.15); border-radius:10px; padding:16px 18px; display:flex; align-items:center; gap:10px; font-size:13px; font-weight:500; color:#059669; }
      .ab-gen { font-size:10px; font-weight:600; color:#1D3BB3; background:none; border:none; cursor:pointer; padding:0; font-family:inherit; white-space:nowrap; }
      .ab-gen.is-loading { color:#9CA3AF; pointer-events:none; }
      .ab-draft-panel { display:none; margin-top:8px; padding:10px 12px; background:#f8fafc; border:1px solid #E8EDF5; border-radius:8px; font-size:12px; color:#111827; line-height:1.5; }
      .ab-draft-panel.is-open { display:block; }
      .ab-draft-panel pre { white-space:pre-wrap; word-break:break-word; margin:0 0 8px; font-family:inherit; font-size:12px; }
      .ab-draft-actions { display:flex; gap:12px; align-items:center; margin-top:6px; }
      .ab-draft-copy { font-size:11px; font-weight:600; color:#059669; background:none; border:none; cursor:pointer; padding:0; font-family:inherit; }
