        + `<span style="font-size:12.5px;color:var(--color-text-secondary);">${escapeHtml(fmtDateLong(selectedDate))}</span>`
        + (_vAlertSv ? `<span style="font-size:12.5px;font-weight:600;color:${_vAlertSv.fg};">${_vAlert >= 3 ? "vigilance m\u00e9t\u00e9o forte" : "vigilance m\u00e9t\u00e9o"}</span>` : "")
        + `<span style="flex:1;"></span>`
        + `<a href="/app/insightevent/tableau" style="color:#1D3BB3;font-weight:600;text-decoration:none;font-size:12.5px;white-space:nowrap;">Piloter \u2192</a>`
      + `</div>`
    + `</div>`;

    // Weekly goal — ONE goal for the whole account; picking it reorders the cards live.
    var GOAL_OPTS = [
      { key: "faire_venir", label: "Faire venir" },
      { key: "augmenter_panier", label: "Augmenter le CA" },
      { key: "plus_avis", label: "Plus d\u2019avis" },
      { key: "surveiller_marche", label: "Surveiller le march\u00e9" },
    ];
    // One weekly goal for the whole account — the header dropdown handles which site
    // you are looking at, so the goal no longer carries its own site picker.
    var activeGoalKey = _effGoalKey;
    var _goalChipLabel = activeGoalKey
      ? ("Objectif\u00a0: " + ((GOAL_OPTS.filter(function(g){ return g.key === activeGoalKey; })[0] || {}).label || ""))
      : "D\u00e9finir un objectif";
    var goalSelectorHtml = (
      '<div class="pls-goal" data-goal-selector>'
      + '<button type="button" class="pls-goal-chip" data-goal-chip-toggle aria-expanded="false">'
        + '<span data-goal-chip-label>' + escapeHtml(_goalChipLabel) + '</span>'
        + '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>'
      + '</button>'
      + '<div class="pls-goal-pop" data-goal-popover hidden>'
        + '<div class="eb" style="margin-bottom:6px;">Objectif de la semaine</div>'
        + '<div style="font-size:11px;color:#6B7280;margin-bottom:10px;line-height:1.4;">Les cartes qui servent cet objectif passent en t\u00eate de la liste.</div>'
        + '<div style="display:flex;gap:6px;flex-wrap:wrap;">'
        + GOAL_OPTS.map(function(g) {
            var sel = (g.key === activeGoalKey);
            return '<button type="button" data-goal-key="' + g.key + '" aria-pressed="' + (sel ? 'true' : 'false') + '" style="font-size:12px;font-weight:600;padding:6px 12px;border:1px solid ' + (sel ? '#1D3BB3' : '#E5E7EB') + ';background:' + (sel ? '#1D3BB3' : '#fff') + ';color:' + (sel ? '#fff' : '#6B7280') + ';cursor:pointer;font-family:inherit;">' + escapeHtml(g.label) + '</button>';
          }).join("")
        + '</div>'
      + '</div>'
      + '</div>'
    );

    // Actions-menées counter (single-site; baseline from dbt table, bumped live on card_done)
    var _cardsDone = (!isMultisite && data.activity && data.activity.cards_done != null) ? Number(data.activity.cards_done) : null;
    var counterHtml = (_cardsDone != null)
      ? '<div style="display:flex;align-items:center;gap:6px;margin-bottom:12px;"><span style="font-size:11px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#059669;">\u2713 <span data-actions-counter>' + _cardsDone + '</span> actions men\u00e9es</span></div>'
      : "";

    // Assemble
    // Radar retiré (14/08) : ses trois volets vivent sur Piloter (héros + Événements
    // concurrents + Ma veille concurrentielle) — les hooks ops sont gardés contre null.
    root.innerHTML = pillsHtml + verdictHtml + goalSelectorHtml + counterHtml + briefHtml + feedHtml;
    applySowhatClamp(root);

    // Engagement cards — merged into Fil d'actualité, scoped to the SAME sites the feed
