  var CHANNEL_DEFS = {gbp:{label:"Google Business Profile",max:1500,icon:"G",color:"#4285F4",cat:"pub"},instagram:{label:"Instagram",max:2200,icon:"IG",color:"#E1306C",cat:"pub"},facebook:{label:"Facebook",max:null,icon:"FB",color:"#0866FF",cat:"pub"},email:{label:"Email",max:null,icon:"@",color:"#6B7280",cat:"send"},sms:{label:"SMS",max:160,icon:"SM",color:"#059669",cat:"send"},whatsapp:{label:"WhatsApp",max:1000,icon:"WA",color:"#25D366",cat:"send"},slack:{label:"Slack",max:null,icon:"SL",color:"#4A154B",cat:"send"},internal:{label:"Note interne",max:null,icon:"N",color:"#374151",cat:"send"},phone:{label:"Appel téléphonique",max:null,icon:"T",color:"#0ea5e9",cat:"send"}};
  function openBrouillonLibrary(opts) { return window.MSDraftWorkspace.openLibrary(opts); }
  // (corps déplacé dans public/js/draft-workspace.js — tiroir partagé, 18/07.)

  // ---- Render ----
  function renderDailyBrief(allFeed, profile, currentDay, selectedDate, locationId, days, followedCount, activeGoalKey) {
    var today = todayYmd();
    var prof = profile || {};

    var candidates = [];
    if (typeof window.renderActionCandidates === 'function' && window._lastActionCandidates) {
      // FUITE ENTRE SITES — corrigée le 25/08 (défaut trouvé au rendu réel, pas à la lecture).
      // Cet appel passait le profil ET le contexte-jour du site de SESSION à toutes les cartes,
      // y compris celles des autres sites : la carte competition_proximity de la rangée
      // « Muse Square » disait « autour de MS Test », et son « concurrent le plus proche »
      // venait du rayon d'un autre site. On rend donc PAR SITE, chacun avec SON profil et SON
      // jour (window._plsSiteData, déjà en mémoire — zéro requête), puis on concatène.
      // Vue mono-site ou table absente : comportement d'avant, au caractère près.
      var _sd = Array.isArray(window._plsSiteData) ? window._plsSiteData : null;
      if (_sd && _sd.length > 1) {
        var _byLoc = {};
        window._lastActionCandidates.forEach(function (c) {
          var k = String((c && c.location_id) || '');
          (_byLoc[k] = _byLoc[k] || []).push(c);
        });
        _sd.forEach(function (site) {
          var list = _byLoc[String(site.location_id)];
          if (!list || !list.length) return;
          var sDay = (site.days || []).filter(function (d) { return normalizeYmd(d.date) === normalizeYmd(selectedDate); })[0]
            || (site.days || [])[0] || {};
          var part = window.renderActionCandidates(list, site.profile || prof, sDay, selectedDate, "veille", _channelConfigsCache || {}, today) || [];
          candidates = candidates.concat(part);
          delete _byLoc[String(site.location_id)];
        });
        // Cartes sans site connu (jamais observé, mais rien ne doit disparaître silencieusement).
        Object.keys(_byLoc).forEach(function (k) {
          candidates = candidates.concat(window.renderActionCandidates(_byLoc[k], prof, currentDay, selectedDate, "veille", _channelConfigsCache || {}, today) || []);
        });
        candidates.sort(function (a, b) { return (b.score - a.score) || 0; });
      } else {
        candidates = window.renderActionCandidates(window._lastActionCandidates, prof, currentDay, selectedDate, "veille", _channelConfigsCache || {}, today);
      }
    }
    // ---- audience_mismatch (client-side only — needs profile join) ----
    var audLabel = String(currentDay.audience_availability_label || "").toLowerCase();
    var myAudComp = String(prof.primary_audience_1 || "").toLowerCase();
    var AUD_FR_COMP = {local:"r\u00e9sidents locaux",professionals:"professionnels",tourists:"touristes",students:"\u00e9tudiants",families:"familles",seniors:"seniors"};
    var myAudLabelComp = AUD_FR_COMP[myAudComp] || "";
    var audMismatch = false;
    if (myAudComp === "professionals" && (audLabel.indexOf("vacances") >= 0 || audLabel.indexOf("f\u00e9ri\u00e9") >= 0 || audLabel.indexOf("famille") >= 0)) audMismatch = true;
    if (myAudComp === "tourists" && audLabel.indexOf("touris") < 0 && audLabel.indexOf("f\u00e9ri\u00e9") < 0 && audLabel.indexOf("vacances") < 0) audMismatch = true;
    if ((myAudComp === "local" || myAudComp === "families") && audLabel.indexOf("professionnel") >= 0 && audLabel.indexOf("vacances") < 0) audMismatch = true;
    if (audMismatch && myAudLabelComp) {
      var audAvailable = audLabel.indexOf("touris") >= 0 ? "touristes" : audLabel.indexOf("famille") >= 0 ? "familles" : audLabel.indexOf("f\u00e9ri\u00e9") >= 0 ? "public jour f\u00e9ri\u00e9" : audLabel.indexOf("vacances") >= 0 ? "vacanciers" : audLabel.indexOf("soldes") >= 0 || audLabel.indexOf("commercia") >= 0 ? "acheteurs" : "public diff\u00e9rent";
      candidates.push({ item: { change_subtype:"_audience_mismatch", affected_date:currentDay.date, alert_level:2, location_label: currentDay.location_label || "" }, tmpl: {
        type:"threat", barClass:"ab-warning",
        urgencyPill:{label:"Aujourd\u2019hui",style:"background:var(--color-pill-warn-bg);color:var(--color-pill-warn-text);"},
        typePill:{label:"Audience",style:"background:#EFF6FF;color:#1e40af;"},
        what: "Public du jour : " + audAvailable + " \u2014 votre cible (" + myAudLabelComp + ") est moins disponible",
        sowhat: (function() {
          var peak = currentDay ? Number(currentDay.ft_peak_hour || 0) : 0;
          var peakStr = peak > 0 ? peak + "h" : "";
          return "Public du jour : " + audAvailable + ". Votre cible (" + myAudLabelComp + ") est moins disponible." + (peakStr ? " Pic \u00e0 " + peakStr + " \u2014 adaptez vos horaires et votre offre en cons\u00e9quence." : " Ajustez vos horaires ou adaptez votre offre.");
        })(),
        actions: [
          {text:"R\u00e9duisez votre \u00e9quipe si la fr\u00e9quentation cible sera faible",meta:"Exploitation \u00b7 \u00c9quipe",key:"staff_adjust",channel:CH_INTERNAL},
          {text:"Publiez un post adapt\u00e9 au public disponible (" + audAvailable + ")",meta:"Communication \u00b7 Adaptation",key:"visitor_comm",channel:CH_GBP},
        ],
      }, score: 65 });
    }

    // ── « Vu » (23/08, owner : valoriser le nouveau à impact égal, sans toucher aux menaces). ──
    // Mémoire CLIENT par clé de carte (suppression_key du mart ; repli type|date|site pour les
    // cartes construites ici), dans localStorage comme les retours fermés — rien côté serveur.
    // Marquée « vue » au RENDU : à la visite suivante la pastille tombe et la carte recule,
    // à score et niveau égaux seulement — une menace de niveau 3 passe toujours devant.
    var _SEEN_LS = "ms_seen_cards";
    var _seenMap = {};
    try { _seenMap = JSON.parse(localStorage.getItem(_SEEN_LS) || "{}") || {}; } catch (e) { _seenMap = {}; }
    function _cardKey(c) {
      var it = c && c.item ? c.item : (c || {});
      return String(it.suppression_key || ((it.change_subtype || it.action_type || '') + '|' + (it.affected_date || it.date || '') + '|' + (it.location_id || it.location_label || '')));
    }
    function _isNew(c) { return _seenMap[_cardKey(c)] ? 0 : 1; }
    function _firstSeen(c) { return String(_seenMap[_cardKey(c)] || ''); }
    // À score égal : non vu d'abord, puis la découverte la plus RÉCENTE d'abord (horodatage de
    // première vue). Sans ce second critère, une carte entrée par la nouveauté ressortait à la
    // visite suivante (tout vu → score seul) et l'ordre oscillait (mesuré au harnais, 23/08).
    function _newTie(a, b) { var d = _isNew(b) - _isNew(a); if (d) return d; var fa = _firstSeen(a), fb = _firstSeen(b); return fb > fa ? 1 : fb < fa ? -1 : 0; }
    function _markSeen(list) {
      var now = new Date().toISOString(), changed = false;
      (list || []).forEach(function (c) { var k = _cardKey(c); if (!_seenMap[k]) { _seenMap[k] = now; changed = true; } });
      if (changed) { try { localStorage.setItem(_SEEN_LS, JSON.stringify(_seenMap)); } catch (e) {} }
    }
    window._msIsNewCard = _isNew; window._msNewTie = _newTie; window._msMarkSeen = _markSeen;
    candidates.sort(function(a,b) { return (b.score - a.score) || _newTie(a, b); });
    var seen = {};
    var top = [];
    var _catCounts = {};
    var MAX_PER_CAT = 2;

    // SÉLECTION PAR SITE (29/07/2026). Tout ce qui suit — clés de dédup, plafond par catégorie,
    // top-N, quotas objectif et performance — était GLOBAL au compte, écrit quand un compte
    // n'avait qu'un lieu. Sur un compte multi-sites, deux cartes du MÊME type venues de DEUX
    // LIEUX s'effondraient en une seule : l'écran montrait le payload d'un site sous un en-tête
    // nommant les deux. Constaté sur le compte Les Olivades le 29/07 — « météo niveau 4 » de
    // Paris affiché pour Saint-Étienne-du-Grès qui est à 3 ; « 1 126 événements à 5 km » de
    // Paris pour un site qui en compte 0. Ce n'était pas un regroupement discutable, c'était
    // faux à l'écran.
    // On scope tout par site : la dédup GARDE son rôle À L'INTÉRIEUR d'un lieu
    // (weather_hazard_onset + weather_worsened -> une seule carte météo) et ne traverse plus
    // les lieux. La concaténation de libellés « A · B » plus bas devient de ce fait morte —
    // elle créait une entité qui n'existe dans aucun Compte.
    function _siteKey(c) {
      var it = c && c.item ? c.item : null;
      return String((it && (it.location_id || it.location_label)) || '');
    }
    function _topForSite(k) {
      var n = 0;
      for (var _ti = 0; _ti < top.length; _ti++) if (_siteKey(top[_ti]) === k) n++;
      return n;
    }
    var MAX_PER_SITE = 10;
    var _goalCounts = {};
    var _perfCounts = {};

    // Goal pass: up to 3 cards serving the active weekly goal, surfaced first.
    var _goalTypes = (activeGoalKey && window.GOAL_SERVING_TYPES) ? (window.GOAL_SERVING_TYPES[activeGoalKey] || []) : [];
    var _goalSet = {};
    for (var _gi = 0; _gi < _goalTypes.length; _gi++) _goalSet[String(_goalTypes[_gi]).toLowerCase()] = true;
    if (_goalTypes.length) {
      for (var _gj = 0; _gj < candidates.length; _gj++) {
        var _gc = candidates[_gj];
        var _gk = _siteKey(_gc);
        if ((_goalCounts[_gk] || 0) >= 3) continue;   // 3 cartes objectif PAR SITE
        var _gsub = String(_gc.item.change_subtype||"").toLowerCase();
        var _salesGoal = (window.msSalesGoal ? window.msSalesGoal(_gc.item) : null);
        if (!_goalSet[_gsub] && _salesGoal !== activeGoalKey) continue;
        var _gDedupSub = (_gsub === "weather_hazard_onset" || _gsub === "weather_worsened") ? "weather_alert" : (_gsub === "high_competition_density" || _gsub === "competition_proximity") ? "competition_density" : _gsub;
        var _gDedup = _gk + "|" + _gDedupSub + "|" + normalizeYmd(_gc.item.affected_date);
        if (seen[_gDedup]) continue;
        seen[_gDedup] = true;
        _gc.tmpl._goal_card = true;
        top.push(_gc);
        _goalCounts[_gk] = (_goalCounts[_gk] || 0) + 1;
      }
    }

    // Performance pass: reserve ONE baseline sales/perf card so the operator always has a
    // pulse on their numbers — without the feed being crowded by 4 sales cards regardless
    // of priority. Priority-relevant sales cards come through the goal pass above (driver-
    // routed via msSalesGoal); any extra through the context pass (capped low).
    for (var _pj = 0; _pj < candidates.length; _pj++) {
      var _pc = candidates[_pj];
      if (String(_pc.item.action_category || "").toLowerCase() !== "performance") continue;
      var _pk = _siteKey(_pc);
      if ((_perfCounts[_pk] || 0) >= 4 || _topForSite(_pk) >= MAX_PER_SITE) continue;
      var _psub = String(_pc.item.change_subtype || "").toLowerCase();
      var _pdedup = _pk + "|" + _psub + "|" + normalizeYmd(_pc.item.affected_date);
      if (seen[_pdedup]) continue;
      seen[_pdedup] = true;
      top.push(_pc);
      _perfCounts[_pk] = (_perfCounts[_pk] || 0) + 1;
      _catCounts[_pk + "|performance"] = (_catCounts[_pk + "|performance"] || 0) + 1;
    }

    // PÉRIMÈTRE PASS (étage 4, 31/07/2026) — UNE place réservée PAR SITE pour une carte qui attend
    // la réponse de périmètre. Même motif que la performance pass ci-dessus, et pour la même raison :
    // ces cartes n'ont PAS d'enjeu (c'est leur définition), elles tombent donc en fin du tri
    // `b.score - a.score` et le plafond MAX_PER_CAT = 2 les coupe. Sans place réservée la question
    // ne serait jamais posée, donc jamais répondue, donc la famille resterait muette pour toujours —
    // exactement le raisonnement qui a fait rejeter le formulaire de profil comme unique entrée.
    //
    // Tri entre candidates d'un même site : priorité de la carte, puis nombre d'événements
    // concurrents décroissant. CE N'EST PAS un montant € — ces cartes n'en ont pas, et en fabriquer
    // un serait la faute corrigée le 31/07 sur les cartes concurrent. Le vrai critère en euros
    // viendra du calcul des deux hypothèses (1 km / 20 km) au cron, chantier séparé (temps 2).
    //
