        moreSt.textContent = 'Voir ' + (stRows.length - 2) + ' autre' + (stRows.length - 2 > 1 ? 's' : '') + ' chantier' + (stRows.length - 2 > 1 ? 's' : '');
        moreSt.addEventListener('click', function() {
