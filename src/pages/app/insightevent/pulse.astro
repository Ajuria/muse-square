  function _structImpKey(imp) { return String((imp && imp.location_id) || '') + '|' + String((imp && imp.class_key) || ''); }
  function _impByKey(k) {
    var arr = Array.isArray(window._lastDayClassImpacts) ? window._lastDayClassImpacts : [];
    for (var i = 0; i < arr.length; i++) { if (_structImpKey(arr[i]) === k) return arr[i]; }
    return null;
  }

  function _wireStructRows(scope) {
    // « Choisir le site » (variante 2, owner 25/08) : le groupe déplie SES rangées par site,
    // chacune avec ses propres gestes — c'est ainsi que « M'engager » sait sur quel site il
    // agit, la contrepartie que le proto annonçait. Le sous-bloc est câblé par le même
    // _wireStructRows, donc rien de neuf à maintenir.
    scope.querySelectorAll('[data-struct-expand]').forEach(function (b) {
      b.addEventListener('click', function () {
        var gkey = b.getAttribute('data-struct-expand');
        var sub = scope.querySelector('[data-struct-sub="' + gkey + '"]');
        if (!sub) return;
        if (sub.style.display === 'block') { sub.style.display = 'none'; sub.innerHTML = ''; b.textContent = 'Choisir le site'; return; }
        var parts = gkey.split('|');          // g | class_key | pos|neg
        var cls = parts[1], sens = parts[2];
        var arr = Array.isArray(window._lastDayClassImpacts) ? window._lastDayClassImpacts : [];
        var rows = arr.filter(function (i) {
          return String(i.class_key || '') === cls && (Number(i.eur_year) > 0 ? 'pos' : 'neg') === sens;
        })
                      .sort(function (x, y) { return Math.abs(Number(y.eur_year) || 0) - Math.abs(Number(x.eur_year) || 0); });
        if (!rows.length) return;
        sub.innerHTML = rows.map(function (imp) { return _structRowHtml(imp, _structImpKey(imp), false); }).join('');
        sub.style.display = 'block';
        b.textContent = 'Replier';
        _wireStructRows(sub);
      });
    });

    // Inc D (owner 25/08, point 2) : « Pas pour moi » structurel — card_not_done SANS date
    // (un motif n'expire pas avec un jour), clé de lecture 'structural_<classe>|' via
    // card-states. La rangée part du fil immédiatement ; l'événement reste en base.
    scope.querySelectorAll('[data-struct-dispo]').forEach(function(b) {
      b.addEventListener('click', function(e) {
        e.stopPropagation();
        var imp = _impByKey(b.getAttribute('data-struct-dispo'));
        if (!imp) return;
        fetch('/api/analytics/track', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ event: 'card_not_done', location_id: imp.location_id, action_type: 'structural_' + String(imp.class_key || ''), change_subtype: 'structural_' + String(imp.class_key || ''), affected_date: null })
        }).catch(function(){});
        var map = _cardStatesByLoc[imp.location_id];
        if (map) map['structural_' + String(imp.class_key || '') + '|'] = 'ecarte';
        var card = b.closest('.ab-card');
        if (card) card.remove();
      });
    });
    // Navigation vers la page « Reproduire le dispositif gagnant » (CTA identification).
    scope.querySelectorAll('[data-struct-page]').forEach(function(b) {
      b.addEventListener('click', function() {
        var imp = _impByKey(b.getAttribute('data-struct-page'));
        if (!imp || !imp.location_id) return;
        window.location.href = '/app/insightevent/dispositif?location_id=' + encodeURIComponent(imp.location_id) + '&class=' + encodeURIComponent(imp.class_key || '');
      });
    });
    // « Reproduire le dispositif » (registre identification) : le Documenter — la pratique
    // capturée nourrit la base de connaissances (étape 2 du parcours ; l'étape 1, le mode
    // enquête, arrive avec l'atelier — docs/atelier-mecanismes-spec.md). Repli : jamais un mur.
    scope.querySelectorAll('[data-struct-doc]').forEach(function(b) {
      b.addEventListener('click', function() {
        var key = b.getAttribute('data-struct-doc');
        var imp = _impByKey(key);
        var ws = scope.querySelector('[data-struct-ws="' + key + '"]');
        if (!imp || !ws) return;
        if (ws.style.display === 'block') { ws.style.display = 'none'; ws.innerHTML = ''; return; }
        ws.style.display = 'block';
        var origin = {
          origin_action_type: 'structural_' + imp.class_key,
          origin_driver: null,
          origin_suppression_key: 'structural:' + imp.class_key + ':' + imp.location_id,
          origin_card_instance_id: null,
          origin_affected_date: null,
          creation_residual_pct: null,
          creation_residual_z: null,
          creation_confidence_tier: null,
          creation_baseline_daily: null
        };
        if (!window.MSBpForm) {
          if (!window.MSCommitForm) { ws.innerHTML = '<div style="padding:14px 16px;font-size:12px;color:#B91C1C;">Formulaire indisponible — rechargez la page.</div>'; return; }
          ws.innerHTML = window.MSCommitForm.buildHtml({ suggestions: [String(imp.chantier_fr || '').replace(/^(Actions? conseillées?|Chantier|Enquête)\s*:\s*/, '')] });
          window.MSCommitForm.wire(ws, { location_id: imp.location_id, origin: origin,
            fetchOwners: function() { return fetchTeamMembers(imp.location_id).then(function(m) { return (m && m.length) ? m : teamMembersPool(imp.location_id); }); },
            onDone: function(j) { ws.innerHTML = '<div style="padding:14px 16px;font-size:12px;color:' + (j && j.ok ? '#166534' : '#B91C1C') + ';">' + (j && j.ok ? 'Engagement créé.' : ('Erreur : ' + escapeHtml((j && j.error) || 'réessayez'))) + '</div>'; },
            onCancel: function() { ws.style.display = 'none'; ws.innerHTML = ''; } });
          return;
        }
        ws.innerHTML = window.MSBpForm.buildHtml({
          anchorHtml: escapeHtml(String(imp.title_fr || '')),
          pistes: ['Offre ou mise en avant spécifique ces jours-là', 'Organisation particulière de l’équipe sur ces journées', 'Communication publiée avant ces journées']
        });
        window.MSBpForm.wire(ws, {
          location_id: imp.location_id,
          origin: origin,
          onSaved: function() { ws.innerHTML = '<div style="padding:14px 16px;font-size:12px;color:#166534;">Documenté — ajouté à vos bonnes pratiques. Le dispositif se précise avec chaque journée expliquée.</div>'; }
        });
      });
    });
    // Communiquer sur motif structurel (owner 15/08) : même workspace partagé que les
    // cartes datées — signal_type structural_<classe>, seed replié si inconnu du seeder.
    scope.querySelectorAll('[data-struct-follow]').forEach(function(b) {
      b.addEventListener('click', function() {
        var eng = document.getElementById('pls-engagement-cards');
        if (eng) eng.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
    scope.querySelectorAll('[data-struct-commit]').forEach(function(b) {
      b.addEventListener('click', function() {
        var key = b.getAttribute('data-struct-commit');
        var imp = _impByKey(key);
        var ws = scope.querySelector('[data-struct-ws="' + key + '"]');
        if (!imp || !ws) return;
        if (ws.style.display === 'block') { ws.style.display = 'none'; ws.innerHTML = ''; return; }
        if (!window.MSCommitForm) { ws.style.display = 'block'; ws.innerHTML = '<div style="padding:14px 16px;font-size:12px;color:#B91C1C;">Formulaire indisponible — rechargez la page.</div>'; return; }
        ws.style.display = 'block';
        ws.innerHTML = window.MSCommitForm.buildHtml({ suggestions: [String(imp.chantier_fr || '').replace(/^(Actions? conseillées?|Chantier)\s*:\s*/, '')] });
        window.MSCommitForm.wire(ws, {
          location_id: imp.location_id,
          origin: {
            origin_action_type: 'structural_' + imp.class_key,
            origin_driver: null,
            origin_suppression_key: 'structural:' + imp.class_key + ':' + imp.location_id,
            origin_card_instance_id: null,
            origin_affected_date: null,
            creation_residual_pct: null,
            creation_residual_z: null,
            creation_confidence_tier: null,
            creation_baseline_daily: null
          },
          fetchOwners: function() {
            return fetchTeamMembers(imp.location_id).then(function(members) {
              return (members && members.length) ? members : teamMembersPool(imp.location_id);
            });
          },
          onDone: function(j) {
            ws.innerHTML = '<div style="padding:14px 16px;font-size:12px;color:' + (j && j.ok ? '#166534' : '#B91C1C') + ';">' + (j && j.ok ? 'Engagement créé — le motif passe « En amélioration » ; le batch mensuel dira si le poids recule.' : ('Erreur : ' + escapeHtml((j && j.error) || 'réessayez'))) + '</div>';
            if (j && j.ok) { try { renderEngagements(_engagementLocs); } catch (err) {} }
          },
          onCancel: function() { ws.style.display = 'none'; ws.innerHTML = ''; }
        });
      });
    });
  }

  function _triageApplyFilters(mount) {
    var fh = _triageState.fh, fn = _triageState.fn;
    var filtering = fh !== 'tous' || fn !== 'tous';
    mount.querySelectorAll('.ab-card[data-t-site]').forEach(function(c) {
      var h = c.getAttribute('data-t-h') === '3' ? 'struct' : (c.getAttribute('data-t-h') === '0' ? 'today' : 'week');
      // Un motif PROMU (carte pleine, data-t-h=0) répond aux deux filtres : Aujourd'hui ET Structurel.
      var okH = fh === 'tous' || h === fh;
      var okN = fn === 'tous' || c.getAttribute('data-t-n') === fn;
      // UN DOUBLON RESTE CACHÉ, quoi qu'il arrive (owner 25/08). Défaut mesuré : le dédup
      // marquait bien data-t-dup et posait display:none, puis CETTE fonction — qui tourne à la
      // fin de buildTriageLayout — remettait tout le monde à display:'' selon les seuls filtres.
      // Résultat sur la page réelle : 6 doublons marqués, 0 caché, et comme ils gardaient leur
      // position d'origine, ils s'affichaient EN TÊTE du fil. Mon contrôle précédent vérifiait
      // le marquage, jamais la visibilité — il passait au vert sur une page fausse.
      if (c.getAttribute('data-t-dup') === '1') { c.style.display = 'none'; return; }
      var folded = c.getAttribute('data-t-folded') === '1';
      c.style.display = (okH && okN && (!folded || filtering || _triageState.sortEnjeu)) ? '' : 'none';
    });
    mount.querySelectorAll('[data-t-more]').forEach(function(b) {
      b.style.display = (filtering || _triageState.sortEnjeu) ? 'none' : '';
    });
    mount.querySelectorAll('[data-t-subhead]').forEach(function(sh) {
      sh.style.display = (fh === 'tous' || fh === 'struct') && !_triageState.sortEnjeu ? '' : 'none';
    });
  }

  function _triageSortSite(block) {
    var cards = [].slice.call(block.querySelectorAll('.ab-card[data-t-site]'));
    cards.sort(function(a, b) {
      if (_triageState.sortEnjeu) return Number(b.getAttribute('data-t-e')) - Number(a.getAttribute('data-t-e'));
      var d = Number(a.getAttribute('data-t-h')) - Number(b.getAttribute('data-t-h'));
      if (d !== 0) return d;
      var e = Number(b.getAttribute('data-t-e')) - Number(a.getAttribute('data-t-e'));
      if (e !== 0) return e;
      // P2 (27/08) — départage FINAL : à clés arbitrées égales (owner 25/08, intouchées),
      // le thème déjà écarté (« Pas pour moi », data-t-rej) descend. 0 rejet = tri inchangé.
      return Number(a.getAttribute('data-t-rej') || 0) - Number(b.getAttribute('data-t-rej') || 0);
    });
    var subhead = block.querySelector('[data-t-subhead]');
    cards.forEach(function(c) {
      if (!_triageState.sortEnjeu && c.getAttribute('data-t-h') === '3' && subhead) block.appendChild(c);
      else if (subhead && !_triageState.sortEnjeu) block.insertBefore(c, subhead);
      else block.appendChild(c);
    });
    if (subhead && !_triageState.sortEnjeu) {
      // re-place structurels après le subhead, dans leur ordre trié
      cards.filter(function(c) { return c.getAttribute('data-t-h') === '3'; }).forEach(function(c) { block.appendChild(c); });
    }
  }

  function buildTriageLayout() {
    var mount = document.getElementById('pls-triage');
    if (!mount) return;
    var root = mount.parentElement;
    var ctxCards = [].slice.call(root.querySelectorAll('.ab-card[data-ab-card-idx][data-t-site]'));
    var imps = Array.isArray(window._lastDayClassImpacts) ? window._lastDayClassImpacts.slice() : [];
    // DÉDUP INSTRUMENTÉE (01/08, trace multi-sites) : le grain vrai est UNE ligne par
    // (lieu, classe). Un doublon dans le tableau fusionné (symptôme vu par l'owner : les
    // valeurs d'un site sous le bloc d'un autre + un motif en plein ET compact) est éliminé
    // ET signalé — le warn EST la sonde du diagnostic, pas un tapis.
    (function () {
      var seen = {};
      var dedup = [];
      imps.forEach(function (i) {
        var k = _structImpKey(i);
        if (seen[k]) {
          try { console.warn('[triage] doublon day_class_impacts éliminé', k, 'labels:', seen[k].location_label, '/', i.location_label); } catch (e) {}
          return;
        }
        seen[k] = i;
        dedup.push(i);
      });
      imps = dedup;
    })();
    // Inc D (owner 25/08, point 2) : un motif écarté (« Pas pour moi », action_log
    // card_not_done sans date) ne revient pas au fil — état lu par site via card-states,
    // clé 'structural_<classe>|'. Réversible : c'est un événement, jamais une suppression.
    imps = imps.filter(function(i) { return cardStateFor('structural_' + String(i.class_key || ''), '', i.location_id) !== 'ecarte'; });
    imps.sort(function(a, b) { return Math.abs(Number(b.eur_year) || 0) - Math.abs(Number(a.eur_year) || 0); });
    // FIL UNIQUE (proto agir-proto-v3, owner 25/08 soir : « tu n'as pas suivi le prototype »)
    // — plus de blocs par site : une seule liste triée, chaque rangée porte sa pilule
    // date · SITE en haut à droite (vue compte). La PROMOTION structurelle reste PAR SITE
    // (doctrine 01/08 : plafond 2, motif engagé compact, classe portée aujourd'hui compacte).
    var order = [];
    ctxCards.forEach(function(c) { var st = c.getAttribute('data-t-site') || ''; if (order.indexOf(st) < 0) order.push(st); });
    imps.forEach(function(i) { var st = String(i.location_label || ''); if (order.indexOf(st) < 0) order.push(st); });
    // Barre de filtres (3 contrôles, pas plus — décision owner « too complicated »).
    var bar = '<div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin:14px 0 4px;">'
      + ['today|Aujourd’hui', 'week|Cette semaine', 'struct|Structurel'].map(function(x) {
          var v = x.split('|');
          return '<button type="button" data-t-fh="' + v[0] + '" style="font-size:12px;padding:4px 11px;border-radius:20px;border:1px solid var(--color-border);background:#fff;color:#374151;cursor:pointer;font-family:inherit;">' + v[1] + '</button>';
        }).join('')
      + '<span style="width:1px;height:18px;background:var(--color-border);margin:0 4px;"></span>'
      + ['defend|Menaces', 'capture|Opportunités'].map(function(x) {
          var v = x.split('|');
          return '<button type="button" data-t-fn="' + v[0] + '" style="font-size:12px;padding:4px 11px;border-radius:20px;border:1px solid var(--color-border);background:#fff;color:#374151;cursor:pointer;font-family:inherit;">' + v[1] + '</button>';
        }).join('')
      + '<span style="width:1px;height:18px;background:var(--color-border);margin:0 4px;"></span>'
      + '<button type="button" data-t-sort="1" style="font-size:12px;padding:4px 11px;border-radius:20px;border:1px solid var(--color-border);background:#fff;color:#374151;cursor:pointer;font-family:inherit;">Trier par enjeu</button>'
      + '</div>';
    // FIN DE LA PROMOTION STRUCTURELLE (owner 25/08, option 1). Un motif de fond n'a plus
    // qu'UNE forme : le bandeau. La doctrine du 01/08 en promouvait jusqu'à 2 par site en
    // CARTE PLEINE dans le fil du jour — mesuré sur le compte owner, ces cartes occupaient
    // 4 des 5 lignes visibles, ne laissant qu'UNE vraie carte du jour sur 20, et deux sites
    // sur trois sans aucune carte visible. Cause : le tri mêlait deux ÉCHELLES — un €/an
    // structurel (−24 965) et un € du jour ou un % — qui ne se comparent pas. Les motifs ne
    // perdent rien : ils sont tous listés en bandeaux sous « Chantiers structurels ».
    var compactImps = [];
    order.forEach(function(site) {
      var siteCtx = ctxCards.filter(function(c) { return (c.getAttribute('data-t-site') || '') === site; });
      var _siteCls = {};
      siteCtx.forEach(function(c) { var k = c.getAttribute('data-t-class'); if (k) _siteCls[k] = 1; });
      imps.filter(function(imp) { return String(imp.location_label || '') === site; })
        .forEach(function(imp) {
          // Règle 5 (doctrine valeur) conservée : un motif dont la classe est portée AUJOURD'HUI
          // par une carte datée du site n'affiche pas son montant deux fois.
          compactImps.push({ imp: imp, key: _structImpKey(imp), porte: !!_siteCls[String(imp.class_key || '')] });
        });
    });
    var html = bar
      + '<div data-t-block="0">'
        + '<div data-t-cards="0"></div>'
        + (compactImps.length ? '<div data-t-subhead="0" style="font-size:11px;letter-spacing:0.07em;text-transform:uppercase;color:var(--color-text-muted);font-weight:500;margin:12px 0 8px 2px;">Chantiers structurels</div>' : '')
        // Les rangées compactes vivaient À NU sous le bloc, quand toutes les autres rangées du
        // fil sont dans un conteneur encadré : d'où le « bandeau » mal formé signalé trois fois
        // par l'owner, et le décalage d'1 px mesuré au navigateur (la bordure du conteneur).
        // VARIANTE 2 (owner 25/08) : regroupement PAR MOTIF (class_key), tous sites confondus.
        // Un motif présent sur un seul site garde exactement sa ligne d'avant.
        + (compactImps.length ? '<div data-t-struct="0">' + (function () {
            // Regroupement par MOTIF **ET PAR SENS** — trouvé en lisant la sortie : sur
            // « jours chargés », deux sites perdent (−120 €/j) et un gagne (+132 €/j). Les
            // fondre donnait une étendue à cheval sur zéro, un NET qui masquait le site
            // gagnant, et surtout UN SEUL titre là où contextCopy en écrit deux — « Mettez en
            // place votre dispositif… » quand ça coûte, « Identifiez pourquoi… vous
            // rapportent » quand ça rapporte. Séparés, chaque ligne dit vrai.
            var byClass = {}, ordre = [];
            compactImps.forEach(function (x) {
              var k = String(x.imp.class_key || x.key) + '|' + (Number(x.imp.eur_year) > 0 ? 'pos' : 'neg');
              if (!byClass[k]) { byClass[k] = []; ordre.push(k); }
              byClass[k].push(x);
            });
            // Tri par |cumul| : le motif le plus lourd du COMPTE en tête, pas celui du 1er site.
            ordre.sort(function (a, b) {
              var sa = byClass[a].reduce(function (t, x) { return t + Math.abs(Number(x.imp.eur_year) || 0); }, 0);
              var sb = byClass[b].reduce(function (t, x) { return t + Math.abs(Number(x.imp.eur_year) || 0); }, 0);
              return sb - sa;
            });
            return ordre.map(function (k) {
              var grp = byClass[k];
              return grp.length > 1 ? _structGroupRowHtml(grp) : _structRowHtml(grp[0].imp, grp[0].key, grp[0].porte);
            }).join('');
          })() + '</div>' : '')
      + '</div>';
    mount.innerHTML = html;
    var holder = mount.querySelector('[data-t-cards="0"]');
    ctxCards.forEach(function(c) { holder.appendChild(c); });
    // Le fil du jour est désormais 100 % conjoncturel : une seule échelle, le tri redevient
    // honnête — horizon puis |montant|.
    var _mix = [].slice.call(holder.querySelectorAll('.ab-card[data-t-site]'));
    // UN MOTIF = UNE CARTE (owner 25/08, variante 2 étendue aux cartes DATÉES). « Préparez une
    // offre pour la rentrée » apparaissait trois fois, « Adaptez votre dispositif de
    // communication » trois fois : le même motif, un site par ligne. On garde la PREMIÈRE et
    // on nomme les autres sites sur sa pilule. Garde-fou repris des chantiers : on ne fusionne
    // que des cartes de MÊME SENS — un +24 % et un −8 % sous un seul titre mentiraient.
    (function () {
      var vus = {};
      _mix.forEach(function (c) {
        // SENS lu sur le COIN RENDU, pas sur data-t-n : ce dernier vient de enjeu.eur_year et
        // vaut 'none' pour les cartes dont le coin est un %. Résultat mesuré au premier jet :
        // « moins d'activité » fusionnait +24 % avec −8 % et −11 % sous un seul titre et un
        // seul chiffre — le même mensonge que celui écarté sur les chantiers ce matin.
        var _amtEl = c.querySelector('.ab-eur .amt');
        var _sens = _amtEl ? (_amtEl.className.indexOf('gain') >= 0 ? '+' : _amtEl.className.indexOf('defend') >= 0 ? '-' : '?') : '0';
        // La DATE entre dans la clé : deux cartes du même type sur des jours DIFFÉRENTS sont
        // deux faits distincts, jamais un doublon. Sans elle, un site seul qui reçoit deux
        // alertes le même motif à deux dates n'en verrait qu'une — cas non rencontré sur le
        // parc au 25/08, mais latent et invisible le jour où il arrive.
        var _dte = ((c.querySelector('.ab-eur .ab-meta') || {}).textContent || '').match(/\d{2}\/\d{2}/);
        var k = (c.getAttribute('data-t-type') || '') + '|' + ((c.querySelector('.ab-what') || {}).textContent || '').trim()
              + '|' + _sens + '|' + (_dte ? _dte[0] : '');
        if (!vus[k]) { vus[k] = { chef: c, sites: [c.getAttribute('data-t-site') || ''] }; return; }
        vus[k].sites.push(c.getAttribute('data-t-site') || '');
        c.setAttribute('data-t-dup', '1');
        c.style.display = 'none';
      });
      Object.keys(vus).forEach(function (k) {
        var g = vus[k];
        if (g.sites.length < 2) return;
        var meta = g.chef.querySelector('.ab-eur .ab-meta');
        if (!meta) return;
        var d = (meta.textContent || '').match(/^\s*(\d{2}\/\d{2})/);
        meta.innerHTML = (d ? escapeHtml(d[1]) + ' \u00b7 ' : '')
          + '<span style="color:#374151;font-weight:600;">' + escapeHtml(g.sites.join(' \u00b7 ')) + '</span>';
      });
      var _dups = _mix.filter(function (c) { return c.getAttribute('data-t-dup') === '1'; });
      _mix = _mix.filter(function (c) { return c.getAttribute('data-t-dup') !== '1'; });
      // Repoussés en fin de conteneur : sans ça ils gardaient la place qu'ils occupaient avant
      // le tri, c'est-à-dire les premiers rangs.
      _dups.forEach(function (c) { holder.appendChild(c); });
    })();
    // TRI (owner 25/08) : une carte qui porte un chiffre MESURÉ passe devant une carte qui n'en
    // porte pas — c'est ce qui séparait le signal du remplissage. À l'intérieur de chaque groupe
    // l'horizon garde la main (arbitrage owner : les prospectives chiffrées restent devant),
    // puis le montant. Avant : l'horizon écrasait tout, et un enjeu de 0 € battait 5 412 €.
    _mix.sort(function(a, b) {
