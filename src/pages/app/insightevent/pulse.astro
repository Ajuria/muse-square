      body.style.display = open ? "block" : "none";
      if (chevron) chevron.style.transform = open ? "rotate(180deg)" : "none";
    };
    const _voletIds = Array.from(root.querySelectorAll("[data-radar-toggle]")).map(b => b.getAttribute("data-radar-toggle"));
    root.querySelectorAll("[data-radar-toggle]").forEach(btn => {
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-radar-toggle");
        const body = root.querySelector(`[data-radar-body="${id}"]`);
        if (!body) return;
        const isOpen = body.style.display !== "none";
        _voletIds.forEach(other => { if (other !== id) _setVoletOpen(other, false); });
        _setVoletOpen(id, !isOpen);
        try { localStorage.setItem(_radarOpenKey, isOpen ? "" : id); } catch (e) {}
      });
    });
    // Restaure le volet ouvert lors de la dernière visite.
    try {
      const _savedOpen = localStorage.getItem(_radarOpenKey);
      if (_savedOpen && _voletIds.indexOf(_savedOpen) >= 0) _setVoletOpen(_savedOpen, true);
    } catch (e) {}

    // Header — « Pourquoi ce score » : le hero se déplie sur sa preuve (renderScoreDetail).
    const _heroToggle = root.querySelector("[data-hero-toggle]");
    const _heroBody = root.querySelector("[data-hero-body]");
    if (_heroToggle && _heroBody) {
      _heroToggle.addEventListener("click", (e) => {
        if (e.target.closest("a,button")) return; // liens/CTA internes gardent leur comportement
