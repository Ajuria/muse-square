  function teamMembersFor(locationId) { return _teamMembersByLoc[locationId] || []; }
  // Card-recipient pool: the card's own site if it has team members, otherwise every configured
  // member across all sites (deduped) — so recipients are always proposed even for sites, or
  // cards with no location_id, that have no team config of their own.
  function teamMembersPool(locationId) {
    var own = _teamMembersByLoc[locationId] || [];
    if (own.length) return own;
