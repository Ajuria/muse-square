---
// « Reproduire le dispositif gagnant » — l'atterrissage du CTA d'identification des cartes
// structurelles. CHAT-FIRST (verdict owner 03/08, proto v3 validé) : la page n'a que deux
// éléments — l'en-tête du motif (le poids total, référentiel 1 de l'échelle d'enjeu) et la
// conversation. L'ouverture est DÉTERMINISTE (provider partagé api/insight/dispositif) ; les
// tours passent par le mode enquête de /api/insight/prompt (body.dispositif — discipline +
// porte chiffrée côté serveur) ; la fiche arrive en tour de chat et sauve par les chemins
// réels (/api/best-practices origin structural_<classe>, MSCommitForm, PATCH replay).
// Le calcul d'engagement (« 4 pics × X € ») est DÉTERMINISTE ici — jamais par le modèle.
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { Show } from "@clerk/astro/components";

const locParam = Astro.url.searchParams.get("location_id") || "";
const classParam = Astro.url.searchParams.get("class") || "";
---

<Show when="signed-out" client:load>
  <meta http-equiv="refresh" content="0; url=/sign-in" />
</Show>

<Show when="signed-in" client:load>
  <BaseLayout title="Reproduire le dispositif gagnant — Muse Square" hideSurveyCta={true} hideFooter={true}>
    <div id="dispo-root" data-loc={locParam} data-class={classParam}>
      <div id="dispo-toolbar"><a href="/app/insightevent/pulse" id="dispo-back">← Retour à Pulse</a></div>
      <div id="dispo-status">Chargement de vos données…</div>
      <div id="dispo-doc" style="display:none;"></div>
    </div>

    <style is:global>
      #dispo-root { max-width: 760px; margin: 0 auto; padding: 16px 16px 80px; font-family: system-ui, -apple-system, sans-serif; color: #111827; }
      #dispo-toolbar { margin-bottom: 14px; }
      #dispo-back { font-size: 14px; color: #6b7280; text-decoration: none; }
      #dispo-status { padding: 60px 0; text-align: center; color: #9ca3af; font-size: 14px; }
      .dp-card { background: var(--color-bg-card, #fff); border: 1px solid var(--color-border, rgba(0,0,0,0.08)); border-radius: 10px; margin-bottom: 12px; box-shadow: 0 1px 3px rgba(16,24,40,0.06); padding: 14px 16px; }
      .dp-pills { display: flex; gap: 5px; flex-wrap: wrap; margin-bottom: 6px; }
      .dp-chip { display: inline-flex; align-items: center; font-size: 12px; padding: 3px 9px; border-radius: 20px; background: #F3F4F6; color: #6b7280; white-space: nowrap; }
      .dp-what { font-size: 14px; font-weight: 600; line-height: 1.35; margin-bottom: 4px; }
      .dp-sub { font-size: 12px; color: #6B7280; line-height: 1.45; }
      .dp-amt { text-align: right; cursor: help; }
      .dp-amt-val { font-size: 16px; font-weight: 600; white-space: nowrap; }
      .dp-amt-sub { font-size: 10.5px; color: #9CA3AF; margin-top: 2px; text-decoration: underline dotted rgba(156,163,175,0.6); text-underline-offset: 2px; }
      .dp-hov { text-decoration: underline dotted rgba(156,163,175,0.8); text-underline-offset: 2px; cursor: help; }
      .dp-btn { display: inline-flex; align-items: center; gap: 5px; font-size: 13px; font-weight: 500; color: #1D3BB3; border: 1px solid #1D3BB3; border-radius: 10px; padding: 6px 12px; background: transparent; cursor: pointer; font-family: inherit; }
      .dp-btn[disabled] { opacity: 0.5; cursor: default; }
      .dp-field { margin: 8px 0; }
      .dp-field label { display: block; font-size: 10.5px; font-weight: 600; color: #6B7280; margin-bottom: 3px; text-transform: uppercase; letter-spacing: 0.05em; }
      .dp-field textarea { width: 100%; box-sizing: border-box; font-size: 12.5px; color: #111827; background: #fff; border: 1px solid rgba(0,0,0,0.12); border-radius: 8px; padding: 8px 10px; line-height: 1.45; font-family: inherit; }
      .dp-src { font-size: 10.5px; color: #9CA3AF; margin-top: 6px; }
      .dp-msg { border-radius: 10px; padding: 11px 13px; font-size: 13px; line-height: 1.55; margin: 10px 0; max-width: 92%; }
      .dp-msg.ia { background: #F8FAFC; border: 1px solid rgba(0,0,0,0.08); color: #374151; }
      .dp-msg.moi { background: #EEF2FF; color: #1D3BB3; margin-left: auto; }
      .dp-aside { font-size: 12px; color: #9CA3AF; line-height: 1.5; margin: 4px 0 10px 4px; max-width: 88%; }
      .dp-aside a { color: #6B7280; text-decoration: underline dotted; cursor: pointer; }
      .dp-chips { display: flex; gap: 8px; flex-wrap: wrap; margin: 12px 0 6px; }
      .dp-chips button { font-size: 12.5px; color: #1D3BB3; background: #fff; border: 1px dashed rgba(29,59,179,0.45); border-radius: 18px; padding: 7px 13px; cursor: pointer; font-family: inherit; text-align: left; line-height: 1.4; }
      .dp-inputbar { display: flex; gap: 8px; align-items: center; background: #fff; border: 1px solid rgba(0,0,0,0.1); border-radius: 12px; padding: 8px 10px; margin-top: 12px; }
      .dp-inputbar input { flex: 1; border: none; outline: none; font-size: 13px; font-family: inherit; color: #111827; background: transparent; }
      .dp-fiche { border: 1px solid rgba(29,59,179,0.25); border-radius: 10px; padding: 10px 12px; margin-top: 10px; background: #fff; }
    </style>

    <script is:inline src="/commit-form.js?v=11"></script>
    <script is:inline>
      (function () {
        var root = document.getElementById("dispo-root");
        var statusEl = document.getElementById("dispo-status");
        var docEl = document.getElementById("dispo-doc");
        var loc = root.getAttribute("data-loc") || "";
        var cls = root.getAttribute("data-class") || "traffic_high";
        function esc(s) { return String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;"); }
        function frInt(n) { return Math.abs(Math.round(Number(n) || 0)).toLocaleString("fr-FR"); }
        function frDate(iso) { var d = String(iso || "").slice(0, 10); return d ? d.slice(8, 10) + "/" + d.slice(5, 7) : ""; }

        if (!loc) { statusEl.textContent = "Lieu manquant — ouvrez cette page depuis une carte."; return; }

        fetch("/api/insight/dispositif?location_id=" + encodeURIComponent(loc) + "&class=" + encodeURIComponent(cls), { cache: "no-store" })
          .then(function (r) { return r.json(); })
          .then(function (j) {
            if (!j || !j.ok) { statusEl.textContent = "Erreur : " + esc((j && j.error) || "réessayez."); return; }
            if (!j.found) { statusEl.textContent = esc(j.reason || "Pas encore disponible pour ce motif."); return; }
            render(j);
          })
          .catch(function () { statusEl.textContent = "Erreur de chargement — réessayez."; });

        function render(j) {
          var nar = j.narrative || {};
          var imp = j.impact || null;
          var ex = j.unexplained_days || [];
          var pos = imp && Number(imp.eur_year) > 0;
          var medDay = imp && imp.avg_gap_eur != null && isFinite(Number(imp.avg_gap_eur)) ? Math.round(Number(imp.avg_gap_eur)) : null;
          var medStr = medDay != null ? ((medDay >= 0 ? "+" : "−") + frInt(medDay) + " €") : null;
          var html = "";

          // ── En-tête motif (référentiel 1 : le poids TOTAL) ──
          html += '<div class="dp-card">'
            + '<div class="dp-pills"><span class="dp-chip" style="background:#EEF2FF;color:#1D3BB3;">Structurel</span><span class="dp-chip">Affluence</span></div>'
            + '<div style="display:flex;align-items:flex-start;gap:12px;">'
              + '<div style="flex:1;min-width:0;">'
                + '<div class="dp-what">Reproduire le dispositif gagnant — vos jours de pointe</div>'
                + '<div class="dp-sub">De « pourquoi ces journées marchent » à « comment les déclencher ».</div>'
              + '</div>'
              + (imp ? '<div class="dp-amt" title="' + esc('Mesuré sur ' + imp.n_days + ' j / ' + imp.span_months + ' mois — ' + (imp.tier_label_fr || '')) + '">'
                  + '<div class="dp-amt-val" style="color:' + (pos ? '#059669' : '#B45309') + ';">' + (pos ? '+' : '−') + frInt(imp.eur_year) + ' €/an</div>'
                  + '<div class="dp-amt-sub">' + (pos ? 'à gagner' : 'perdus') + ' · jours de pointe</div></div>' : '')
            + '</div></div>';

          // ── La conversation (verdict 03/08 : elle EST l'interface) ──
          html += '<div class="dp-card"><div id="dp-chat"></div>'
            + '<div class="dp-chips" id="dp-chips">'
              + '<button type="button" data-chip="1">« Voici ce qu’on fait ces jours-là… »</button>'
              + '<button type="button" data-chip="2">Rien de particulier — on subit plus qu’on ne prépare.</button>'
            + '</div>'
            + '<div class="dp-inputbar"><input id="dp-input" placeholder="Écrivez votre réponse…" autocomplete="off">'
            + '<button type="button" id="dp-send" class="dp-btn">Envoyer</button></div></div>';

          docEl.innerHTML = html;
          statusEl.style.display = "none";
          docEl.style.display = "block";

          var chat = document.getElementById("dp-chat");
          var input = document.getElementById("dp-input");
          var sendBtn = document.getElementById("dp-send");
          var chips = document.getElementById("dp-chips");
          var hist = [];
          var pending = false;
          var savedPracticeId = null;
          var ficheN = 0;

          function addEl(cssClass, innerHtml) {
            var d = document.createElement("div");
            d.className = cssClass;
            d.innerHTML = innerHtml;
            chat.appendChild(d);
            d.scrollIntoView({ behavior: "smooth", block: "nearest" });
            return d;
          }

          // ── Ouverture DÉTERMINISTE (message de référence validé 03/08 — spec atelier
          // § Hiérarchie de l'enquête). Le survol porte la méthode ; le texte, le job. ──
          var hovPred = 'Chaleur ' + nar.pct_heat + ' %, vacances ' + nar.pct_vacances + ' %, week-end ' + nar.pct_weekend + ' % de ces jours — co-occurrences mesurées sur vos données, pas des causes prouvées.';
          var openHtml = (imp ? 'Vos jours de pointe valent <strong>' + (pos ? '+' : '−') + frInt(imp.eur_year) + ' €/an</strong>, et ' : '')
            + nar.n_env + ' de vos ' + nar.n_days + ' jours de pointe sont <span class="dp-hov" title="' + esc(hovPred) + '">prévisibles</span> — ils arrivent avec la chaleur, les vacances ou le week-end.<br><br>'
            + 'La question qui compte : <strong>qu’est-ce qui fait réussir une journée de pointe chez vous — et est-ce écrit, pour que l’équipe le rejoue à chaque pic annoncé ?</strong><br>'
            + 'Si c’est dans votre tête, ça dépend de vous ; documenté, ça devient un dispositif.'
            + '<div class="dp-src">Vérifié · vos ' + nar.n_days + ' jours de pointe mesurés</div>';
          var openPlain = (imp ? 'Vos jours de pointe valent ' + (pos ? '+' : '-') + frInt(imp.eur_year) + ' €/an, et ' : '')
            + nar.n_env + ' de vos ' + nar.n_days + ' jours de pointe sont prévisibles — ils arrivent avec la chaleur, les vacances ou le week-end. '
            + 'La question qui compte : qu’est-ce qui fait réussir une journée de pointe chez vous — et est-ce écrit, pour que l’équipe le rejoue à chaque pic annoncé ? '
            + 'Si c’est dans votre tête, ça dépend de vous ; documenté, ça devient un dispositif.';
          addEl("dp-msg ia", openHtml);
          hist.push({ role: "assistant", content: openPlain });

          // ── Continuité : un dispositif déjà documenté sur ce motif s'affiche en ouverture —
          // l'enquête repart de lui (règle 9 côté serveur), jamais de re-documentation. ──
          var exd = j.existing_dispositifs || [];
          if (exd.length) {
            var d0 = exd[0];
            var exLine = 'Déjà documenté chez vous : « ' + d0.practice_text + ' » — '
              + (d0.in_test ? 'test en cours, suivi sur Pulse.' : (d0.tier === 'prouvee' ? 'prouvé au rejeu.' : 'déclaré, pas encore testé.'))
              + (exd.length > 1 ? ' (+' + (exd.length - 1) + ' autre' + (exd.length > 2 ? 's' : '') + ')' : '');
            addEl("dp-msg ia", esc(exLine));
            hist.push({ role: "assistant", content: exLine });
          }

          // ── Note de marge (porte de matérialité : poids faible → note, pas question) ──
          if (ex.length) {
            var exBits = ex.map(function (d) {
              var tip = [];
              if (d.hour_min != null && d.hour_max != null) tip.push('Ventes de ' + d.hour_min + ' h à ' + d.hour_max + ' h (' + frInt(d.tickets) + ' tickets) — pas de fermeture anticipée.');
              if (d.top_categories && d.top_categories.length) tip.push('Mix produits habituel (' + d.top_categories.map(function (c) { return c.category + ' ' + c.pct + ' %'; }).join(', ') + ').');
              return '<span class="dp-hov" title="' + esc(tip.join(' ') || 'Vérifications internes indisponibles ce jour-là.') + '">' + esc(d.dow_fr.slice(0, 3) + ' ' + frDate(d.date)) + '</span>';
            }).join(", ");
            addEl("dp-aside", 'En marge : ' + (ex.length === 1 ? 'une journée de pointe' : ex.length + ' journées de pointe') + ' sans facteur connu — ' + exBits
              + '. Poids faible, possiblement la variation ordinaire. Un souvenir ? <a id="dp-note">Notez-le</a> · sinon, laissez.');
            var noteLink = document.getElementById("dp-note");
            if (noteLink) noteLink.addEventListener("click", function () {
              input.value = "Le " + frDate(ex[0].date) + ", ";
              input.focus();
            });
          }

          // ── Envoi d'un tour vers le mode enquête ──
          function send(text) {
            var q = String(text == null ? input.value : text).trim();
            if (!q || pending) return;
            pending = true;
            input.value = "";
            input.disabled = true;
            sendBtn.disabled = true;
            if (chips) chips.style.display = "none";
            addEl("dp-msg moi", esc(q));
            var typing = addEl("dp-msg ia", '<span style="color:#9CA3AF;">…</span>');
            var histBefore = hist.slice(-12);
            hist.push({ role: "user", content: q });
            fetch("/api/insight/prompt", {
              method: "POST", headers: { "content-type": "application/json" },
              body: JSON.stringify({
                q: q,
                stream: false,
                dispositif: { class_key: cls, location_id: loc },
                conversation_history: histBefore,
                thread_context: { location_id: loc },
              }),
            }).then(function (r) { return r.json(); }).then(function (j2) {
              typing.remove();
              if (!j2 || !j2.ok || !j2.enquete || !j2.enquete.say_fr) {
                hist.pop();
                addEl("dp-msg ia", 'Erreur : ' + esc((j2 && j2.error) || 'réessayez') + '.');
                return;
              }
              var say = String(j2.enquete.say_fr);
              addEl("dp-msg ia", esc(say).replace(/\n/g, "<br>"));
              var f = j2.enquete.fiche || null;
              hist.push({ role: "assistant", content: say + (f ? "\n[Fiche proposée] " + f.fact_fr + " — Preuves : " + f.evidence_fr + " — Test : " + f.test_fr : "") });
              if (f) renderFiche(f);
            }).catch(function () {
              typing.remove();
              hist.pop();
              addEl("dp-msg ia", "Erreur réseau — réessayez.");
            }).finally(function () {
              pending = false;
              input.disabled = false;
              sendBtn.disabled = false;
              input.focus();
            });
          }
          sendBtn.addEventListener("click", function () { send(); });
          input.addEventListener("keydown", function (e) { if (e.key === "Enter") send(); });
          if (chips) chips.addEventListener("click", function (e) {
            var b = e.target && e.target.closest ? e.target.closest("button[data-chip]") : null;
            if (!b) return;
            if (b.getAttribute("data-chip") === "1") { input.value = "Voici ce qu’on fait ces jours-là : "; input.focus(); }
            else send("Rien de particulier — on subit plus qu’on ne prépare.");
          });

          // ── La fiche : un tour de chat. Champs éditables en place, Enregistrer = le POST réel. ──
          function renderFiche(f) {
            ficheN += 1;
            var n = ficheN;
            var fh = '<div class="dp-fiche">'
              + '<div class="dp-field"><label>Ce que vous faites</label><textarea id="dp-fact-' + n + '" rows="2">' + esc(f.fact_fr) + '</textarea></div>'
              + '<div class="dp-field"><label>Les jours qui le montrent</label><textarea id="dp-evid-' + n + '" rows="2">' + esc(f.evidence_fr) + '</textarea></div>'
              + '<div class="dp-field"><label>Comment on saura que ça marche</label><textarea id="dp-test-' + n + '" rows="2">' + esc(f.test_fr) + '</textarea></div>'
              + '<div style="display:flex;align-items:center;gap:8px;margin-top:6px;">'
                + '<span class="dp-src" style="margin-top:0;">Modifiez directement, puis enregistrez.</span>'
                + '<span style="margin-left:auto;"><button type="button" id="dp-save-' + n + '" class="dp-btn">On l’enregistre</button></span>'
              + '</div><div id="dp-save-msg-' + n + '" class="dp-src" style="display:none;"></div>'
              + '</div>';
            addEl("dp-msg ia", 'Je résume — relisez, corrigez :' + fh);
            var saveBtn = document.getElementById("dp-save-" + n);
            saveBtn.addEventListener("click", function () {
              var fact = String((document.getElementById("dp-fact-" + n) || {}).value || "").trim();
              var evid = String((document.getElementById("dp-evid-" + n) || {}).value || "").trim();
              var test = String((document.getElementById("dp-test-" + n) || {}).value || "").trim();
              var msg = document.getElementById("dp-save-msg-" + n);
              if (!fact) { msg.style.display = "block"; msg.style.color = "#B91C1C"; msg.textContent = "Décrivez d’abord ce que vous faites."; return; }
              saveBtn.disabled = true;
              fetch("/api/best-practices", {
                method: "POST", headers: { "content-type": "application/json" },
                body: JSON.stringify({
                  location_id: loc,
                  practice_text: fact,
                  evidence_refs: evid || null,
                  confirmation_test: test || null,
                  origin: { origin_action_type: "structural_" + cls, day_class_key: cls },
                }),
              }).then(function (r) { return r.json(); }).then(function (jj) {
                msg.style.display = "block";
                if (jj && jj.ok) {
                  savedPracticeId = jj.practice_id || null;
                  msg.style.color = "#166534";
                  msg.textContent = "Enregistré dans vos bonnes pratiques — au tier déclaré.";
                  renderCommitTurn(test);
                } else { msg.style.color = "#B91C1C"; msg.textContent = "Erreur : " + ((jj && jj.error) || "réessayez") + "."; saveBtn.disabled = false; }
              }).catch(function () { msg.style.display = "block"; msg.style.color = "#B91C1C"; msg.textContent = "Erreur réseau — réessayez."; saveBtn.disabled = false; });
            });
          }

          // ── Après enregistrement : référentiels 2 et 3 de l'échelle d'enjeu (déterministes —
          // la multiplication est celle de l'exploitant, jamais une promesse) + M'engager réel. ──
          function renderCommitTurn(testText) {
            var n = ficheN;
            var enj = medStr
              ? 'Une journée déclenchée vaut <strong>' + medStr + '</strong> <span class="dp-hov" title="' + esc('Médiane mesurée de vos ' + (imp ? imp.n_days : '') + ' jours de pointe vs votre normale (' + (imp ? imp.tier_label_fr || '' : '') + '). Le poids total du motif n’est pas la promesse de ce dispositif — il n’en explique qu’une part, le test dira laquelle.') + '">(médiane mesurée)</span>. '
                + 'Le rythme est votre levier : 4 pics déclenchés dans le mois ≈ <strong>' + (medDay >= 0 ? '+' : '−') + frInt(4 * medDay) + ' €</strong> — c’est votre multiplication, pas une promesse.<br><br>'
              : '';
            var el = addEl("dp-msg ia", enj + 'Prêt à l’engager sur le test ?'
              + '<div style="display:flex;gap:8px;margin-top:10px;"><span style="margin-left:auto;"><button type="button" id="dp-commit-' + n + '" class="dp-btn">M’engager sur le test</button></span></div>'
              + '<div id="dp-commit-ws-' + n + '" style="display:none;margin-top:10px;border-top:1px solid #F3F4F6;padding-top:10px;"></div>');
            var commitBtn = document.getElementById("dp-commit-" + n);
            commitBtn.addEventListener("click", function () {
              var ws = document.getElementById("dp-commit-ws-" + n);
              if (!ws) return;
              if (ws.style.display === "block") { ws.style.display = "none"; ws.innerHTML = ""; return; }
              if (!window.MSCommitForm) { ws.style.display = "block"; ws.innerHTML = '<div class="dp-sub" style="color:#B91C1C;">Formulaire indisponible — rechargez la page.</div>'; return; }
              ws.style.display = "block";
              ws.innerHTML = window.MSCommitForm.buildHtml({ suggestions: testText ? [testText] : [] });
              window.MSCommitForm.wire(ws, {
                location_id: loc,
                origin: {
                  origin_action_type: "structural_" + cls,
                  origin_driver: null,
                  origin_suppression_key: "structural:" + cls + ":" + loc,
                  origin_card_instance_id: null,
                  origin_affected_date: null,
                  creation_residual_pct: null,
                  creation_residual_z: null,
                  creation_confidence_tier: null,
                  creation_baseline_daily: null
                },
                onDone: function (jd) {
                  var okd = jd && jd.ok;
                  if (okd && jd.commitment_id && savedPracticeId) {
                    fetch("/api/best-practices", {
                      method: "PATCH", headers: { "content-type": "application/json" },
                      body: JSON.stringify({ practice_id: savedPracticeId, location_id: loc, replay_commitment_id: jd.commitment_id })
                    }).catch(function () {});
                  }
                  ws.innerHTML = '<div class="dp-sub" style="color:' + (okd ? "#166534" : "#B91C1C") + ';">'
                    + (okd
                      ? "Engagement créé et lié au dispositif — il passera à « prouvé » si le test tient (verdict au bilan, mesuré sur vos ventes réelles). Direction Pulse, où votre test est suivi…"
                      : "Erreur : " + esc((jd && jd.error) || "réessayez") + ".")
                    + "</div>";
                  el.scrollIntoView({ behavior: "smooth", block: "nearest" });
                  if (okd) setTimeout(function () { window.location.href = "/app/insightevent/pulse"; }, 2000);
                },
                onCancel: function () { ws.style.display = "none"; ws.innerHTML = ""; }
              });
            });
          }

          input.focus();
        }
      })();
    </script>
  </BaseLayout>
</Show>
