---
// « Reproduire le dispositif gagnant » — l'atterrissage du CTA d'identification des cartes
// structurelles (doctrine 01/08, amendement 7 ; spec docs/atelier-mecanismes-spec.md ; proto
// approuvé public/atelier-dispositif-proto.html). Étape 1 servie par le provider partagé
// (api/insight/dispositif) ; étape 2 POSTe l'objet dispositif réel (/api/best-practices,
// pièce 1) ; le mode enquête LLM est la pièce suivante — la page montre déjà les vérifications
// internes DÉTERMINISTES (amplitude horaire, mix produits) calculées par le provider.
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { Show } from "@clerk/astro/components";

const locParam = Astro.url.searchParams.get("location_id") || "";
const classParam = Astro.url.searchParams.get("class") || "";
---

<Show when="signed-out" client:load>
  <meta http-equiv="refresh" content="0; url=/sign-in" />
</Show>

<Show when="signed-in" client:load>
  <BaseLayout title="Reproduire le dispositif gagnant — Muse Square" hideSurveyCta={true} hideFooter={true}>
    <div id="dispo-root" data-loc={locParam} data-class={classParam}>
      <div id="dispo-toolbar"><a href="/app/insightevent/pulse" id="dispo-back">← Retour à Pulse</a></div>
      <div id="dispo-status">Chargement de vos données…</div>
      <div id="dispo-doc" style="display:none;"></div>
    </div>

    <style is:global>
      #dispo-root { max-width: 760px; margin: 0 auto; padding: 16px 16px 80px; font-family: system-ui, -apple-system, sans-serif; color: #111827; }
      #dispo-toolbar { margin-bottom: 14px; }
      #dispo-back { font-size: 14px; color: #6b7280; text-decoration: none; }
      #dispo-status { padding: 60px 0; text-align: center; color: #9ca3af; font-size: 14px; }
      .dp-card { background: var(--color-bg-card, #fff); border: 1px solid var(--color-border, rgba(0,0,0,0.08)); border-radius: 10px; margin-bottom: 12px; box-shadow: 0 1px 3px rgba(16,24,40,0.06); padding: 14px 16px; }
      .dp-pills { display: flex; gap: 5px; flex-wrap: wrap; margin-bottom: 6px; }
      .dp-chip { display: inline-flex; align-items: center; font-size: 12px; padding: 3px 9px; border-radius: 20px; background: #F3F4F6; color: #6b7280; white-space: nowrap; }
      .dp-what { font-size: 14px; font-weight: 600; line-height: 1.35; margin-bottom: 4px; }
      .dp-sub { font-size: 12px; color: #6B7280; line-height: 1.45; }
      .dp-amt { text-align: right; cursor: help; }
      .dp-amt-val { font-size: 16px; font-weight: 600; white-space: nowrap; }
      .dp-amt-sub { font-size: 10.5px; color: #9CA3AF; margin-top: 2px; text-decoration: underline dotted rgba(156,163,175,0.6); text-underline-offset: 2px; }
      .dp-eb { font-size: 11px; letter-spacing: 0.07em; text-transform: uppercase; color: rgba(17,24,39,0.45); font-weight: 500; margin: 18px 0 8px; }
      .dp-hov { text-decoration: underline dotted rgba(156,163,175,0.8); text-underline-offset: 2px; cursor: help; }
      .dp-step { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; }
      .dp-step .n { width: 18px; height: 18px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 700; }
      .dp-step.on { color: #1D3BB3; } .dp-step.on .n { background: #EEF2FF; color: #1D3BB3; }
      .dp-step.off { color: #9ca3af; } .dp-step.off .n { background: #F3F4F6; color: #6b7280; }
      .dp-rail { display: flex; align-items: center; gap: 8px; margin: 14px 0 16px; }
      .dp-rail .sep { flex: 1; height: 1px; background: #F3F4F6; }
      .dp-table { border-collapse: collapse; width: 100%; font-size: 12px; }
      .dp-table th { text-align: left; font-size: 10.5px; letter-spacing: 0.05em; text-transform: uppercase; color: #9CA3AF; font-weight: 500; padding: 6px 8px; border-bottom: 1px solid rgba(0,0,0,0.08); }
      .dp-table td { padding: 6px 8px; border-bottom: 1px solid #F3F4F6; color: #374151; }
      .dp-btn { display: inline-flex; align-items: center; gap: 5px; font-size: 13px; font-weight: 500; color: #1D3BB3; border: 1px solid #1D3BB3; border-radius: 10px; padding: 6px 12px; background: transparent; cursor: pointer; font-family: inherit; }
      .dp-field { margin: 10px 0; }
      .dp-field label { display: block; font-size: 11px; font-weight: 600; color: #6B7280; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.05em; }
      .dp-field textarea, .dp-field input { width: 100%; box-sizing: border-box; font-size: 12.5px; color: #111827; background: #fff; border: 1px solid rgba(0,0,0,0.12); border-radius: 8px; padding: 8px 10px; line-height: 1.45; font-family: inherit; }
      .dp-src { font-size: 10.5px; color: #9CA3AF; margin-top: 4px; }
      details.dp-days summary { font-size: 12px; font-weight: 600; color: #1D3BB3; cursor: pointer; padding: 4px 0; }
    </style>

    <script is:inline src="/commit-form.js?v=11"></script>
    <script is:inline>
      (function () {
        var root = document.getElementById("dispo-root");
        var statusEl = document.getElementById("dispo-status");
        var docEl = document.getElementById("dispo-doc");
        var loc = root.getAttribute("data-loc") || "";
        var cls = root.getAttribute("data-class") || "traffic_high";
        function esc(s) { return String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;"); }
        function frInt(n) { return Math.abs(Math.round(Number(n) || 0)).toLocaleString("fr-FR"); }
        function frDate(iso) { var d = String(iso || "").slice(0, 10); return d ? d.slice(8, 10) + "/" + d.slice(5, 7) : ""; }

        if (!loc) { statusEl.textContent = "Lieu manquant — ouvrez cette page depuis une carte."; return; }

        fetch("/api/insight/dispositif?location_id=" + encodeURIComponent(loc) + "&class=" + encodeURIComponent(cls), { cache: "no-store" })
          .then(function (r) { return r.json(); })
          .then(function (j) {
            if (!j || !j.ok) { statusEl.textContent = "Erreur : " + esc((j && j.error) || "réessayez."); return; }
            if (!j.found) { statusEl.textContent = esc(j.reason || "Pas encore disponible pour ce motif."); return; }
            render(j);
          })
          .catch(function () { statusEl.textContent = "Erreur de chargement — réessayez."; });

        function render(j) {
          var nar = j.narrative || {};
          var imp = j.impact || null;
          var ex = j.unexplained_days || [];
          var pos = imp && Number(imp.eur_year) > 0;
          var html = "";

          // ── En-tête motif ──
          html += '<div class="dp-card">'
            + '<div class="dp-pills"><span class="dp-chip" style="background:#EEF2FF;color:#1D3BB3;">Structurel</span><span class="dp-chip">Affluence</span></div>'
            + '<div style="display:flex;align-items:flex-start;gap:12px;">'
              + '<div style="flex:1;min-width:0;">'
                + '<div class="dp-what">Reproduire le dispositif gagnant — vos jours de pointe</div>'
                + '<div class="dp-sub">De « pourquoi ces journées marchent » à « comment les déclencher ».</div>'
              + '</div>'
              + (imp ? '<div class="dp-amt" title="' + esc('Mesuré sur ' + imp.n_days + ' j / ' + imp.span_months + ' mois — ' + (imp.tier_label_fr || '')) + '">'
                  + '<div class="dp-amt-val" style="color:' + (pos ? '#059669' : '#B45309') + ';">' + (pos ? '+' : '−') + frInt(imp.eur_year) + ' €/an</div>'
                  + '<div class="dp-amt-sub">' + (pos ? 'à gagner' : 'perdus') + ' · jours de pointe</div></div>' : '')
            + '</div></div>';

          // ── PAGE RESSERRÉE (owner 02/08 : « too many ideas — le job d'abord »). Trois blocs
          // en langue d'exploitant : le fait, votre explication, testez-la. La MÉTHODE (tiers,
          // co-occurrences, doctrine des €, retombées) vit en INFOBULLE, jamais en texte
          // courant. Rail 1-2-3 et table des 40 jours retirés ; le champ « preuves » devient
          // invisible (backend, pré-rempli — il part dans la fiche, il ne se lit pas ici).
          var medDay = imp && imp.avg_gap_eur != null && isFinite(Number(imp.avg_gap_eur)) ? Math.round(Number(imp.avg_gap_eur)) : null;
          var medStr = medDay != null ? ((medDay >= 0 ? "+" : "−") + frInt(medDay) + " €") : null;
          var defaultEvidence = ex.length
            ? ex.map(function (d) { return d.dow_fr + " " + frDate(d.date) + " — " + frInt(d.visitors) + " visiteurs sans chaleur, vacances ni week-end"; }).join(" ; ")
            : "";

          // ── 1. Le fait ──
          html += '<div class="dp-eb">Ce que vos données disent</div><div class="dp-card">'
            + '<div style="font-size:13.5px;font-weight:600;line-height:1.5;">'
              + '<span class="dp-hov" title="' + esc(nar.pct_heat + ' % de ces jours sont des jours de chaleur, ' + nar.pct_vacances + ' % des vacances scolaires, ' + nar.pct_weekend + ' % des week-ends — co-occurrences mesurées sur vos données, pas des causes prouvées.') + '">'
              + nar.n_env + ' de vos ' + nar.n_days + ' jours de pointe arrivent avec la chaleur, les vacances ou le week-end.</span></div>';
          if (ex.length) {
            html += '<div style="font-size:13.5px;font-weight:600;color:#1D3BB3;line-height:1.5;margin-top:6px;">'
              + (ex.length === 1 ? 'Une journée ne s’explique pas :' : ex.length + ' journées ne s’expliquent pas :') + '</div>';
            ex.forEach(function (d) {
              var tip = [];
              if (d.hour_min != null && d.hour_max != null) tip.push('Ventes de ' + d.hour_min + ' h à ' + d.hour_max + ' h (' + frInt(d.tickets) + ' tickets) — pas de fermeture anticipée.');
              if (d.top_categories && d.top_categories.length) tip.push('Produits dans les proportions habituelles (' + d.top_categories.map(function (c) { return c.category + ' ' + c.pct + ' %'; }).join(', ') + ' — habituel : ' + (d.usual_top_categories || []).map(function (c) { return c.category + ' ' + c.pct + ' %'; }).join(', ') + ').');
              html += '<div style="margin-top:6px;font-size:12.5px;"><strong>' + esc(d.dow_fr + ' ' + frDate(d.date)) + '</strong> — ' + frInt(d.visitors) + ' visiteurs. '
                + (tip.length ? '<span class="dp-hov" title="' + esc(tip.join(' ')) + '">Journée normale par ailleurs — la cause est ailleurs.</span>' : '') + '</div>';
            });
          } else {
            html += '<div class="dp-sub" style="margin-top:6px;">Toutes vos journées de pointe arrivent avec un facteur connu — rien à expliquer aujourd’hui.</div>';
          }
          html += '</div>';

          // ── 2. Votre explication (la fiche — POST réel ; preuves invisibles, pré-remplies) ──
          html += '<div class="dp-eb">Votre explication</div><div class="dp-card">'
            + '<div class="dp-sub" style="margin-bottom:8px;">Que s’était-il passé ces jours-là ? C’est la pièce manquante — et '
              + (medStr ? 'une journée comme ça vaut <strong style="color:' + (medDay >= 0 ? '#059669' : '#B45309') + ';">' + medStr + '</strong> <span class="dp-hov" title="' + esc('Médiane de vos ' + (imp ? imp.n_days : '') + ' jours de pointe vs votre normale (' + (imp ? imp.tier_label_fr : '') + '). Une explication documentée est réutilisable, testable, et enrichit vos bonnes pratiques.') + '">chez vous</span>.' : 'une explication documentée devient réutilisable.') + '</div>'
            + '<div class="dp-field"><label>Ce que vous aviez fait ces jours-là</label><textarea id="dp-fact" rows="2" placeholder="Ex. : stand extérieur les jours de marché des producteurs"></textarea></div>'
            + '<div class="dp-field"><label>Comment on saura que ça marche</label><textarea id="dp-test" rows="2" placeholder="Ex. : les 3 prochains jours de marché avec stand sorti dépassent l’attendu du jour"></textarea></div>'
            + '<textarea id="dp-evid" style="display:none;">' + esc(defaultEvidence) + '</textarea>'
            + '<div style="display:flex;align-items:center;gap:8px;margin-top:8px;">'
              + '<span style="margin-left:auto;"><button type="button" id="dp-save" class="dp-btn">Enregistrer</button></span>'
            + '</div><div id="dp-save-msg" class="dp-src" style="display:none;"></div>'
          + '</div>';

          // ── 3. Testez-la ──
          html += '<div class="dp-eb">Testez-la</div><div class="dp-card">'
            + '<div style="display:flex;align-items:flex-start;gap:12px;">'
              + '<div style="flex:1;min-width:0;">'
                + '<div class="dp-sub">Engagez-vous sur le test : on mesure sur vos ventes réelles, le verdict tombe au bilan.</div>'
              + '</div>'
              + (medStr ? '<div class="dp-amt" title="' + esc('Médiane mesurée de vos jours de pointe vs votre normale. Le potentiel annuel est VOTRE calcul : le nombre de journées que vous visez × ' + medStr + '. Le poids total du motif (' + (imp ? (pos ? '+' : '−') + frInt(imp.eur_year) + ' €/an' : '') + ') n’est pas la promesse de ce dispositif — il n’en explique qu’une part, le test dira laquelle. Son €/an propre n’existera qu’au test prouvé, au rythme constaté.') + '">'
                + '<div class="dp-amt-val" style="color:' + (medDay >= 0 ? '#059669' : '#B45309') + ';">' + medStr + '</div>'
                + '<div class="dp-amt-sub">par journée déclenchée</div></div>' : '')
            + '</div>'
            + '<div style="display:flex;gap:8px;margin-top:10px;"><span style="margin-left:auto;"><button type="button" id="dp-commit" class="dp-btn">M’engager sur le test</button></span></div>'
            + '<div id="dp-commit-ws" style="display:none;margin-top:10px;border-top:1px solid #F3F4F6;padding-top:10px;"></div>'
          + '</div>';

          docEl.innerHTML = html;
          statusEl.style.display = "none";
          docEl.style.display = "block";

          var savedPracticeId = null;
          var saveBtn = document.getElementById("dp-save");
          if (saveBtn) saveBtn.addEventListener("click", function () {
            var fact = String((document.getElementById("dp-fact") || {}).value || "").trim();
            var evid = String((document.getElementById("dp-evid") || {}).value || "").trim();
            var test = String((document.getElementById("dp-test") || {}).value || "").trim();
            var msg = document.getElementById("dp-save-msg");
            if (!fact) { msg.style.display = "block"; msg.style.color = "#B91C1C"; msg.textContent = "Décrivez d’abord ce que vous aviez fait."; return; }
            saveBtn.disabled = true;
            fetch("/api/best-practices", {
              method: "POST", headers: { "content-type": "application/json" },
              body: JSON.stringify({
                location_id: loc,
                practice_text: fact,
                evidence_refs: evid || null,
                confirmation_test: test || null,
                origin: { origin_action_type: "structural_" + cls, day_class_key: cls },
              }),
            }).then(function (r) { return r.json(); }).then(function (jj) {
              msg.style.display = "block";
              if (jj && jj.ok) { savedPracticeId = jj.practice_id || null; msg.style.color = "#166534"; msg.textContent = "Dispositif enregistré — il sera proposé sur les signaux comparables, et le test le fera passer à « prouvé »."; }
              else { msg.style.color = "#B91C1C"; msg.textContent = "Erreur : " + ((jj && jj.error) || "réessayez") + "."; saveBtn.disabled = false; }
            }).catch(function () { msg.style.display = "block"; msg.style.color = "#B91C1C"; msg.textContent = "Erreur réseau — réessayez."; saveBtn.disabled = false; });
          });

          // Graduation : M'engager sur le test — le formulaire d'engagement RÉEL (roster
          // auto-alimenté par MSCommitForm), pré-rempli avec le test de la fiche, puis liaison
          // au dispositif enregistré (PATCH replay_commitment_id -> tier « prouvée » au 'met').
          var commitBtn = document.getElementById("dp-commit");
          if (commitBtn) commitBtn.addEventListener("click", function () {
            var ws = document.getElementById("dp-commit-ws");
            if (!ws) return;
            if (ws.style.display === "block") { ws.style.display = "none"; ws.innerHTML = ""; return; }
            if (!window.MSCommitForm) { ws.style.display = "block"; ws.innerHTML = '<div class="dp-sub" style="color:#B91C1C;">Formulaire indisponible — rechargez la page.</div>'; return; }
            var test = String((document.getElementById("dp-test") || {}).value || "").trim();
            ws.style.display = "block";
            ws.innerHTML = window.MSCommitForm.buildHtml({ suggestions: test ? [test] : [] });
            window.MSCommitForm.wire(ws, {
              location_id: loc,
              origin: {
                origin_action_type: "structural_" + cls,
                origin_driver: null,
                origin_suppression_key: "structural:" + cls + ":" + loc,
                origin_card_instance_id: null,
                origin_affected_date: null,
                creation_residual_pct: null,
                creation_residual_z: null,
                creation_confidence_tier: null,
                creation_baseline_daily: null
              },
              onDone: function (j) {
                var okd = j && j.ok;
                if (okd && j.commitment_id && savedPracticeId) {
                  fetch("/api/best-practices", {
                    method: "PATCH", headers: { "content-type": "application/json" },
                    body: JSON.stringify({ practice_id: savedPracticeId, location_id: loc, replay_commitment_id: j.commitment_id })
                  }).catch(function () {});
                }
                ws.innerHTML = '<div class="dp-sub" style="color:' + (okd ? "#166534" : "#B91C1C") + ';">'
                  + (okd
                    ? (savedPracticeId
                      ? "Engagement créé et lié au dispositif — il passera à « prouvé » si le test tient (verdict au bilan, mesuré sur vos ventes)."
                      : "Engagement créé. Enregistrez aussi la fiche (étape 2) pour lier le dispositif au test.")
                    : "Erreur : " + esc((j && j.error) || "réessayez") + ".")
                  + "</div>";
              },
              onCancel: function () { ws.style.display = "none"; ws.innerHTML = ""; }
            });
          });
        }
      })();
    </script>
  </BaseLayout>
</Show>
