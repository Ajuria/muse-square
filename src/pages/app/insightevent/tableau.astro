              var panel = body.querySelector('[data-tb-arm-panel="' + pi + '"]');
              if (!p2 || !panel) return;
              if (panel.style.display === "block") { panel.style.display = "none"; return; }
              var ctx = p2.arm_signal_ctx || {};
              panel.style.display = "block";
              var serieHref = b.getAttribute("data-tb-arm-serie") || "";
              panel.innerHTML = (serieHref
                  ? '<div class="tb-eb" style="margin-bottom:4px;">Comment automatiser ?</div>'
