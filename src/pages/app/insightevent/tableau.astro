              else if (k === "ops") { var opc = document.getElementById("tb-ops-sec"); if (opc) opc.scrollIntoView({ behavior: "smooth", block: "start" }); }
              else openVolet(k, true);
            });
          });
          body.querySelectorAll("[data-tb-period]").forEach(function (b) {
            b.addEventListener("click", function () { period = Number(b.getAttribute("data-tb-period")); render(); });
