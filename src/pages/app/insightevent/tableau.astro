                + '<div style="font-size:12.5px;line-height:1.6;"><span style="font-weight:600;">Chaleur annoncée demain (niveau ≥ 3)</span>'
                + (ctx.n_hot_30 != null ? " — " + ctx.n_hot_30 + " jour" + (ctx.n_hot_30 > 1 ? "s" : "") + " chauds sur vos 30 derniers" : "")
                + (ctx.next_hot ? " · prochain annoncé : " + dowFr(ctx.next_hot) + " " + frD(ctx.next_hot) : " · aucun annoncé dans l’horizon de prévision") + '</div>'
                + '<div style="font-size:11.5px;color:#6B7280;line-height:1.6;margin:6px 0;">Garde-fous : 1 déclenchement maximum par 7 jours · à chaque tir, la consigne part par email et un engagement mesuré s’arme (vos réglages du test) — chaque verdict s’ajoute au track record. La consigne ne convoque personne (achats, équipe déjà planifiée).</div>'
                + '<div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:8px 0;">'
                + '<input data-arm-name style="font-size:12.5px;font-family:inherit;border:1px solid rgba(0,0,0,0.12);border-radius:8px;padding:8px 10px;width:180px;" placeholder="Destinataire (nom)" value="' + esc(p2.arm_recipient_name || "") + '">'
                + '<input data-arm-mail style="font-size:12.5px;font-family:inherit;border:1px solid rgba(0,0,0,0.12);border-radius:8px;padding:8px 10px;width:220px;" placeholder="Email" value="' + esc(p2.arm_recipient_contact || "") + '">'
                + '<button type="button" data-arm-go style="font-size:13px;font-weight:500;color:#1D3BB3;border:1px solid #1D3BB3;border-radius:10px;padding:6px 12px;background:transparent;cursor:pointer;font-family:inherit;">Automatiser ce dispositif</button>'
                + '<span data-arm-msg style="font-size:12px;color:#B91C1C;"></span></div>';
              panel.querySelector("[data-arm-go]").addEventListener("click", function () {
                var nm = (panel.querySelector("[data-arm-name]").value || "").trim();
                var em = (panel.querySelector("[data-arm-mail]").value || "").trim();
                var msg = panel.querySelector("[data-arm-msg]");
                if (!em || em.indexOf("@") < 0) { msg.textContent = "Un email destinataire est requis."; return; }
                patchArm(p2, { enabled: true, recipient_name: nm || null, recipient_contact: em, channel: "email", cooldown_days: 7 }, function (ok, err) {
                  if (ok) load(); else msg.textContent = "Erreur : " + (err || "réessayez.");
