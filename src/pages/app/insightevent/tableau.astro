          // ── Armer sur signal — panneau chiffres réels + garde-fous (inchangé). ──
          function patchArm(p2, armBody, doneCb) {
            fetch("/api/best-practices", { method: "PATCH", headers: { "content-type": "application/json" }, body: JSON.stringify({ practice_id: p2.practice_id, location_id: p2.location_id, arm: armBody }) })
              .then(function (r) { return r.json(); })
              .then(function (res) { doneCb(res && res.ok, res && res.error); })
              .catch(function () { doneCb(false, "réseau"); });
