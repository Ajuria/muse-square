              });
            } else if ((g.offres_base || {}).n_tarifs) {
              html += '<div><span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:' + GREEN + ';margin-right:6px;"></span><span style="font-weight:600;">Leurs offres et tarifs : rien n’a bougé</span> — ' + g.offres_base.n_tarifs + ' tarifs comparés à chaque passage (' + g.offres_base.n_lieux + ' lieux publient leurs prix)</div>';
            }
          } else html += '<div style="color:#9CA3AF;">Aucun concurrent suivi — suivez vos menaces fortes pour que la veille tourne.</div>';
          html += '<div style="font-size:11px;color:#9CA3AF;margin-top:4px;">Une menace « forte » : public commun élevé et proximité. La veille passe chaque nuit sur les sites de vos concurrents suivis.</div>';
          // Automatisations (reçu / programmé / à activer — contenu inchangé).
          html += (done.length ? '<div style="height:1px;background:rgba(0,0,0,0.08);margin:8px 0;"></div><p class="tb-eb" style="margin:2px 0 2px;">Reçu</p>' + done.map(function (l) { return "<div>" + l + "</div>"; }).join("") : "")
            + (planned.length ? '<p class="tb-eb" style="margin:' + (done.length ? "8px" : "2px") + ' 0 2px;">Programmé</p>' + planned.map(function (l) { return "<div>" + l + "</div>"; }).join("") : "")
            + (toActivate.length ? '<div style="height:1px;background:rgba(0,0,0,0.08);margin:8px 0;"></div><p class="tb-eb" style="margin-bottom:4px;">À activer</p>' + toActivate.map(function (l) { return "<div>" + l + "</div>"; }).join("") : "")
            + '</div></div>';

          body.innerHTML = html;

          // ── Écouteurs ──
          Object.keys(openVolets).forEach(function (k) {
            if (!openVolets[k]) return;
            var v = body.querySelector('[data-tb-body="' + k + '"]');
            if (v) v.style.display = "block";
            var btn = body.querySelector('[data-tb-volet="' + k + '"]');
            if (btn) btn.setAttribute("aria-expanded", "true");
          });
          body.querySelectorAll("[data-tb-period]").forEach(function (b) {
            b.addEventListener("click", function () { period = Number(b.getAttribute("data-tb-period")); render(); });
          });
          var mg = document.getElementById("tb-mg");
          if (mg) mg.addEventListener("click", function () { var l = document.getElementById("tb-mg-list"); l.style.display = l.style.display === "none" ? "block" : "none"; });
          body.querySelectorAll("[data-tb-volet]").forEach(function (b) {
            b.addEventListener("click", function () {
              var k = b.getAttribute("data-tb-volet");
              var v = body.querySelector('[data-tb-body="' + k + '"]');
              if (!v) return;
              var opened = v.style.display === "none";
              v.style.display = opened ? "block" : "none";
              openVolets[k] = opened;
              b.setAttribute("aria-expanded", opened ? "true" : "false");
            });
          });
          body.querySelectorAll("[data-tb-open]").forEach(function (a) {
            a.addEventListener("click", function () {
              var v = body.querySelector('[data-tb-body="' + a.getAttribute("data-tb-open") + '"]');
              if (v) { v.style.display = "block"; openVolets[a.getAttribute("data-tb-open")] = true; }
              var btn = body.querySelector('[data-tb-volet="' + a.getAttribute("data-tb-open") + '"]');
              if (btn) btn.setAttribute("aria-expanded", "true");
            });
          });
          body.querySelectorAll("[data-tb-lect]").forEach(function (b) {
            b.addEventListener("click", function () { var l = document.getElementById("tb-lecture"); if (l) l.style.display = l.style.display === "none" || !l.style.display ? "block" : "none"; });
          });
          body.querySelectorAll("[data-tb-fold]").forEach(function (b) {
            b.addEventListener("click", function () { var l = document.getElementById(b.getAttribute("data-tb-fold")); if (l) l.style.display = l.style.display === "none" || !l.style.display ? "block" : "none"; });
          });
          // M'engager sur un apprentissage : MÊME machinerie que les chantiers structurels de
          // Pulse (origin structural_<class_key> + clé de suppression) — jamais un chemin parallèle.
          body.querySelectorAll("[data-tb-engage]").forEach(function (b) {
            b.addEventListener("click", function (ev) {
              ev.preventDefault();
              var li = Number(b.getAttribute("data-tb-engage"));
              var r = (window._tbLearnings || [])[li];
              var panel = body.querySelector('[data-tb-engage-panel="' + li + '"]');
              if (!r || !panel) return;
              if (panel.style.display === "block") { panel.style.display = "none"; panel.innerHTML = ""; return; }
              panel.style.display = "block";
              if (!window.MSCommitForm) { panel.innerHTML = '<div style="font-size:12.5px;color:#B91C1C;">Formulaire indisponible — rechargez la page.</div>'; return; }
              panel.innerHTML = '<p class="tb-eb" style="margin-bottom:8px;">M’engager — ' + esc(r.label_fr) + (r.site_label ? " · " + esc(r.site_label) : "") + '</p><div data-eng-form></div>';
              var host = panel.querySelector("[data-eng-form]");
              host.innerHTML = window.MSCommitForm.buildHtml({});
              window.MSCommitForm.wire(host, {
                location_id: r.location_id,
                origin: {
                  origin_action_type: "structural_" + r.class_key,
                  origin_driver: null,
                  origin_suppression_key: "structural:" + r.class_key + ":" + r.location_id,
                  origin_card_instance_id: null,
                  origin_affected_date: null,
                  creation_residual_pct: null,
                  creation_residual_z: null,
                  creation_confidence_tier: null,
                  creation_baseline_daily: null,
                },
                onDone: function (jd) { if (jd && jd.ok) load(); },
                onCancel: function () { panel.style.display = "none"; panel.innerHTML = ""; },
              });
            });
          });

          // « Prouver » : POST /api/commitments (test 7 j, seuil +10 %) puis PATCH
          // /api/best-practices (replay_commitment_id) — inchangé, puis re-fetch (état serveur).
          body.querySelectorAll("[data-tb-replay]").forEach(function (b) {
            b.addEventListener("click", function (ev) {
              ev.preventDefault();
              var pid = b.getAttribute("data-tb-replay");
              var pr2 = (window._tbPractices || []).filter(function (x) { return x.practice_id === pid; })[0];
              if (!pr2) return;
              b.textContent = "Test…";
              fetch("/api/commitments", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({
                location_id: pr2.location_id, origin_action_type: pr2.origin_action_type,
                window_kind: "7d", threshold_basis: "pct", threshold_pct: 10,
                committed_action_text: "Test du dispositif : " + String(pr2.text || "").slice(0, 180),
                owner_person_name: pr2.author || "—",
              }) })
                .then(function (r) { return r.json(); })
                .then(function (c) {
                  if (!c || !c.ok || !c.commitment_id) throw new Error((c && c.error) || "Erreur");
                  return fetch("/api/best-practices", { method: "PATCH", headers: { "content-type": "application/json" }, body: JSON.stringify({ practice_id: pid, location_id: pr2.location_id, replay_commitment_id: c.commitment_id }) }).then(function (r) { return r.json(); });
                })
                .then(function () { load(); })
                .catch(function (e) { b.textContent = "Prouver"; alert("Erreur : " + (e && e.message ? e.message : "réessayez")); });
            });
          });

          // ── Armer sur signal — panneau chiffres réels + garde-fous (inchangé). ──
          function patchArm(p2, armBody, doneCb) {
            fetch("/api/best-practices", { method: "PATCH", headers: { "content-type": "application/json" }, body: JSON.stringify({ practice_id: p2.practice_id, location_id: p2.location_id, arm: armBody }) })
              .then(function (r) { return r.json(); })
              .then(function (res) { doneCb(res && res.ok, res && res.error); })
              .catch(function () { doneCb(false, "réseau"); });
          }
          body.querySelectorAll("[data-tb-arm]").forEach(function (b) {
            b.addEventListener("click", function (ev) {
              ev.preventDefault();
              var pi = b.getAttribute("data-tb-arm");
              var p2 = (window._tbPractices || [])[Number(pi)];
              var panel = body.querySelector('[data-tb-arm-panel="' + pi + '"]');
              if (!p2 || !panel) return;
              if (panel.style.display === "block") { panel.style.display = "none"; return; }
              var ctx = p2.arm_signal_ctx || {};
              panel.style.display = "block";
              panel.innerHTML = '<div class="tb-eb" style="margin-bottom:4px;">Le signal</div>'
                + '<div style="font-size:12.5px;line-height:1.6;"><span style="font-weight:600;">Chaleur annoncée demain (niveau ≥ 3)</span>'
                + (ctx.n_hot_30 != null ? " — " + ctx.n_hot_30 + " jour" + (ctx.n_hot_30 > 1 ? "s" : "") + " chauds sur vos 30 derniers" : "")
                + (ctx.next_hot ? " · prochain annoncé : " + dowFr(ctx.next_hot) + " " + frD(ctx.next_hot) : " · aucun annoncé dans l’horizon de prévision") + '</div>'
                + '<div style="font-size:11.5px;color:#6B7280;line-height:1.6;margin:6px 0;">Garde-fous : 1 déclenchement maximum par 7 jours · à chaque tir, la consigne part par email et un engagement mesuré s’arme (vos réglages du test) — chaque verdict s’ajoute au track record. La consigne ne convoque personne (achats, équipe déjà planifiée).</div>'
                + '<div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:8px 0;">'
                + '<input data-arm-name style="font-size:12.5px;font-family:inherit;border:1px solid rgba(0,0,0,0.12);border-radius:8px;padding:8px 10px;width:180px;" placeholder="Destinataire (nom)" value="' + esc(p2.arm_recipient_name || "") + '">'
                + '<input data-arm-mail style="font-size:12.5px;font-family:inherit;border:1px solid rgba(0,0,0,0.12);border-radius:8px;padding:8px 10px;width:220px;" placeholder="Email" value="' + esc(p2.arm_recipient_contact || "") + '">'
                + '<button type="button" data-arm-go style="font-size:13px;font-weight:500;color:#1D3BB3;border:1px solid #1D3BB3;border-radius:10px;padding:6px 12px;background:transparent;cursor:pointer;font-family:inherit;">Armer ce dispositif</button>'
                + '<span data-arm-msg style="font-size:12px;color:#B91C1C;"></span></div>';
              panel.querySelector("[data-arm-go]").addEventListener("click", function () {
                var nm = (panel.querySelector("[data-arm-name]").value || "").trim();
                var em = (panel.querySelector("[data-arm-mail]").value || "").trim();
                var msg = panel.querySelector("[data-arm-msg]");
                if (!em || em.indexOf("@") < 0) { msg.textContent = "Un email destinataire est requis."; return; }
                patchArm(p2, { enabled: true, recipient_name: nm || null, recipient_contact: em, channel: "email", cooldown_days: 7 }, function (ok, err) {
                  if (ok) load(); else msg.textContent = "Erreur : " + (err || "réessayez.");
                });
              });
            });
          });
          body.querySelectorAll("[data-tb-disarm]").forEach(function (b) {
            b.addEventListener("click", function (ev) {
              ev.preventDefault();
              var parts = String(b.getAttribute("data-tb-disarm") || "").split("|");
              patchArm({ practice_id: parts[0], location_id: parts[1] }, { enabled: false }, function (ok, err) {
                if (ok) load(); else alert("Erreur : " + (err || "réessayez."));
              });
            });
          });

          // ── Premier test mesuré : formulaire PARTAGÉ MSCommitForm (inchangé). ──
          if (db.first_test) {
            body.querySelectorAll('a[href="#tb-first-test"]').forEach(function (a) {
              a.addEventListener("click", function (ev) {
                ev.preventDefault();
                var panel = document.getElementById("tb-first-test");
                if (!panel) return;
                if (panel.style.display === "block") { panel.style.display = "none"; panel.innerHTML = ""; return; }
                panel.style.display = "block";
                if (!window.MSCommitForm) { panel.innerHTML = '<div style="font-size:12.5px;color:#B91C1C;">Formulaire indisponible — rechargez la page.</div>'; return; }
                panel.innerHTML = '<p class="tb-eb" style="margin-bottom:8px;">Votre premier test mesuré' + (db.first_test.site_label ? " — " + esc(db.first_test.site_label) : "") + '</p>'
                  + '<div style="font-size:12px;color:#6B7280;line-height:1.5;margin-bottom:8px;">Décrivez UNE action et sa fenêtre à venir — la mesure s’arme seule et le verdict tombe automatiquement à la fin.</div>'
                  + '<div data-ft-form></div>';
                var ftHost = panel.querySelector("[data-ft-form]");
                ftHost.innerHTML = window.MSCommitForm.buildHtml({});
                window.MSCommitForm.wire(ftHost, {
                  location_id: db.first_test.location_id,
                  origin: {
                    origin_action_type: "onboarding_first_test",
                    origin_suppression_key: "onboarding_first_test:" + db.first_test.location_id,
                  },
                  onDone: function (jd) { if (jd && jd.ok) load(); },
                  onCancel: function () { panel.style.display = "none"; panel.innerHTML = ""; },
                });
                panel.scrollIntoView({ behavior: "smooth", block: "start" });
              });
            });
          }
        }

        load();
        if (loc) document.getElementById("tb-new").href = "/app/insightevent/evenement?location_id=" + encodeURIComponent(loc) + "&new=1";
      })();
    </script>
  </BaseLayout>
</Show>
