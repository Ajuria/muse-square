---
// « /tableau » — le Tableau de bord (maquette v3 validée 05/08), atterrissage de l'onglet Piloter.
// Trois étages : (1) Impact + « À faire maintenant » (le geste = LIGNE D'ACTION .aline, jamais un
// bouton — un seul bouton plein par écran : Nouvel événement ; le pli s'annonce par les OBJECTIFS,
// pas un compte de gestes) ; (2) Cette semaine (échéances ≤ 7 j en colonnes [J-x | quoi | ›],
// signaux compressés en chip infobulée) ; (3) volets fermés dont le titre EST la réponse —
// Dispositifs (« Prouver · Automatiser » sur les fiches) · Équipe · Automatisation (reçu + À activer,
// uniquement des interrupteurs réels). Design system de l'app : police héritée, eyebrows .eb,
// cartes ombrées — plus aucun style inventé. GARDE-FOU : aucune métrique brute sans son verdict.
// Multi-sites par défaut (fetch SANS location_id sauf filtre URL explicite).
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import PiloterBottomBar from "../../../components/PiloterBottomBar.astro";
import { Show } from "@clerk/astro/components";

const locParam = Astro.url.searchParams.get("location_id") || "";
---

<Show when="signed-out" client:load>
  <meta http-equiv="refresh" content="0; url=/sign-in" />
</Show>

<Show when="signed-in" client:load>
  <BaseLayout title="Tableau de bord — Muse Square" hideSurveyCta={true} hideFooter={true}>
    <div id="tb-root" data-loc={locParam}>
      <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:10px;margin-bottom:12px;">
        <div style="font-size:20px;font-weight:600;color:#111827;">Tableau de bord</div>
        <a id="tb-new" href="/app/insightevent/evenement?new=1" style="display:inline-flex;align-items:center;padding:9px 16px;background:#1D3BB3;border-radius:6px;font-size:13px;font-weight:500;color:#fff;text-decoration:none;white-space:nowrap;">Nouvel événement</a>
      </div>
      <div id="tb-body" style="font-size:13px;color:#9CA3AF;">Chargement…</div>
    </div>

    <PiloterBottomBar active="piloter" />

    <style is:global>
      #tb-root { max-width: 760px; margin: 0 auto; padding: 16px 16px 90px; color: #111827; }
      .tb-card { background: #fff; border: 1px solid rgba(0,0,0,0.08); border-radius: 10px; box-shadow: 0 1px 3px rgba(16,24,40,0.06), 0 1px 2px rgba(16,24,40,0.04); margin-bottom: 12px; }
      .tb-eb { font-size: 11px; letter-spacing: 0.07em; text-transform: uppercase; color: rgba(17,24,39,0.45); font-weight: 500; margin: 0; }
      .tb-chip { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; padding: 2px 8px; border-radius: 20px; white-space: nowrap; }
      .tb-link { color: #1D3BB3; font-weight: 600; text-decoration: none; font-size: 12.5px; }
      .tb-aline { display: block; color: #1D3BB3; font-size: 13px; font-weight: 600; line-height: 1.5; text-decoration: none; }
      .tb-volet { width: 100%; display: flex; align-items: center; gap: 10px; padding: 13px 16px; background: none; border: none; font-family: inherit; font-size: 13px; cursor: pointer; text-align: left; color: #111827; }
    </style>

    <script is:inline>
      (function () {
        var root = document.getElementById("tb-root");
        var body = document.getElementById("tb-body");
        // `loc` sert aux LIENS. Le fetch n'envoie location_id QUE si l'URL porte un filtre
        // explicite — sinon l'endpoint couvre TOUS les sites du compte.
        var locFilter = root.getAttribute("data-loc") || "";
        var loc = locFilter;
        var period = 30;

        function esc(s) { return String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;"); }
        function frInt(n) { return Math.abs(Math.round(Number(n) || 0)).toLocaleString("fr-FR"); }
        function frD(iso) { var d = String(iso || "").slice(0, 10); return d ? d.slice(8, 10) + "/" + d.slice(5, 7) : ""; }
        var DOW3 = ["dim", "lun", "mar", "mer", "jeu", "ven", "sam"];
        function dowFr(iso) { var d = new Date(iso + "T00:00:00Z"); return isNaN(d.getTime()) ? "" : DOW3[d.getUTCDay()]; }
        function daysTo(iso) { var d = new Date(iso + "T00:00:00Z"); return Math.round((d.getTime() - new Date(new Date().toISOString().slice(0, 10) + "T00:00:00Z").getTime()) / 86400000); }
        function signEur(n) { return (Number(n) >= 0 ? "+" : "−") + frInt(n) + " €"; }
        function initials(name) {
          var parts = String(name || "").split(/[\s·]+/).filter(Boolean);
          return ((parts[0] || "?")[0] + (parts[1] ? parts[1][0] : "")).toUpperCase();
        }

        function load() {
          body.innerHTML = '<div style="font-size:13px;color:#9CA3AF;">Chargement…</div>';
          fetch("/api/insight/dashboard?period=" + period + (locFilter ? "&location_id=" + encodeURIComponent(locFilter) : ""), { cache: "no-store" })
            .then(function (r) { return r.json(); })
            .then(function (j) {
              if (!j || !j.ok) { body.textContent = "Erreur : " + ((j && j.error) || "réessayez."); return; }
              render(j);
            })
            .catch(function () { body.textContent = "Erreur de chargement."; });
        }

        // ── Les gestes, formulés par OBJECTIF (maquette v3) : le premier est LA ligne d'action
        //    toujours visible, les autres se plient sous « À débloquer : <ce qu'il y a à gagner> ».
        function buildGoals(j) {
          var db = j.debloquer || {};
          var goals = [];
          (db.bilans_pending || []).forEach(function (b, i) {
            var late = b.fin ? Math.max(0, -daysTo(b.fin)) : 0;
            goals.push({
              kind: "bilan", title: b.title,
              aline: "→ Faire le bilan de « " + b.title + " » (2 min)" + (late ? " — il attend depuis " + late + " jour" + (late > 1 ? "s" : "") : ""),
              sub: "3 questions · calibre météo, accès et fréquentation",
              goal_fr: i === 0 ? "Affiner vos prévisions météo/accès" : null,
              link_fr: "Bilan " + b.title,
              href: "/app/insightevent/evenement?location_id=" + encodeURIComponent(b.location_id || "") + "&saved_item_id=" + encodeURIComponent(b.saved_item_id || "") + "&mode=bilan",
            });
          });
          if (db.to_document) goals.push({
            kind: "documenter",
            aline: "→ Documenter votre verdict tenu — il devient un dispositif déclaré",
            sub: "depuis la carte de l’action, dans Agir",
            goal_fr: "Enrichir vos dispositifs", link_fr: "Documenter le verdict tenu",
            href: "/app/insightevent/pulse",
          });
          if (db.declared_no_replay) {
            var firstDeclared = (j.practices || []).filter(function (p) { return p.status !== "proven" && !p.replay_commitment_id && p.origin_action_type; })[0];
            goals.push({
              kind: "prouver",
              aline: "→ Prouver un dispositif de plus — une exécution mesurée suffit",
              sub: "si la cible tient, déclaré devient prouvé",
              goal_fr: "Prouver un dispositif de plus",
              link_fr: "Prouver « " + String((firstDeclared && firstDeclared.text) || "dispositif").slice(0, 40) + " »",
              href: "#tb-disp", open_volet: "di",
            });
          }
          if (db.team_empty) goals.push({
            kind: "equipe",
            aline: "→ Ajouter votre équipe — vos engagements pourront être assignés et notifiés",
            sub: "Compte → Communication · 2 min",
            goal_fr: "Faire vivre l’Équipe", link_fr: "Ajouter vos destinataires",
            href: "/profile?tab=comm",
          });
          if (db.channels_missing) goals.push({
            kind: "canaux",
            aline: "→ Brancher un canal (email ou Slack) — vos alertes et notifications partiront",
            sub: "Compte → Communication · 2 min",
            goal_fr: "Recevoir alertes et notifications", link_fr: "Brancher un canal",
            href: "/profile?tab=comm",
          });
          if (db.alerts_prefs_missing) goals.push({
            kind: "alertes",
            aline: "→ Choisir ce qui mérite un email — alertes critiques, point du jour, digest",
            sub: "vos préférences d’alertes n’ont jamais été posées",
            goal_fr: "Choisir ce qui mérite un email", link_fr: "Régler vos alertes",
            href: "/notifications",
          });
          if (!db.margin_declared) goals.push({
            kind: "marge",
            aline: "→ Déclarer votre marge — débloque le KPI profit",
            sub: "une phrase dans Explorer, c’est tout",
            goal_fr: "Débloquer le KPI profit", link_fr: "Déclarer votre marge (une phrase)",
            href: "/app/insightevent/prompt?q=" + encodeURIComponent("Ma marge est d’environ  %"),
          });
          return goals;
        }
        function goalsSummary(j, rest) {
          var db = j.debloquer || {};
          var parts = [];
          if (db.declared_no_replay) parts.push(db.declared_no_replay + " dispositif" + (db.declared_no_replay > 1 ? "s" : "") + " prouvable" + (db.declared_no_replay > 1 ? "s" : ""));
          var nb = rest.filter(function (g) { return g.kind === "bilan"; }).length;
          if (nb) parts.push("vos prévisions (" + nb + " bilan" + (nb > 1 ? "s" : "") + ")");
          if (db.to_document && !rest.some(function (g) { return g.kind === "documenter"; })) {} // couvert par la ligne visible
          else if (db.to_document) parts.push("vos dispositifs (1 à documenter)");
          if (rest.some(function (g) { return g.kind === "equipe" || g.kind === "canaux"; })) parts.push("votre équipe et vos canaux");
          else if (rest.some(function (g) { return g.kind === "alertes"; })) parts.push("vos alertes");
          if (!db.margin_declared) parts.push("le KPI profit");
          return parts.join(" · ");
        }

        function render(j) {
          var html = "";
          var im = j.impact || {};
          var db = j.debloquer || {};

          // ── ÉTAGE 1 : Impact + le geste du moment ──
          var periodSel = '<span style="display:inline-flex;gap:12px;font-size:11.5px;">'
            + [[30, "30 j"], [90, "90 j"], [365, "12 mois"]].map(function (p) {
                var on = p[0] === period;
                return '<button type="button" data-tb-period="' + p[0] + '" style="font-family:inherit;border:none;background:none;padding:0;cursor:pointer;' + (on ? "color:#111827;font-weight:600;text-decoration:underline;text-underline-offset:3px;" : "color:#9CA3AF;") + '">' + p[1] + "</button>";
              }).join("") + "</span>";

          var pipe = [];
          if ((db.replays_running || []).length) pipe.push(db.replays_running.length + " en rejeu (verdict " + dowFr(db.replays_running[0].end) + ")");
          var declaredN = (j.practices || []).filter(function (p) { return p.status !== "proven"; }).length;
          if (declaredN) pipe.push(declaredN + " déclaré" + (declaredN > 1 ? "s" : ""));

          var goals = buildGoals(j);
          var primary = goals[0] || null;
          var rest = goals.slice(1);
          var summary = goalsSummary(j, rest);

          html += '<div class="tb-card" style="padding:16px;">'
            + '<div style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px;flex-wrap:wrap;"><p class="tb-eb">Impact mesuré de vos opérations</p>' + periodSel + '</div>'
            + '<div style="display:flex;gap:24px;flex-wrap:wrap;align-items:baseline;">'
            + '<div><div style="font-size:28px;font-weight:600;line-height:1;color:' + (im.gap_eur == null ? "#111827" : im.gap_eur >= 0 ? "#059669" : "#B45309") + ';">' + (im.gap_eur == null ? "— €" : signEur(im.gap_eur)) + '</div>'
            + '<div style="font-size:10.5px;color:#9CA3AF;margin-top:4px;">vs attendu · ' + im.eur_windows + ' fenêtre' + (im.eur_windows > 1 ? "s" : "") + (im.confounded ? ' · ' + im.confounded + ' non-mesurable hors €' : '') + ' · jamais extrapolé</div></div>'
            + '<div><div style="font-size:20px;font-weight:600;line-height:1;">' + im.targets_met + '<span style="font-size:13px;color:#9CA3AF;font-weight:500;">/' + im.windows_judged + ' cibles atteintes</span></div>'
            + '<div style="font-size:10.5px;color:#9CA3AF;margin-top:4px;">sur ' + j.period_days + ' j' + (im.next_judgment ? ' · prochaine jugée ' + dowFr(im.next_judgment) + ' ' + frD(im.next_judgment) : '') + '</div></div>'
            + '<div><div style="font-size:20px;font-weight:600;line-height:1;">' + im.practices_proven + '<span style="font-size:13px;color:#9CA3AF;font-weight:500;"> dispositif' + (im.practices_proven > 1 ? "s" : "") + ' prouvé' + (im.practices_proven > 1 ? "s" : "") + '</span></div>'
            + '<div style="font-size:10.5px;color:#9CA3AF;margin-top:4px;">' + (pipe.length ? pipe.join(" · ") : "documentez pour en créer") + '</div></div>'
            + '</div>';

          if (primary) {
            html += '<div style="height:1px;background:rgba(0,0,0,0.08);margin:14px 0 12px;"></div>'
              + '<p class="tb-eb" style="margin-bottom:3px;">À faire maintenant</p>'
              + '<a class="tb-aline" href="' + primary.href + '">' + esc(primary.aline) + '</a>'
              + '<div style="font-size:11px;color:#9CA3AF;">' + esc(primary.sub) + '</div>';
            if (rest.length && summary) {
              html += '<button type="button" id="tb-mg" style="display:block;padding:8px 0 0;font-size:12px;color:#6b7280;background:none;border:none;font-family:inherit;cursor:pointer;text-align:left;">À débloquer : ' + esc(summary) + ' <span style="font-size:10px;">▾</span></button>'
                + '<div id="tb-mg-list" style="display:none;font-size:12.5px;line-height:2;padding-top:2px;">'
                + rest.map(function (g) {
                    return '<div>' + (g.goal_fr ? '<span style="font-weight:600;">' + esc(g.goal_fr) + '</span> → ' : '') + '<a class="tb-link" href="' + g.href + '"' + (g.open_volet ? ' data-tb-open="' + g.open_volet + '"' : '') + '>' + esc(g.link_fr) + '</a></div>';
                  }).join("")
                + '</div>';
            }
          }
          html += '</div>';

          // ── ÉTAGE 2 : Cette semaine ──
          var ops = j.operations || [];
          var seen = {};
          var firstOps = [];
          var restBy = {};
          ops.forEach(function (o) {
            var k = o.saved_item_id || o.title;
            if (!seen[k]) { seen[k] = true; firstOps.push(o); restBy[k] = []; }
            else restBy[k].push(o);
          });
          var week = firstOps.filter(function (o) { return daysTo(o.occ_date) <= 7; });
          var laterOps = firstOps.filter(function (o) { return daysTo(o.occ_date) > 7; });
          var weekComs = (j.open_commitments || []).filter(function (c) { return !c.is_event && c.days_to_end != null && c.days_to_end >= 0 && c.days_to_end <= 7; });

          html += '<div class="tb-card" style="padding:14px 16px;">'
            + '<div style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:8px;"><p class="tb-eb">Cette semaine</p><a class="tb-link" id="tb-all" href="/app/insightevent/evenement" style="font-size:11.5px;">Tous mes événements →</a></div>';
          if (!week.length && !weekComs.length) {
            html += '<div style="font-size:12.5px;color:#9CA3AF;">Rien à échéance sous 7 jours' + (laterOps.length ? ' — prochaine : ' + dowFr(laterOps[0].occ_date) + ' ' + frD(laterOps[0].occ_date) : '') + '.</div>';
          } else {
            html += '<div style="display:grid;grid-template-columns:44px 1fr 18px;gap:8px 10px;align-items:center;font-size:13px;">';
            week.forEach(function (o) {
              var sig = [];
              if (o.competitor_flag) sig.push("Concurrent à proximité le jour même");
              if (Number(o.weather_lvl) >= 3) sig.push("météo niv. " + o.weather_lvl);
              var kpiLbl = o.kpi === "family_revenue" ? "famille " + (o.kpi_family || "") : o.kpi === "revenue_residual" ? "CA vs attendu" : (o.kpi || "");
              var dossierHref = "/app/insightevent/evenement?location_id=" + encodeURIComponent(o.location_id || loc) + "&saved_item_id=" + encodeURIComponent(o.saved_item_id);
              html += '<span style="font-size:11px;font-weight:700;color:#1D3BB3;">J-' + daysTo(o.occ_date) + '</span>'
                + '<span style="min-width:0;"><a href="' + dossierHref + '" style="font-weight:600;color:inherit;text-decoration:none;">' + esc(o.title) + '</a> '
                + (j.multi_site && o.site_label ? '<span class="tb-chip" style="background:#F3F4F6;color:#6b7280;">' + esc(o.site_label) + '</span> ' : '')
                + (sig.length ? '<span class="tb-chip" style="background:#FEF3E2;color:#B45309;cursor:help;" title="' + esc(sig.join(" · ")) + '">⚠ ' + sig.length + ' signa' + (sig.length > 1 ? "ux" : "l") + '</span>' : '')
                + '<br>' + (o.ready_com && o.ready_snap ? '<span style="font-size:11px;color:#059669;font-weight:600;">✓ prête</span>' : '<span style="font-size:11px;color:#9CA3AF;">s’arme à J-7</span>')
                + '<span style="font-size:11px;color:#9CA3AF;">' + (o.n_total > 1 ? ' · occurrence ' + o.occ_num + '/' + o.n_total : '') + (o.target ? ' · cible ' + esc(kpiLbl) + ' ' + esc(o.target) : '') + (o.owner ? ' · ' + esc(String(o.owner).split("·")[0].trim()) : '') + '</span></span>'
                + '<a class="tb-link" href="' + dossierHref + '" style="font-size:15px;">›</a>';
            });
            weekComs.forEach(function (c) {
              var title = String(c.text || "").split(String.fromCharCode(8594))[0].split(".")[0].slice(0, 80);
              html += '<span style="font-size:11px;font-weight:700;color:#1D3BB3;">J-' + c.days_to_end + '</span>'
                + '<span style="min-width:0;"><a href="/app/insightevent/pulse" style="font-weight:600;color:inherit;text-decoration:none;">' + esc(title) + '</a> '
                + (j.multi_site && c.site_label ? '<span class="tb-chip" style="background:#F3F4F6;color:#6b7280;">' + esc(c.site_label) + '</span>' : '')
                + '<br><span style="font-size:11px;color:#9CA3AF;">fenêtre ' + frD(c.ws) + (c.we !== c.ws ? ' → ' + frD(c.we) : '') + (c.threshold_value != null ? ' · seuil +' + c.threshold_value + ' %' : '') + (c.owner ? ' · ' + esc(String(c.owner).split("·")[0].trim()) : '') + '</span></span>'
                + '<a class="tb-link" href="/app/insightevent/pulse" style="font-size:15px;">›</a>';
            });
            html += '</div>';
          }
          var restCount = 0, restLast = null;
          Object.keys(restBy).forEach(function (k) { restBy[k].forEach(function (o) { restCount++; if (!restLast || o.occ_date > restLast) restLast = o.occ_date; }); });
          laterOps.forEach(function (o) { restCount++; if (!restLast || o.occ_date > restLast) restLast = o.occ_date; });
          if (restCount) html += '<div style="font-size:11.5px;color:#9CA3AF;margin-top:10px;">Et ensuite : ' + restCount + ' occurrence' + (restCount > 1 ? "s" : "") + ' (→ ' + dowFr(restLast) + ' ' + frD(restLast) + ') — chacune s’arme seule à J-7.</div>';
          html += '</div>';

          // ── ÉTAGE 3 : volets fermés — Dispositifs · Équipe · Automatisé ──
          var cutoff = new Date(Date.now() - j.period_days * 86400000).toISOString().slice(0, 10);
          var pr = (j.practices || []).filter(function (p) { return !p.date || p.date >= cutoff; });
          var replayEnd = (db.replays_running || [])[0] ? db.replays_running[0].end : null;
          var provenN = pr.filter(function (p) { return p.status === "proven"; }).length;
          var voletDiTitle = provenN + ' prouvé' + (provenN > 1 ? "s" : "")
            + ((db.replays_running || []).length ? ' · ' + db.replays_running.length + ' en rejeu' + (replayEnd ? ' (verdict ' + dowFr(replayEnd) + ')' : '') : '')
            + (declaredN ? ' · ' + declaredN + ' déclaré' + (declaredN > 1 ? "s" : "") : '');
          html += '<div class="tb-card" id="tb-disp"><button type="button" class="tb-volet" data-tb-volet="di">'
            + '<span style="width:8px;height:8px;border-radius:50%;background:#9CA3AF;flex:none;"></span>'
            + '<span style="flex:1;"><span style="font-weight:600;">Dispositifs</span> — ' + voletDiTitle + '</span>'
            + '<span style="color:#9CA3AF;font-size:11px;">▾</span></button>'
            + '<div data-tb-body="di" style="display:none;padding:0 16px 12px;font-size:12.5px;color:#374151;line-height:1.7;">';
          if (!pr.length) html += '<div style="color:#9CA3AF;">Aucun sur la période — chaque verdict tenu peut en créer un (« Documenter »).</div>';
          pr.slice(0, 6).forEach(function (p) {
            var running = p.replay_commitment_id && p.status !== "proven";
            var chip = p.status === "proven" ? ['prouvé', '#E6F6F0', '#059669'] : running ? ['en rejeu', '#E6F6F0', '#059669'] : ['déclaré', '#F3F4F6', '#6b7280'];
            var canAct = p.practice_id && p.origin_action_type && !p.replay_commitment_id;
            var autoHref = "/app/insightevent/evenement?location_id=" + encodeURIComponent(p.location_id || loc) + "&new=1&titre=" + encodeURIComponent(String(p.text || "").slice(0, 60)) + "&dispositif=" + encodeURIComponent(String(p.text || "").slice(0, 240));
            html += '<div style="display:flex;gap:8px;align-items:center;padding:3px 0;flex-wrap:wrap;">'
              + '<span class="tb-chip" style="background:' + chip[1] + ';color:' + chip[2] + ';">' + chip[0] + '</span>'
              + '<span style="flex:1;min-width:180px;">' + esc(String(p.text || "").slice(0, 110)) + '</span>'
              + (running && replayEnd ? '<span style="font-size:11px;color:#9CA3AF;">verdict ' + dowFr(replayEnd) + ' ' + frD(replayEnd) + '</span>' : '')
              + (canAct ? '<a class="tb-link" href="#" data-tb-replay="' + esc(p.practice_id) + '" title="Une exécution mesurée de plus — si la cible tient, le dispositif devient prouvé">Prouver</a><span style="color:#D1D5DB;">·</span><a class="tb-link" href="' + autoHref + '" title="En faire une série récurrente : armement J-7, contexte, verdicts — tout seul">Automatiser</a>' : '')
              + '</div>';
          });
          html += '</div></div>';

          var eq = j.equipe || [];
          var eqLead = eq.slice().sort(function (a, b) { return (b.open || []).length - (a.open || []).length; })[0];
          var eqTitle = eqLead && (eqLead.open || []).length
            ? String(eqLead.who).split("·")[0].trim() + " porte " + (eq.filter(function (p) { return (p.open || []).length; }).length > 1 ? "le plus" : "tout") + " (" + eqLead.open.length + " en cours)" + (im.gap_eur != null ? " · " + signEur(im.gap_eur) + " mesurés" : "")
            : "personne n’a d’opération en cours";
          html += '<div class="tb-card"><button type="button" class="tb-volet" data-tb-volet="eq">'
            + '<span style="width:8px;height:8px;border-radius:50%;background:#1D3BB3;flex:none;"></span>'
            + '<span style="flex:1;"><span style="font-weight:600;">Équipe</span> — ' + esc(eqTitle) + '</span>'
            + '<span style="color:#9CA3AF;font-size:11px;">▾</span></button>'
            + '<div data-tb-body="eq" style="display:none;padding:0 16px 12px;font-size:12.5px;color:#374151;line-height:1.7;">';
          eq.forEach(function (p) {
            var opsTxt = (p.open || []).map(function (o) {
              var title = String(o.text || "").split("—")[0].trim().slice(0, 50);
              var href = o.saved_item_id ? '/app/insightevent/evenement?saved_item_id=' + encodeURIComponent(o.saved_item_id) : '/app/insightevent/pulse';
              return '<a class="tb-link" href="' + href + '">' + esc(title) + '</a>' + (o.we ? " (J-" + daysTo(o.we) + ")" : "");
            }).join(" · ") || '<span style="color:#9CA3AF;">rien en cours</span>';
            html += '<div style="display:flex;gap:10px;align-items:center;padding:4px 0;flex-wrap:wrap;">'
              + '<span style="width:26px;height:26px;border-radius:50%;background:#EEF2FF;color:#1D3BB3;display:inline-flex;align-items:center;justify-content:center;font-weight:700;font-size:11px;flex:none;">' + esc(initials(p.who)) + '</span>'
              + '<span style="flex:1;min-width:180px;"><span style="font-weight:600;">' + esc(String(p.who).split("·")[0].trim()) + '</span>' + (String(p.who).indexOf("·") > 0 ? ' ·' + esc(String(p.who).split("·").slice(1).join("·")) : '') + ' — ' + opsTxt + '</span>'
              + '<span style="font-size:11px;color:#9CA3AF;flex:none;">tenue ' + (p.judged ? p.kept + "/" + p.judged : "—") + '</span>'
              + (p.gap_eur != null ? '<span style="font-size:11px;font-weight:600;color:' + (p.gap_eur >= 0 ? "#059669" : "#B45309") + ';flex:none;">' + signEur(p.gap_eur) + '</span>' : '')
              + '</div>';
          });
          html += '</div></div>';

          var au = j.automated || {};
          var auLines = [];
          (au.snapshots_recent || []).slice(0, 2).forEach(function (d) { auLines.push('✓ Contexte du ' + dowFr(d) + ' ' + frD(d) + ' gelé (météo, concurrence, accès)'); });
          if (au.next_autoarm) auLines.push('↻ Occurrence du ' + dowFr(au.next_autoarm.occ_date) + ' ' + frD(au.next_autoarm.occ_date) + ' (' + esc(au.next_autoarm.title) + ') : s’armera seule à J-7');
          if ((au.verdicts_scheduled || []).length) auLines.push('↻ Verdict' + (au.verdicts_scheduled.length > 1 ? "s" : "") + ' jugé' + (au.verdicts_scheduled.length > 1 ? "s" : "") + ' automatiquement après ' + au.verdicts_scheduled.slice(0, 2).map(function (d) { return dowFr(d) + ' ' + frD(d); }).join(' et '));
          var na = (au.competitor_alerts_7d || []).length;
          if (na) auLines.push('⚠ Veille concurrent : ' + na + ' alerte' + (na > 1 ? "s" : "") + ' surveillée' + (na > 1 ? "s" : "") + ' sur 7 jours');
          html += '<div class="tb-card"><button type="button" class="tb-volet" data-tb-volet="au">'
            + '<span style="width:8px;height:8px;border-radius:50%;background:#059669;flex:none;"></span>'
            + '<span style="flex:1;"><span style="font-weight:600;">Automatisation</span> — ' + auLines.length + ' action' + (auLines.length > 1 ? "s" : "") + ' exécutée' + (auLines.length > 1 ? "s" : "") + ' cette semaine · 2 à activer</span>'
            + '<span style="color:#9CA3AF;font-size:11px;">▾</span></button>'
            + '<div data-tb-body="au" style="display:none;padding:0 16px 12px;font-size:12.5px;color:#374151;line-height:1.8;">'
            + (auLines.length ? auLines.map(function (l) { return '<div>' + l + '</div>'; }).join("") : '<div style="color:#9CA3AF;">Rien cette semaine — les automatisations s’activent avec vos opérations.</div>')
            + '<div style="height:1px;background:rgba(0,0,0,0.08);margin:8px 0;"></div>'
            + '<p class="tb-eb" style="margin-bottom:4px;">À activer</p>'
            + '<div>Alerte automatique quand un concurrent programme un événement sur un de vos jours <a class="tb-link" href="/notifications">Activer →</a></div>'
            + '<div>Notification automatique à l’équipe sur signal interne <a class="tb-link" href="/app/insightevent/pulse">Configurer →</a></div>'
            + '</div></div>';

          body.innerHTML = html;
          window._tbPractices = pr;

          body.querySelectorAll("[data-tb-period]").forEach(function (b) {
            b.addEventListener("click", function () { period = Number(b.getAttribute("data-tb-period")); load(); });
          });
          var mg = document.getElementById("tb-mg");
          if (mg) mg.addEventListener("click", function () { var l = document.getElementById("tb-mg-list"); l.style.display = l.style.display === "none" ? "block" : "none"; });
          body.querySelectorAll("[data-tb-volet]").forEach(function (b) {
            b.addEventListener("click", function () {
              var v = body.querySelector('[data-tb-body="' + b.getAttribute("data-tb-volet") + '"]');
              if (v) v.style.display = v.style.display === "none" ? "block" : "none";
            });
          });
          body.querySelectorAll("[data-tb-open]").forEach(function (a) {
            a.addEventListener("click", function () {
              var v = body.querySelector('[data-tb-body="' + a.getAttribute("data-tb-open") + '"]');
              if (v) v.style.display = "block";
            });
          });
          // « Prouver » : POST /api/commitments (rejeu 7 j, seuil +10 %) puis PATCH
          // /api/best-practices (replay_commitment_id) — deux endpoints existants.
          body.querySelectorAll("[data-tb-replay]").forEach(function (b) {
            b.addEventListener("click", function (ev) {
              ev.preventDefault();
              var pid = b.getAttribute("data-tb-replay");
              var pr2 = (window._tbPractices || []).filter(function (x) { return x.practice_id === pid; })[0];
              if (!pr2) return;
              b.textContent = "Rejeu…";
              fetch("/api/commitments", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({
                location_id: pr2.location_id, origin_action_type: pr2.origin_action_type,
                window_kind: "7d", threshold_basis: "pct", threshold_pct: 10,
                committed_action_text: "Rejeu du dispositif : " + String(pr2.text || "").slice(0, 180),
                owner_person_name: pr2.author || "—",
              }) })
                .then(function (r) { return r.json(); })
                .then(function (c) {
                  if (!c || !c.ok || !c.commitment_id) throw new Error((c && c.error) || "Erreur");
                  return fetch("/api/best-practices", { method: "PATCH", headers: { "content-type": "application/json" }, body: JSON.stringify({ practice_id: pid, location_id: pr2.location_id, replay_commitment_id: c.commitment_id }) }).then(function (r) { return r.json(); });
                })
                .then(function () { load(); })
                .catch(function (e) { b.textContent = "Prouver"; alert("Erreur : " + (e && e.message ? e.message : "réessayez")); });
            });
          });
        }

        load();
        if (loc) {
          document.getElementById("tb-new").href = "/app/insightevent/evenement?location_id=" + encodeURIComponent(loc) + "&new=1";
        } else {
          fetch("/api/profile/locations", { cache: "no-store" })
            .then(function (r) { return r.json(); })
            .then(function (p) {
              var l0 = p && p.ok && Array.isArray(p.locations) && p.locations[0];
              if (!l0 || !l0.location_id) return;
              loc = String(l0.location_id);
              document.getElementById("tb-new").href = "/app/insightevent/evenement?location_id=" + encodeURIComponent(loc) + "&new=1";
            })
            .catch(function () {});
        }
      })();
    </script>
  </BaseLayout>
</Show>
