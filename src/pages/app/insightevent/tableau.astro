---
// « /tableau » — le Tableau de bord (refonte « couche 1 lisible en 5 s » validée par maquette
// public/tableau-proto.html, 09-10/08). Règles de forme : couche 1 = CHIFFRES, points d'état et
// chips (aucune ligne > 6 mots, UNE seule phrase visible : la ligne d'action) ; la prose
// (Lecture, dernier verdict, méthodes) s'ouvre AU CLIC ; rangées « Cette semaine » sur UNE ligne
// en colonnes [date · ● · titre · chips · cible · avatar · ›] ; volets à titres en chips d'état.
// + les deux cartes moat : « Occasions » (signaux joués/manqués, € mesurés, une action par ligne)
// et « Ce que l'app a appris de vos sites » (les apprentissages eux-mêmes, voix maison € d'abord).
// Le fetch est UNIQUE (period=365) : les périodes 30/90 se DÉRIVENT côté client (impact_rows +
// judged_meta) — bascule instantanée, volets préservés (dérivation prouvée = serveur, 09/08).
// GARDE-FOU inchangé : aucune métrique brute sans son verdict. Multi-sites par défaut.
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { Show } from "@clerk/astro/components";

const locParam = Astro.url.searchParams.get("location_id") || "";
---

<Show when="signed-out" client:load>
  <meta http-equiv="refresh" content="0; url=/sign-in" />
</Show>

<Show when="signed-in" client:load>
  <BaseLayout title="Tableau de bord — Muse Square" hideSurveyCta={true} hideFooter={true}>
    <div id="tb-root" data-loc={locParam}>
      <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:10px;margin-bottom:12px;">
        <div style="font-size:20px;font-weight:600;color:#111827;">Tableau de bord</div>
        <a id="tb-new" href="/app/insightevent/evenement?new=1" style="display:inline-flex;align-items:center;padding:8px 15px;background:transparent;border:1px solid #1D3BB3;border-radius:10px;font-size:13px;font-weight:500;color:#1D3BB3;text-decoration:none;white-space:nowrap;">Nouvel événement</a>
      </div>
      <div id="tb-body" style="font-size:13px;color:#9CA3AF;">Chargement…</div>
    </div>


    <script is:inline src="/commit-form.js?v=11"></script>
    <style is:global>
      #tb-root { max-width: 760px; margin: 0 auto; padding: 16px 16px 90px; color: #111827; }
      .tb-card { background: #fff; border: 1px solid rgba(0,0,0,0.08); border-radius: 10px; box-shadow: 0 1px 3px rgba(16,24,40,0.06), 0 1px 2px rgba(16,24,40,0.04); margin-bottom: 12px; }
      .tb-eb { font-size: 11px; letter-spacing: 0.07em; text-transform: uppercase; color: rgba(17,24,39,0.45); font-weight: 500; margin: 0; }
      .tb-chip { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; padding: 2px 8px; border-radius: 20px; white-space: nowrap; }
      .tb-link { color: #1D3BB3; font-weight: 600; text-decoration: none; font-size: 12.5px; }
      .tb-aline { display: block; color: #1D3BB3; font-size: 13px; font-weight: 600; line-height: 1.5; text-decoration: none; }
      .tb-volet { width: 100%; display: flex; align-items: center; gap: 10px; padding: 13px 16px; background: none; border: none; font-family: inherit; font-size: 13px; cursor: pointer; text-align: left; color: #111827; }
      /* Rangée UNE LIGNE en colonnes — on balaie, on ne lit pas ; toute la rangée est cliquable. */
      .tb-row3 { display: grid; grid-template-columns: 46px 10px minmax(0,1fr) auto auto 20px 14px; gap: 0 8px; align-items: center; padding: 7px 8px; margin: 0 -8px; border-radius: 8px; color: inherit; text-decoration: none; cursor: pointer; font-size: 13px; }
      .tb-row3:hover { background: #F8FAFC; }
      .tb-row3:hover .tb-rarr { color: #1D3BB3; }
      .tb-rarr { color: #9CA3AF; font-size: 15px; font-weight: 600; text-align: right; }
      .tb-chevron { display: inline-block; transition: transform 0.15s; color: #9CA3AF; font-size: 11px; }
      .tb-volet[aria-expanded="true"] .tb-chevron { transform: rotate(180deg); }
      /* Rangée « occasion / apprentissage » : € d'abord, mini-phrase, action. */
      .tb-occrow { display: grid; grid-template-columns: auto minmax(0,1fr) auto; gap: 0 10px; align-items: center; padding: 6px 0; font-size: 13px; }
      .tb-fold { display: none; margin-top: 8px; padding: 10px 12px; background: #F8FAFC; border-radius: 8px; font-size: 12px; line-height: 1.6; color: #374151; }
    </style>

    <script is:inline>
      (function () {
        var root = document.getElementById("tb-root");
        var body = document.getElementById("tb-body");
        // `loc` sert aux LIENS. Le fetch n'envoie location_id QUE si l'URL porte un filtre
        // explicite — sinon l'endpoint couvre TOUS les sites du compte.
        var locFilter = root.getAttribute("data-loc") || "";
        var loc = locFilter;
        var period = 30;
        var J = null;              // payload UNIQUE (period=365) — les périodes se dérivent ici.
        var openVolets = {};       // préservés à la bascule de période (plus de re-fetch).

        function esc(s) { return String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;"); }
        function frInt(n) { return Math.abs(Math.round(Number(n) || 0)).toLocaleString("fr-FR"); }
        function frD(iso) { var d = String(iso || "").slice(0, 10); return d ? d.slice(8, 10) + "/" + d.slice(5, 7) : ""; }
        var DOW3 = ["dim", "lun", "mar", "mer", "jeu", "ven", "sam"];
        function dowFr(iso) { var d = new Date(iso + "T00:00:00Z"); return isNaN(d.getTime()) ? "" : DOW3[d.getUTCDay()]; }
        function pad2(n) { return (n < 10 ? "0" : "") + n; }
        // « Aujourd'hui » en HEURE LOCALE (l'ancien UTC faussait chaque J-x entre minuit et ~2 h).
        var now = new Date();
        var TODAY = now.getFullYear() + "-" + pad2(now.getMonth() + 1) + "-" + pad2(now.getDate());
        function daysTo(iso) { var d = new Date(iso + "T00:00:00Z"); return Math.round((d.getTime() - new Date(TODAY + "T00:00:00Z").getTime()) / 86400000); }
        function shiftDate(iso, days) { var d = new Date(iso + "T12:00:00Z"); d.setUTCDate(d.getUTCDate() + days); return d.toISOString().slice(0, 10); }
        function signEur(n) { return (Number(n) >= 0 ? "+" : "−") + frInt(n) + " €"; }
        function initials(name) {
          var parts = String(name || "").split(/[\s·]+/).filter(Boolean);
          return ((parts[0] || "?")[0] + (parts[1] ? parts[1][0] : "")).toUpperCase();
        }
        function trunc(s, n) {
          s = String(s || "");
          if (s.length <= n) return s;
          var t = s.slice(0, n);
          var sp = t.lastIndexOf(" ");
          return (sp > n * 0.5 ? t.slice(0, sp) : t) + "…";
        }
        var VERDICT_FR = { met: "cible tenue", missed: "cible manquée", confounded: "non-mesurable (écarté)" };
        var VERDICT_COL = { met: "#059669", missed: "#B45309", confounded: "#6b7280" };
        var CLASS_FR = { rain: "pluie", heat_25_27: "chaleur 25-27 °C", heat_28_plus: "chaleur ≥ 28 °C", snow: "neige", wind: "vent", cold: "froid", traffic_high: "forte affluence", school_holiday: "vacances scolaires", competition_low: "concurrence calme" };

        function load() {
          body.innerHTML = '<div style="font-size:13px;color:#9CA3AF;">Chargement…</div>';
          fetch("/api/insight/dashboard?period=365" + (locFilter ? "&location_id=" + encodeURIComponent(locFilter) : ""), { cache: "no-store" })
            .then(function (r) { return r.json(); })
            .then(function (j) {
              if (!j || !j.ok) { body.textContent = "Erreur : " + ((j && j.error) || "réessayez."); return; }
              J = j;
              if (!loc && Array.isArray(j.sites) && j.sites[0]) loc = String(j.sites[0].location_id);
              document.getElementById("tb-new").href = "/app/insightevent/evenement?location_id=" + encodeURIComponent(loc) + "&new=1";
              render();
            })
            .catch(function () { body.textContent = "Erreur de chargement."; });
        }

        // Impact de la période AFFICHÉE, dérivé du payload 365 (mêmes règles que le serveur —
        // égalité prouvée) : mart hors confounded pour les €, journal pour jugées/tenues.
        function impactFor(p) {
          var cut = shiftDate(TODAY, -p);
          var rows = (J.impact_rows || []).filter(function (r) { return String(r.resolved_date || "") >= cut; });
          var kept = rows.filter(function (r) { return r.verdict !== "confounded"; });
          var jm = (J.judged_meta || []).filter(function (m) { return String(m.created_d || "") >= cut; });
          var judged = jm.filter(function (m) { return m.verdict !== "confounded"; });
          return {
            gap_eur: kept.length ? kept.reduce(function (a, r) { return a + (r.gap_eur || 0); }, 0) : null,
            eur_windows: kept.length,
            confounded: rows.length - kept.length,
            windows_judged: judged.length,
            targets_met: judged.filter(function (m) { return /met|tenu|beat/i.test(String(m.verdict)); }).length,
            practices_proven: (J.practice_counts || {}).proven || 0,
            next_judgment: (J.impact || {}).next_judgment || null,
          };
        }

        // ── Les gestes (moteur inchangé) — le pli s'annonce en CHIPS, pas en phrase. ──
        function buildGoals(j) {
          var db = j.debloquer || {};
          var goals = [];
          (db.bilans_pending || []).forEach(function (b, i) {
            var late = b.fin ? Math.max(0, -daysTo(b.fin)) : 0;
            goals.push({
              kind: "bilan",
              aline: "→ Faire le bilan de « " + b.title + " » (2 min)" + (late ? " — il attend depuis " + late + " jour" + (late > 1 ? "s" : "") : ""),
              sub: "3 questions · calibre météo, accès et fréquentation",
              goal_fr: i === 0 ? "Affiner vos prévisions météo/accès" : null,
              link_fr: "Bilan " + b.title,
              href: "/app/insightevent/evenement?location_id=" + encodeURIComponent(b.location_id || "") + "&saved_item_id=" + encodeURIComponent(b.saved_item_id || "") + "&mode=bilan",
            });
          });
          if (db.sales_stale) goals.push({
            kind: "fraicheur",
            aline: "→ Importer vos ventes récentes — elles s’arrêtent au " + frD(db.sales_stale.last_sale_date)
              + (j.multi_site && db.sales_stale.site_label ? " (" + db.sales_stale.site_label + ")" : "")
              + " · " + db.sales_stale.stale_days + " jours sans données",
            sub: "sans ventes fraîches, ni cartes du jour ni verdicts mesurés",
            goal_fr: "Réveiller vos cartes du jour", link_fr: "Importer vos ventes récentes",
            href: "/app/insightevent/prompt",
          });
          (db.sales_missing || []).slice(0, 1).forEach(function (m) {
            goals.push({
              kind: "ventes",
              aline: "→ Importer les ventes" + (m.site_label ? " de " + m.site_label : "") + " — aucune donnée : le site est aveugle",
              sub: "un export CSV de votre caisse suffit, dans Explorer",
              goal_fr: "Mesurer ce site", link_fr: "Importer les premières ventes",
              href: "/app/insightevent/prompt",
            });
          });
          if (db.first_test) goals.push({
            kind: "premier_test",
            aline: "→ Engagez votre premier test mesuré — verdict automatique à la fin de la fenêtre",
            sub: "une action, une fenêtre à venir — la mesure et le verdict se font seuls" + (j.multi_site && db.first_test.site_label ? " · " + db.first_test.site_label : ""),
            goal_fr: "Obtenir votre premier verdict mesuré", link_fr: "Engager votre premier test",
            href: "#tb-first-test",
          });
          if (db.to_document) goals.push({
            kind: "documenter",
            aline: "→ Documenter votre verdict tenu — il devient un dispositif déclaré",
            sub: "depuis la carte de l’action, dans Agir",
            goal_fr: "Enrichir vos dispositifs", link_fr: "Documenter le verdict tenu",
            href: "/app/insightevent/pulse",
          });
          if (db.declared_no_replay) {
            var firstDeclared = (j.practices || []).filter(function (p) { return p.tier === "declaree" && !p.replay_commitment_id && p.origin_action_type; })[0];
            goals.push({
              kind: "prouver",
              aline: "→ Prouver un dispositif de plus — une exécution mesurée suffit",
              sub: "si la cible tient, déclaré devient prouvé",
              goal_fr: "Prouver un dispositif de plus",
              link_fr: "Prouver « " + String((firstDeclared && firstDeclared.text) || "dispositif").slice(0, 40) + " »",
              href: "#tb-disp", open_volet: "di",
            });
          }
          if (db.team_empty) goals.push({
            kind: "equipe",
            aline: "→ Ajouter votre équipe — vos engagements pourront être assignés et notifiés",
            sub: "Compte → Communication · 2 min",
            goal_fr: "Faire vivre l’Équipe", link_fr: "Ajouter vos destinataires",
            href: "/profile?tab=comm",
          });
          if (db.channels_missing) goals.push({
            kind: "canaux",
            aline: "→ Brancher un canal (email ou Slack) — vos alertes et notifications partiront",
            sub: "Compte → Communication · 2 min",
            goal_fr: "Recevoir alertes et notifications", link_fr: "Brancher un canal",
            href: "/profile?tab=comm",
          });
          if (db.alerts_prefs_missing) goals.push({
            kind: "alertes",
            aline: "→ Choisir ce qui mérite un email — alertes critiques, point du jour, digest",
            sub: "vos préférences d’alertes n’ont jamais été posées",
            goal_fr: "Choisir ce qui mérite un email", link_fr: "Régler vos alertes",
            href: "/notifications",
          });
          if (!db.margin_declared) goals.push({
            kind: "marge",
            aline: "→ Déclarer votre marge — débloque le KPI profit",
            sub: "une phrase dans Explorer, c’est tout",
            goal_fr: "Débloquer le KPI profit", link_fr: "Déclarer votre marge (une phrase)",
            href: "/app/insightevent/prompt?q=" + encodeURIComponent("Ma marge est d’environ  %"),
          });
          return goals;
        }
        function goalsChips(j, rest) {
          var db = j.debloquer || {};
          var out = [];
          if (db.declared_no_replay) out.push(db.declared_no_replay + " dispositif" + (db.declared_no_replay > 1 ? "s" : ""));
          var nb = rest.filter(function (g) { return g.kind === "bilan"; }).length;
          if (nb) out.push(nb + " bilan" + (nb > 1 ? "s" : ""));
          if (rest.some(function (g) { return g.kind === "documenter"; })) out.push((db.to_document || 1) + " à documenter");
          if (rest.some(function (g) { return g.kind === "fraicheur" || g.kind === "ventes"; })) out.push("ventes");
          if (rest.some(function (g) { return g.kind === "premier_test"; })) out.push("premier test");
          if (rest.some(function (g) { return g.kind === "equipe" || g.kind === "canaux"; })) out.push("équipe/canaux");
          else if (rest.some(function (g) { return g.kind === "alertes"; })) out.push("alertes");
          if (!db.margin_declared) out.push("KPI profit");
          return out;
        }

        function siteChip(label) { return J.multi_site && label ? '<span class="tb-chip" style="background:#F3F4F6;color:#6b7280;">' + esc(label) + '</span>' : ""; }
        function occRow(eur, eurColor, eurTip, phrase, phraseTip, action) {
          return '<div class="tb-occrow">'
            + '<span style="font-weight:700;color:' + eurColor + ';white-space:nowrap;cursor:help;" title="' + esc(eurTip || "") + '">' + eur + '</span>'
            + '<span style="min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"' + (phraseTip ? ' title="' + esc(phraseTip) + '"' : "") + '>' + phrase + '</span>'
            + action
            + '</div>';
        }
        function row3(href, o3) {
          return '<a class="tb-row3" href="' + href + '">'
            + '<span><span style="font-size:11px;font-weight:700;color:' + o3.jColor + ';">' + o3.j + '</span>' + (o3.jsub ? '<span style="display:block;font-size:9.5px;color:#9CA3AF;line-height:1.3;">' + o3.jsub + '</span>' : "") + '</span>'
            + '<span style="width:8px;height:8px;border-radius:50%;background:' + o3.dot + ';justify-self:center;cursor:help;" title="' + esc(o3.dotTip || "") + '"></span>'
            + '<span style="min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:600;" title="' + esc(o3.titleTip || o3.title) + '">' + esc(o3.title) + '</span>'
            + '<span style="display:inline-flex;gap:4px;">' + (o3.chips || "") + '</span>'
            + '<span style="font-size:11px;color:#6b7280;white-space:nowrap;cursor:help;" title="' + esc(o3.rightTip || "") + '">' + (o3.right || "") + '</span>'
            + (o3.who ? '<span title="' + esc(o3.who) + '" style="width:20px;height:20px;border-radius:50%;background:#EEF2FF;color:#1D3BB3;display:inline-flex;align-items:center;justify-content:center;font-weight:700;font-size:9.5px;cursor:help;">' + esc(initials(o3.who)) + '</span>' : '<span></span>')
            + '<span class="tb-rarr">›</span></a>';
        }

        function render() {
          var j = J;
          var html = "";
          var im = impactFor(period);
          var db = j.debloquer || {};
          var pc = j.practice_counts || { proven: 0, rejeu: 0, declared: 0 };
          var replayEnd = (db.replays_running || [])[0] ? db.replays_running[0].end : null;

          // ── ÉTAGE 1 : Impact — chiffres + micro-libellés ; la prose s'ouvre au clic. ──
          var periodSel = '<span style="display:inline-flex;gap:12px;font-size:11.5px;">'
            + [[30, "30 j"], [90, "90 j"], [365, "12 mois"]].map(function (p) {
                var on = p[0] === period;
                return '<button type="button" data-tb-period="' + p[0] + '" style="font-family:inherit;border:none;background:none;padding:0;cursor:pointer;' + (on ? "color:#111827;font-weight:600;text-decoration:underline;text-underline-offset:3px;" : "color:#9CA3AF;") + '">' + p[1] + "</button>";
              }).join("") + "</span>";
          var seuilsCase = im.gap_eur != null && im.windows_judged > 0 && im.targets_met === 0 && im.gap_eur > 0;
          var lecture = null;
          if (seuilsCase)
            lecture = "Les fenêtres rapportent (" + signEur(im.gap_eur) + " vs attendu) mais aucune cible n’est tenue — vos seuils sont trop hauts d’un cran. À recalibrer au prochain engagement.";
          else if (im.gap_eur != null && im.gap_eur > 0 && im.targets_met > 0)
            lecture = signEur(im.gap_eur) + " vs attendu et " + im.targets_met + " cible" + (im.targets_met > 1 ? "s" : "") + " tenue" + (im.targets_met > 1 ? "s" : "") + " sur " + im.windows_judged + " — rejouez ce qui tient (Dispositifs).";
          else if (im.gap_eur != null && im.gap_eur < 0)
            lecture = "Fenêtres sous l’attendu (" + signEur(im.gap_eur) + ") — resserrez sur les dispositifs prouvés.";
          var lv = j.last_verdict || null;
          var eurTip = im.eur_windows + " fenêtre" + (im.eur_windows > 1 ? "s" : "") + " mesurée" + (im.eur_windows > 1 ? "s" : "") + (im.confounded ? " · " + im.confounded + " écartée" + (im.confounded > 1 ? "s" : "") + " (facteur externe)" : "") + " · jamais extrapolé";
          html += '<div class="tb-card" style="padding:16px;">'
            + '<div style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px;flex-wrap:wrap;"><p class="tb-eb" style="cursor:help;" title="Somme des écarts mesurés des fenêtres engagées jugées — jamais extrapolé.">Impact mesuré de vos opérations</p><span style="display:inline-flex;align-items:baseline;gap:8px;">' + periodSel + '<span style="font-size:10.5px;color:#9CA3AF;">filtre l’Impact seul</span></span></div>'
            + '<div style="display:flex;gap:32px;flex-wrap:wrap;align-items:flex-start;">'
            + '<div><div style="font-size:28px;font-weight:600;line-height:1;color:' + (im.gap_eur == null ? "#111827" : im.gap_eur >= 0 ? "#059669" : "#B45309") + ';">' + (im.gap_eur == null ? "— €" : signEur(im.gap_eur)) + '</div>'
            + '<div style="font-size:10.5px;color:#9CA3AF;margin-top:5px;cursor:help;" title="' + esc(eurTip) + '">vs attendu · ' + period + ' j</div></div>'
            + '<div><div style="font-size:28px;font-weight:600;line-height:1;">' + im.targets_met + '<span style="font-size:14px;color:#9CA3AF;font-weight:500;">/' + im.windows_judged + '</span></div>'
            + '<div style="font-size:10.5px;color:#9CA3AF;margin-top:5px;">cibles tenues' + (im.next_judgment === TODAY ? " · verdict auj." : im.next_judgment ? " · prochaine " + frD(im.next_judgment) : "") + '</div>'
            + (seuilsCase ? '<button type="button" data-tb-lect class="tb-chip" style="background:#FEF3E2;color:#B45309;border:none;cursor:pointer;font-family:inherit;font-weight:600;margin-top:6px;">Seuils trop hauts ?</button>' : "")
            + '</div>'
            + '<div><div style="font-size:28px;font-weight:600;line-height:1;">' + im.practices_proven + '</div>'
            + '<div style="font-size:10.5px;color:#9CA3AF;margin-top:5px;">prouvé' + (im.practices_proven > 1 ? "s" : "") + (pc.rejeu ? " · " + pc.rejeu + " en rejeu" : "") + (pc.declared ? " · " + pc.declared + " déclaré" + (pc.declared > 1 ? "s" : "") : "") + '</div></div>'
            + '</div>';
          if (lv) html += '<button type="button" data-tb-lect style="display:flex;align-items:center;gap:6px;margin-top:12px;padding:0;background:none;border:none;font-family:inherit;font-size:12px;color:#6b7280;cursor:pointer;">'
            + '<span style="width:8px;height:8px;border-radius:50%;background:' + (VERDICT_COL[lv.verdict] || "#6b7280") + ';flex:none;"></span>'
            + 'dernier verdict : <span style="font-weight:600;color:' + (VERDICT_COL[lv.verdict] || "#6b7280") + ';">' + (VERDICT_FR[lv.verdict] || esc(lv.verdict)).split(" (")[0] + '</span> · ' + frD(lv.we) + ' <span style="font-size:10px;">▾</span></button>';
          if (lecture || lv) {
            html += '<div id="tb-lecture" class="tb-fold">'
              + (lecture ? '<div><span style="font-weight:600;">Lecture :</span> ' + esc(lecture) + '</div>' : "")
              + (lv ? '<div style="color:#6b7280;">Dernier verdict : « ' + esc(trunc(lv.text, 70)) + ' » — ' + (VERDICT_FR[lv.verdict] || esc(lv.verdict)) + (lv.gap_eur != null && lv.verdict !== "confounded" ? " · " + signEur(lv.gap_eur) + " vs attendu" : lv.verdict !== "confounded" ? " · € en cours de mesure" : "") + " (" + dowFr(lv.we) + " " + frD(lv.we) + ")</div>" : "")
