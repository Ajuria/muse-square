            panel.querySelectorAll("[data-tb-body]").forEach(function (o) { o.style.display = "none"; });
            Object.keys(openVolets).forEach(function (kk) { if (kk !== k) openVolets[kk] = false; });
            var meta = null; voletMeta.forEach(function (vm) { if (vm.id === k) meta = vm; });
            var head = panel.querySelector("[data-tb-rphead]");
            if (!head) {
              panel.innerHTML = '<div data-tb-rphead style="display:flex;align-items:center;gap:8px;margin-bottom:8px;"><span data-tb-rpdot style="width:8px;height:8px;border-radius:50%;display:inline-block;"></span><span data-tb-rplabel style="font-weight:650;font-size:13px;"></span><span style="flex:1;"></span><button type="button" data-tb-rpclose style="background:none;border:none;color:#9CA3AF;font-size:12px;cursor:pointer;font-family:inherit;">fermer ▴</button></div>';
              panel.querySelector("[data-tb-rpclose]").addEventListener("click", function () {
                panel.style.display = "none";
                Object.keys(openVolets).forEach(function (kk) { openVolets[kk] = false; });
                body.querySelectorAll(".tb-rb").forEach(function (c2) { c2.classList.remove("on"); });
              });
            }
            if (meta) {
              panel.querySelector("[data-tb-rpdot]").style.background = meta.dot;
              var lblEl = panel.querySelector("[data-tb-rplabel]");
              lblEl.innerHTML = ""; lblEl.textContent = String(meta.label).replace(/<[^>]+>/g, "");
            }
            panel.appendChild(v);
            v.style.display = "block";
            panel.style.display = "block";
            openVolets[k] = true;
            body.querySelectorAll(".tb-rb").forEach(function (c2) { c2.classList.toggle("on", c2.getAttribute("data-tb-rb") === k); });
            if (scroll) panel.scrollIntoView({ behavior: "smooth", block: "nearest" });
          }
          Object.keys(openVolets).forEach(function (k) { if (openVolets[k]) openVolet(k, false); });
          // Tuiles héros cliquables (proto 17/08) : chacune mène à sa section.
          body.querySelectorAll("[data-tb-tile]").forEach(function (t) {
