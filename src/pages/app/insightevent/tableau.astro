          // Découverte (23/08) : POST discover-competitors, puis les candidats s'insèrent sous la
          // rangée, chacun = rangée « Suivez X » (même afRow, même bouton data-tb-follow,
          // place_id vide — add-competitor géocode par nom + ville).
          var bindFollow;
          body.querySelectorAll("[data-tb-discover]").forEach(function (b) {
            b.addEventListener("click", function () {
              if (b.disabled) return;
              b.disabled = true; b.textContent = "Recherche\u2026";
              var row = b.closest(".tb-af") || b.parentNode;
              fetch("/api/competitive/discover-competitors", {
                method: "POST", headers: { "content-type": "application/json" },
                body: JSON.stringify({ location_id: b.getAttribute("data-tb-discover") }),
              }).then(function (r) { return r.json(); }).then(function (jj) {
                var cands = (jj && jj.ok && jj.candidates) || [];
                if (!cands.length) { b.textContent = "Rien trouv\u00e9"; b.disabled = true; return; }
                b.textContent = cands.length + " trouv\u00e9" + (cands.length > 1 ? "s" : "");
                var frag = document.createElement("div");
                // La phrase de la page source (preuve de l'agent) vit en infobulle du titre ;
                // le sous-titre est le bénéfice approuvé du verbe Suivre (BENEFICE, afRow).
                frag.innerHTML = cands.map(function (c) {
                  return afRow({ rang: 4, iso: null, col: AMBER,
                    titre: "Suivez " + trunc(c.competitor_name, 40),
                    tip: c.source_sentence || c.city || "",
                    geste: '<button type="button" class="tb-link" data-tb-follow="" data-tb-follow-nom="' + esc(c.competitor_name) + '" data-tb-follow-city="' + esc(c.city || "") + '" data-tb-follow-addr="' + esc(c.address || "") + '" data-tb-follow-url="' + esc(c.source_url || "") + '" data-tb-follow-loc="' + esc(b.getAttribute("data-tb-discover")) + '" style="background:none;border:none;padding:0;font-family:inherit;cursor:pointer;">Suivre \u2192</button>' });
                }).join("");
                var after = row; while (frag.firstChild) { after = row.parentNode.insertBefore(frag.firstChild, after.nextSibling); }
                bindFollow(row.parentNode);
              }).catch(function () { b.disabled = false; b.textContent = "Chercher \u2192"; });
            });
          });
          bindFollow = function (scope) { scope.querySelectorAll("[data-tb-follow]:not([data-tb-bound])").forEach(function (b) {
            b.setAttribute("data-tb-bound", "1");
            b.addEventListener("click", function () {
              if (b.disabled) return;
              b.disabled = true; b.textContent = "Ajout\u2026";
              fetch("/api/competitive/add-competitor", {
                method: "POST", headers: { "content-type": "application/json" },
                body: JSON.stringify({
                  // Le site du TROU, jamais le site courant de la page (bug 16/08 : Occitanie
                  // suivait un musée parisien).
                  location_id: b.getAttribute("data-tb-follow-loc") || loc,
                  competitor_name: b.getAttribute("data-tb-follow-nom") || "",
                  city: b.getAttribute("data-tb-follow-city") || "",
                  google_place_id: b.getAttribute("data-tb-follow") || "",
                  address: b.getAttribute("data-tb-follow-addr") || undefined,
                  source_url: b.getAttribute("data-tb-follow-url") || undefined,
                }),
              }).then(function (r) { return r.json(); }).then(function (jj) {
                if (jj && jj.ok) { b.textContent = "Suivi \u2713"; b.style.color = "#059669"; b.title = "Dans votre veille \u2014 premi\u00e8re lecture cette nuit"; }
                else { b.disabled = false; b.textContent = "Suivre \u2192"; alert("Ajout impossible : " + ((jj && jj.error) || "r\u00e9essayez")); }
              }).catch(function () { b.disabled = false; b.textContent = "Suivre \u2192"; });
            });
          }); };
          bindFollow(body);
          // Événements publics (19/08) : dépliage « au-delà » + filtre « même public » — bascule
          // d'affichage sur des rangées PRÉ-RENDUES, aucun re-calcul.
          body.querySelectorAll("[data-ep-beyond]").forEach(function (b) {
            b.addEventListener("click", function (ev) {
              ev.preventDefault();
              var l2 = body.querySelector('[data-ep-beyond-list="' + (b.getAttribute("data-ep-beyond") || "").replace(/"/g, '\\"') + '"]');
              if (l2) l2.style.display = l2.style.display === "none" ? "block" : "none";
            });
          });
          body.querySelectorAll("[data-ep-flt-row]").forEach(function (row2) {
            var loc3 = row2.getAttribute("data-ep-flt-row");
            row2.querySelectorAll("[data-ep-flt]").forEach(function (b) {
              b.addEventListener("click", function () {
                row2.querySelectorAll("[data-ep-flt]").forEach(function (x2) { x2.style.border = "1px solid rgba(0,0,0,0.08)"; x2.style.color = "#6b7280"; x2.style.background = "#fff"; });
                b.style.border = "1px solid #1D3BB3"; b.style.color = "#1D3BB3"; b.style.background = "#EEF2FF";
                var commun = b.getAttribute("data-ep-flt") === "commun";
                var list2 = body.querySelector('[data-ep-list="' + loc3 + '"]');
                if (!list2) return;
                var shown = 0;
                list2.querySelectorAll("[data-ep-row]").forEach(function (r3) {
