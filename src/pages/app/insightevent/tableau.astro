          body.querySelectorAll("[data-tb-lect]").forEach(function (b) {
            b.addEventListener("click", function () { var l = document.getElementById("tb-lecture"); if (l) l.style.display = l.style.display === "none" || !l.style.display ? "block" : "none"; });
          });
          body.querySelectorAll("[data-tb-fold]").forEach(function (b) {
            b.addEventListener("click", function () { var l = document.getElementById(b.getAttribute("data-tb-fold")); if (l) l.style.display = l.style.display === "none" || !l.style.display ? "block" : "none"; });
          });
          // M'engager sur un apprentissage : MÊME machinerie que les chantiers structurels de
          // Pulse (origin structural_<class_key> + clé de suppression) — jamais un chemin parallèle.
          body.querySelectorAll("[data-tb-engage]").forEach(function (b) {
            b.addEventListener("click", function (ev) {
              ev.preventDefault();
              var li = Number(b.getAttribute("data-tb-engage"));
              var r = (window._tbLearnings || [])[li];
              var panel = body.querySelector('[data-tb-engage-panel="' + li + '"]');
              if (!r || !panel) return;
              if (panel.style.display === "block") { panel.style.display = "none"; panel.innerHTML = ""; return; }
              panel.style.display = "block";
