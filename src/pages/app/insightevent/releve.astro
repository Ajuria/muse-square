---
// « /app/insightevent/releve » — LE RELEVÉ DE L'ESPACE (docs/marche-guidee-spec.md § 9 point 3).
//
// La marche dans le magasin, le téléphone à la main : la caméra s'ouvre DANS la page à « Commencer le
// relevé », garde une photo par Point focal (arrêt d'environ 1,5 s), et se clôt sur UNE page, une
// section par pôle. Décisions owner du 11/09 (M1 une seule boucle qui traverse les pôles ; M2 une photo
// par arrêt, AUCUNE vidéo produite ni envoyée ; M5 le pôle vient du geste, jamais de la position ;
// M7 la caméra dans la page, repli par l'appareil du téléphone) ; mots ratifiés le 12/09 (lexique l. 101-103).
//
// Cette page REMPLACE le proto `tools/proto/releve-espace-proto.html`, supprimé dans ce commit (règle
// de placement : un proto meurt dans le commit qui livre sa surface). Sa logique de détection est
// portée à l'identique dans `public/js/releve-espace.js` — mêmes seuils, mêmes identifiants de nœuds,
// mêmes harnais `__releveStep`/`__releveState`, pour que la vérification du 12/09 continue de valoir.
//
// Les pôles sont lus ICI, côté serveur (foyer `listPoles`, couche semantic — jamais `analytics`) : la
// page s'ouvre avec eux, aucun aller-retour client avant de pouvoir marcher. Même résolution de site
// que `map.astro` : le site de l'URL s'il est possédé ou en membership, sinon celui de la session.
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { Show } from "@clerk/astro/components";
import { makeBQClient } from "../../../lib/bq";
import { listPoles } from "../../../lib/dispositifs/poleReading";
import { EVOL_COPY } from "../../../lib/commitments/commitmentCopy";

const locals_location_id =
  (Astro.locals && typeof (Astro.locals as any).location_id === "string" && (Astro.locals as any).location_id.trim())
    ? (Astro.locals as any).location_id.trim()
    : null;
if (!locals_location_id) return Astro.redirect("/profile");

const url_location_id = (Astro.url?.searchParams?.get("location_id") ?? "").trim();
const _ownedIds: string[] = Array.isArray((Astro.locals as any).all_location_ids) ? (Astro.locals as any).all_location_ids.map(String) : [];
const _memberIds: string[] = Array.isArray((Astro.locals as any).member_location_ids) ? (Astro.locals as any).member_location_ids.map(String) : [];
const location_id = (!!url_location_id && (_ownedIds.includes(url_location_id) || _memberIds.includes(url_location_id)))
  ? url_location_id : locals_location_id;

// 14/09 (owner : « Tu ne demandes pas pour quelle location je filme ») — LE SITE EST NOMMÉ, ET SE
// CHOISIT. Son compte porte TROIS sites et un seul a des pôles : pris en silence, le relevé s'ouvrait
// vide sur les deux autres, sans rien dire. Même défaut que la carte le 09/09, même correctif : le nom
// du site est affiché, et un compte à plusieurs sites bascule ici même. Le nombre de pôles est dit
// DANS la liste — on ne choisit pas un site à l'aveugle.
// Le cache des pages /app est interdit par le middleware (`sansCachePourLApp`), pas ici : le garde
// Clerk répond avant qu'une page s'exécute, donc un en-tête posé dans la page ne couvre pas tout.
// Le marqueur de version, affiché : c'est LUI qui répond à « quelle version as-tu exécutée ? ».
const BUILD = String(process.env.VERCEL_GIT_COMMIT_SHA || "local").slice(0, 7);

// Les pôles du site, avec les composants de leur VERSION COURANTE : la seconde question du relevé
// (« Quel composant ? ») n'a que ceux du pôle touché, donc trois ou quatre boutons — pas un tri.
let poles: Array<{ dispositif_id: string; commitment_id: string | null; name: string; components: Array<{ component_key: string; label: string | null; type_label_fr: string | null; role_label_fr: string | null; fixture_no: number | null }> }> = [];
let sites: Array<{ location_id: string; label: string; poles: number }> = [];
try {
  const bq = makeBQClient(process.env.BQ_PROJECT_ID || "muse-square-open-data");
  const PROJ = process.env.BQ_PROJECT_ID || "muse-square-open-data";
  const _ids = Array.from(new Set([location_id, ..._ownedIds, ..._memberIds].filter(Boolean)));
  // Une seule requête pour les sites du compte : leur nom ET combien de pôles chacun porte. Amorcée
  // en parallèle des pôles du site courant — aucun aller-retour en série (budget 3 s).
  const sitesP = _ids.length > 1 ? bq.query({
    query: `WITH noms AS (
              SELECT location_id, ANY_VALUE(site_name) AS label
              FROM \`${PROJ}.semantic.vw_insight_event_ai_location_context\`
              WHERE location_id IN UNNEST(@ids) GROUP BY 1),
            p AS (
              SELECT location_id, COUNT(DISTINCT dispositif_id) AS n
              FROM \`${PROJ}.semantic.vw_insight_event_dispositif_components\`
              WHERE location_id IN UNNEST(@ids) AND status = 'open' GROUP BY 1)
            SELECT noms.location_id, noms.label, COALESCE(p.n, 0) AS n
            FROM noms LEFT JOIN p USING (location_id) ORDER BY noms.label`,
    params: { ids: _ids }, types: { ids: ["STRING"] }, location: "EU",
  }).then((r: any) => (Array.isArray(r?.[0]) ? r[0] : [])).catch(() => []) : Promise.resolve([] as any[]);
  const polesP = listPoles(bq, location_id);
  // Le N\u00b0 DU PLAN de chaque meuble (owner 14/09). Il ne se d\u00e9duit PAS de la cl\u00e9 : `parseComponents`
  // fabrique une cl\u00e9 absente avec `randomUUID().slice(0, 8)` \u2014 les `p1\u2026p52` de ce compte viennent du
  // semis, pas d'une r\u00e8gle. Le num\u00e9ro est une valeur D\u00c9CLAR\u00c9E, lue \u00e0 sa source : la mesure d'espace,
  // par la vue semantic (jamais `analytics`). La vue a le grain famille \u2014 d'o\u00f9 le regroupement ; le
  // num\u00e9ro le plus r\u00e9cent gagne si un meuble a \u00e9t\u00e9 remesur\u00e9. Amorc\u00e9e en PARALL\u00c8LE (budget 3 s).
  const numsP = bq.query({
    query: `SELECT dispositif_id, component_key,
                   ARRAY_AGG(fixture_no IGNORE NULLS ORDER BY version_no DESC, measured_at DESC LIMIT 1)[SAFE_OFFSET(0)] AS fixture_no
            FROM \`${PROJ}.semantic.vw_insight_event_component_space\`
            WHERE location_id = @l AND component_key IS NOT NULL
            GROUP BY 1, 2`,
    params: { l: location_id }, types: { l: "STRING" }, location: "EU",
  }).then((r: any) => (Array.isArray(r?.[0]) ? r[0] : [])).catch(() => []);
  const [_sites, _poles, _nums] = await Promise.all([sitesP, polesP, numsP]);
  const flat = (v: any): any => (v && typeof v === "object" && "value" in v ? v.value : v);
  sites = (_sites as any[]).map((r) => ({ location_id: String(flat(r.location_id)), label: String(flat(r.label) || ""), poles: Number(flat(r.n)) || 0 }))
    .filter((x) => x.label);
  const numeros = new Map<string, number>();
  for (const r of _nums as any[]) {
    const n = Number(flat(r.fixture_no));
    if (Number.isFinite(n) && n > 0) numeros.set(`${String(flat(r.dispositif_id))}:${String(flat(r.component_key))}`, n);
  }
  poles = _poles.map((p) => ({
    dispositif_id: p.dispositif_id,
    commitment_id: p.commitment_id,
    name: p.name,
    components: (p.components || []).map((c) => ({
      component_key: c.component_key,
      label: c.label,
      type_label_fr: c.type_label_fr,
      role_label_fr: c.role_label_fr,
      fixture_no: numeros.get(`${p.dispositif_id}:${c.component_key}`) ?? null,
    })),
  }));
} catch { poles = []; }

// Les chaînes visibles vivent au foyer du lexique et voyagent par define:vars — jamais recopiées
// dans le module client. Les trois `capture_*` et `pole_photo_*` sont celles du rail de la photo.
// Les chaînes visibles vivent au foyer du lexique et voyagent par define:vars — jamais recopiées dans
// le module client. Le filtre est par PRÉFIXE, et c'est délibéré : une liste de clés écrite à la main
// a déjà trahi une fois (14/09 — les consignes et les états, ajoutés au foyer, n'étaient pas dans la
// liste, donc absents de la page alors que le harnais, qui filtre par préfixe, les avait). Le harnais
// `tools/harness/releve-verify.mts` applique EXACTEMENT le même filtre : les deux ne peuvent plus
// divergerpar omission.
const RELEVE_COPY: Record<string, string> = Object.fromEntries(
  Object.entries(EVOL_COPY as Record<string, unknown>)
    .filter(([k, v]) => typeof v === "string"
      && (k.startsWith("releve_") || k.startsWith("capture_") || k.startsWith("pole_photo_")))
    .map(([k, v]) => [k, String(v)]),
);
---

<Show when="signed-out" client:load>
  <meta http-equiv="refresh" content="0; url=/sign-in" />
</Show>

<Show when="signed-in" client:load>
  <BaseLayout title="Relevé de l'espace — Muse Square" hideSurveyCta={true} hideFooter={true}>
    <div class="ms-container" id="rl-root">
      <div id="rl-toolbar">
        <a id="rl-back" href="/app/insightevent/tableau">{"← " + EVOL_COPY.back_pole}</a>
        <span id="rl-clock">0:00</span>
      </div>
      <h1 id="rl-title">{EVOL_COPY.releve_titre}</h1>
      <!-- LE SITE, nommé et choisi (owner 14/09). Même patron que le sélecteur de la carte : le nom du
           site EST son libellé, aucun mot nouveau. Le marqueur à droite dit quelle version tourne. -->
      <div id="rl-site">
        {sites.length > 1
          ? <select id="rl-site-sel">
              {sites.map((x) => (<option value={x.location_id} selected={x.location_id === location_id}>{x.label}</option>))}
            </select>
          : <span>{(sites[0] && sites[0].label) || ""}</span>}
        <span id="rl-build" title="version">{BUILD}</span>
      </div>
      <div id="rl-doc">
        <!-- FORME C (owner 14/09, choisie sur proto) — trois lignes avant de marcher : ce qui se passe,
             comment cadrer, comment changer de pôle. La première dit la seule chose qu'on ne peut pas
             deviner : que la photo part toute seule. Le mot est « meuble » (owner 14/09) ; la base
             garde « composant ». -->
        <!-- 14/09 (owner) — LE CADRAGE SE MONTRE, IL NE S'ÉCRIT PAS. Trois phrases de 13 px que
             « personne ne lira sur un téléphone » ; deux décrivaient un cadrage, qu'un dessin porte mieux.
             LE MÊME meuble dans les trois cadres (un seul `<g>`, réutilisé) : bien cadré, agrandi — il
             déborde —, puis de trois quarts — les tablettes fuient. Trois dessins différents compareraient
             trois dessins, pas trois cadrages. C'est le découpage qui fait voir « trop près », pas une
             légende. La phrase qui reste dit le DÉCLENCHEMENT : un comportement ne se dessine pas. -->
        <svg id="rl-croquis" viewBox="0 0 366 272" role="img" aria-label={EVOL_COPY.releve_consigne_2}>
          <defs>
            <g id="meuble">
              <path d="M0 0 H78 V116 H0 Z" fill="#FCFCFD"/>
              <path d="M0 0 V116 M78 0 V116" stroke="#111827" stroke-width="2.4" fill="none" stroke-linecap="square"/>
              <path d="M0 0 H78" stroke="#111827" stroke-width="2.4"/>
              <path d="M-2 116 H80" stroke="#111827" stroke-width="3" stroke-linecap="round"/>
              <g stroke="#111827" stroke-width="1.6"><path d="M0 30 H78"/><path d="M0 59 H78"/><path d="M0 88 H78"/></g>
              <g fill="#DDE3F7" stroke="#1D3BB3" stroke-width="1.1">
                <path d="M9 30 V16 q0-3 2-4 V8 h4 v4 q2 1 2 4 V30 Z"/><path d="M21 30 V16 q0-3 2-4 V8 h4 v4 q2 1 2 4 V30 Z"/>
                <path d="M33 30 V16 q0-3 2-4 V8 h4 v4 q2 1 2 4 V30 Z"/><path d="M45 30 V16 q0-3 2-4 V8 h4 v4 q2 1 2 4 V30 Z"/>
                <path d="M57 30 V16 q0-3 2-4 V8 h4 v4 q2 1 2 4 V30 Z"/>
              </g>
              <g fill="#EEF2FF" stroke="#1D3BB3" stroke-width="1.1">
                <rect x="8" y="42" width="13" height="17" rx="2.5"/><rect x="25" y="42" width="13" height="17" rx="2.5"/>
                <rect x="42" y="42" width="13" height="17" rx="2.5"/><rect x="59" y="42" width="11" height="17" rx="2.5"/>
              </g>
              <g stroke="#1D3BB3" stroke-width="1.1" fill="none"><path d="M10 45 H19 M27 45 H36 M44 45 H53 M61 45 H68"/></g>
              <g fill="#F4F6FE" stroke="#1D3BB3" stroke-width="1.1">
                <rect x="8" y="69" width="10" height="19"/><rect x="20" y="69" width="10" height="19"/>
                <rect x="32" y="69" width="10" height="19"/><rect x="44" y="69" width="10" height="19"/>
                <rect x="56" y="69" width="14" height="19"/>
              </g>
              <g fill="#EEF2FF" stroke="#1D3BB3" stroke-width="1.1">
                <rect x="8" y="98" width="30" height="18" rx="1.5"/><rect x="42" y="98" width="28" height="18" rx="1.5"/>
              </g>
              <path d="M23 98 V116 M56 98 V116" stroke="#1D3BB3" stroke-width="1" opacity=".7"/>
            </g>
            <clipPath id="rlc1"><rect x="8" y="16" width="102" height="184" rx="9"/></clipPath>
            <clipPath id="rlc2"><rect x="132" y="16" width="102" height="184" rx="9"/></clipPath>
            <clipPath id="rlc3"><rect x="256" y="16" width="102" height="184" rx="9"/></clipPath>
          </defs>
          <g clip-path="url(#rlc1)"><use href="#meuble" transform="translate(20 46) scale(0.99)"/></g>
          <rect x="8" y="16" width="102" height="184" rx="9" fill="none" stroke="#111827" stroke-width="2.6"/>
          <g stroke="#0F6E56" stroke-width="1.4" stroke-dasharray="3,4" opacity=".85">
            <path d="M14 46 H18 M14 164 H18"/><path d="M16 46 V164"/>
          </g>
          <circle cx="59" cy="224" r="13.5" fill="#0F6E56"/>
          <path d="M53 224 l4 5 l9 -11" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
          <text x="59" y="256" text-anchor="middle" font-size="12.5" fill="#111827" font-weight="600">{EVOL_COPY.releve_cadre_bon}</text>
          <g clip-path="url(#rlc2)"><use href="#meuble" transform="translate(126 6) scale(1.55)"/></g>
          <rect x="132" y="16" width="102" height="184" rx="9" fill="none" stroke="#111827" stroke-width="2.6"/>
          <circle cx="183" cy="224" r="13.5" fill="#B45309"/>
          <path d="M177 218 l12 12 M189 218 l-12 12" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round"/>
          <text x="183" y="256" text-anchor="middle" font-size="12.5" fill="#6B7280">{EVOL_COPY.releve_cadre_pres}</text>
          <g clip-path="url(#rlc3)"><use href="#meuble" transform="translate(276 48) scale(0.95) skewY(9) scale(0.88 1)"/></g>
          <rect x="256" y="16" width="102" height="184" rx="9" fill="none" stroke="#111827" stroke-width="2.6"/>
          <circle cx="307" cy="224" r="13.5" fill="#B45309"/>
          <path d="M301 218 l12 12 M313 218 l-12 12" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round"/>
          <text x="307" y="256" text-anchor="middle" font-size="12.5" fill="#6B7280">{EVOL_COPY.releve_cadre_biais}</text>
        </svg>
        <p id="rl-declenche">{EVOL_COPY.releve_consigne_1}</p>
        <nav id="poles"></nav>
        {poles.length === 0 && <p id="rl-sans-pole">{EVOL_COPY.capture_aucun_pole}</p>}
        <button id="mainBtn" type="button" class="ms-btn" disabled={poles.length === 0}>{EVOL_COPY.releve_commencer}</button>
        <div id="summary">
          <div id="sumEtat"></div>
          <div id="sumBilan" style="display:none;"></div>
          <div id="sumBody"></div>
          <div class="rl-row">
            <button id="sumBack" type="button" class="ms-btn">{EVOL_COPY.releve_reprendre}</button>
            <a id="sumDl" class="ms-btn" download="releve-espace.json" href="#">{EVOL_COPY.releve_compte_rendu}</a>
          </div>
        </div>
      </div>

      <!-- 14/09 (owner) — « quand on filme, on devrait être en format vertical full page avec juste le
           bouton arrêter visible, c'est tout ». Le viseur n'est plus une vignette dans le document :
           c'est un calque plein écran. Dedans : l'image, le nom du pôle (qu'on touche pour en changer),
           l'état EN MOTS, et le bouton qui arrête. Rien d'autre — la bande des cartes et le cadre de
           couleur sont retirés : deux décorations dont il fallait devenir la légende. -->
      <div id="capture" hidden>
        <video id="cam" playsinline muted autoplay></video>
        <button id="poleTag" type="button"></button>
        <div id="etat"></div>
        <button id="stopBtn" type="button">{EVOL_COPY.releve_fin}</button>
        <div id="overlay">
          <b id="ovTitle"></b><span id="ovText"></span>
          <label id="ovFile" class="ms-btn" hidden>{EVOL_COPY.releve_photo_appareil}<input id="fileIn" type="file" accept="image/*" capture="environment" /></label>
        </div>
        <div id="poleSheet" hidden><div id="poleSheetList"></div></div>
      </div>

      <div id="settings">
        <h2>Réglages</h2>
        <label>Seuil « bouge »</label><input id="tMove" type="number" step="0.5" min="1" max="40" />
        <label>Seuil « immobile »</label><input id="tStill" type="number" step="0.5" min="0.5" max="20" />
        <label>Immobilité avant la photo (ms)</label><input id="stillMs" type="number" step="100" min="300" max="5000" />
        <label>Fenêtre d'une photo plus nette (ms)</label><input id="winMs" type="number" step="100" min="0" max="4000" />
        <label>Netteté minimale</label><input id="sharpMin" type="number" step="10" min="0" max="20000" />
        <label>Luminosité minimale (0-255)</label><input id="brightMin" type="number" step="5" min="0" max="255" />
        <div class="rl-row"><button id="setCancel" type="button" class="ms-btn">Fermer</button><button id="setSave" type="button" class="ms-btn">Enregistrer</button></div>
      </div>
    </div>

    <style is:global>
      /* Le document : ce qu'on voit AVANT et APRÈS la marche. Pendant, c'est le calque plein écran. */
      #rl-root { max-width: 760px; margin: 0 auto; padding: 0 16px 90px; color: #111827; }
      #rl-toolbar { display: flex; justify-content: space-between; align-items: center; margin: 16px 0 12px; }
      #rl-back { font-size: 14px; color: #6b7280; text-decoration: none; }
      #rl-clock { font-size: 14px; color: #6b7280; font-variant-numeric: tabular-nums; user-select: none; -webkit-user-select: none; }
      #rl-title { font-size: 20px; font-weight: 600; margin: 0 0 12px; }
      #rl-site { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 0 0 12px; }
      #rl-site select, #rl-site > span:first-child { font: inherit; font-size: 15px; color: #111827; border: 0; background: transparent; padding: 0; }
      #rl-build { font-family: ui-monospace, monospace; font-size: 11px; color: #9CA3AF; }
      #rl-sans-pole { font-size: 13px; color: #6b7280; margin: 10px 0 0; }
      #rl-doc { background: #fff; border: 1px solid rgba(0,0,0,0.10); border-radius: 10px; padding: 12px; }
      #rl-croquis { display: block; width: 100%; height: auto; margin: 4px 0 2px; }
      #rl-declenche { margin: 0 2px 16px; font-size: 16px; line-height: 1.5; color: #111827; }
      #poles { display: flex; gap: 8px; overflow-x: auto; padding: 0 0 4px; -webkit-overflow-scrolling: touch; }
      #poles button { flex: 0 0 auto; border: 1px solid rgba(0,0,0,0.08); background: #fff; border-radius: 999px; padding: 10px 14px; font-size: 14px; color: #111827; font-family: inherit; min-height: 44px; }
      #poles button.on { background: var(--color-brand-blue, #0b37e5); border-color: var(--color-brand-blue, #0b37e5); color: #fff; }
      /* 14/09 (owner : « Pourquoi commencer le relevé n'est pas fixe en bas au bon endroit ? ») — LE
         GESTE PRINCIPAL NE BOUGE PAS. Il était dans le flux : ajouter une ligne de consigne le faisait
         descendre, et le pouce devait le chercher. Il est désormais FIXÉ en bas, au-dessus de la barre
         de navigation (--ms-bb-h, 74 px sous 768 px, 0 ailleurs) — la même place quel que soit le
         contenu au-dessus, et la même place que « Fin du relevé » pendant la prise de vue. */
      #mainBtn { position: fixed; left: 50%; transform: translateX(-50%);
                 width: min(728px, calc(100% - 32px)); height: 56px; z-index: 60; background: #fff;
                 bottom: calc(var(--ms-bb-h, 0px) + env(safe-area-inset-bottom, 0px) + 12px); }
      /* Le document se termine au-dessus du bouton : rien ne se cache dessous. */
      #rl-root { padding-bottom: calc(var(--ms-bb-h, 0px) + 92px); }

      /* ── LE CALQUE DE PRISE DE VUE : plein écran, vertical, l'image et rien qui parasite ── */
      #capture { position: fixed; inset: 0; z-index: 120; background: #000; overflow: hidden; }
      body.rl-filme { overflow: hidden; }
      #cam { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; background: #000; }
      /* Le pôle courant : un seul élément en haut, et c'est LUI qu'on touche pour en changer. */
      /* Le pôle et LE MEUBLE ATTENDU (le rang décide, spec M4) — avec sa photo quand on en a une : un
         nom partagé par six meubles ne dit rien, la photo du meuble si. */
      /* 14/09 (owner, photo du téléphone) — LA PASTILLE NE PREND PLUS TOUTE LA LARGEUR. Elle faisait
         `left: 12px; right: 12px` : un toucher en haut de l'image, destiné à prendre une photo,
         ouvrait la feuille des pôles. Elle se réduit à son contenu, et le reste du haut redevient du
         viseur. Elle garde une cible confortable (44 px de haut, 70 % de large au maximum). */
      #poleTag { position: absolute; top: calc(env(safe-area-inset-top, 0px) + 12px); left: 12px; display: inline-block;
                 max-width: 70%; background: rgba(17,24,39,.72); color: #fff; border: 0; border-radius: 20px; padding: 10px 14px;
                 font-size: 15px; font-family: inherit; text-align: left; min-height: 44px; }
      #poleTag .pt-l1 { display: block; font-weight: 600; }
      #poleTag .pt-l2 { display: flex; align-items: center; gap: 8px; margin-top: 4px; font-size: 13px; opacity: .92; }
      #poleTag .pt-l2 img { width: 32px; height: 32px; object-fit: cover; border-radius: 6px; flex: none; }
      /* L'ÉTAT EN MOTS — ce que la marche attend de vous, là, maintenant. Jamais une couleur seule. */
      /* L'état et le bouton se lisent sur N'IMPORTE QUELLE image : un fond sombre, jamais une ombre de
         texte seule — une étagère claire l'avalait (vu au harnais, 402 x 812, avant livraison). */
      #etat { position: absolute; left: 16px; right: 16px; top: 40%; bottom: auto;
              display: flex; justify-content: center; pointer-events: none; }
      #etat:empty { display: none; }
      #etat::before { content: attr(data-mot); color: #fff; font-size: 17px; line-height: 1.45; text-align: center;
              background: rgba(17,24,39,.72); border-radius: 999px; padding: 10px 16px; max-width: 100%; }
      #stopBtn { position: absolute; left: 16px; right: 16px; bottom: calc(env(safe-area-inset-bottom, 0px) + 20px); z-index: 2;
                 height: 56px; border-radius: 12px; border: 1px solid rgba(255,255,255,.9); background: rgba(17,24,39,.88); color: #fff;
                 font-family: inherit; font-size: 16px; font-weight: 600; text-transform: uppercase; letter-spacing: .3px; }
      /* La pastille reste visible par-dessus la feuille : on voit toujours quel pôle on quitte. */
      #poleTag { z-index: 2; }
      #overlay { position: absolute; inset: 0; display: none; align-items: center; justify-content: center; flex-direction: column; gap: 6px;
                 background: rgba(17,24,39,.62); color: #fff; text-align: center; padding: 24px; }
      #overlay b { font-size: 24px; font-weight: 600; }
      #overlay span { font-size: 15px; opacity: .92; }
      #overlay .ms-btn { margin-top: 14px; border-color: #fff; color: #fff; }
      #overlay input { display: none; }
      /* Changer de pôle : une feuille qui monte, touchée depuis le nom du pôle. */
      /* La feuille des pôles tombe SOUS la pastille et s'arrête au-dessus du bouton : elle ne peut plus
         cacher « Fin du relevé » (l'owner l'a vue manger 70 % de l'écran, bouton compris, et a conclu
         qu'il n'y avait pas de bouton d'arrêt). Toucher n'importe où ailleurs la referme. */
      #poleSheet { position: absolute; inset: 0; background: rgba(17,24,39,.55); }
      #poleSheetList { position: absolute; left: 12px; right: 12px; top: calc(env(safe-area-inset-top, 0px) + 64px);
                       max-height: calc(100% - env(safe-area-inset-top, 0px) - env(safe-area-inset-bottom, 0px) - 180px);
                       background: #fff; overflow: auto; border-radius: 14px; padding: 4px 0; box-shadow: 0 10px 30px rgba(0,0,0,.35); }
      #poleSheetList button { display: block; width: 100%; text-align: left; padding: 16px 20px; font-size: 16px; font-family: inherit;
                              color: #111827; background: none; border: 0; border-bottom: 1px solid #F3F4F6; min-height: 56px; }
      #poleSheetList button.on { color: #fff; background: var(--color-brand-blue, #0b37e5); }

      /* ── LA FIN DU RELEVÉ : une page, une section par pôle, l'enregistrement en arrière-plan ── */
      #summary { display: none; }
      #sumEtat { font-size: 13px; color: #374151; background: #F8FAFC; border: 1px solid #e5e7eb; border-radius: 8px; padding: 8px 10px; margin-bottom: 12px; }
      #summary .sec { margin: 0 0 18px; }
      #summary .sec h3 { font-size: 13px; letter-spacing: .06em; text-transform: uppercase; color: #111827; font-weight: 700; margin: 0 0 8px; }
      #summary .sec .n { font-size: 13px; color: #6b7280; margin: 0 0 6px; }
      /* 15/09 — LE BILAN DE LA MARCHE, en tête de la page de fin. Styles portés ICI et non en ligne :
         ce bloc est écrit par le kit dans un conteneur qui EXISTE dans la page, donc un bloc scopé
         l'atteint (à la différence du HTML injecté ailleurs, CLAUDE.md § Frontend). */
      #sumBilan { background: #FBFCFE; border: 1px solid #eef1f6; border-radius: 10px; padding: 12px 14px; margin-bottom: 14px; }
      .rl-bilan-t { font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: #111827; margin-bottom: 6px; }
      .rl-bilan-l { font-size: 13px; color: #374151; line-height: 1.55; }
      .rl-bilan-w { font-size: 12.5px; color: #B45309; margin-top: 6px; }
      .rl-shot { display: flex; gap: 10px; padding: 8px 0; border-bottom: 1px solid #F3F4F6; }
      .rl-shot img { width: 96px; height: 110px; object-fit: cover; border-radius: 6px; border: 1px solid #e5e7eb; flex: none; }
      .rl-shot .c { flex: 1; min-width: 0; }
      .rl-shot .t { font-size: 12px; color: #6b7280; margin-bottom: 4px; }
      .rl-shot .t b { color: #111827; font-weight: 600; }
      .rl-shot .w { font-size: 12px; color: #B45309; margin-bottom: 4px; }
      .rl-shot .qb { display: flex; align-items: center; gap: 8px; width: 100%; box-sizing: border-box; text-align: left; padding: 8px 10px; margin-bottom: 6px;
                     border: 1px solid #e5e7eb; border-radius: 8px; background: #fff; font-size: 14px; font-family: inherit; color: #111827; min-height: 48px; }
      .rl-shot .qb img { width: 36px; height: 36px; object-fit: cover; border-radius: 6px; flex: none; }
      /* Le meuble attribué : un bouton, parce qu'il se corrige — et sa photo quand elle existe. */
      .rl-comp { display: flex; align-items: center; gap: 8px; width: 100%; box-sizing: border-box; text-align: left; padding: 6px 8px; margin: 2px 0 6px;
                 border: 1px solid #e5e7eb; border-radius: 8px; background: #F8FAFC; font-size: 14px; font-family: inherit; color: #111827; min-height: 44px; }
      .rl-comp img { width: 36px; height: 36px; object-fit: cover; border-radius: 6px; flex: none; }
      .rl-comp[disabled] { opacity: .8; }
      .rl-liste { margin-bottom: 6px; }
      .rl-shot .rm { font-size: 12px; color: #6b7280; background: none; border: 0; font-family: inherit; padding: 4px 0; }
      #settings { display: none; position: fixed; inset: 0; background: #fff; z-index: 140; overflow: auto; padding: 16px; }
      #settings h2 { font-size: 16px; margin: 0 0 12px; }
      #settings label { display: block; margin: 12px 0 4px; font-size: 13px; color: #6b7280; }
      #settings input[type=number] { width: 100%; border: 1px solid rgba(0,0,0,0.08); border-radius: 6px; padding: 10px; font-size: 15px; }
      .rl-row { display: flex; gap: 8px; margin-top: 16px; }
      .rl-row .ms-btn { flex: 1; height: 44px; }
      a.ms-btn { text-decoration: none; }
    </style>

    <script is:inline define:vars={{ RL_POLES: poles, RL_COPY: RELEVE_COPY, RL_BUILD: BUILD, RL_LOC: location_id }}>
      // Le site et la version servie voyagent avec les p\u00f4les : la marche les \u00e9crit dans son contexte
      // (`/api/dispositifs/walks`), et sans eux on ne saurait pas de quel magasin ni de quel code vient
      // une photo ratee.
      window.MSReleve = { poles: RL_POLES, copy: RL_COPY, location_id: RL_LOC, build: RL_BUILD };
      // ── UNE PAGE PÉRIMÉE SE RÉPARE TOUTE SEULE (owner 14/09, quatre essais perdus) ────────────────
      // `no-store` empêche les prochaines mises en cache ; il n'efface pas celles déjà posées, et il ne
      // couvre pas la restauration d'onglet (bfcache) ni une application rouverte depuis l'écran
      // d'accueil. Deux gardes, et aucune ne demande quoi que ce soit à l'utilisateur :
      //   1. une page RESTAURÉE se recharge (pageshow.persisted) ;
      //   2. une page dont la version DIFFÈRE de celle du serveur se recharge UNE fois (garde en
      //      session : si le rechargement ne change rien, on n'entre pas en boucle — on AFFICHE alors
      //      les deux versions à côté du marqueur, pour que l'écart soit lisible au lieu d'être deviné).
      (function () {
        window.addEventListener("pageshow", function (e) { if (e && e.persisted) window.location.reload(); });
        fetch("/api/build", { cache: "no-store" }).then(function (r) { return r.json(); }).then(function (j) {
          if (!j || !j.ok || !j.build || j.build === RL_BUILD) return;
          var vu = null; try { vu = sessionStorage.getItem("ms-build-reload"); } catch (e) {}
          if (vu === j.build) {
            var el = document.getElementById("rl-build");
            if (el) { el.textContent = RL_BUILD + " ≠ " + j.build; el.style.color = "#B45309"; }
            return;
          }
          try { sessionStorage.setItem("ms-build-reload", j.build); } catch (e) {}
          window.location.reload();
        }).catch(function () {});
      })();
      // Changer de site RECHARGE la page sur ce site : ses pôles sont lus côté serveur, jamais devinés
      // côté client. Les paramètres en cours (diagnostic, réglages) sont gardés.
      (function () {
        var sel = document.getElementById("rl-site-sel");
        if (!sel) return;
        sel.addEventListener("change", function () {
          var u = new URL(window.location.href);
          u.searchParams.set("location_id", sel.value);
          window.location.href = u.toString();
        });
      })();
    </script>
    <script is:inline src="/js/photo-capture.js?v=3"></script>
    <script is:inline src="/js/releve-espace.js?v=21"></script>
  </BaseLayout>
