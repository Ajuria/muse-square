            var mount = body.querySelector("[data-ev-share-mount]");
            if (!mount) return;
            if (mount.style.display === "block") { mount.style.display = "none"; mount.innerHTML = ""; return; }
            if (!window.MSDraftWorkspace) { mount.style.display = "block"; mount.innerHTML = '<div style="font-size:12.5px;color:#B91C1C;">Espace de rédaction indisponible — rechargez la page.</div>'; return; }
            var rowS = null;
            (j.apres.rows || []).forEach(function (r) { if (r.gap_eur != null) rowS = r; });
            var kpiTxt = it.kpi === "family_revenue" && rowS && rowS.family_rev != null
              ? "famille " + (it.kpi_family || "") + " " + frInt(rowS.family_rev) + " €" + (it.kpi_target_eur != null ? " (objectif " + frInt(it.kpi_target_eur) + " €)" : "")
              : it.kpi === "profit_estimated" && rowS && rowS.profit_day != null
              ? "profit estimé " + frInt(rowS.profit_day) + " €" + (rowS.profit_avg != null ? " (sa moyenne 90 j " + frInt(rowS.profit_avg) + " €)" : "")
              : rowS ? "CA " + frInt(rowS.revenue) + " € (habituel " + frInt(rowS.expected) + " €)" : "";
            var whatTxt = it.title + " — " + (rowS ? dowFr(rowS.date) + " " + frD(rowS.date) : "") + (kpiTxt ? " : " + kpiTxt : "")
              + (rowS && rowS.target_met === false ? " — objectif manqué" : rowS && rowS.target_met === true ? " — objectif atteint" : "");
            mount.style.display = "block";
            window.MSDraftWorkspace.open(mount, {
              mode: "comm",
              location_id: it.location_id || loc,
              signal_type: "event_result",
              affected_date: rowS ? rowS.date : "",
              card_what: whatTxt,
              card_sowhat: j.apres.reconciliation || "",
              signal: { saved_item_id: item, event_title: it.title, dispositif: it.dispositif || null },
              artifact_mode: "post",
              detail_url: window.location.href,
              onClose: function () { mount.style.display = "none"; mount.innerHTML = ""; },
            });
            mount.scrollIntoView({ behavior: "smooth", block: "nearest" });
          });

          body.querySelectorAll("[data-ev-st]").forEach(function (b) {
            b.addEventListener("click", function () {
              var k = b.getAttribute("data-ev-st");
              body.querySelectorAll("[data-ev-st]").forEach(function (x) { var on = x === b; x.style.background = on ? "#1D3BB3" : "#fff"; x.style.color = on ? "#fff" : "#1D3BB3"; });
              body.querySelectorAll("[data-ev-panel]").forEach(function (p) { p.style.display = p.getAttribute("data-ev-panel") === k ? "block" : "none"; });
              setHead(k);
            });
          });

          // Choisir (état Décider) : selected_date + engagement ancré sur le jour (interim
          // incrément 4 : seuil % dérivé de l'apport visé vs l'attendu du jour choisi).
          body.querySelectorAll("[data-ev-choose]").forEach(function (b) {
            b.addEventListener("click", function () {
              var date = b.getAttribute("data-ev-choose");
              var day2 = null; j.days.forEach(function (d) { if (d.date === date) day2 = d; });
              var o3 = (day2 && day2.objectif) || {};
              var pct = it.kpi_target_pct != null ? Math.round(it.kpi_target_pct)
                : (o3.apport_eur != null && o3.expected_eur ? Math.max(1, Math.min(100, Math.round(100 * o3.apport_eur / o3.expected_eur))) : 10);
              b.disabled = true; b.textContent = "Choix…";
              // Durée multi-jours (04/08) : la fenêtre de mesure couvre [lancement, lancement+durée−1]
              // et event_end_date (colonne historique, lue par les crons bilan/J-7) se cale dessus.
              var dur = Number(it.duration_days) >= 1 ? Math.min(31, Math.round(Number(it.duration_days))) : 1;
              var updBody = { saved_item_id: item, selected_date: date };
              if (dur > 1) {
                var ed = new Date(date + "T00:00:00Z"); ed.setUTCDate(ed.getUTCDate() + dur - 1);
                updBody.event_end_date = ed.toISOString().slice(0, 10);
              }
              fetch("/api/saved-items/update", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(updBody) })
                .then(function (r) { return r.json(); })
                .then(function (u) {
                  if (!u || !u.ok) throw new Error((u && u.error) || "Erreur");
                  return fetch("/api/commitments", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({
                    location_id: loc, origin_action_type: "event_" + (it.event_type || "autre"), saved_item_id: item,
                    event_kpi: it.kpi || null, kpi_family: it.kpi_family || null,
                    window_kind: "day_of", window_start_date: date, window_days: dur > 1 ? dur : null,
                    threshold_basis: "pct", threshold_pct: pct,
                    committed_action_text: it.title + (it.dispositif ? " — " + it.dispositif : ""),
                    owner_person_name: it.author_person_name || "—",
                  }) }).then(function (r) { return r.json(); });
                })
                .then(function (c) {
                  var m = body.querySelector("[data-ev-choose-msg]");
                  m.style.display = "block";
                  m.textContent = frD(date) + " choisi — " + (c && c.ok ? "engagement de mesure créé (fenêtre ancrée sur ce jour). Rechargement…" : "événement mis à jour, mais engagement non créé (" + ((c && c.error) || "erreur") + ").");
                  if (c && c.ok) setTimeout(function () { window.location.reload(); }, 1200);
                })
                .catch(function (e) { b.disabled = false; b.textContent = "Choisir"; alert("Erreur : " + (e && e.message ? e.message : "réessayez")); });
            });
          });

        }
        // Mode CRÉATION (?new=1 ou ?dates= pré-remplies depuis la planification) — les autres
        // modes (dossier, liste) ont déjà lancé leur fetch ci-dessus.
        if (!item && wantForm) {
          if (!loc) { body.textContent = "Lieu manquant — ouvrez cette page depuis l’application."; return; }
          if (!window.MSEventForm) { body.textContent = "Formulaire indisponible — rechargez la page."; return; }
          window.MSEventForm.open(body, { location_id: loc, dates: preDates, titre: qs.get("titre") || "", dispositif: qs.get("dispositif") || "" });
        }
      })();
    </script>
  </BaseLayout>
</Show>
