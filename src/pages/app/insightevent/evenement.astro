---
// « /evenement » — le dossier d'événement-dispositif (spec docs/evenement-dossier-spec.md).
// Mode LISTE (par défaut, sans saved_item_id) : les événements du lieu via ?list=1 — premier
// consommateur de vw_insight_event_user_events ; lieu résolu via /api/profile/locations
// (primaire d'abord) quand l'URL n'en porte pas (lien BottomBar).
// Mode CRÉATION (?new=1 ou ?dates=) : MSEventForm (public/event-form.js, ?dates= pré-remplies).
// Mode DOSSIER (?saved_item_id=) : les 3 états Décider/Avant/Après sur provider evenementFamily ;
// la CIBLE du KPI dominant est jugée en DÉTERMINISTE (target_met — un fait), le verdict
// STATISTIQUE reste celui de l'engagement K1 (bande de bruit + gardes — décision étape 3),
// les deux affichés, jamais confondus ; lieu résolu via saved-items/get quand absent (lien Nav).
// Bilan déclaratif 3 questions (complément du mesuré — décision owner 03/08) : bloc du dossier
// quand une occurrence est passée et qu'aucun bilan n'est soumis ; ?mode=bilan y défile (email J+7).
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { Show } from "@clerk/astro/components";

const locParam = Astro.url.searchParams.get("location_id") || "";
const itemParam = Astro.url.searchParams.get("saved_item_id") || "";
---

<Show when="signed-out" client:load>
  <meta http-equiv="refresh" content="0; url=/sign-in" />
</Show>

<Show when="signed-in" client:load>
  <BaseLayout title="Événement — Muse Square" hideSurveyCta={true} hideFooter={true}>
    <div id="evt-root" data-loc={locParam} data-item={itemParam}>
      <div id="evt-toolbar" style="margin-bottom:14px;"><a href="/app/insightevent/tableau" id="evt-back" style="font-size:14px;color:#6b7280;text-decoration:none;">← Retour</a></div>
      <div id="evt-head" style="margin-bottom:12px;">
        <div style="font-size:15px;font-weight:600;color:#111827;">Nouvel événement</div>
        <div style="font-size:12px;color:#6b7280;line-height:1.5;">Un événement porte son dispositif, son objectif (le KPI que le verdict jugera) et, s’il se répète, sa série — la mesure se crée avec lui.</div>
      </div>
      <div id="evt-body" style="background:#fff;border:1px solid rgba(0,0,0,0.08);border-radius:10px;box-shadow:0 1px 3px rgba(16,24,40,0.06);padding:14px 16px;">Chargement…</div>
    </div>


    <style is:global>
      #evt-root { max-width: 760px; margin: 0 auto; padding: 16px 16px 80px; font-family: system-ui, -apple-system, sans-serif; color: #111827; }
      /* Bilan : les puces se lisent comme des CHOIX (retour owner 05/08) */
      .evt-bl-chip:hover { border-color: #1D3BB3 !important; color: #1D3BB3 !important; }
    </style>

    <script is:inline src="/event-form.js?v=7"></script>
    <script is:inline>
      (function () {
        var root = document.getElementById("evt-root");
        var body = document.getElementById("evt-body");
        // « Retour » = le point de DÉPART (owner 05/08) : history.back() quand on vient d'une
        // page de l'app ; repli tableau pour les arrivées directes (email, lien partagé).
        var backEl = document.getElementById("evt-back");
        if (backEl) backEl.addEventListener("click", function (ev) {
          if (window.history.length > 1 && document.referrer && document.referrer.indexOf(window.location.origin) === 0) { ev.preventDefault(); window.history.back(); }
        });
        var loc = root.getAttribute("data-loc") || "";
        var item = root.getAttribute("data-item") || "";
        var qs = new URLSearchParams(window.location.search);
        var preDates = String(qs.get("dates") || "").split(",").map(function (s) { return s.trim(); }).filter(Boolean);
        var wantForm = qs.get("new") === "1" || preDates.length > 0;
        // inc. 6 : après un geste du bloc consigne, le dossier se re-rend depuis la base et
        // revient sur le bloc (feedback = la vérité relue, pas un message).
        var consigneScrollPending = false;

        function openDossier() {
          fetch("/api/insight/evenement?location_id=" + encodeURIComponent(loc) + "&saved_item_id=" + encodeURIComponent(item), { cache: "no-store" })
            .then(function (r) { return r.json(); })
            .then(function (j) {
              if (!j || !j.ok) { body.textContent = "Erreur : " + ((j && j.error) || "réessayez."); return; }
              if (!j.found) { body.textContent = j.reason || "Événement introuvable."; return; }
              renderDossier(j);
            })
            .catch(function () { body.textContent = "Erreur de chargement."; });
        }

        function openList() {
          fetch("/api/insight/evenement?location_id=" + encodeURIComponent(loc) + "&list=1", { cache: "no-store" })
            .then(function (r) { return r.json(); })
            .then(function (j) {
              if (!j || !j.ok) { body.textContent = "Erreur : " + ((j && j.error) || "réessayez."); return; }
              renderList(j.events || []);
            })
            .catch(function () { body.textContent = "Erreur de chargement."; });
        }

        if (item) {
          // Dossier — lieu résolu par l'événement lui-même quand le lien n'en porte pas (Nav, emails).
          if (loc) { openDossier(); }
          else {
            fetch("/api/saved-items/get", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ saved_item_id: item }) })
              .then(function (r) { return r.json(); })
              .then(function (g) {
                if (!g || !g.ok || !g.item || !g.item.location_id) { body.textContent = "Événement introuvable."; return; }
                loc = String(g.item.location_id);
                openDossier();
              })
              .catch(function () { body.textContent = "Erreur de chargement."; });
          }
          // (renderDossier et ses aides sont déclarés plus bas — hoisting.)
        } else if (!wantForm) {
          // LISTE par défaut — lieu primaire quand l'URL n'en porte pas (lien BottomBar).
          document.querySelector("#evt-head div").textContent = "Mes événements";
          document.querySelector("#evt-head div + div").textContent = "Tous les événements du lieu — dossier, série et mesure. Le dossier juge la cible ; le verdict statistique reste celui de l’engagement.";
          if (loc) { openList(); }
          else {
            fetch("/api/profile/locations", { cache: "no-store" })
              .then(function (r) { return r.json(); })
              .then(function (p) {
                var l0 = p && p.ok && Array.isArray(p.locations) && p.locations[0];
                if (!l0 || !l0.location_id) { body.textContent = "Aucun lieu configuré."; return; }
                loc = String(l0.location_id);
                openList();
              })
              .catch(function () { body.textContent = "Erreur de chargement."; });
          }
        }
        function esc(s) { return String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;"); }
        function frInt(n) { return Math.abs(Math.round(Number(n) || 0)).toLocaleString("fr-FR"); }
        function frD(iso) { var d = String(iso || "").slice(0, 10); return d ? d.slice(8, 10) + "/" + d.slice(5, 7) : ""; }
        var DOW_FR_PAGE = ["dimanche", "lundi", "mardi", "mercredi", "jeudi", "vendredi", "samedi"];
        function dowFr(iso) { var d = String(iso || "").slice(0, 10); return d ? (DOW_FR_PAGE[new Date(d + "T12:00:00Z").getUTCDay()] || "") : ""; }
        function signEur(n) { return (Number(n) >= 0 ? "+" : "−") + frInt(n) + " €"; }
        var TONE = { ok: "#059669", warn: "#B45309", bad: "#e24b4a", info: "#6B7280" };
        function dot(t) { return '<span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:' + (TONE[t] || TONE.info) + ';margin-right:7px;flex:none;margin-top:5px;"></span>'; }
        function qLine(qu) {
          return '<div style="display:flex;align-items:flex-start;padding:7px 0;border-bottom:1px solid #F3F4F6;font-size:12.5px;line-height:1.5;">' + dot(qu.tone)
            + '<span>' + esc(qu.fact_fr) + (qu.action_fr ? ' <span style="color:#1D3BB3;font-weight:600;">' + esc(qu.action_fr) + '</span>' : '')
            + (qu.href ? ' <a href="' + esc(qu.href) + '" style="color:#1D3BB3;font-weight:600;text-decoration:none;white-space:nowrap;">' + esc(qu.link_fr || 'Voir →') + '</a>' : '') + '</span></div>';
        }

        // ── La LISTE (mode par défaut) — la vue user_events : quand, série, track record. ──
        function renderList(events) {
          var newHref = "/app/insightevent/evenement?location_id=" + encodeURIComponent(loc) + "&new=1";
          if (!events.length) {
            body.innerHTML = '<div style="font-size:13px;color:#6B7280;">Aucun événement pour ce lieu. <a href="' + newHref + '" style="color:#1D3BB3;font-weight:600;">Créer le premier</a>.</div>';
            return;
          }
          var head2 = '<div style="display:flex;justify-content:flex-end;margin-bottom:10px;"><a href="' + newHref + '" style="display:inline-flex;align-items:center;padding:8px 14px;background:#1D3BB3;border-radius:6px;font-size:13px;font-weight:500;color:#fff;text-decoration:none;">Nouvel événement</a></div>';
          body.innerHTML = head2 + events.map(function (e) {
            var when = e.recurring
              ? "Série · " + (e.n_occurrences || 0) + " occurrence(s)" + (e.next_date ? " · prochaine le " + frD(e.next_date) : e.last_date ? " · terminée le " + frD(e.last_date) : "")
              : e.next_date ? "Prochaine date : " + frD(e.next_date)
              : e.selected_date ? "Date : " + frD(e.selected_date)
              : e.last_date ? "Terminé le " + frD(e.last_date) : "Dates à choisir";
            var track = e.n_resolved
              ? '<span style="font-size:11px;font-weight:600;border-radius:20px;padding:3px 9px;color:' + (Number(e.sum_gap_eur) >= 0 ? "#059669" : "#B45309") + ';background:' + (Number(e.sum_gap_eur) >= 0 ? "#E6F6F0" : "#FEF3E2") + ';">' + (e.sum_gap_eur != null ? signEur(e.sum_gap_eur) + " vs attendu · " : "") + (e.n_beat || 0) + "/" + e.n_resolved + " tenue(s)</span>"
              : '<span style="font-size:11px;color:#9CA3AF;">pas encore de mesure résolue</span>';
            return '<a href="/app/insightevent/evenement?location_id=' + encodeURIComponent(loc) + '&saved_item_id=' + encodeURIComponent(e.saved_item_id) + '" style="display:block;text-decoration:none;color:inherit;border:1px solid rgba(0,0,0,0.08);border-radius:10px;padding:12px 14px;margin-bottom:8px;background:#fff;">'
              + '<div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin-bottom:4px;">'
              + '<span style="font-size:13.5px;font-weight:600;">' + esc(e.title) + '</span>'
              + (e.type_label_fr ? '<span style="display:inline-flex;font-size:11px;padding:2px 8px;border-radius:20px;background:#F3F4F6;color:#6b7280;">' + esc(e.type_label_fr) + '</span>' : "")
              + '</div>'
              + '<div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;font-size:12px;color:#6B7280;">'
              + '<span>' + esc(when) + '</span>' + track
              + (e.author_person_name ? '<span>créé par ' + esc(e.author_person_name) + '</span>' : "")
              + '</div></a>';
          }).join("");
        }

        // ── Bilan déclaratif — 3 questions (décision owner 03/08 : « conservé en complément du
        //    mesuré, 3 questions »). Complément du MESURÉ : météo vécue (calibre les classes),
        //    accessibilité vécue (clients vs fournisseurs, non mesurable), fréquentation vs
        //    attentes (non mesurée pour la plupart des lieux). La concurrence saute : seule
        //    dimension déjà entièrement mesurée par le pipeline. Écrit dans raw.event_outcomes
        //    via /api/saved-items/bilan (endpoint inchangé, competition_felt absent → NULL). ──
        function maybeRenderBilan(j) {
          var it = j.item || {};
          window._evtBilanItem = it;
          var today = new Date().toISOString().slice(0, 10);
          var past = (it.dates || []).map(String).filter(function (d) { return d && d.slice(0, 10) <= today; });
          if (!past.length && it.selected_date && String(it.selected_date).slice(0, 10) <= today) past = [String(it.selected_date).slice(0, 10)];
          if (!past.length) return;
          var bilanDate = past[past.length - 1].slice(0, 10);
          window._evtBilanJ = j;
          fetch("/api/saved-items/snapshot?saved_item_id=" + encodeURIComponent(item), { cache: "no-store" })
            .then(function (r) { return r.json(); })
            .then(function (sj) {
              if (!sj || !sj.ok) return;
              if (sj.bilan_submitted) { renderBilanDoneBlock(bilanDate); return; }
              renderBilanBlock(bilanDate);
            })
            .catch(function () {});
        }

        // ── Chaîne bilan → dispositif (10/08) : l'output découle de l'input, jamais un bouton
        //    frère. Idempotente (apres.documented, clé serveur) ; recette JAMAIS vide (l'ancien
        //    bouton avait écrit « Lancement SaaS (événement « Lancement SaaS ») » — archivé) ;
        //    le succès a un ENDROIT : lien vers vos Dispositifs. ──
        function docChainHtml() {
          var jj = window._evtBilanJ || {};
          var itC = jj.item || {};
          if (!jj.apres || !jj.apres.rows || !jj.apres.rows.length) return "";
          var link = '<a href="/app/insightevent/tableau" style="color:#1D3BB3;font-weight:600;text-decoration:none;font-size:12.5px;">Voir dans vos Dispositifs →</a>';
          if (jj.apres.documented) return '<div style="margin-top:8px;font-size:12.5px;color:#6B7280;">Ce qui a marché est déjà documenté · ' + link + '</div>';
          var needRecette = !(itC.dispositif && String(itC.dispositif).trim());
          return '<div id="evt-doc-chain" style="margin-top:10px;display:flex;gap:8px;flex-wrap:wrap;align-items:center;">'
            + (needRecette ? '<input id="evt-doc-recette" placeholder="La recette à retenir (une phrase)" style="flex:1;min-width:220px;padding:7px 10px;border:1px solid #E5E7EB;border-radius:8px;font-size:13px;font-family:inherit;">' : '<span style="font-size:12.5px;color:#6B7280;">Dispositif : ' + esc(String(itC.dispositif).slice(0, 60)) + '</span>')
            + '<button type="button" id="evt-doc-go" style="font-size:13px;font-weight:500;color:#1D3BB3;border:1px solid #1D3BB3;border-radius:10px;padding:6px 12px;background:transparent;cursor:pointer;font-family:inherit;">En faire un dispositif →</button>'
            + '<span id="evt-doc-msg" style="font-size:12px;"></span></div>';
        }
        function wireDocChain(container) {
          var go = container.querySelector("#evt-doc-go");
          if (!go) return;
          go.addEventListener("click", function () {
            var jj = window._evtBilanJ || {};
            var itC = jj.item || {};
            var msg = container.querySelector("#evt-doc-msg");
            var inp = container.querySelector("#evt-doc-recette");
            var recette = itC.dispositif && String(itC.dispositif).trim() ? String(itC.dispositif).trim() : (inp ? inp.value.trim() : "");
            if (!recette) { msg.style.color = "#B45309"; msg.textContent = "Écrivez la recette à retenir — un dispositif vide ne sert personne."; if (inp) inp.style.borderColor = "#B45309"; return; }
            var evid = ((jj.apres && jj.apres.rows) || []).filter(function (r) { return r.gap_eur != null; }).map(function (r) { return r.dow_fr + " " + frD(r.date) + " : " + signEur(r.gap_eur) + " vs attendu"; }).join(" ; ");
            go.disabled = true;
            fetch("/api/best-practices", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({
              location_id: loc,
              practice_text: recette.slice(0, 240) + " (événement « " + itC.title + " »)",
              evidence_refs: evid || null,
              confirmation_test: "La prochaine occurrence dépasse l’attendu du jour",
              origin: { origin_action_type: "event_" + (itC.event_type || "autre") },
            }) }).then(function (r) { return r.json(); }).then(function (p) {
              if (p && p.ok) {
                if (jj.apres) jj.apres.documented = true;
                container.querySelector("#evt-doc-chain").innerHTML = '<span style="font-size:12.5px;color:#166534;">Versé à vos Dispositifs (tier déclaré — le rejeu, c’est la prochaine occurrence) · </span><a href="/app/insightevent/tableau" style="color:#1D3BB3;font-weight:600;text-decoration:none;font-size:12.5px;">Voir →</a>';
              } else { msg.style.color = "#B91C1C"; msg.textContent = "Erreur : " + ((p && p.error) || "réessayez"); go.disabled = false; }
            }).catch(function () { msg.style.color = "#B91C1C"; msg.textContent = "Erreur réseau."; go.disabled = false; });
          });
        }
        // Bilan déjà envoyé : l'état est dit, et la chaîne dispositif reste accessible.
        function renderBilanDoneBlock(bilanDate) {
          var chain = docChainHtml();
          if (!chain) return;
          var wrap = document.createElement("div");
          wrap.id = "evt-bilan";
          wrap.style.cssText = "margin-top:16px;border-top:1px solid #F3F4F6;padding-top:12px;";
          wrap.innerHTML = '<div style="font-size:12.5px;color:#6B7280;">Bilan du ' + frD(bilanDate) + ' déjà enregistré.</div>' + chain;
          body.appendChild(wrap);
          wireDocChain(wrap);
        }

        function renderBilanBlock(bilanDate) {
          var chosen = {};
          // F4 (owner 10/08) : le bilan demandait le CONTEXTE vécu mais jamais « avez-vous mené
          // l'action ? » — sans elle, une cible manquée est inattribuable (météo, ou dispositif
          // jamais appliqué ?). Posée en 1re question quand l'événement porte un dispositif.
          var itB = window._evtBilanItem || {};
          var askAction = !!(itB.dispositif && String(itB.dispositif).trim());
          var BL_KEYS = (askAction ? ["action_carried"] : []).concat(["weather_accuracy", "mobility_felt", "attendance_vs_expect"]);
          var BL_NUM = {}; BL_KEYS.forEach(function (k, i) { BL_NUM[k] = i + 1; });
          var BL_N = BL_KEYS.length;
          var BL_NAME = { action_carried: "le dispositif", weather_accuracy: "la météo", mobility_felt: "l’accès", attendance_vs_expect: "la fréquentation" };
          function group(key, opts) {
            return '<div data-bl-grp="' + key + '" style="display:flex;gap:6px;flex-wrap:wrap;margin:6px 0 14px;">' + opts.map(function (o) {
              return '<button type="button" class="evt-bl-chip" data-bl-g="' + key + '" data-bl-v="' + o[0] + '" style="font-size:12px;font-family:inherit;padding:6px 12px;border:1px solid #E5E7EB;border-radius:20px;background:#fff;color:#374151;cursor:pointer;">' + o[1] + '</button>';
            }).join("") + '</div>';
          }
          function qhead(key, text) {
            return '<div data-bl-q="' + key + '" style="font-size:13px;font-weight:500;">' + BL_NUM[key] + '/' + BL_N + ' — ' + text + '</div>';
          }
          var wrap = document.createElement("div");
          wrap.id = "evt-bilan";
          wrap.style.cssText = "margin-top:16px;border-top:1px solid #F3F4F6;padding-top:12px;";
          wrap.innerHTML = '<div style="font-size:11px;text-transform:uppercase;letter-spacing:0.06em;color:rgba(17,24,39,0.45);font-weight:600;margin-bottom:4px;">Bilan déclaratif — votre vécu du ' + frD(bilanDate) + '</div>'
            + '<div style="font-size:12px;color:#6B7280;margin-bottom:10px;">' + BL_N + ' questions — ce que la mesure ne voit pas : vos conditions réelles' + (askAction ? " et ce que vous avez fait" : "") + '. Le CA, lui, est déjà mesuré ci-dessus.</div>'
            + (askAction
              ? qhead("action_carried", 'Le dispositif prévu a-t-il été appliqué ? <span style="font-weight:400;color:#9CA3AF;">(' + esc(String(itB.dispositif).slice(0, 60)) + ')</span>')
                + group("action_carried", [["oui", "Oui, comme prévu"], ["partiel", "En partie"], ["non", "Non"]])
              : "")
            + qhead("weather_accuracy", 'Les conditions météo correspondaient-elles à nos prévisions ?')
            + group("weather_accuracy", [["conforme", "Oui, conforme"], ["mieux", "Meilleures que prévu"], ["pire", "Pires que prévu"]])
            + qhead("mobility_felt", 'L’accès à votre site était-il fluide pour vos visiteurs ?')
            + group("mobility_felt", [["fluide", "Fluide"], ["difficile", "Quelques difficultés"], ["perturbe", "Fortement perturbé"]])
            + qhead("attendance_vs_expect", 'La fréquentation, par rapport à vos attentes ?')
            + group("attendance_vs_expect", [["beyond", "Bien au-delà"], ["conforme", "Conforme"], ["endeca", "En deçà"]])
            + '<div style="display:flex;gap:10px;flex-wrap:wrap;align-items:flex-start;">'
            + '<div><div style="font-size:12px;color:#6B7280;margin-bottom:4px;">Nb de visiteurs (optionnel)</div><input id="evt-bilan-att" type="number" placeholder="ex. 340" style="width:120px;padding:7px 10px;border:1px solid #E5E7EB;border-radius:8px;font-size:13px;font-family:inherit;"></div>'
            + '<div style="flex:1;min-width:200px;"><div style="font-size:12px;color:#6B7280;margin-bottom:4px;">Commentaire (optionnel)</div><textarea id="evt-bilan-com" placeholder="Observation, retour terrain…" style="width:100%;padding:7px 10px;border:1px solid #E5E7EB;border-radius:8px;font-size:13px;font-family:inherit;resize:vertical;min-height:38px;"></textarea></div>'
            + '</div>'
            + '<div style="display:flex;align-items:center;gap:10px;margin-top:10px;"><button type="button" id="evt-bilan-send" style="font-size:13px;font-weight:500;color:#fff;background:#1D3BB3;border:none;border-radius:10px;padding:7px 14px;cursor:pointer;font-family:inherit;">Envoyer mon bilan</button><span id="evt-bilan-msg" style="font-size:12px;color:#6B7280;"></span></div>';
          body.appendChild(wrap);
          wrap.querySelectorAll("[data-bl-g]").forEach(function (b) {
            b.addEventListener("click", function () {
              var g = b.getAttribute("data-bl-g");
              chosen[g] = b.getAttribute("data-bl-v");
              var qh = wrap.querySelector('[data-bl-q="' + g + '"]');
              if (qh) qh.style.color = "";
              wrap.querySelectorAll('[data-bl-g="' + g + '"]').forEach(function (x) {
                var on = x === b;
                x.style.background = on ? "#EEF2FF" : "#fff";
                x.style.borderColor = on ? "#1D3BB3" : "#E5E7EB";
                x.style.color = on ? "#1D3BB3" : "#374151";
                x.style.fontWeight = on ? "600" : "400";
              });
            });
          });
          wrap.querySelector("#evt-bilan-send").addEventListener("click", function () {
            var msg = wrap.querySelector("#evt-bilan-msg");
            var missing = BL_KEYS.filter(function (k) { return !chosen[k]; });
            if (missing.length) {
              missing.forEach(function (k) {
                var h = wrap.querySelector('[data-bl-q="' + k + '"]');
                if (h) h.style.color = "#B45309";
                wrap.querySelectorAll('[data-bl-g="' + k + '"]').forEach(function (x) { x.style.borderColor = "#B45309"; });
              });
              msg.style.color = "#B45309";
              var mParts = missing.map(function (k) { return BL_NUM[k] + " (" + BL_NAME[k] + ")"; });
              msg.textContent = missing.length === 1
                ? "Il manque la question " + BL_NUM[missing[0]] + " — " + BL_NAME[missing[0]] + "."
                : "Il manque les questions " + mParts.slice(0, -1).join(", ") + " et " + mParts[mParts.length - 1] + ".";
              var h0 = wrap.querySelector('[data-bl-q="' + missing[0] + '"]');
              if (h0 && h0.scrollIntoView) h0.scrollIntoView({ behavior: "smooth", block: "center" });
              return;
            }
            var att = parseInt(wrap.querySelector("#evt-bilan-att").value || "", 10);
            var btn = wrap.querySelector("#evt-bilan-send");
            btn.disabled = true;
            fetch("/api/saved-items/bilan", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({
              saved_item_id: item, selected_date: bilanDate,
              action_carried: chosen.action_carried || null,
              weather_accuracy: chosen.weather_accuracy, mobility_felt: chosen.mobility_felt,
              attendance_vs_expect: chosen.attendance_vs_expect,
              attendance_approx: isNaN(att) ? null : att,
              free_comment: wrap.querySelector("#evt-bilan-com").value.trim() || null,
              collection_channel: "in_app",
            }) })
              .then(function (r) { return r.json(); })
              .then(function (p) {
                if (p && p.ok) {
                  wrap.innerHTML = '<div style="font-size:12.5px;color:#166534;background:#E6F6F0;border-radius:8px;padding:9px 12px;">Bilan enregistré — il complète la mesure de cet événement.</div>' + docChainHtml();
                  wireDocChain(wrap);
                }
                else { msg.style.color = "#B91C1C"; msg.textContent = "Erreur : " + ((p && p.error) || "réessayez."); btn.disabled = false; }
              })
              .catch(function () { msg.style.color = "#B91C1C"; msg.textContent = "Erreur réseau."; btn.disabled = false; });
          });
          if (qs.get("mode") === "bilan" && wrap.scrollIntoView) wrap.scrollIntoView({ behavior: "smooth", block: "start" });
        }

        // ── Consigne d'opération (inc. 7, audit owner 05/08) — SÉRIES seulement. DEUX modes :
        //    LECTURE = l'aperçu exact de l'email qui partira (zéro écart écran/envoi) ;
        //    ÉDITION = deux saisies seulement (votre consigne + l'arrivée) — tout ce que
        //    l'app sait déjà (horaires, objectif, dispositif) est injecté, jamais resaisi.
        //    UN seul Enregistrer (offset inclus) : plus d'écriture par chip (le fix de la
        //    transaction avortée vit côté update.ts). Lexique métier : « opération »,
        //    jamais « occurrence » ni « horaires de série » à l'écran. ──
        var consigneEditOverride = false;
        function renderConsigne(j) {
          var it = j.item || {};
          if (!it.recurrence || it.recurrence === "none") return;
          var today = new Date().toISOString().slice(0, 10);
          var future = (it.dates || []).map(String).filter(function (d) { return d.slice(0, 10) >= today; });
          if (!future.length) return;
          var off = it.consigne_send_offset != null ? it.consigne_send_offset : 2;
          var enabled = it.consigne_enabled === true;
          var sends = j.consigne_sends || [];
          var SERIE = "__serie__";
          var selOcc = SERIE;
          var nextOcc = future[0].slice(0, 10);
          // Champ unique : les 3 anciens champs fusionnés (migrés en un au premier Enregistrer).
          var consigneText = [it.consigne_store_info, it.consigne_interactions, it.consigne_deroule]
            .filter(Boolean).join("\n\n");
          var hasConsigne = consigneText.trim().length > 0;
          var mode = (hasConsigne || enabled) && !consigneEditOverride ? "read" : "edit";

          function offMinus(dateIso, n) {
            var t = new Date(dateIso + "T12:00:00");
            t.setDate(t.getDate() - n);
            return t.toISOString().slice(0, 10);
          }
          function postUpdate(fields, btn, done) {
            if (btn) btn.disabled = true;
            var body2 = { saved_item_id: item };
            Object.keys(fields).forEach(function (k) { body2[k] = fields[k]; });
            fetch("/api/saved-items/update", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body2) })
              .then(function (r) { return r.json(); })
              .then(function (p) { done(p && p.ok, p && p.error); })
              .catch(function () { done(false, "réseau"); });
          }
          function rerender(mode2) {
            consigneEditOverride = mode2 === "edit";
            wrap.remove();
            renderConsigne(j);
          }

          var kpiLbl2 = it.kpi === "family_revenue" ? "famille " + (it.kpi_family || "") : it.kpi === "revenue_residual" ? "CA vs attendu" : (it.kpi || "");
          var targetTxt = it.kpi_target_eur != null ? frInt(it.kpi_target_eur) + " €" : it.kpi_target_pct != null ? "+" + frInt(it.kpi_target_pct) + " %" : "";
          var hoursTxt = it.hour_start != null && it.hour_end != null ? "ouverture au public " + it.hour_start + " h – " + it.hour_end + " h" : null;
          var sendDate = offMinus(nextOcc, off);
          var sendWhen = sendDate <= today ? "aujourd\u2019hui" : "le " + dowFr(sendDate) + " " + frD(sendDate);

          var wrap = document.createElement("div");
          wrap.id = "evt-consigne";
          wrap.style.cssText = "margin-top:16px;border-top:1px solid #F3F4F6;padding-top:12px;";

          // ── Tête commune : titre + état + geste ──
          var head2 = "";
          if (!enabled && mode === "read") {
            head2 += '<a data-cs-toggle-aline style="display:block;color:#1D3BB3;font-size:13px;font-weight:600;line-height:1.5;cursor:pointer;margin-bottom:8px;">Activer l\u2019envoi automatique : la consigne partira seule ' + sendWhen + ' (J-' + off + ') pour l\u2019op\u00e9ration du ' + frD(nextOcc) + ' \u2192</a>';
          }
          head2 += '<div style="display:flex;align-items:center;gap:10px;margin-bottom:4px;flex-wrap:wrap;">'
            + '<div style="font-size:11px;text-transform:uppercase;letter-spacing:0.06em;color:rgba(17,24,39,0.45);font-weight:600;flex:1;">Consigne d\u2019op\u00e9ration</div>'
            + '<span style="display:inline-flex;font-size:11px;padding:2px 8px;border-radius:20px;background:' + (enabled ? "#E6F6F0" : "#F3F4F6") + ';color:' + (enabled ? "#059669" : "#6b7280") + ';">Envoi automatique : ' + (enabled ? "actif" : "d\u00e9sactiv\u00e9") + '</span>'
            + (mode === "read" ? '<a data-cs-edit style="color:#1D3BB3;font-weight:600;font-size:12.5px;cursor:pointer;">Modifier</a>' : "")
            + (enabled ? '<a data-cs-toggle style="color:#1D3BB3;font-weight:600;font-size:11.5px;cursor:pointer;">D\u00e9sactiver</a>' : "") + '</div>';

          var bodyHtml = "";
          if (mode === "read") {
            // ── LECTURE : l'email tel qu'il partira, assembl\u00e9 des m\u00eames pi\u00e8ces que le serveur ──
            var lines = [];
            lines.push("Op\u00e9ration : " + dowFr(nextOcc) + " " + frD(nextOcc) + (hoursTxt ? " \u00b7 " + hoursTxt : ""));
            if (it.consigne_arrival) lines.push("Arriv\u00e9e des participants : " + it.consigne_arrival);
            if (targetTxt) lines.push("Objectif de l\u2019op\u00e9ration : " + kpiLbl2 + " " + targetTxt + " \u2014 mesur\u00e9 automatiquement.");
            if (it.dispositif) lines.push("Le dispositif :\n" + it.dispositif);
            if (hasConsigne) lines.push("Consigne :\n" + consigneText);
            if (it.author_person_name) lines.push("Responsable : " + it.author_person_name);
            bodyHtml += '<div style="font-size:12px;color:#6B7280;margin-bottom:6px;">'
              + (enabled ? 'Part seule ' + sendWhen + ' (J-' + off + ') \u2014 op\u00e9ration du ' + frD(nextOcc) + ', aux participants + au responsable.' : 'Aper\u00e7u de l\u2019email \u2014 l\u2019envoi automatique est d\u00e9sactiv\u00e9.') + '</div>'
              + '<div style="font-size:12.5px;color:#374151;background:#F8FAFC;border:1px solid rgba(0,0,0,0.08);border-radius:8px;padding:10px 12px;line-height:1.6;white-space:pre-line;">' + esc(lines.join("\n\n")) + '</div>';
            if (sends.length) {
              bodyHtml += '<div style="margin-top:8px;font-size:12.5px;color:#166534;background:#E6F6F0;border-radius:8px;padding:9px 12px;">Derni\u00e8re consigne envoy\u00e9e le ' + frD(sends[0].sent_on) + ' \u00e0 ' + sends[0].n_recipients + ' destinataire(s) \u2014 op\u00e9ration du ' + frD(sends[0].occurrence_date) + '.</div>';
            }
          } else {
            // ── \u00c9DITION : deux saisies, un Enregistrer ──
            bodyHtml += '<div style="font-size:12px;color:#6B7280;line-height:1.5;margin-bottom:10px;">Deux champs \u2014 le reste (horaires, objectif, dispositif) est d\u00e9j\u00e0 connu et partira dans l\u2019email. Envoi <span data-cs-offwrap>'
              + [1, 2, 3].map(function (n) {
                  return '<button type="button" data-cs-off="' + n + '" style="font-size:11px;font-family:inherit;padding:2px 9px;border:1px solid ' + (n === off ? "#1D3BB3" : "#E5E7EB") + ';border-radius:20px;background:' + (n === off ? "#EEF2FF" : "#fff") + ';color:' + (n === off ? "#1D3BB3" : "#374151") + ';font-weight:' + (n === off ? "600" : "400") + ';cursor:pointer;">J-' + n + '</button>';
                }).join(" ")
              + '</span> avant chaque op\u00e9ration.</div>'
              + '<div style="margin:8px 0;"><div style="font-size:10.5px;font-weight:600;color:#6B7280;margin-bottom:3px;text-transform:uppercase;letter-spacing:0.05em;">Votre consigne</div>'
              + '<textarea id="evt-cs-text" rows="6" placeholder="Ce que chaque participant doit savoir \u2014 mise en place, d\u00e9roul\u00e9, interactions clients\u2026" style="width:100%;box-sizing:border-box;font-size:12.5px;color:#111827;background:#fff;border:1px solid rgba(0,0,0,0.12);border-radius:8px;padding:8px 10px;line-height:1.5;font-family:inherit;resize:vertical;">' + esc(consigneText) + '</textarea>'
              + '<a data-cs-reuse style="font-size:11.5px;color:#1D3BB3;font-weight:600;cursor:pointer;">Reprendre la consigne d\u2019un autre \u00e9v\u00e9nement</a><span data-cs-reuse-list style="display:block;"></span></div>'
              + '<div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:8px 0;"><div style="font-size:10.5px;font-weight:600;color:#6B7280;text-transform:uppercase;letter-spacing:0.05em;">Arriv\u00e9e des participants</div>'
              + '<input id="evt-cs-arrival" value="' + esc(it.consigne_arrival || "") + '" placeholder="optionnel \u2014 ex. 8 h 30" style="font-size:12.5px;font-family:inherit;border:1px solid rgba(0,0,0,0.12);border-radius:8px;padding:8px 10px;width:200px;">'
              + (hoursTxt ? '<span style="font-size:11px;color:#9CA3AF;">' + hoursTxt + ' (horaires de l\u2019op\u00e9ration)</span>' : "") + '</div>'
              + '<div style="display:flex;align-items:center;gap:10px;"><button type="button" data-cs-save style="font-size:13px;font-weight:500;color:#1D3BB3;border:1px solid #1D3BB3;border-radius:10px;padding:6px 12px;background:transparent;cursor:pointer;font-family:inherit;">Enregistrer la consigne</button>'
              + (hasConsigne ? '<a data-cs-cancel style="font-size:12px;color:#6B7280;cursor:pointer;">Annuler</a>' : "")
              + '<span data-cs-save-msg style="font-size:12px;color:#6B7280;"></span></div>';
          }

          // ── Participants (les deux modes) ──
          bodyHtml += '<div style="margin:12px 0 8px;">'
            + '<div style="display:flex;align-items:baseline;gap:8px;flex-wrap:wrap;"><div style="font-size:10.5px;font-weight:600;color:#6B7280;text-transform:uppercase;letter-spacing:0.05em;">Participants</div>'
            + '<button type="button" data-cs-occ="' + SERIE + '" style="font-size:11.5px;font-family:inherit;padding:3px 10px;border:1px solid #1D3BB3;border-radius:20px;background:#EEF2FF;color:#1D3BB3;font-weight:600;cursor:pointer;">Toute la s\u00e9rie</button>'
            + future.slice(0, 8).map(function (d) {
                d = d.slice(0, 10);
                return '<button type="button" data-cs-occ="' + d + '" style="font-size:11.5px;font-family:inherit;padding:3px 10px;border:1px solid #E5E7EB;border-radius:20px;background:#fff;color:#374151;font-weight:400;cursor:pointer;">' + frD(d) + '</button>';
              }).join(" ")
            + (future.length > 8 ? '<span style="font-size:11px;color:#9CA3AF;">\u2026 ' + future.length + ' op\u00e9rations \u00e0 venir</span>' : "") + '</div>'
            + '<div data-cs-plist style="font-size:12.5px;color:#6B7280;margin:8px 0 6px;">Chargement\u2026</div>'
            + '<div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">'
            + '<input id="evt-cs-pname" placeholder="Nom (ex. le producteur)" style="font-size:12.5px;font-family:inherit;border:1px solid rgba(0,0,0,0.12);border-radius:8px;padding:8px 10px;width:180px;">'
            + '<input id="evt-cs-pcontact" placeholder="Email" style="font-size:12.5px;font-family:inherit;border:1px solid rgba(0,0,0,0.12);border-radius:8px;padding:8px 10px;width:220px;">'
            + '<button type="button" data-cs-padd style="font-size:13px;font-weight:500;color:#1D3BB3;border:1px solid #1D3BB3;border-radius:10px;padding:6px 12px;background:transparent;cursor:pointer;font-family:inherit;">Ajouter</button>'
            + '<span data-cs-padd-msg style="font-size:12px;color:#B91C1C;"></span></div>'
            + '<div data-cs-roster style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin-top:6px;"></div>'
            + '<div style="font-size:10.5px;color:#9CA3AF;margin-top:6px;">'
            + (it.author_person_name ? 'Le responsable (' + esc(String(it.author_person_name).split("\u00b7")[0].trim()) + ') re\u00e7oit d\u00e9j\u00e0 chaque envoi \u2014 inutile de l\u2019ajouter en participant. ' : "")
            + 'Contacts conserv\u00e9s pour l\u2019envoi des consignes uniquement \u2014 supprimables \u00e0 tout moment.</div>'
            + '</div>'
            + '<div style="font-size:10.5px;color:#9CA3AF;margin-top:6px;">La mesure, elle, est d\u00e9j\u00e0 automatique : un engagement s\u2019arme seul \u00e0 J-7 de chaque op\u00e9ration \u2014 verdicts cumul\u00e9s au fil de la s\u00e9rie.</div>';

          wrap.innerHTML = head2 + bodyHtml;
          body.appendChild(wrap);

          // ── C\u00e2blage commun ──
          function toggleConsigne() {
            postUpdate({ consigne_enabled: !enabled }, null, function (ok, err) {
              if (ok) { consigneScrollPending = true; consigneEditOverride = false; openDossier(); }
              else { alert("Erreur : " + (err || "r\u00e9essayez.")); }
            });
          }
          var tgl = wrap.querySelector("[data-cs-toggle]");
          if (tgl) tgl.addEventListener("click", toggleConsigne);
          var tglA = wrap.querySelector("[data-cs-toggle-aline]");
          if (tglA) tglA.addEventListener("click", toggleConsigne);
          var editLink = wrap.querySelector("[data-cs-edit]");
          if (editLink) editLink.addEventListener("click", function () { rerender("edit"); });
          var cancelLink = wrap.querySelector("[data-cs-cancel]");
          if (cancelLink) cancelLink.addEventListener("click", function () { rerender("read"); });

          // ── \u00c9dition : offset local (aucune \u00e9criture avant Enregistrer) + reprise + save ──
          if (mode === "edit") {
            var selOff = off;
            wrap.querySelectorAll("[data-cs-off]").forEach(function (b) {
              b.addEventListener("click", function () {
                selOff = parseInt(b.getAttribute("data-cs-off"), 10);
                wrap.querySelectorAll("[data-cs-off]").forEach(function (x) {
                  var on = x === b;
                  x.style.borderColor = on ? "#1D3BB3" : "#E5E7EB";
                  x.style.background = on ? "#EEF2FF" : "#fff";
                  x.style.color = on ? "#1D3BB3" : "#374151";
                  x.style.fontWeight = on ? "600" : "400";
                });
              });
            });
            var reuse = wrap.querySelector("[data-cs-reuse]");
            if (reuse) reuse.addEventListener("click", function () {
              var host = wrap.querySelector("[data-cs-reuse-list]");
              if (host.innerHTML) { host.innerHTML = ""; return; }
              host.innerHTML = '<span style="font-size:11.5px;color:#9CA3AF;">Chargement\u2026</span>';
              fetch("/api/insight/evenement?location_id=" + encodeURIComponent(loc) + "&consignes=1", { cache: "no-store" })
                .then(function (r) { return r.json(); })
                .then(function (p) {
                  var others = ((p && p.consignes) || []).filter(function (c) { return c.saved_item_id !== item; });
                  if (!others.length) { host.innerHTML = '<span style="font-size:11.5px;color:#9CA3AF;">Aucune autre consigne \u00e9crite sur ce lieu.</span>'; return; }
                  host.innerHTML = others.map(function (c, ci) {
                    return '<button type="button" data-cs-reuse-pick="' + ci + '" style="display:block;text-align:left;font-size:11.5px;font-family:inherit;color:#1D3BB3;background:none;border:1px dashed rgba(29,59,179,0.45);border-radius:8px;padding:5px 9px;margin-top:4px;cursor:pointer;max-width:100%;">' + esc(c.title) + ' \u2014 \u00ab ' + esc(String(c.consigne_store_info).slice(0, 70)) + '\u2026 \u00bb</button>';
                  }).join("");
                  host.querySelectorAll("[data-cs-reuse-pick]").forEach(function (b) {
                    b.addEventListener("click", function () {
                      var c = others[Number(b.getAttribute("data-cs-reuse-pick"))];
                      document.getElementById("evt-cs-text").value = c.consigne_store_info || "";
                      if (c.consigne_arrival && !document.getElementById("evt-cs-arrival").value) document.getElementById("evt-cs-arrival").value = c.consigne_arrival;
                      host.innerHTML = "";
                    });
                  });
                })
                .catch(function () { host.innerHTML = '<span style="font-size:11.5px;color:#B91C1C;">Erreur de chargement.</span>'; });
            });
            var saveBtn = wrap.querySelector("[data-cs-save]");
            saveBtn.addEventListener("click", function () {
              var msg = wrap.querySelector("[data-cs-save-msg]");
              msg.style.color = "#6B7280";
              msg.textContent = "Enregistrement\u2026";
              // UNE \u00e9criture : texte fusionn\u00e9 dans consigne_store_info, les 2 anciens champs
              // vid\u00e9s ("" = SET NULL), arriv\u00e9e, offset — plus jamais d'\u00e9criture par chip.
              postUpdate({
                consigne_store_info: (document.getElementById("evt-cs-text").value || "").trim(),
                consigne_interactions: "",
                consigne_deroule: "",
                consigne_arrival: (document.getElementById("evt-cs-arrival").value || "").trim(),
                consigne_send_offset: selOff,
              }, saveBtn, function (ok, err) {
                saveBtn.disabled = false;
                if (ok) { consigneScrollPending = true; consigneEditOverride = false; openDossier(); }
                else { msg.style.color = "#B91C1C"; msg.textContent = "Erreur : " + (err || "r\u00e9essayez."); }
              });
            });
          }

          // ── Participants (inchang\u00e9 sur le fond, lexique r\u00e9vis\u00e9) ──
          function loadParticipants(d) {
            var list = wrap.querySelector("[data-cs-plist]");
            list.textContent = "Chargement\u2026";
            var qs2 = d === SERIE ? "" : "&date=" + encodeURIComponent(d);
            fetch("/api/saved-items/participants?saved_item_id=" + encodeURIComponent(item) + qs2, { cache: "no-store" })
              .then(function (r) { return r.json(); })
              .then(function (p) {
                if (!p || !p.ok) { list.textContent = "Erreur de chargement des participants."; return; }
                var rows = p.participants || [];
                if (d === SERIE) rows = rows.filter(function (x) { return x.serie === true; });
                if (!rows.length) {
                  list.innerHTML = d === SERIE
                    ? 'Aucun participant de s\u00e9rie \u2014 ajoutez ici ceux qui re\u00e7oivent CHAQUE op\u00e9ration (le producteur, l\u2019\u00e9quipe du samedi\u2026).'
                    : 'Aucun participant propre \u00e0 l\u2019op\u00e9ration du ' + frD(d) + ' \u2014 les participants de s\u00e9rie et le responsable recevront la consigne.';
                  return;
                }
                list.innerHTML = rows.map(function (x) {
                  return '<span style="display:inline-flex;align-items:center;gap:6px;font-size:12px;border:1px solid #E5E7EB;border-radius:20px;padding:4px 10px;margin:0 6px 6px 0;background:#fff;color:#374151;">' + esc(x.participant_name)
                    + (x.serie === true && d !== SERIE ? ' <span style="color:#1D3BB3;font-size:11px;">toute la s\u00e9rie</span>' : '')
                    + (x.contact ? ' <span style="color:#9CA3AF;">' + esc(x.contact) + '</span>' : ' <span style="color:#B45309;">sans email \u2014 ne recevra rien</span>')
                    + ' <a data-cs-pdel="' + esc(x.participant_id) + '" style="color:#9CA3AF;cursor:pointer;font-weight:600;">\u00d7</a></span>';
                }).join("");
                list.querySelectorAll("[data-cs-pdel]").forEach(function (a) {
                  a.addEventListener("click", function () {
                    fetch("/api/saved-items/participants", { method: "DELETE", headers: { "content-type": "application/json" }, body: JSON.stringify({ saved_item_id: item, participant_id: a.getAttribute("data-cs-pdel") }) })
                      .then(function (r) { return r.json(); })
                      .then(function () { loadParticipants(selOcc); });
                  });
                });
              })
              .catch(function () { list.textContent = "Erreur de chargement des participants."; });
          }
          loadParticipants(selOcc);

          fetch("/api/channels/team?location_id=" + encodeURIComponent(loc), { cache: "no-store" })
            .then(function (r) { return r.json(); })
            .then(function (t) {
              var host = wrap.querySelector("[data-cs-roster]");
              var items2 = (t && t.ok && t.items) || [];
              if (!host || !items2.length) return;
              host.innerHTML = '<span style="font-size:11px;color:#9CA3AF;">Votre \u00e9quipe :</span>' + items2.map(function (m, i) {
                var nm = ((m.first_name || "") + " " + (m.last_name || "")).trim();
                var em = (m.channels_contact && m.channels_contact.email) || "";
                return '<button type="button" data-cs-rpick="' + i + '" data-n="' + esc(nm) + '" data-e="' + esc(em) + '" style="font-size:11.5px;font-family:inherit;padding:3px 10px;border:1px dashed rgba(29,59,179,0.45);border-radius:20px;background:#fff;color:#1D3BB3;cursor:pointer;">' + esc(nm) + (m.role ? ' \u00b7 ' + esc(m.role) : '') + (em ? '' : ' (sans email)') + '</button>';
              }).join(" ");
              host.querySelectorAll("[data-cs-rpick]").forEach(function (b) {
                b.addEventListener("click", function () {
                  document.getElementById("evt-cs-pname").value = b.getAttribute("data-n") || "";
                  document.getElementById("evt-cs-pcontact").value = b.getAttribute("data-e") || "";
                  document.getElementById("evt-cs-pcontact").focus();
                });
              });
            })
            .catch(function () {});

          wrap.querySelectorAll("[data-cs-occ]").forEach(function (b) {
            b.addEventListener("click", function () {
              selOcc = b.getAttribute("data-cs-occ");
              wrap.querySelectorAll("[data-cs-occ]").forEach(function (x) {
                var on = x === b;
                x.style.borderColor = on ? "#1D3BB3" : "#E5E7EB";
                x.style.background = on ? "#EEF2FF" : "#fff";
                x.style.color = on ? "#1D3BB3" : "#374151";
                x.style.fontWeight = on ? "600" : "400";
              });
              loadParticipants(selOcc);
            });
          });

          var padd = wrap.querySelector("[data-cs-padd]");
          padd.addEventListener("click", function () {
            var name = (document.getElementById("evt-cs-pname").value || "").trim();
            var contact = (document.getElementById("evt-cs-pcontact").value || "").trim();
            var msg = wrap.querySelector("[data-cs-padd-msg]");
            if (!name) { msg.textContent = "Le nom est requis."; return; }
            msg.textContent = "";
            padd.disabled = true;
            var pbody = { saved_item_id: item, participant_name: name, contact: contact };
            if (selOcc === SERIE) pbody.serie = true; else pbody.date = selOcc;
            fetch("/api/saved-items/participants", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(pbody) })
              .then(function (r) { return r.json(); })
              .then(function (p) {
                padd.disabled = false;
                if (!p || !p.ok) { msg.textContent = "Erreur : " + ((p && p.error) || "r\u00e9essayez."); return; }
                document.getElementById("evt-cs-pname").value = "";
                document.getElementById("evt-cs-pcontact").value = "";
                loadParticipants(selOcc);
              })
              .catch(function () { padd.disabled = false; msg.textContent = "Erreur r\u00e9seau."; });
          });

          if (consigneScrollPending) {
            consigneScrollPending = false;
            wrap.scrollIntoView({ behavior: "smooth", block: "start" });
          }
        }

        // ── Le dossier à 3 états (protos v2.1/v3 validés) — la même matière provider,
        //    densité différente : Décider (colonnes candidats), Avant (les 5 questions),
        //    Après (KPI + série). Tout affichage en JJ/MM, montants frInt. ──
        function renderDossier(j) {
          var it = j.item; var stage = j.stage;
          var states = [];
          if (stage === "decider") states.push(["decider", "Décider"]);
          if (j.avant_date) states.push(["avant", "Avant"]);
          if (j.apres && j.apres.rows.length) states.push(["apres", "Après"]);
          var current = stage === "decider" ? "decider" : (stage === "apres" ? "apres" : "avant");

          var chips = '<span style="display:inline-flex;font-size:12px;padding:3px 9px;border-radius:20px;background:#EEF2FF;color:#1D3BB3;">Événement</span>'
            + '<span style="display:inline-flex;font-size:12px;padding:3px 9px;border-radius:20px;background:#F3F4F6;color:#6b7280;">' + esc(it.event_type_label_fr || "") + '</span>'
            + (it.event_nature ? '<span style="display:inline-flex;font-size:12px;padding:3px 9px;border-radius:20px;background:#F3F4F6;color:#6b7280;">' + (it.event_nature === "outdoor" ? "Extérieur" : it.event_nature === "indoor" ? "Intérieur" : "Int/Ext") + (it.hour_start != null && it.hour_end != null ? " · " + it.hour_start + " h – " + it.hour_end + " h" : "") + '</span>' : "");
          var kpiLbl = it.kpi === "family_revenue" ? "famille " + (it.kpi_family || "") : it.kpi === "revenue_residual" ? "CA vs attendu" : it.kpi;
          var head = '<div style="display:flex;gap:5px;flex-wrap:wrap;margin-bottom:6px;">' + chips
            + (it.kpi_target_eur != null || it.kpi_target_pct != null
              ? '<span style="display:inline-flex;font-size:12px;padding:3px 9px;border-radius:20px;background:#E6F6F0;color:#059669;">Objectif : ' + esc(kpiLbl) + (it.kpi_target_eur != null ? " " + frInt(it.kpi_target_eur) + " €" : " +" + frInt(it.kpi_target_pct) + " %") + '</span>'
              : '<span style="display:inline-flex;font-size:12px;padding:3px 9px;border-radius:20px;background:#F3F4F6;color:#6b7280;" title="Aucune cible n’a été posée sur cet événement — le CA du jour reste mesuré vs votre attendu.">Sans objectif chiffré · CA suivi vs attendu</span>') + '</div>'
            + '<div style="font-size:14px;font-weight:600;">' + esc(it.title) + '</div>'
            + '<div style="font-size:12px;color:#6B7280;line-height:1.5;">' + (it.recurrence !== "none" ? "Série · " + it.dates.length + " occurrences" : "Dates : " + it.dates.map(frD).join(" · ")) + (it.author_person_name ? " · créé par " + esc(it.author_person_name) : "") + (it.dispositif ? "<br>Dispositif : " + esc(it.dispositif) : "") + '</div>';

          var segHtml = states.length > 1
            ? '<div style="margin:12px 0;"><span style="display:inline-flex;border:1px solid #1D3BB3;border-radius:8px;overflow:hidden;">'
              + states.map(function (s) { return '<button type="button" data-ev-st="' + s[0] + '" style="font-size:12px;font-family:inherit;border:none;padding:6px 12px;cursor:pointer;background:' + (s[0] === current ? "#1D3BB3" : "#fff") + ';color:' + (s[0] === current ? "#fff" : "#1D3BB3") + ';">' + s[1] + '</button>'; }).join("")
              + '</span></div>' : '<div style="margin:12px 0;"></div>';

          // État Décider — colonnes candidats (les 5 questions + objectif par candidat).
          var deciderHtml = "";
          if (stage === "decider") {
            var best = null;
            j.days.forEach(function (d) { if (d.present && d.score != null && (!best || d.score > best.score)) best = d; });
            deciderHtml = '<div data-ev-panel="decider"><div style="overflow-x:auto;"><table style="border-collapse:collapse;width:100%;font-size:12px;min-width:520px;">'
              + '<thead><tr><th style="text-align:left;width:120px;"></th>' + j.days.map(function (d) {
                  return '<th style="text-align:left;padding:8px;border-bottom:1px solid rgba(0,0,0,0.08);"><strong>' + d.dow_fr.slice(0, 3) + " " + frD(d.date) + '</strong>' + (best && d.date === best.date ? ' <span style="font-size:10px;padding:1px 7px;border-radius:20px;background:#EEF2FF;color:#1D3BB3;">recommandé</span>' : "") + '<br><span style="color:#9CA3AF;font-weight:400;">' + (d.score != null ? "score " + d.score + "/10" : "hors horizon") + '</span></th>';
                }).join("") + '</tr></thead><tbody>'
              + '<tr><td style="color:#6B7280;font-size:11px;text-transform:uppercase;padding:8px;">Objectif</td>' + j.days.map(function (d) {
                  var o = d.objectif || {};
                  return '<td style="padding:8px;border-bottom:1px solid #F3F4F6;">' + (o.expected_eur != null ? "attendu ≈ " + frInt(o.expected_eur) + " €" + (o.total_eur != null ? "<br><strong>total ≈ " + frInt(o.total_eur) + " €</strong>" : "") : "—") + '</td>';
                }).join("") + '</tr>'
              + '<tr><td style="color:#6B7280;font-size:11px;text-transform:uppercase;padding:8px;vertical-align:top;">Le jour</td>' + j.days.map(function (d) {
                  return '<td style="padding:8px;border-bottom:1px solid #F3F4F6;vertical-align:top;">' + d.questions.map(qLine).join("") + '</td>';
                }).join("") + '</tr>'
              + '<tr><td></td>' + j.days.map(function (d) {
                  return '<td style="padding:8px;">' + (d.date >= new Date().toISOString().slice(0, 10) ? '<button type="button" data-ev-choose="' + esc(d.date) + '" style="font-size:13px;font-weight:500;color:#1D3BB3;border:1px solid #1D3BB3;border-radius:10px;padding:6px 12px;background:transparent;cursor:pointer;font-family:inherit;">Choisir</button>' : "") + '</td>';
                }).join("") + '</tr></tbody></table></div>'
              + (best ? '<div style="color:#1D3BB3;font-size:13px;font-weight:600;margin-top:8px;">Recommandé : ' + best.dow_fr + " " + frD(best.date) + ' — meilleur score du jour ; vérifiez ses lignes ci-dessus avant de choisir.</div>' : "")
              + '<div data-ev-choose-msg style="display:none;margin-top:8px;font-size:12.5px;color:#166534;background:#E6F6F0;border-radius:8px;padding:9px 12px;"></div></div>';
          }

          // État Avant — les 5 questions du jour visé.
          var avantHtml = "";
          if (j.avant_date) {
            var day = null;
            j.days.forEach(function (d) { if (d.date === j.avant_date) day = d; });
            if (day) {
              var o2 = day.objectif || {};
              avantHtml = '<div data-ev-panel="avant"' + (current !== "avant" ? ' style="display:none;"' : "") + '>'
                + '<div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;"><div style="font-size:11px;text-transform:uppercase;letter-spacing:0.06em;color:rgba(17,24,39,0.45);font-weight:600;flex:1;">Le ' + day.dow_fr + " " + frD(day.date) + ' pour votre événement</div>'
                + (day.score != null ? '<span style="font-size:12px;padding:3px 9px;border-radius:20px;background:#F3F4F6;color:#6b7280;">Score prévu : ' + day.score + '/10</span>' : "") + '</div>'
                + day.questions.map(qLine).join("")
                + (o2.expected_eur != null ? '<div style="font-size:12px;color:#6B7280;margin-top:8px;">Objectif : ' + esc(kpiLbl) + (o2.apport_eur != null ? " — apport visé " + signEur(o2.apport_eur) : "") + " · attendu du jour ≈ " + frInt(o2.expected_eur) + " €" + (o2.total_eur != null ? " → total visé ≈ " + frInt(o2.total_eur) + " €" : "") + '</div>' : "") + '</div>';
            }
          }

          // État Après — mesuré par occurrence + série + Documenter.
          var apresHtml = "";
          if (j.apres && j.apres.rows.length) {
            var last = null;
            j.apres.rows.forEach(function (r) { if (r.gap_eur != null) last = r; });
            var box = function (k, v, b) { return '<div style="flex:1;min-width:120px;border:1px solid rgba(0,0,0,0.08);border-radius:8px;padding:10px 12px;"><div style="font-size:10.5px;text-transform:uppercase;letter-spacing:0.05em;color:#9CA3AF;font-weight:600;">' + k + '</div><div style="font-size:15px;font-weight:600;margin-top:3px;">' + v + '</div><div style="font-size:10.5px;color:#9CA3AF;margin-top:2px;">' + b + '</div></div>'; };
            var panel = "";
            if (last) {
              var domBox = it.kpi === "family_revenue" && last.family_rev != null
                ? box("Famille " + esc(it.kpi_family || "") + " — objectif", frInt(last.family_rev) + " €", last.family_avg != null ? "vs " + frInt(last.family_avg) + " € sa moyenne journalière" : "") : "";
              var chip = "";
              if (last.target_met != null) {
                var okT = last.target_met;
                var detail = it.kpi === "family_revenue" && last.family_rev != null
                  ? "famille " + esc(it.kpi_family || "") + " " + frInt(last.family_rev) + " € (cible " + frInt(it.kpi_target_eur) + " €)"
                  : it.kpi === "revenue_residual" && last.residual_pct != null ? "CA " + (last.residual_pct >= 0 ? "+" : "") + last.residual_pct + " % vs attendu (cible +" + frInt(it.kpi_target_pct) + " %)"
                  : "";
                chip = '<div style="margin-bottom:8px;"><span style="display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;border-radius:20px;padding:4px 11px;color:' + (okT ? "#059669" : "#B45309") + ';background:' + (okT ? "#E6F6F0" : "#FEF3E2") + ';">' + (okT ? "Cible atteinte" : "Cible manquée") + (detail ? " — " + detail : "") + '</span></div>';
              }
              if (last.target_met == null && it.kpi_target_eur == null && it.kpi_target_pct == null)
                chip = '<div style="margin-bottom:8px;font-size:12px;color:#6B7280;">Aucun objectif n’était posé — le mesuré ci-dessous reste votre référence ; posez une cible à la prochaine occasion pour obtenir un verdict.</div>';
              panel = chip + '<div style="font-size:12px;color:#6B7280;margin-bottom:6px;">Dernière occurrence mesurée : ' + last.dow_fr + " " + frD(last.date) + (last.verdict ? " · verdict statistique de l’engagement : " + esc(last.verdict) : " · verdict statistique au bilan de l’engagement") + '</div>'
                + '<div style="display:flex;gap:10px;flex-wrap:wrap;">' + domBox
                + box("CA total", frInt(last.revenue) + " €", "vs " + frInt(last.expected) + " € attendu (" + signEur(last.gap_eur) + ")")
                + (last.tickets != null ? box("Tickets", frInt(last.tickets), "vs " + frInt(last.tickets_base) + " habituel" + (last.tickets_delta_pct != null ? " (" + (last.tickets_delta_pct >= 0 ? "+" : "") + last.tickets_delta_pct + " %)" : "")) : "")
                + (last.basket != null ? box("Panier moyen", String(last.basket).replace(".", ",") + " €", "vs " + String(last.basket_base).replace(".", ",") + " € habituel") : "") + '</div>';
            }
            var serieHtml = "";
            if (j.apres.serie) {
              var se = j.apres.serie;
              serieHtml = '<div style="margin-top:12px;border-top:1px solid #F3F4F6;padding-top:10px;">'
                + '<div style="display:flex;align-items:center;gap:10px;"><div style="font-size:13px;font-weight:600;flex:1;">Série — ' + se.n_above + "/" + se.n_measured + ' occurrence(s) mesurée(s) au-dessus de l’attendu</div>'
                + (se.sum_gap_eur != null ? '<div style="text-align:right;"><div style="font-size:15px;font-weight:600;color:' + (se.sum_gap_eur >= 0 ? "#059669" : "#B45309") + ';">' + signEur(se.sum_gap_eur) + '</div><div style="font-size:10.5px;color:#9CA3AF;">mesuré · ' + se.n_measured + ' occ. — jamais extrapolé</div></div>' : "") + '</div>'
                + j.apres.rows.map(function (r) {
                    return '<div style="display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid #F3F4F6;font-size:12.5px;"><span style="width:100px;font-weight:600;">' + r.dow_fr.slice(0, 3) + " " + frD(r.date) + '</span>'
                      + (r.gap_eur != null ? '<span style="font-size:11px;font-weight:600;border-radius:20px;padding:3px 9px;color:' + (r.gap_eur >= 0 ? "#059669" : "#B45309") + ';background:' + (r.gap_eur >= 0 ? "#E6F6F0" : "#FEF3E2") + ';">' + signEur(r.gap_eur) + ' vs attendu</span>' : '<span style="font-size:11px;color:#9CA3AF;">pas de mesure</span>')
                      + (r.family_rev != null ? '<span style="font-size:11.5px;color:#6B7280;">' + esc(it.kpi_family || "famille") + " " + frInt(r.family_rev) + " €</span>" : "")
                      + (r.verdict ? '<span style="font-size:11px;color:#6B7280;">verdict : ' + esc(r.verdict) + '</span>' : "") + '</div>';
                  }).join("")
                + (se.next_date ? '<div style="font-size:12px;color:#6B7280;margin-top:6px;">Prochaine occurrence : ' + frD(se.next_date) + ' — préparation en carte J-1.</div>' : "") + '</div>';
            }
            // 10/08 (owner) : plus de bouton « Documenter » PARALLÈLE au bilan — même acte
            // (capitaliser) en deux formulaires déconnectés. Une seule voie : le bilan, qui
            // enchaîne sur « En faire un dispositif ? » (voir docChainHtml).
            apresHtml = '<div data-ev-panel="apres"' + (current !== "apres" ? ' style="display:none;"' : "") + '>' + panel + serieHtml + '</div>';
          }

          if (avantHtml && current === "decider") avantHtml = avantHtml.replace('data-ev-panel="avant"', 'data-ev-panel="avant" style="display:none;"');
          body.innerHTML = head + segHtml + deciderHtml + avantHtml + apresHtml;
          // F1/F3 (owner 10/08) : le titre dit le JOB, le sous-titre ce que ça livre — jamais
          // le modèle de données. Promesse limitée à ce que le pipeline fait vraiment.
          var HEAD_BY_STAGE = {
            decider: ["Choisir la date — " + it.title, "Les jours candidats, déjà chiffrés — comparez, puis choisissez."],
            avant: ["Préparer — " + it.title, "Le jour est chiffré ci-dessous ; la mesure s’arme seule à J-7 et le verdict tombera tout seul."],
            apres: ["Évaluer — " + it.title, "Le résultat est mesuré ci-dessous ; votre bilan ajoute ce que la mesure ne voit pas — 2 minutes."],
          };
          function setHead(k) {
            var h = HEAD_BY_STAGE[k] || HEAD_BY_STAGE.avant;
            document.querySelector("#evt-head div").textContent = h[0];
            var sub = document.querySelector("#evt-head div + div");
            if (sub) sub.textContent = h[1];
          }
          setHead(current);
          renderConsigne(j);
          maybeRenderBilan(j);

          body.querySelectorAll("[data-ev-st]").forEach(function (b) {
            b.addEventListener("click", function () {
              var k = b.getAttribute("data-ev-st");
              body.querySelectorAll("[data-ev-st]").forEach(function (x) { var on = x === b; x.style.background = on ? "#1D3BB3" : "#fff"; x.style.color = on ? "#fff" : "#1D3BB3"; });
              body.querySelectorAll("[data-ev-panel]").forEach(function (p) { p.style.display = p.getAttribute("data-ev-panel") === k ? "block" : "none"; });
              setHead(k);
            });
          });

          // Choisir (état Décider) : selected_date + engagement ancré sur le jour (interim
          // incrément 4 : seuil % dérivé de l'apport visé vs l'attendu du jour choisi).
          body.querySelectorAll("[data-ev-choose]").forEach(function (b) {
            b.addEventListener("click", function () {
              var date = b.getAttribute("data-ev-choose");
              var day2 = null; j.days.forEach(function (d) { if (d.date === date) day2 = d; });
              var o3 = (day2 && day2.objectif) || {};
              var pct = it.kpi_target_pct != null ? Math.round(it.kpi_target_pct)
                : (o3.apport_eur != null && o3.expected_eur ? Math.max(1, Math.min(100, Math.round(100 * o3.apport_eur / o3.expected_eur))) : 10);
              b.disabled = true; b.textContent = "Choix…";
              // Durée multi-jours (04/08) : la fenêtre de mesure couvre [lancement, lancement+durée−1]
              // et event_end_date (colonne historique, lue par les crons bilan/J-7) se cale dessus.
              var dur = Number(it.duration_days) >= 1 ? Math.min(31, Math.round(Number(it.duration_days))) : 1;
              var updBody = { saved_item_id: item, selected_date: date };
              if (dur > 1) {
                var ed = new Date(date + "T00:00:00Z"); ed.setUTCDate(ed.getUTCDate() + dur - 1);
                updBody.event_end_date = ed.toISOString().slice(0, 10);
              }
              fetch("/api/saved-items/update", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(updBody) })
                .then(function (r) { return r.json(); })
                .then(function (u) {
                  if (!u || !u.ok) throw new Error((u && u.error) || "Erreur");
                  return fetch("/api/commitments", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({
                    location_id: loc, origin_action_type: "event_" + (it.event_type || "autre"), saved_item_id: item,
                    event_kpi: it.kpi || null, kpi_family: it.kpi_family || null,
                    window_kind: "day_of", window_start_date: date, window_days: dur > 1 ? dur : null,
                    threshold_basis: "pct", threshold_pct: pct,
                    committed_action_text: it.title + (it.dispositif ? " — " + it.dispositif : ""),
                    owner_person_name: it.author_person_name || "—",
                  }) }).then(function (r) { return r.json(); });
                })
                .then(function (c) {
                  var m = body.querySelector("[data-ev-choose-msg]");
                  m.style.display = "block";
                  m.textContent = frD(date) + " choisi — " + (c && c.ok ? "engagement de mesure créé (fenêtre ancrée sur ce jour). Rechargement…" : "événement mis à jour, mais engagement non créé (" + ((c && c.error) || "erreur") + ").");
                  if (c && c.ok) setTimeout(function () { window.location.reload(); }, 1200);
                })
                .catch(function (e) { b.disabled = false; b.textContent = "Choisir"; alert("Erreur : " + (e && e.message ? e.message : "réessayez")); });
            });
          });

        }
        // Mode CRÉATION (?new=1 ou ?dates= pré-remplies depuis la planification) — les autres
        // modes (dossier, liste) ont déjà lancé leur fetch ci-dessus.
        if (!item && wantForm) {
          if (!loc) { body.textContent = "Lieu manquant — ouvrez cette page depuis l’application."; return; }
          if (!window.MSEventForm) { body.textContent = "Formulaire indisponible — rechargez la page."; return; }
          window.MSEventForm.open(body, { location_id: loc, dates: preDates, titre: qs.get("titre") || "", dispositif: qs.get("dispositif") || "" });
        }
      })();
    </script>
  </BaseLayout>
</Show>
