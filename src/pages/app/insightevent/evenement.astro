---
// « /evenement » — le dossier d'événement-dispositif (spec docs/evenement-dossier-spec.md).
// Mode LISTE (par défaut, sans saved_item_id) : les événements du lieu via ?list=1 — premier
// consommateur de vw_insight_event_user_events ; lieu résolu via /api/profile/locations
// (primaire d'abord) quand l'URL n'en porte pas (lien BottomBar).
// Mode CRÉATION (?new=1 ou ?dates=) : MSEventForm (public/js/event-form.js, ?dates= pré-remplies).
// Mode DOSSIER (?saved_item_id=) : les 3 états Décider/Avant/Après sur provider evenementFamily ;
// la CIBLE du KPI dominant est jugée en DÉTERMINISTE (target_met — un fait), le verdict
// STATISTIQUE reste celui de l'engagement K1 (bande de bruit + gardes — décision étape 3),
// les deux affichés, jamais confondus ; lieu résolu via saved-items/get quand absent (lien Nav).
// Bilan déclaratif 3 questions (complément du mesuré — décision owner 03/08) : bloc du dossier
// quand une occurrence est passée et qu'aucun bilan n'est soumis ; ?mode=bilan y défile (email J+7).
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { Show } from "@clerk/astro/components";

const locParam = Astro.url.searchParams.get("location_id") || "";
const itemParam = Astro.url.searchParams.get("saved_item_id") || "";
---

<Show when="signed-out" client:load>
  <meta http-equiv="refresh" content="0; url=/sign-in" />
</Show>

<Show when="signed-in" client:load>
  <BaseLayout title="Événement — Muse Square" hideSurveyCta={true} hideFooter={true}>
    <div id="evt-root" data-loc={locParam} data-item={itemParam}>
      <div id="evt-toolbar" style="margin-bottom:14px;"><a href="/app/insightevent/tableau" id="evt-back" style="font-size:14px;color:#6b7280;text-decoration:none;">← Retour</a></div>
      <div id="evt-head" style="margin-bottom:12px;">
        <div style="font-size:15px;font-weight:600;color:#111827;">Nouvelle opération</div>
        <div style="font-size:12px;color:#6b7280;line-height:1.5;">Un événement porte son dispositif, son objectif (le KPI que le verdict jugera) et, s’il se répète, sa série — la mesure se crée avec lui.</div>
      </div>
      <div id="evt-body" style="background:#fff;border:1px solid rgba(0,0,0,0.08);border-radius:10px;box-shadow:0 1px 3px rgba(16,24,40,0.06);padding:14px 16px;">Chargement…</div>
    </div>


    <style is:global>
      #evt-root { max-width: 760px; margin: 0 auto; padding: 16px 16px 80px; font-family: system-ui, -apple-system, sans-serif; color: #111827; }
      /* Bilan : les puces se lisent comme des CHOIX (retour owner 05/08) */
      .evt-bl-chip:hover { border-color: #1D3BB3 !important; color: #1D3BB3 !important; }
    </style>

<script is:inline src="/js/pole-form.js?v=3"></script>
<script is:inline src="/js/event-form.js?v=15"></script>
    <script is:inline src="/js/draft-workspace.js?v=5"></script>
    <script is:inline>
      (function () {
        var root = document.getElementById("evt-root");
        var body = document.getElementById("evt-body");
        // « Retour » = le point de DÉPART (owner 05/08) : history.back() quand on vient d'une
        // page de l'app ; repli tableau pour les arrivées directes (email, lien partagé).
        var backEl = document.getElementById("evt-back");
        if (backEl) backEl.addEventListener("click", function (ev) {
          if (window.history.length > 1 && document.referrer && document.referrer.indexOf(window.location.origin) === 0) { ev.preventDefault(); window.history.back(); }
        });
        var loc = root.getAttribute("data-loc") || "";
        var item = root.getAttribute("data-item") || "";
        var qs = new URLSearchParams(window.location.search);
        var preDates = String(qs.get("dates") || "").split(",").map(function (s) { return s.trim(); }).filter(Boolean);
        var wantForm = qs.get("new") === "1" || preDates.length > 0;
        // inc. 6 : après un geste du bloc consigne, le dossier se re-rend depuis la base et
        // revient sur le bloc (feedback = la vérité relue, pas un message).
        var consigneScrollPending = false;

        function openDossier() {
          fetch("/api/insight/evenement?location_id=" + encodeURIComponent(loc) + "&saved_item_id=" + encodeURIComponent(item), { cache: "no-store" })
            .then(function (r) { return r.json(); })
            .then(function (j) {
              if (!j || !j.ok) { body.textContent = "Erreur : " + ((j && j.error) || "réessayez."); return; }
              if (!j.found) { body.textContent = j.reason || "Événement introuvable."; return; }
              renderDossier(j);
            })
            .catch(function () { body.textContent = "Erreur de chargement."; });
        }

        function openList() {
          fetch("/api/insight/evenement?location_id=" + encodeURIComponent(loc) + "&list=1", { cache: "no-store" })
            .then(function (r) { return r.json(); })
            .then(function (j) {
              if (!j || !j.ok) { body.textContent = "Erreur : " + ((j && j.error) || "réessayez."); return; }
              renderList(j.events || []);
            })
            .catch(function () { body.textContent = "Erreur de chargement."; });
        }

        if (item) {
          // Dossier — lieu résolu par l'événement lui-même quand le lien n'en porte pas (Nav, emails).
          if (loc) { openDossier(); }
          else {
            fetch("/api/saved-items/get", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ saved_item_id: item }) })
              .then(function (r) { return r.json(); })
              .then(function (g) {
                if (!g || !g.ok || !g.item || !g.item.location_id) { body.textContent = "Événement introuvable."; return; }
                loc = String(g.item.location_id);
                openDossier();
              })
              .catch(function () { body.textContent = "Erreur de chargement."; });
          }
          // (renderDossier et ses aides sont déclarés plus bas — hoisting.)
        } else if (!wantForm) {
          // LISTE par défaut — lieu primaire quand l'URL n'en porte pas (lien BottomBar).
          document.querySelector("#evt-head div").textContent = "Mes événements";
          document.querySelector("#evt-head div + div").textContent = "Tous les événements du lieu — dossier, série et mesure. Le dossier juge la cible ; le verdict statistique reste celui de l’engagement.";
          if (loc) { openList(); }
          else {
            fetch("/api/profile/locations", { cache: "no-store" })
              .then(function (r) { return r.json(); })
              .then(function (p) {
                var l0 = p && p.ok && Array.isArray(p.locations) && p.locations[0];
                if (!l0 || !l0.location_id) { body.textContent = "Aucun lieu configuré."; return; }
                loc = String(l0.location_id);
                openList();
              })
              .catch(function () { body.textContent = "Erreur de chargement."; });
          }
        }
        function esc(s) { return String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;"); }
        function frInt(n) { return Math.abs(Math.round(Number(n) || 0)).toLocaleString("fr-FR"); }
        function frD(iso) { var d = String(iso || "").slice(0, 10); return d ? d.slice(8, 10) + "/" + d.slice(5, 7) : ""; }
        var DOW_FR_PAGE = ["dimanche", "lundi", "mardi", "mercredi", "jeudi", "vendredi", "samedi"];
        function dowFr(iso) { var d = String(iso || "").slice(0, 10); return d ? (DOW_FR_PAGE[new Date(d + "T12:00:00Z").getUTCDay()] || "") : ""; }
        function signEur(n) { return (Number(n) >= 0 ? "+" : "−") + frInt(n) + " €"; }
        var TONE = { ok: "#059669", warn: "#B45309", bad: "#e24b4a", info: "#6B7280" };
        function dot(t) { return '<span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:' + (TONE[t] || TONE.info) + ';margin-right:7px;flex:none;margin-top:5px;"></span>'; }
        function qLine(qu) {
          return '<div style="display:flex;align-items:flex-start;padding:7px 0;border-bottom:1px solid #F3F4F6;font-size:12.5px;line-height:1.5;">' + dot(qu.tone)
            + '<span>' + esc(qu.fact_fr) + (qu.action_fr ? ' <span style="color:#1D3BB3;font-weight:600;">' + esc(qu.action_fr) + '</span>' : '')
            + (qu.href ? ' <a href="' + esc(qu.href) + '" style="color:#1D3BB3;font-weight:600;text-decoration:none;white-space:nowrap;">' + esc(qu.link_fr || 'Voir →') + '</a>' : '') + '</span></div>';
        }

        // ── La LISTE (mode par défaut) — la vue user_events : quand, série, track record. ──
        function renderList(events) {
          var newHref = "/app/insightevent/evenement?location_id=" + encodeURIComponent(loc) + "&new=1";
          // « Nouvel événement » vit dans la rangée Retour (owner 18/08 — même motif que le
          // tableau de bord), jamais dans la carte de liste.
          var tb = document.getElementById("evt-toolbar");
          if (tb && !document.getElementById("evt-new-btn")) {
            tb.style.cssText += "display:flex;align-items:center;justify-content:space-between;gap:10px;";
            var nb = document.createElement("a");
            nb.id = "evt-new-btn"; nb.href = newHref;
            nb.style.cssText = "display:inline-flex;align-items:center;padding:8px 14px;border:1px solid #1D3BB3;border-radius:8px;font-size:13px;font-weight:500;color:#1D3BB3;text-decoration:none;background:#fff;";
            nb.textContent = "Nouvel \u00e9v\u00e9nement";
            tb.appendChild(nb);
          }
          // « Fixer → » du tableau de bord (owner 18/08) : vue FILTRÉE des événements sans
          // objectif — même critère que le compteur du bandeau (kpi absent en base).
          var filtreSansObj = qs.get("filtre") === "sans_objectif";
          var filtreHead = "";
          if (filtreSansObj) {
            var tousHref = "/app/insightevent/evenement?location_id=" + encodeURIComponent(loc);
            var sans = events.filter(function (e) { return !e.kpi; });
            filtreHead = '<div style="display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;margin-bottom:10px;font-size:13px;">'
              + '<span style="font-weight:650;">' + sans.length + ' \u00e9v\u00e9nement' + (sans.length > 1 ? 's' : '') + ' sans objectif</span>'
              + '<span style="color:#6B7280;">sans objectif, aucun verdict \u2014 fixez-le, la mesure fait le reste</span>'
              + '<a href="' + tousHref + '" style="margin-left:auto;color:#1D3BB3;font-weight:600;text-decoration:none;font-size:12.5px;">Tous mes \u00e9v\u00e9nements \u2192</a></div>';
            events = sans;
            if (!events.length) {
              body.innerHTML = filtreHead + '<div style="font-size:13px;color:#6B7280;">Tous vos \u00e9v\u00e9nements ont un objectif sur ce lieu.</div>';
              return;
            }
          }
          if (!events.length) {
            body.innerHTML = '<div style="font-size:13px;color:#6B7280;">Aucun événement pour ce lieu. <a href="' + newHref + '" style="color:#1D3BB3;font-weight:600;">Créer le premier</a>.</div>';
            return;
          }
          body.innerHTML = filtreHead + events.map(function (e) {
            var when = e.recurring
              ? "Série · " + (e.n_occurrences || 0) + " occurrence(s)" + (e.next_date ? " · prochaine le " + frD(e.next_date) : e.last_date ? " · terminée le " + frD(e.last_date) : "")
              : e.next_date ? "Prochaine date : " + frD(e.next_date)
              : e.selected_date ? "Date : " + frD(e.selected_date)
              : e.last_date ? "Terminé le " + frD(e.last_date) : "Dates à choisir";
            var track = e.n_resolved
              ? '<span style="font-size:11px;font-weight:600;border-radius:20px;padding:3px 9px;color:' + (Number(e.sum_gap_eur) >= 0 ? "#059669" : "#B45309") + ';background:' + (Number(e.sum_gap_eur) >= 0 ? "#E6F6F0" : "#FEF3E2") + ';">' + (e.sum_gap_eur != null ? signEur(e.sum_gap_eur) + " vs votre résultat habituel · " : "") + (e.n_beat || 0) + "/" + e.n_resolved + " tenue(s)</span>"
              : '<span style="font-size:11px;color:#9CA3AF;">pas encore de mesure résolue</span>';
            return '<a href="/app/insightevent/evenement?location_id=' + encodeURIComponent(loc) + '&saved_item_id=' + encodeURIComponent(e.saved_item_id) + '" style="display:block;text-decoration:none;color:inherit;border:1px solid rgba(0,0,0,0.08);border-radius:10px;padding:12px 14px;margin-bottom:8px;background:#fff;">'
              + '<div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin-bottom:4px;">'
              + '<span style="font-size:13.5px;font-weight:600;">' + esc(e.title) + '</span>'
              // UNE pilule, deux \u00e9tats (owner 18/08) : l'objectif est fix\u00e9 (avec SA valeur) ou pas.
              + (e.kpi
                ? '<span style="display:inline-flex;font-size:11px;padding:2px 8px;border-radius:20px;background:#F3F4F6;color:#374151;">Objectif : ' + (e.kpi === 'family_revenue' ? (e.kpi_target_eur != null ? '+' + frInt(e.kpi_target_eur) + ' \u20ac famille' : 'famille') : (e.kpi_target_pct != null ? '+' + String(e.kpi_target_pct).replace('.', ',') + ' %' : 'fix\u00e9')) + '</span>'
                : '<span style="display:inline-flex;font-size:11px;padding:2px 8px;border-radius:20px;background:#FEF3E2;color:#B45309;">Objectif non fix\u00e9</span>')
              + '</div>'
              + '<div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;font-size:12px;color:#6B7280;">'
              + '<span>' + esc(when) + '</span>' + track
              + (e.author_person_name ? '<span>créé par ' + esc(e.author_person_name) + '</span>' : "")
              + '</div></a>';
          }).join("");
        }

        // ── Bilan déclaratif — 3 questions (décision owner 03/08 : « conservé en complément du
        //    mesuré, 3 questions »). Complément du MESURÉ : météo vécue (calibre les classes),
        //    accessibilité vécue (clients vs fournisseurs, non concluant), fréquentation vs
        //    attentes (non mesurée pour la plupart des lieux). La concurrence saute : seule
        //    dimension déjà entièrement mesurée par le pipeline. Écrit dans raw.event_outcomes
        //    via /api/saved-items/bilan (endpoint inchangé, competition_felt absent → NULL). ──
        // ── Porte objectif (owner 16/08) : « toute page de mesure PORTE un objectif ». Un
        //    événement sans cible n'a pas droit au bilan — on fixe l'objectif D'ABORD, en place
        //    (update.ts accepte kpi/kpi_target_*), puis le dossier se re-rend depuis la base.
        function renderFixObjectifBlock(it, jj0) {
          // Aperçu pendant la saisie (owner 18/08) : la valeur ABSOLUE de l'opération + l'annualisé.
          // Référence = votre résultat habituel des jours de l'opération (objectif.expected_eur du
          // dossier) ; annualisé SEULEMENT pour une série (52 hebdo / 12 mensuel) — jamais extrapolé
          // pour un ponctuel.
          var _refs = ((jj0 && jj0.days) || []).map(function (d2) { return d2.objectif && d2.objectif.expected_eur; }).filter(function (v2) { return v2 != null; });
          var _refEur = _refs.length ? _refs.reduce(function (a2, b2) { return a2 + b2; }, 0) / _refs.length : null;
          // Repli : les occurrences MESURÉES d'Évaluer (apres.rows[].expected — le « vs X € habituel »).
          if (_refEur == null && jj0 && jj0.apres && jj0.apres.rows) {
            var _r2 = jj0.apres.rows.map(function (r2) { return r2.expected; }).filter(function (v2) { return v2 != null; });
            if (_r2.length) _refEur = _r2.reduce(function (a2, b2) { return a2 + b2; }, 0) / _r2.length;
          }
          var _occAn = it.recurrence === 'weekly' ? 52 : it.recurrence === 'monthly' ? 12 : null;
          var wrap = document.createElement("div");
          wrap.id = "evt-bilan";
          wrap.style.cssText = "margin-top:16px;border-top:1px solid #F3F4F6;padding-top:12px;";
          var kpiSet = !!it.kpi;
          var isFam = it.kpi === "family_revenue";
          var kpiLbl3 = isFam ? "CA famille " + (it.kpi_family ? "\u00ab " + it.kpi_family + " \u00bb" : "") + " (\u20ac)"
            : it.kpi === "tickets" ? "tickets vs votre résultat habituel (+%)"
            : it.kpi === "basket" ? "panier moyen vs votre résultat habituel (+%)"
            : it.kpi === "profit_estimated" ? "profit estimé vs sa moyenne 90 j (+%)"
            : "CA du jour vs votre résultat habituel (+%)";
          wrap.innerHTML = '<div style="font-size:11px;text-transform:uppercase;letter-spacing:0.06em;color:#B45309;font-weight:600;margin-bottom:4px;">Objectif \u00e0 fixer</div>'
            + '<div style="font-size:12.5px;color:#374151;margin-bottom:10px;">Sans objectif, aucun verdict ne peut juger vos occurrences \u2014 fixez-le, la mesure fait le reste.' + (kpiSet ? "" : " KPI par d\u00e9faut : CA du jour vs votre résultat habituel (modifiable ensuite).") + '</div>'
            + '<div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">'
            + '<span style="font-size:12.5px;color:#6B7280;">' + kpiLbl3 + ' :</span>'
            + '<input data-fx-val type="number" min="1" step="1" placeholder="' + (isFam ? "ex. 150" : "ex. 10") + '" style="width:90px;padding:6px 9px;border:1px solid #E5E7EB;border-radius:8px;font-size:13px;font-family:inherit;">'
            + '<span style="font-size:13px;color:#374151;">' + (isFam ? "\u20ac" : "%") + '</span>'
            + '<button type="button" data-fx-save style="font-size:12.5px;font-weight:600;color:#fff;background:#1D3BB3;border:none;border-radius:8px;padding:6px 13px;cursor:pointer;font-family:inherit;">Fixer l\u2019objectif</button>'
            + '<span data-fx-msg style="font-size:12px;color:#B45309;"></span></div>'
            + '<div data-fx-prev style="font-size:12px;color:#6B7280;margin-top:8px;"></div>';
          (body.querySelector('[data-ev-mount="bilan"]') || body).appendChild(wrap);
          var _prevEl = wrap.querySelector("[data-fx-prev]");
          wrap.querySelector("[data-fx-val]").addEventListener("input", function () {
            var v2 = Number(String(wrap.querySelector("[data-fx-val]").value || "").replace(",", "."));
            if (!v2 || v2 <= 0) { _prevEl.textContent = ""; return; }
            var absEur = isFam ? v2 : (_refEur != null && it.kpi !== 'tickets' && it.kpi !== 'basket' ? _refEur * v2 / 100 : null);
            if (absEur == null) { _prevEl.textContent = ""; return; }
            _prevEl.innerHTML = '\u2248 <b>+' + frInt(absEur) + ' \u20ac</b> par occurrence'
              + (isFam ? '' : ' <span style="color:#9CA3AF;">(sur votre r\u00e9sultat habituel \u2248 ' + frInt(_refEur) + ' \u20ac/j)</span>')
              + (_occAn ? ' \u00b7 \u2248 <b>+' + frInt(absEur * _occAn) + ' \u20ac/an</b> <span style="color:#9CA3AF;">(s\u00e9rie, ' + _occAn + ' occurrences/an)</span>' : '');
          });
          wrap.querySelector("[data-fx-save]").addEventListener("click", function () {
            var v = Number(String(wrap.querySelector("[data-fx-val]").value || "").replace(",", "."));
            var msg = wrap.querySelector("[data-fx-msg]");
            if (!isFinite(v) || v <= 0) { msg.textContent = "Cible requise (nombre positif)."; return; }
            msg.style.color = "#6B7280"; msg.textContent = "Enregistrement\u2026";
            var payload = { saved_item_id: item, kpi: it.kpi || "revenue_residual", kpi_family: isFam ? (it.kpi_family || null) : null };
            if (isFam) payload.kpi_target_eur = v; else payload.kpi_target_pct = v;
            fetch("/api/saved-items/update", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(payload) })
              .then(function (r2) { return r2.json(); })
              .then(function (jj) {
                if (jj && jj.ok) { openDossier(); }
                else { msg.style.color = "#B45309"; msg.textContent = (jj && jj.error) || "R\u00e9essayez."; }
              }).catch(function () { msg.style.color = "#B45309"; msg.textContent = "R\u00e9essayez."; });
          });
        }

        function maybeRenderBilan(j) {
          var it = j.item || {};
          window._evtBilanItem = it;
          // Porte objectif : pas de cible -> pas de bilan (on ne demande pas un v\u00e9cu qu'aucun
          // verdict ne pourra juger) ; le bloc \u00ab Objectif \u00e0 fixer \u00bb prend la place.
          if (it.kpi_target_eur == null && it.kpi_target_pct == null) { renderFixObjectifBlock(it, j); return; }
          var today = new Date().toISOString().slice(0, 10);
          // Terminée = date passée, ou aujourd'hui avec l'heure de fin dépassée (Paris). Sans
          // heure de fin connue, le jour même ne compte pas — on ne demande pas un vécu à venir.
          var _hParis = Number(new Intl.DateTimeFormat("fr-FR", { timeZone: "Europe/Paris", hour: "numeric", hour12: false }).format(new Date()));
          function occOver(d) {
            var dd = String(d).slice(0, 10);
            if (dd < today) return true;
            if (dd > today) return false;
            return it.hour_end != null && _hParis >= Number(it.hour_end);
          }
          var past = (it.dates || []).map(String).filter(function (d) { return d && occOver(d); });
          if (!past.length && it.selected_date && occOver(it.selected_date)) past = [String(it.selected_date).slice(0, 10)];
          if (!past.length) return;
          var bilanDate = past[past.length - 1].slice(0, 10);
          // Le bilan ne se demande QUE sur une occurrence terminée : tant que son engagement
          // tourne, la seule action possible est d'ajuster (page Évolution).
          var rowB0 = ((j.apres && j.apres.rows) || []).filter(function (r) { return r.date === bilanDate; })[0];
          if (rowB0 && (rowB0.commitment_status === "open" || rowB0.commitment_status === "pending")) return;
          window._evtBilanJ = j;
          fetch("/api/saved-items/snapshot?saved_item_id=" + encodeURIComponent(item), { cache: "no-store" })
            .then(function (r) { return r.json(); })
            .then(function (sj) {
              if (!sj || !sj.ok) return;
              if (sj.bilan_submitted) { renderBilanDoneBlock(bilanDate); return; }
              renderBilanBlock(bilanDate);
            })
            .catch(function () {});
        }

        // ── Chaîne bilan → dispositif (10/08) : l'output découle de l'input, jamais un bouton
        //    frère. Idempotente (apres.documented, clé serveur) ; recette JAMAIS vide (l'ancien
        //    bouton avait écrit « Lancement SaaS (événement « Lancement SaaS ») » — archivé) ;
        //    le succès a un ENDROIT : lien vers vos Dispositifs. ──
        function docChainHtml() {
          var jj = window._evtBilanJ || {};
          var itC = jj.item || {};
          if (!jj.apres || !jj.apres.rows || !jj.apres.rows.length) return "";
