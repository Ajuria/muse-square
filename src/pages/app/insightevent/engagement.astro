---
export const prerender = false;
// « /engagement » — la page d'une OPÉRATION (vue de détail d'Agir). Le document est le composant partagé
// EngagementDoc ; un PÔLE ouvert par cette adresse est redirigé vers /app/insightevent/pole (13/09).
import BaseLayout from "../../../layouts/BaseLayout.astro";
import EngagementDoc from "../../../components/EngagementDoc.astro";
import { Show } from "@clerk/astro/components";
import { EVOL_COPY } from "../../../lib/commitments/commitmentCopy";

const id = Astro.url.searchParams.get("id") || "";
---

<Show when="signed-out" client:load>
  <meta http-equiv="refresh" content="0; url=/sign-in" />
</Show>

<Show when="signed-in" client:load>
  <BaseLayout title="Évolution de l'engagement — Muse Square" hideSurveyCta={true} hideFooter={true}>
    <EngagementDoc id={id} page="engagement" backHref="/app/insightevent/pulse" backLabel={EVOL_COPY.back} />
  </BaseLayout>
</Show>
